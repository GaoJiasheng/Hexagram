{
  "1": {
    "0": [
      {
        "term": "上仪同三司",
        "note": "隋散官名，仪同三司之上阶，有位秩而无职事。"
      },
      {
        "term": "城阳郡开国公",
        "note": "爵名。郡公之号，冠以所封之郡曰城阳。"
      },
      {
        "term": "萧吉",
        "note": "字文休，梁武帝兄长沙王萧懿之孙，入隋精阴阳算术。"
      }
    ],
    "1": [
      {
        "term": "九功",
        "note": "六府三事之功：水火金木土谷，与正德、利用、厚生。"
      },
      {
        "term": "六沴",
        "reading": "liù lì",
        "note": "沴，恶气相伤。六气不和所生的灾变，语本《洪范五行传》。"
      },
      {
        "term": "坟索",
        "reading": "fén suǒ",
        "note": "三坟、八索的省称，泛指上古典籍。"
      },
      {
        "term": "商王受命",
        "note": "受，商纣之名。句本《尚书》，三政即三正。"
      }
    ]
  },
  "2": {
    "0": [
      {
        "term": "释名",
        "note": "解释名称之义；六朝训诂通例，汉刘熙有《释名》专书。"
      },
      {
        "term": "五行",
        "note": "金木水火土五者，古以为万物之本、递相生克。"
      },
      {
        "term": "支干",
        "note": "即干支，天干与地支；古书多作「支干」。"
      }
    ]
  },
  "3": {
    "0": [
      {
        "term": "咳而名之",
        "reading": "hái ér míng zhī",
        "note": "《礼记·内则》语。咳,婴儿哺笑之声;子生三月能咳笑,乃为之命名。"
      },
      {
        "term": "春秋元命苞",
        "note": "汉代《春秋》纬书之一,多言阴阳五行灾异,原书久佚,今存辑本。"
      },
      {
        "term": "礼斗威仪",
        "note": "汉代《礼》纬篇名,言五行德运、皇极之气,书已亡佚,仅见征引。"
      },
      {
        "term": "土生于金",
        "note": "当依《说文》作「金生于土」,故「金」字从土,左右象金在土中。"
      }
    ]
  },
  "4": {
    "0": [
      {
        "term": "大挠",
        "reading": "dà náo",
        "note": "传为黄帝史官,始作甲子以名日月,干支所自出。"
      },
      {
        "term": "孚甲",
        "reading": "fú jiǎ",
        "note": "草木种子的外壳;抽轧而出,谓萌芽破壳。"
      },
      {
        "term": "三礼义宗",
        "note": "梁崔灵恩撰,通解周礼、仪礼、礼记之书,隋唐尚存,今佚。"
      },
      {
        "term": "摄提格",
        "reading": "shè tí gé",
        "note": "岁阴名,太岁在寅之岁的称谓,见《尔雅·释天》十二岁阴。"
      }
    ]
  },
  "5": {
    "0": [
      {
        "term": "洪范传",
        "note": "汉人解《尚书·洪范》之作，旧属伏生一系《洪范五行传》，本篇后半灾异说多本于此。"
      },
      {
        "term": "地上之木为观",
        "note": "《易》观卦上巽下坤，巽为木、坤为地，故云；观又训可观、示人。"
      },
      {
        "term": "春气动而鹰隼化",
        "note": "《礼记·月令》仲春「鹰化为鸠」，与秋日鹰隼搏击相对，故下云杀生二端。"
      },
      {
        "term": "盒摒必亡",
        "note": "「盒摒」二字讹，当作「好战」；语本《司马法》「国虽大，好战必亡」。"
      }
    ]
  },
  "6": {
    "0": [
      {
        "term": "大衍",
        "reading": "dà yǎn",
        "note": "《易·系辞》「大衍之数五十」，筮法所用蓍数，萧吉据以论动静。"
      },
      {
        "term": "支干",
        "reading": "zhī gān",
        "note": "天干地支之合称；隋以前多称支干，后世倒言作干支。"
      },
      {
        "term": "纳音",
        "reading": "nà yīn",
        "note": "以六十甲子两两相配，纳于五音，谓某干支属金木水火土。"
      },
      {
        "term": "九宫",
        "reading": "jiǔ gōng",
        "note": "洛书九数分布九位，戴九履一，左三右七，术家谓之九宫。"
      }
    ]
  },
  "7": {
    "0": [
      {
        "term": "筌蹄",
        "reading": "quán tí",
        "note": "筌，捕鱼竹器；蹄，捕兔之网。《庄子·外物》以喻取物之具，得鱼兔而可忘。"
      },
      {
        "term": "蓍策",
        "reading": "shī cè",
        "note": "占筮所用蓍草之茎。分策揲数以定九六七八之爻，故言数详于蓍策。"
      },
      {
        "term": "贞悔",
        "reading": "zhēn huǐ",
        "note": "重卦内卦为贞，外卦为悔。语出《尚书·洪范》「曰贞曰悔」。"
      },
      {
        "term": "大杀",
        "reading": "dà shài",
        "note": "杀，减省。大杀谓层层递减，减至无可复减处，非杀戮义。"
      }
    ]
  },
  "8": {
    "0": [
      {
        "term": "休王",
        "reading": "xiū wàng",
        "note": "五行随时令盛衰，盛曰王（同「旺」），衰曰休。"
      },
      {
        "term": "颖容",
        "reading": "yǐng róng",
        "note": "东汉末经学家，字子严，撰《春秋释例》，其书已佚。"
      },
      {
        "term": "迟殿",
        "reading": "chí diàn",
        "note": "殿，居后。迟殿谓迟缓在后，与上文「躁疾」相对。"
      },
      {
        "term": "孝经援神契",
        "reading": "xiào jīng yuán shén qì",
        "note": "汉代《孝经》纬书，托名孔子，久佚，今存清人辑本。"
      }
    ]
  },
  "9": {
    "0": [
      {
        "term": "礼稽命征",
        "note": "即《礼纬·稽命征》，汉代纬书，原书亡佚，今仅存辑佚。"
      },
      {
        "term": "援神契",
        "note": "即《孝经援神契》，汉代纬书，原书已佚，今有辑本。"
      },
      {
        "term": "太玄经",
        "note": "汉扬雄拟《易》所作，以三分立八十一首而言数。"
      },
      {
        "term": "对冲",
        "note": "地支相隔六位者两两相对，如子与午、丑与未，谓之冲。"
      }
    ]
  },
  "10": {
    "0": [
      {
        "term": "乐纬",
        "note": "汉代纬书，附会《乐经》而作，隋唐后亡佚，今存辑本。"
      },
      {
        "term": "管辂",
        "reading": "guǎn lù",
        "note": "三国魏平原人，字公明，以《易》占术数名世。"
      },
      {
        "term": "式经",
        "note": "讲式盘占法之书，六朝旧籍，今已亡佚，仅见称引。"
      },
      {
        "term": "坤一索而得离",
        "note": "「离」当作「震」。《说卦》坤一索得震为长男，下文亦称震为长子。"
      }
    ]
  },
  "11": {
    "0": [
      {
        "term": "郑司农",
        "note": "东汉郑众，曾任大司农，故称；《周礼》旧注家，非郑玄。"
      },
      {
        "term": "蓍策",
        "reading": "shī cè",
        "note": "占筮所用蓍草之策。大衍之数五十，其用四十有九。"
      },
      {
        "term": "太康地记",
        "note": "西晋太康中所修地理书，久佚，唐宋类书犹引其文。"
      },
      {
        "term": "髡赭剥",
        "reading": "kūn zhě bō",
        "note": "髡，剃发；赭，罪人所服赭色衣；剥，夺其衣冠身分。"
      }
    ]
  },
  "12": {
    "0": [
      {
        "term": "相生",
        "note": "五行依木生火、火生土、土生金之序递相资生。"
      },
      {
        "term": "生死所",
        "note": "指五行各自的生处与死处，即后世长生、墓绝诸位之所本。"
      },
      {
        "term": "四时休王",
        "reading": "sì shí xiū wàng",
        "note": "五行随四时而分旺、相、休、囚、死；「王」读作旺。"
      }
    ]
  },
  "13": {
    "0": [
      {
        "term": "休王",
        "reading": "xiū wàng",
        "note": "五行轮转中的衰休与当令。王读为旺，谓得时而盛。"
      },
      {
        "term": "颖容",
        "note": "人名。东汉末经学家颖容，字子严，治《春秋左氏》之学。"
      },
      {
        "term": "温城董君",
        "note": "指董仲舒。温城，其里居。下引其语出《春秋繁露·五行对》。"
      },
      {
        "term": "元命苞",
        "note": "即《春秋元命苞》，汉代《春秋》纬书之一，今已亡佚，仅存辑本。"
      }
    ]
  },
  "14": {
    "0": [
      {
        "term": "受气",
        "note": "十二运之首。谓气始萌于母腹，形质未成。"
      },
      {
        "term": "临官",
        "note": "十二运之一。谓将届禄位，其次即为帝旺。"
      },
      {
        "term": "木为土鬼",
        "note": "鬼谓克我者。木克土，故木为土之鬼。"
      },
      {
        "term": "高堂隆",
        "reading": "gāo táng lóng",
        "note": "三国魏人，复姓高堂，明礼制灾异，官至光禄勋。"
      }
    ]
  },
  "15": {
    "0": [
      {
        "term": "休王",
        "reading": "xiū wàng",
        "note": "王读作旺。五行随四时盛衰的位次，王、相、休、囚、死为一组。"
      },
      {
        "term": "柳世隆",
        "note": "南朝齐人，官至尚书右仆射，善卜筮，撰《龟经秘要》，其书今佚。"
      },
      {
        "term": "女弟",
        "note": "妹。甲以妹乙嫁庚，即乙庚相合，阳干以同行阴干配克己之干。"
      },
      {
        "term": "金卿",
        "note": "卿疑为「乡」之讹，谓方位所在；下文木卿、火卿、水卿、土卿同。"
      }
    ]
  },
  "16": {
    "0": [
      {
        "term": "分王四季",
        "reading": "fēn wàng sì jì",
        "note": "王读为旺。谓土分主四季之末，各旺十八日。"
      },
      {
        "term": "空亡",
        "note": "旬中十干配尽，余二支无干可配，卜筮家谓之空亡；亡，无也。"
      },
      {
        "term": "春秋元命苞",
        "reading": "chūn qiū yuán mìng bāo",
        "note": "汉代《春秋》纬书之一，多言天地象数灾异，原书已佚，今存辑本。"
      },
      {
        "term": "尻肱",
        "reading": "kāo gōng",
        "note": "尻，臀骶；肱，自肘至肩之臂。"
      }
    ]
  },
  "17": {
    "0": [
      {
        "term": "相杂",
        "note": "交互错糅。谓五行非各自孤行，彼此含摄交涉。"
      },
      {
        "term": "体杂",
        "note": "五行本体自相含摄，如木中有火、金中有水之类。"
      },
      {
        "term": "支干",
        "note": "即今之干支。萧吉书中皆作「支干」，地支在前。"
      },
      {
        "term": "方位杂",
        "note": "谓四方与中央配属五行，彼此交错兼摄，非截然分属。"
      }
    ]
  },
  "18": {
    "0": [
      {
        "term": "成数",
        "note": "河图之数,一至五为生数,各加五得六至十为成数,水一成六。"
      },
      {
        "term": "从革",
        "reading": "cóng gé",
        "note": "《尚书·洪范》「金曰从革」,谓金可顺人意改易形制。"
      },
      {
        "term": "火刻于金",
        "note": "刻,通「克」。谓火克金;石属金类,故有下问。"
      },
      {
        "term": "炎州",
        "note": "古书所称南方炎热之地,旧传其地有木不为火焚。"
      }
    ]
  },
  "19": {
    "0": [
      {
        "term": "女弟",
        "note": "妹妹。古人对兄而言称妹为女弟，与「女兄」（姊）相对。"
      },
      {
        "term": "木王",
        "reading": "mù wàng",
        "note": "王通「旺」，谓木气当令得时。下文火王、土王、金王、水王同例。"
      },
      {
        "term": "𬬻锑",
        "note": "𬬻为「炉」的异体字，锑指炉冶所出的杂质金属，喻不纯。"
      },
      {
        "term": "怀任",
        "note": "任通「妊」，怀孕。四孟居一季之首，气方孕育，故称怀妊。"
      }
    ]
  },
  "20": {
    "0": [
      {
        "term": "王火",
        "reading": "wàng huǒ",
        "note": "王读为旺。十二运中帝旺之位，谓火气至此最盛。"
      },
      {
        "term": "胎木",
        "note": "胎为十二运之一，居绝后养前，谓气已受孕而未成形。"
      },
      {
        "term": "竝",
        "reading": "bìng",
        "note": "同「并」，都、皆。谓以上所说都是一方之内另含他行。"
      },
      {
        "term": "赵怡",
        "note": "萧吉所引五行家，生平无考，其书今佚，仅存此语。"
      }
    ]
  },
  "21": {
    "0": [
      {
        "term": "无悔恡",
        "reading": "wú huǐ lìn",
        "note": "恡,吝之异体。谓于物无所悔恨吝惜。"
      },
      {
        "term": "扬子云",
        "note": "即扬雄,字子云,西汉学者,著《太玄》《法言》;此下引其配日之说。"
      },
      {
        "term": "冠带",
        "note": "十二长生位之一,言五行盛衰之节,生/沐浴/冠带/相/王/胎/养/死同属此系。"
      },
      {
        "term": "乾巛",
        "reading": "qián kūn",
        "note": "巛为坤之古文,乾巛即乾坤二卦。"
      }
    ]
  },
  "22": {
    "0": [
      {
        "term": "阴阳合德",
        "note": "语出《周易·系辞下》，谓阴阳二气的德性相济相成。"
      },
      {
        "term": "体无偏立",
        "note": "形体不能偏依一方而自立，必待阴阳相配而后成。"
      },
      {
        "term": "夫妇之道",
        "note": "借夫妇相配，喻干支阴阳两两相合之理。"
      }
    ],
    "1": [
      {
        "term": "季氏阴阳说",
        "note": "汉魏间论阴阳之书，撰人不详，今已亡佚，赖本书引存。"
      },
      {
        "term": "款冬",
        "reading": "kuǎn dōng",
        "note": "草名，冬月开花，古人以为得火之热气。"
      },
      {
        "term": "靡草",
        "reading": "mǐ cǎo",
        "note": "细弱之草，《礼记·月令》谓孟夏靡草死。"
      },
      {
        "term": "三庚为伏",
        "note": "夏至后第三个庚日入伏，庚属金而畏火，故伏藏。"
      }
    ],
    "2": [
      {
        "term": "日月行次",
