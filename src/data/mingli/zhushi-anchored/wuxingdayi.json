      },
      {
        "term": "诹訾",
        "reading": "zōu zī",
        "note": "十二次之一，当亥位，正月日月会于此。"
      },
      {
        "term": "豕韦",
        "reading": "shǐ wéi",
        "note": "诹訾的别名，本古国名，后取为星次之号。"
      },
      {
        "term": "斗建",
        "note": "北斗斗柄所指之辰，正月指寅，谓之建寅。"
      }
    ],
    "3": [
      {
        "term": "降娄",
        "reading": "jiàng lóu",
        "note": "十二次之一，当戌位，含奎娄二宿。"
      }
    ],
    "4": [
      {
        "term": "大梁",
        "note": "十二次之一，当酉位，含胃昴毕三宿。"
      }
    ],
    "5": [
      {
        "term": "实沈",
        "reading": "shí shěn",
        "note": "十二次之一，当申位；实沈本高辛氏子名，见《左传》。"
      }
    ],
    "6": [
      {
        "term": "鹑首",
        "note": "十二次之一，当未位，南方朱鸟之首。"
      }
    ],
    "7": [
      {
        "term": "鹑火",
        "note": "十二次之一，当午位，当朱鸟之身。"
      }
    ],
    "8": [
      {
        "term": "鹑尾",
        "note": "十二次之一，当巳位，当朱鸟之尾。"
      }
    ],
    "9": [
      {
        "term": "寿星",
        "note": "十二次之一，当辰位，含角亢二宿。"
      }
    ],
    "10": [
      {
        "term": "大火",
        "note": "十二次之一，当卯位，亦心宿之别名。"
      }
    ],
    "11": [
      {
        "term": "析木",
        "note": "十二次之一，当寅位，在箕斗之间天汉所经。"
      }
    ],
    "12": [
      {
        "term": "星纪",
        "note": "十二次之一，当丑位，含斗牛二宿。"
      }
    ],
    "13": [
      {
        "term": "玄枵",
        "reading": "xuán xiāo",
        "note": "十二次之一，当子位，含虚危二宿。"
      },
      {
        "term": "天鼋",
        "reading": "tiān yuán",
        "note": "玄枵的别名，鼋即大鳖，取虚耗之象。"
      }
    ],
    "14": [
      {
