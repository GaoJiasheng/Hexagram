{
  "1": {
    "0": [
      {
        "term": "矫",
        "reading": "jiǎo",
        "note": "矫饰、做作，掩盖真情而伪装。"
      },
      {
        "term": "令色",
        "note": "讨好的伪善脸色。令，善；此指谄媚之容。"
      },
      {
        "term": "足恭",
        "reading": "jù gōng",
        "note": "过分的恭顺。足，过度；语本《论语·公冶长》。"
      },
      {
        "term": "匿怨而友人",
        "note": "藏怨于心却佯装亲善。语出《论语·公冶长》。"
      }
    ],
    "1": [
      {
        "term": "委其过",
        "note": "推卸过错。委，推诿、卸给他人。"
      },
      {
        "term": "弗能逾",
        "note": "不能超越、摆脱。弗，不；逾，越过。"
      },
      {
        "term": "本然",
        "note": "本来如此的样子，指天生本性。"
      }
    ],
    "2": [
      {
        "term": "尚私则枉",
        "note": "崇私则行为不正。枉，弯曲、邪僻不直。"
      },
      {
        "term": "敛行",
        "note": "收敛约束自己的行为。"
      },
      {
        "term": "机变",
        "note": "机巧权变，随机应变的诈术。"
      }
    ],
    "3": [
      {
        "term": "桓公溺臣",
        "note": "指齐桓公宠信易牙、竖刁等，死后五子争位、尸久不殓。"
      },
      {
        "term": "夫差存越",
        "note": "吴王夫差败越后存而不灭，终被越所亡。"
      },
      {
        "term": "莽奸弗绝",
        "note": "莽指王莽，篡汉自立；言奸臣代不绝迹。"
      },
      {
        "term": "庸为智者乎",
        "note": "岂能算作智者。庸，岂、怎么；反诘语。"
      }
    ]
  },
  "2": {
    "1": [
      {
        "term": "媚",
        "reading": "mèi",
        "note": "谄媚、奉承讨好。"
      },
      {
        "term": "曲",
        "reading": "qū",
        "note": "曲意逢迎，违背本心而顺从。"
      },
      {
        "term": "诟",
        "reading": "gòu",
        "note": "辱骂、责骂。"
      },
      {
        "term": "窥",
        "reading": "kuī",
        "note": "暗中察看，此指揣摩、刺探。"
      }
    ],
    "2": [
      {
        "term": "妄念",
        "note": "非分、不正当的念头。"
      },
      {
        "term": "周公",
        "note": "西周周公旦，辅成王摄政，后世奉为忠臣典范。"
      }
    ],
    "3": [
      {
        "term": "戒惕",
        "note": "戒备警惕。"
      },
      {
        "term": "宠无衰",
        "note": "受宠不衰减。无，犹『不』。"
      }
    ]
  },
  "3": {
    "0": [
      {
        "term": "御",
        "reading": "yù",
        "note": "统御、驾驭、管束在下者，此处指掌权者控制下属。"
      },
      {
        "term": "篡",
        "reading": "cuàn",
        "note": "以下犯上、夺取上位权位，多指臣夺君位。"
      }
    ],
    "1": [
      {
        "term": "恃以刑",
        "note": "恃，依凭；谓威严靠刑罚来维持支撑。"
      },
      {
        "term": "辟",
        "reading": "bì",
        "note": "此处通「僻」，隐僻、隐密，谓谋算须藏而不露。"
      },
      {
        "term": "机心",
        "note": "机巧诡诈之心；语出《庄子·天地》。"
      },
      {
        "term": "靡密",
        "note": "靡，无、莫；此谓交接无不亲密。"
      }
    ],
    "2": [
      {
        "term": "成志",
        "note": "成就其志向、达成所图谋之事。"
      },
      {
        "term": "迁",
        "reading": "qiān",
        "note": "迁升、提拔，谓升其官职。"
      }
    ],
    "3": [
      {
        "term": "隐忍",
        "note": "强自含忍、按而不发，谓暂容其人。"
      },
      {
        "term": "坠其志",
        "note": "坠，使坠落、消磨；谓以厚赏销蚀其志气。"
      },
      {
        "term": "恩威同施",
        "note": "恩惠与威罚并用，旧称「恩威并施」。"
      }
    ]
  },
  "4": {
    "0": [
      {
        "term": "守之尤艰",
        "note": "尤，更加；艰，艰难。谓守权比取权更难。"
      },
      {
        "term": "竟患",
        "note": "竟，终；患，祸患。谓终成祸患。"
      }
    ],
    "1": [
      {
        "term": "假天用事",
        "note": "假，借；用事，当权行事。借天意之名行事。"
      },
      {
        "term": "名之顺也",
        "note": "名，名分；顺，顺当合理。谓取得正当名义。"
      },
      {
        "term": "人所难附",
        "note": "附，归附依从。谓人难以归附。"
      }
    ],
    "2": [
      {
        "term": "用能",
        "note": "用，任用；能，有才能者。谓起用能人。"
      },
      {
        "term": "名实悖之",
        "note": "悖，违背相反。谓名义与实利相背离。"
      },
      {
        "term": "羁",
        "reading": "jī",
        "note": "本指马络头，引申为牵系、笼络、束缚。"
      }
    ]
  },
  "5": {
    "0": [
      {
        "term": "弗容",
        "reading": "fú róng",
        "note": "不相容。弗，不；此言利害两立、势不并存。"
      }
    ],
    "1": [
      {
        "term": "毁誉",
        "reading": "huǐ yù",
        "note": "诋毁与称誉，泛指外界的负面与正面评价。"
      },
      {
        "term": "惟求良善",
        "note": "只图做个善良之人。惟，只；讥其拘守虚名而不计实利。"
      }
    ],
    "2": [
      {
        "term": "疎",
        "reading": "shū",
        "note": "同「疏」，疏远、生分，与「亲」相对。"
      },
      {
        "term": "先机",
        "reading": "xiān jī",
        "note": "抢在对方行动之前占据有利时机。"
      },
      {
        "term": "淫邪",
        "reading": "yín xié",
        "note": "淫秽邪僻，此指卑劣构陷之事。"
      },
      {
        "term": "构敌",
        "reading": "gòu dí",
        "note": "构，罗织罪名以陷害；谓捏造罪状中伤敌人。"
      }
    ]
  },
  "6": {
    "0": [
      {
        "term": "消衍",
        "reading": "xiāo yǎn",
        "note": "消解灾患。衍,指过失、灾患;一说蔓延滋长。"
      }
    ],
    "1": [
      {
        "term": "结纳",
        "reading": "jié nà",
        "note": "结交、拉拢以求亲近接纳。"
      },
      {
        "term": "宗",
        "note": "宗族,同族亲属。古代刑罚有株连及宗之制。"
      }
    ],
    "2": [
      {
        "term": "羡",
        "reading": "xiàn",
        "note": "羡慕、企慕。此谓为众人所企羡。"
      },
      {
        "term": "图",
        "note": "图谋、算计。难图谓难以谋算对付。"
      }
    ]
  },
  "7": {
    "1": [
      {
        "term": "羁行",
        "reading": "jī xíng",
        "note": "羁,马络头,引申为束缚;羁行即拘束行为。"
      },
      {
        "term": "讳处",
        "reading": "huì chù",
        "note": "讳,忌讳、隐避;讳处指人不愿示人的隐私短处。"
      }
    ],
