      },
      {
        "term": "弗怠",
        "note": "弗，不；怠，懈怠松懈。谓不放松。"
      }
    ],
    "1": [
      {
        "term": "枉法",
        "note": "曲解、践踏法律以徇私。枉，使弯曲，引申为歪曲。"
      },
      {
        "term": "纵其为祸方惩",
        "note": "方，才、然后。谓先放任酿祸，然后才加惩处。"
      }
    ],
    "2": [
      {
        "term": "势不济",
        "note": "济，成、足。谓权势不足用、不顶事。"
      },
      {
        "term": "弥消其根",
        "note": "弥，尽、彻底；根，根基、根底。谓铲除其立足之本。"
      },
      {
        "term": "行之不辍",
        "note": "辍，停止中断。谓持续施行不停。"
      }
    ]
  },
  "10": {
    "0": [
      {
        "term": "莫以文也",
        "note": "文,指法律条文。谓评判法之善恶不看明文,而看实际施行。"
      },
      {
        "term": "明罪",
        "note": "使罪名显明、坐实。此句直认刑罚意在定罪而非惩恶,露构陷本色。"
      }
    ],
    "1": [
      {
        "term": "无谕则待，有谕则逮",
        "reading": "yù",
        "note": "谕,上司的指令、批示。谓依上意行事,未得令则候,得令则捕。"
      },
      {
        "term": "畏罪释耳",
        "note": "释,放下、了结,此指以死求解脱。谓拒认而求死者乃惧罪自了。"
      },
      {
        "term": "党",
        "note": "结党、同伙。谓罪一人即可借以牵连其党羽,即所谓「瓜蔓」株连。"
      }
    ],
    "3": [
      {
        "term": "至畏",
        "note": "最为畏惧之事物。谓以人最怕者施刑,必使之屈服。"
      },
      {
        "term": "援友者惟其害",
        "note": "谓救援同党之友只会招致祸害,言为自保而弃友。"
      }
    ],
    "4": [
      {
        "term": "罪人或免人罪",
        "note": "上「罪」作动词(加罪),下「罪」为名词(罪责)。谓加罪者亦可反为人开脱。"
      }
    ]
  },
  "11": {
