      },
      {
        "term": "堪易",
        "note": "堪,可、能;易,变易、转换。谓忠奸可互相转化。"
      }
    ],
    "3": [
      {
        "term": "难恃",
        "note": "恃,依靠、凭借。难恃即难以凭恃。"
      },
      {
        "term": "好恶",
        "note": "喜好与厌恶,此指在上位者的主观爱憎。"
      }
    ],
    "4": [
      {
        "term": "道同",
        "note": "道,门路、路数、立场。道同谓所循路数相同。"
      },
      {
        "term": "世之实",
        "note": "实,实情、真相,与下文「世之表」(表面)相对。"
      }
    ],
    "5": [
      {
        "term": "去表求实",
        "note": "去,撇开、舍去;求实,探求真相。谓不看表面看实质。"
      }
    ]
  },
  "9": {
    "0": [
      {
        "term": "斯须",
        "reading": "sī xū",
