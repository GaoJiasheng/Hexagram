      }
    ],
    "2": [
      {
        "term": "株亲",
        "note": "株,株连;牵连治罪及于亲属,即族诛连坐之制。"
      },
      {
        "term": "率真",
        "note": "率,大致、约略;伪造之证大致像真,使难辨虚实。"
      }
    ],
    "3": [
      {
        "term": "鱼肉",
        "note": "鱼肉本指供宰割之物,引申为任人宰割、受人欺凌。"
      }
    ]
