      {
        "term": "构其反",
        "note": "构,捏造、罗织;构其反即诬陷人谋反。"
      },
      {
        "term": "授首",
        "note": "本指受戮、被斩首,引申为俯首认罪、束手就擒。"
      }
    ],
    "1": [
