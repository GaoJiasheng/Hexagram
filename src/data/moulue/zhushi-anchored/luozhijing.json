    "2": [
      {
        "term": "敌者无常",
        "note": "无常,没有定准、不固定。"
      },
      {
        "term": "失本",
        "note": "本,根本;谓失去立足的根基。"
      },
      {
        "term": "寻隙",
        "reading": "xún xì",
        "note": "隙,缝隙、漏洞;指找可乘之机。"
      },
      {
        "term": "饵之以逮",
        "reading": "ěr zhī yǐ dài",
