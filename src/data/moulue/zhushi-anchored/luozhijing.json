      },
      {
        "term": "宜苛",
        "reading": "yí kē",
        "note": "苛,严苛;宜苛即文中谓责己当从严。"
      }
    ],
    "3": [
      {
        "term": "滞碍",
        "reading": "zhì ài",
        "note": "停滞阻塞;此谓心中无牵挂挂碍。"
      }
    ]
  },
  "8": {
    "0": [
      {
        "term": "自辩",
        "note": "为自己辩白、申诉。辩,辩解。"
      },
      {
        "term": "祸国",
        "note": "祸,用作动词,使……受祸,危害。祸国即危害国家。"
      }
    ],
    "1": [
      {
        "term": "其智阴也",
