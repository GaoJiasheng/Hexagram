{
  "1": {
    "0": [
      {
        "term": "月晕而风",
        "reading": "yuè yùn ér fēng",
        "note": "月周现光圈预示起风。晕,日月周围的光气。古以自然先兆喻人事可察。"
      },
      {
        "term": "础润而雨",
        "reading": "chǔ rùn ér yǔ",
        "note": "柱下石返潮预示降雨。础,垫柱的石墩。与上句同为先兆之喻。"
      },
      {
        "term": "见微知著",
        "reading": "jiàn wēi zhī zhù",
        "note": "由细微迹象推知显著结果。微,隐微;著,显明。"
      },
      {
        "term": "烛情照奸",
        "reading": "zhú qíng zhào jiān",
        "note": "烛、照皆谓明察。意为洞察人情、查照奸邪。"
      },
      {
        "term": "奸佞",
        "reading": "jiān nìng",
        "note": "奸邪谄媚之人。佞,巧言谄谀。"
      }
    ]
  },
  "2": {
    "0": [
      {
        "term": "考之于蓍龟",
        "reading": "shī guī",
        "note": "蓍草与龟甲，古人占卜之具；此谓卜问吉凶。"
      },
      {
        "term": "未雨绸缪",
        "reading": "chóu móu",
        "note": "语本《诗·豳风·鸱鸮》，趁未下雨先缠缚门窗，喻事先准备。"
      },
      {
        "term": "雷霆万钧",
        "note": "钧为古重量单位，三十斤；喻威势极猛、不可阻挡。"
      },
      {
        "term": "以其昏昏，独我昭昭",
        "note": "昏昏，糊涂；昭昭，明白。反用《孟子·尽心下》「以其昭昭」句。"
      }
    ]
  },
  "3": {
    "0": [
      {
        "term": "为政之道",
        "note": "为政：治理政事。指治理政事的根本方法。"
      },
      {
        "term": "为渊驱鱼",
        "note": "语出《孟子·离娄上》，本喻施暴政逼民投敌，此处转指替对手驱走人才。"
      },
      {
        "term": "宥小过",
        "reading": "yòu",
        "note": "宥：宽恕、赦免。宽免小的过失。"
      },
      {
        "term": "用命",
        "note": "听命、效命，服从调遣以尽其力。"
      }
    ]
  },
  "4": {
    "0": [
      {
        "term": "忤",
        "reading": "wǔ",
        "note": "违逆、冒犯。此谓宁直言冒犯而不欺瞒。"
      },
      {
        "term": "谕主以长策",
        "note": "谕,劝导、使明白;长策,长远之计。谓劝君用远谋。"
      },
      {
        "term": "超然立乎显荣之外",
        "note": "显荣,显赫荣耀。谓不使君主孤悬于荣宠而失依凭。"
      },
      {
        "term": "锦上添花",
        "note": "喻好上加好。原文与「雪中进炭」相对,谓急难相济更可贵。"
      }
    ]
  },
  "5": {
    "0": [
      {
        "term": "韬之以晦",
        "reading": "tāo zhī yǐ huì",
        "note": "韬:收藏。晦:昏暗、隐没。谓收敛锋芒、藏其才志,后世「韬光养晦」近此。"
      },
      {
        "term": "叵测",
        "reading": "pǒ cè",
        "note": "叵,不可。叵测即不可揣度,谓人心难以推知。"
      },
      {
        "term": "潜龙勿用",
        "note": "《周易》乾卦初九爻辞,谓阳气潜藏宜静守不动。此处摘引为处世之喻。"
      },
      {
        "term": "知其雄，守其雌",
        "note": "语本《老子》二十八章,谓知雄强而安守雌柔。此处借为退守之辞。"
      }
    ]
  },
  "6": {
    "0": [
      {
        "term": "守如处子",
        "reading": "shǒu rú chǔ zǐ",
        "note": "处子,未出嫁的女子。语意本《孙子·九地》「始如处女」,喻安静自守。"
      },
      {
        "term": "知其雄而守其雌",
        "note": "化用《老子》二十八章「知其雄,守其雌」,此处转作权谋语,与老子本义已殊。"
      },
      {
        "term": "浩然正气",
        "reading": "hào rán zhèng qì",
        "note": "语本《孟子·公孙丑上》「我善养吾浩然之气」,指刚正盛大之气。"
      },
      {
        "term": "奸佞",
        "reading": "jiān nìng",
        "note": "奸,奸邪;佞,巧言谄媚。合指奸邪谄媚的小人。"
      }
    ]
  },
  "7": {
    "0": [
      {
        "term": "假凤虚凰",
        "reading": "jiǎ fèng xū huáng",
        "note": "凤凰本喻佳偶,此谓以假乱真、虚饰相诳。与「移花接木」连用,均指偷换作伪。"
      },
      {
        "term": "武穆",
        "reading": "wǔ mù",
        "note": "岳飞谥号「武穆」,故称岳武穆,南宋抗金名将。此处借其名以饰攻心之说。"
      },
      {
        "term": "俟之以变",
        "reading": "sì zhī yǐ biàn",
        "note": "俟,等待。谓静待对方生变之机。"
      },
      {
        "term": "虚予而实取之",
        "reading": "xū yǔ ér shí qǔ zhī",
        "note": "予,给予。谓表面给予而实则夺取。"
      }
    ]
  },
  "8": {
    "0": [
      {
        "term": "明修栈道，暗度陈仓",
        "note": "典出楚汉相争韩信故事,表面修栈道而暗由陈仓出兵,后凝为遮掩行迹的成语。"
      },
      {
        "term": "偷梁换柱",
        "note": "暗中以假易真、改换关键的俗谚,后亦列为《三十六计》之一。"
      },
      {
        "term": "釜底抽薪",
        "note": "抽去锅底柴薪以止沸,喻从根本上除势,见于古谚与兵家语。"
      },
      {
        "term": "反客为主",
        "note": "由客位转夺主位、由被动转主动,《三十六计》计名之一。"
      }
    ]
  },
  "9": {
    "0": [
      {
        "term": "攻子之盾，必持子之矛",
        "note": "化用《韩非子》「以子之矛攻子之盾」的矛盾典，此处反用，谓借敌之长以制敌。"
      },
      {
        "term": "间者隙也",
        "reading": "jiàn zhě xì yě",
        "note": "间，缝隙、嫌隙；释「离间」之间的本义，谓敌内有隙则可乘。"
      },
      {
        "term": "拨草寻蛇",
        "note": "俗谚，谓循迹搜寻；与「顺手牵羊」皆三十六计、市井熟语，辞气浅近。"
      },
      {
        "term": "喉舌",
        "note": "本指代言发声之要；此谓使敌之耳目反为我传声。"
      }
    ]
  },
  "10": {
    "0": [
      {
        "term": "见微知著",
        "note": "从微小迹象推知将显著的结果。"
      },
      {
        "term": "物必先腐而蠹生",
        "reading": "dù",
        "note": "蠹,蛀虫;喻自身先坏,外患才乘隙而入。"
      },
      {
        "term": "釜底抽薪",
        "reading": "fǔ",
        "note": "釜,锅;抽去锅下柴薪以止沸,喻从根本上解除。"
      },
      {
        "term": "移花接木",
        "note": "把花木嫁接他枝,喻暗中调换、偷换。"
      }
    ]
  },
  "11": {
    "0": [
      {
        "term": "讽",
        "reading": "fěng",
        "note": "以委婉暗示之言劝谏,别于直谏。"
      },
      {
        "term": "恤其情",
        "reading": "xù qí qíng",
        "note": "恤,体念、顾惜;谓体谅对方心境。"
      },
      {
        "term": "讽之喻之",
        "note": "喻,晓喻、以譬晓人;以婉言暗示使其明悟。"
      },
      {
        "term": "诙婚",
        "reading": "huī hūn",
        "note": "\"诙谐\"之讹字,谓言语戏谑而有趣。"
      }
    ]
  },
  "12": {
    "0": [
      {
        "term": "口变淄素",
        "reading": "zī sù",
        "note": "淄为黑、素为白；谓口舌能颠倒黑白。"
      },
      {
        "term": "权移马鹿",
        "note": "化用「指鹿为马」之典，谓以谗言颠倒是非、移夺权柄。"
      },
      {
        "term": "浮石沈木",
        "note": "使石头浮、木头沉，喻颠倒轻重真伪；沈同沉。"
      },
      {
        "term": "社稷",
        "reading": "shè jì",
        "note": "土神与谷神，代指国家政权。"
      }
    ]
  },
  "13": {
