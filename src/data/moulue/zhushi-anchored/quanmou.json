      {
        "term": "一颦一笑",
        "reading": "yī pín yī xiào",
        "note": "颦，皱眉。一皱眉一微笑，泛指女子神情容态。"
      },
      {
        "term": "甲兵",
        "note": "披甲执兵的将士，借指军队、战争。"
      },
      {
        "term": "齐桓晋文",
        "note": "齐桓公、晋文公，春秋时先后称霸，旧以为霸主典范。"
      },
      {
        "term": "汉武唐宗",
        "note": "汉武帝刘彻、唐太宗李世民，后世并称的有为之君。"
      }
    ]
  }
