{
  "1": {
    "0": [
      {
        "term": "智极则愚",
        "note": "智慧用到极处反似愚拙，即所谓大智若愚。"
      },
      {
        "term": "智寡",
        "note": "寡，少。谓智慧不足。"
      }
    ],
    "1": [
      {
        "term": "弗显",
        "reading": "fú xiǎn",
        "note": "弗，不。谓不显露才能。"
      },
      {
        "term": "不就",
        "note": "就，趋赴、就任。谓不去就任高位。"
      },
      {
        "term": "知止",
        "note": "懂得适可而止。语袭《大学》《老子》「知止」而义偏权谋。"
      }
    ],
    "2": [
      {
        "term": "谋人",
        "note": "替他人谋划。下「谋身」谓为己谋划。"
      },
      {
        "term": "深存其敌",
        "note": "存，容留、保全。谓深深容下对手以自全。"
      }
    ],
    "3": [
      {
        "term": "无歇",
        "reading": "wú xiē",
        "note": "歇，停止。谓智计运转不停。"
      },
      {
        "term": "以愚饰智",
        "note": "饰，掩饰。谓以愚拙之态掩藏智计。"
      }
    ],
    "4": [
      {
        "term": "勿恃",
        "reading": "wù shì",
        "note": "恃，倚仗。谓不可倚仗权势。"
      },
      {
        "term": "不矜",
        "reading": "bù jīn",
        "note": "矜，自夸、骄傲。"
      }
    ],
    "5": [
      {
        "term": "德休于小人",
        "note": "休，止息、停息。谓德行在小人处止息不行。"
      }
    ],
    "6": [
      {
        "term": "堪毁",
        "reading": "kān huǐ",
        "note": "堪，能够。谓能够毁掉。"
      },
      {
        "term": "弗恭",
        "note": "不恭谨。"
      }
    ],
    "7": [
      {
        "term": "惠嗣",
        "reading": "huì sì",
        "note": "嗣，后代。谓恩泽及于子孙。"
      }
    ],
    "8": [
      {
        "term": "无逾利",
        "reading": "wú yú lì",
        "note": "逾，超过。谓迷惑人者莫过于利。"
      }
    ],
    "9": [
      {
        "term": "富寡",
        "note": "寡，少。谓真能致富者少。"
      },
      {
        "term": "有戒",
        "note": "戒，戒惧、警惕。"
      }
    ],
    "10": [
      {
        "term": "远信",
        "note": "远，疏远、背离。谓背离信义。"
      },
      {
        "term": "御",
        "reading": "yù",
        "note": "驾驭、控制。"
      }
    ],
    "11": [
      {
        "term": "不怠",
        "reading": "bù dài",
        "note": "怠，懈怠。"
      },
      {
        "term": "独据",
        "note": "独自占有。"
      }
    ],
    "12": [
      {
        "term": "器工招损",
        "note": "工，精巧。谓器物过于精巧反招损坏。"
      },
      {
        "term": "辞尽锋出",
        "note": "辞句说尽则锋芒外露。"
      }
    ],
    "13": [
      {
        "term": "识不逾人",
        "note": "识，见识。逾，超过。"
      },
      {
        "term": "休言讳",
        "reading": "xiū yán huì",
        "note": "休，莫、不要。讳，忌讳之言。"
      }
    ],
    "14": [
      {
        "term": "讷言",
        "reading": "nè yán",
        "note": "讷，言语迟钝。语本《论语》「讷于言」，此处义转为权术。"
      },
      {
        "term": "怯行",
        "reading": "qiè xíng",
        "note": "怯，胆怯。谓显出行动怯懦。"
      }
    ],
    "15": [
      {
        "term": "窃功",
        "reading": "qiè gōng",
        "note": "窃，偷取。谓窃取他人功劳。"
      },
      {
        "term": "谤贤",
        "reading": "bàng xián",
        "note": "谤，诋毁。"
      }
    ],
    "16": [
      {
        "term": "好誉",
        "reading": "hào yù",
        "note": "好，喜爱。誉，赞誉。"
      },
      {
        "term": "主惊",
        "note": "令君主惊疑。"
      }
    ],
    "17": [
      {
        "term": "谄者",
        "reading": "chǎn zhě",
        "note": "谄，谄媚、奉承。"
      },
      {
        "term": "贪巧之功",
        "note": "贪求取巧而得的功劳。"
      }
    ],
    "18": [
      {
        "term": "誉贱",
        "note": "贱，低贱、贬值。"
      },
      {
        "term": "释疑",
        "note": "释，消除。谓消除疑忌。"
      }
    ],
    "19": [
      {
        "term": "誉非正当灭",
        "note": "谓赞誉来路不正反招毁灭。"
      }
    ],
    "20": [
      {
        "term": "情滥无行",
        "note": "滥，过度、无节制。行，德行。"
      },
      {
        "term": "失矩",
        "reading": "shī jǔ",
        "note": "矩，法度、规矩。"
      },
      {
        "term": "其色如一",
        "note": "色，神色。谓神情始终如一不露端倪。"
      }
    ],
    "21": [
      {
        "term": "无度",
        "reading": "wú dù",
        "note": "度，节度。"
      },
      {
        "term": "殊密",
        "reading": "shū mì",
        "note": "殊，过分、特别。谓君臣过于亲密。"
      },
      {
        "term": "反殃",
        "reading": "fǎn yāng",
        "note": "殃，祸殃。谓反招祸殃。"
      }
    ],
    "22": [
      {
        "term": "情存疏",
        "note": "存，保留。疏，疏远。谓与人情谊宜留疏远余地。"
      },
      {
        "term": "无痴",
        "reading": "wú chī",
        "note": "痴，迷恋、痴迷。"
      }
    ],
    "23": [
      {
        "term": "寡情",
        "reading": "guǎ qíng",
        "note": "寡，少。谓情感淡薄。"
      },
      {
        "term": "不敛",
        "reading": "bù liǎn",
        "note": "敛，收敛、克制。"
      }
    ],
    "24": [
      {
        "term": "命顺乃奇",
        "note": "奇，异常、稀奇。谓命途顺遂反属罕见。"
      },
      {
        "term": "枢",
        "reading": "shū",
        "note": "门轴，引申为关键、枢要。"
      }
    ],
    "25": [
      {
        "term": "事本",
        "note": "事情的根本。"
      },
      {
        "term": "燥生百端",
        "note": "燥，烦躁。百端，种种头绪。"
      },
      {
        "term": "蔓",
        "reading": "màn",
        "note": "蔓延、滋长。"
      }
    ],
    "26": [
      {
        "term": "蹇",
        "reading": "jiǎn",
        "note": "本卦名《周易·蹇》，义为艰难、困厄。"
      }
    ],
    "27": [
      {
        "term": "不趋贵",
        "reading": "bù qū guì",
        "note": "趋，趋附、奔走巴结。"
      },
      {
        "term": "忍辱为大",
        "note": "谓能忍受屈辱为大度。"
      }
    ],
    "28": [
      {
        "term": "穷富为仇",
        "note": "谓贫者富者相为仇敌。"
      },
      {
        "term": "弥祸",
        "reading": "mí huò",
        "note": "弥，满、遍布。"
      }
    ],
    "29": [
      {
        "term": "存隙必报",
        "reading": "cún xì bì bào",
        "note": "隙，嫌隙、怨恨。谓怀恨必定报复。"
      },
      {
        "term": "和而弗争",
        "note": "语意化用《论语》「和而不同」，此处义转为谋术。"
      }
    ],
    "30": [
      {
        "term": "谤兴",
        "reading": "bàng xīng",
        "note": "谤，诽谤。兴，兴起。"
      },
      {
        "term": "自屈",
        "note": "自我屈抑、委屈自己。"
      },
      {
        "term": "自罪",
        "note": "自任其过、归罪于己。"
      }
    ],
    "31": [
      {
        "term": "诤",
        "reading": "zhèng",
        "note": "直言规劝。"
      },
      {
        "term": "劝善",
        "note": "劝勉向善。"
      }
    ],
    "32": [
      {
        "term": "堪制",
        "reading": "kān zhì",
        "note": "堪，能够。制，节制。"
      }
    ],
    "33": [
      {
        "term": "无嗜之病",
        "reading": "wú shì zhī bìng",
        "note": "嗜，嗜好。谓没有沉溺嗜好的毛病。"
      },
      {
        "term": "靡失",
        "reading": "mǐ shī",
        "note": "靡，无、不。谓不致失误。"
      },
      {
        "term": "自弃",
        "note": "自暴自弃。"
      }
    ],
    "34": [
      {
        "term": "未济",
        "reading": "wèi jì",
        "note": "济，成功、成就。谓事未成。「未济」亦《易》卦名。"
      },
      {
        "term": "非达",
        "note": "达，通达、达成。"
      }
    ],
    "35": [
      {
        "term": "好礼",
        "reading": "hào lǐ",
        "note": "好，爱好。"
      },
      {
        "term": "示愚",
        "reading": "shì yú",
        "note": "示，显示。谓故作愚拙之态。"
      }
    ],
    "36": [
      {
        "term": "服人",
        "reading": "fú rén",
        "note": "服，使人折服、信服。"
      },
      {
        "term": "其才必曲",
        "note": "曲，偏邪、不正。"
      }
    ],
    "37": [
      {
        "term": "纳言",
        "reading": "nà yán",
        "note": "纳，采纳。谓接纳善言。"
      },
      {
        "term": "不辍",
        "reading": "bù chuò",
        "note": "辍，停止。"
      },
      {
        "term": "容疵",
        "reading": "róng cī",
        "note": "疵，瑕疵、缺点。"
      }
    ],
    "38": [
      {
        "term": "诡道",
        "reading": "guǐ dào",
        "note": "诡，欺诈。谓欺诈之术。"
      },
      {
        "term": "难于胜己",
        "note": "胜，克制、战胜。谓难以克制自己。"
      }
    ],
    "39": [
      {
        "term": "不察",
        "reading": "bù chá",
        "note": "察，省察、考察。"
      }
    ]
  }
}
