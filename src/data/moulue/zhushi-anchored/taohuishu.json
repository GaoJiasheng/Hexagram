{
  "1": {
    "2": [
      {
        "term": "东坡",
        "reading": "dōng pō",
        "note": "苏轼号东坡居士。然此语不见于苏轼可靠文集,系托名缀引,真伪可疑。"
      },
      {
        "term": "亢龙之势",
        "reading": "kàng lóng",
        "note": "语本《周易·乾》「亢龙有悔」,喻居高位至极、骄盈将悔之境。"
      },
      {
        "term": "霜刃",
        "reading": "shuāng rèn",
        "note": "寒霜般的利刃,此喻富贵锋利易伤人。"
      },
      {
        "term": "诵之不辍",
        "reading": "bù chuò",
        "note": "辍,停止;反复诵念不停。"
      }
    ],
    "4": [
      {
        "term": "相生相济",
        "note": "彼此滋生、互相补益,阴阳刚柔相成之意。"
      },
      {
        "term": "机心",
        "reading": "jī xīn",
        "note": "机巧权诈之心,语见《庄子·天地》。"
      },
      {
        "term": "谛",
        "reading": "dì",
        "note": "审察、详究之意。"
      }
    ],
    "6": [
      {
        "term": "自强不息",
        "note": "语出《周易·乾·象》「天行健,君子以自强不息」。此被援引以反诘养晦。"
      },
      {
        "term": "炉鼎",
        "reading": "lú dǐng",
        "note": "本道家炼丹器具,此借喻涵养晦德的凭借。"
      },
      {
        "term": "毫巅",
        "reading": "háo diān",
        "note": "毫毛的尖端,极言精微到极点。"
      }
    ],
    "8": [
      {
        "term": "肤功",
        "reading": "fū gōng",
        "note": "大功;肤,《诗·小雅》毛传训为大。"
      },
      {
        "term": "猛鸷",
        "reading": "měng zhì",
        "note": "鸷,凶猛的鸟;猛鸷指勇猛凶悍。"
      },
      {
        "term": "不相侔",
        "reading": "bù xiāng móu",
        "note": "侔,相等;不相侔谓力量不相当。"
      },
      {
        "term": "尽攘为已有",
        "reading": "jǐn rǎng",
        "note": "攘,夺取;尽行夺取据为己有。"
      }
    ],
    "10": [
      {
        "term": "兵不厌诈",
        "note": "意本《韩非子·难一》「战阵之间,不厌诈伪」,此径归孙子,属附会。"
      },
      {
        "term": "歧路",
        "reading": "qí lù",
        "note": "岔路;典本《列子·说符》歧路亡羊,喻方向纷杂易迷失。"
      },
      {
        "term": "莽",
        "reading": "mǎng",
        "note": "王莽,西汉末篡汉自立,史称伪诈,此与曹操并举为反面例。"
      },
      {
        "term": "诿过",
        "reading": "wěi guò",
        "note": "诿,推卸;诿过谓把过错推给他人。"
      }
    ],
    "12": [
      {
        "term": "趋吉避凶",
        "note": "意本《易》理而非经文原句,系括述卜筮趋避之旨。"
      },
      {
        "term": "三十六",
        "note": "指「三十六计」,其书晚出、撰人不详,非先秦兵法。"
      },
      {
        "term": "束身归命",
        "reading": "shù shēn",
        "note": "约束自身、听凭处置,谓彻底归顺。"
      },
      {
        "term": "方外",
        "reading": "fāng wài",
        "note": "世俗之外,多指隐逸或释道之境。"
      }
    ],
    "14": [
      {
        "term": "鼎革",
        "reading": "dǐng gé",
        "note": "语本《周易》鼎、革二卦,谓改朝换代、变革旧制。"
      },
      {
        "term": "羸疾",
        "reading": "léi jí",
        "note": "羸,瘦弱;羸疾指虚弱之病。"
      },
      {
        "term": "廊庙枢机",
        "reading": "láng miào",
        "note": "廊庙指朝廷,枢机指机要权位,合指中枢要职。"
      },
      {
        "term": "四战之地",
        "note": "四面受敌、无险可守之地,语见《史记·乐毅列传》。"
      }
    ],
    "16": [
      {
        "term": "几先",
        "reading": "jī xiān",
        "note": "几,事物初动的细微征兆;几先谓先于征兆而察。"
      },
      {
        "term": "驹逝",
        "reading": "jū shì",
        "note": "如白驹奔逝,喻时机飞快易失。"
      },
      {
        "term": "杳",
        "reading": "yǎo",
        "note": "深远渺茫、不见踪影。"
      }
    ]
  }
}
