{
  "1": {
    "0": [
      {
        "term": "东坡",
        "reading": "dōng pō",
        "note": "指苏轼,号东坡居士。此处托其名引语,所引不见于苏轼可靠著作。"
      },
      {
        "term": "木秀于林",
        "note": "语本三国李康《运命论》「木秀于林,风必摧之」,谓出众招忌。"
      },
      {
        "term": "偃伏",
        "reading": "yǎn fú",
        "note": "偃,仰倒;伏,俯身。此谓俯身收敛、藏匿自隐。"
      },
      {
        "term": "亢龙",
        "reading": "kàng lóng",
        "note": "语出《易·乾》上九「亢龙有悔」,喻位极而危之势。"
      }
    ]
  },
  "2": {
    "0": [
      {
        "term": "无源之水",
        "note": "没有源头的水，喻失去根本、难以持久。语本《孟子》「原泉混混」之反义。"
      },
      {
        "term": "机心",
        "note": "机巧诈伪之心。语出《庄子·天地》「有机事者必有机心」。"
      },
      {
        "term": "音大者无声",
        "note": "化用《老子》「大音希声」「大象无形」语，此处转以言隐秘之谋。"
      },
      {
        "term": "无妄之福",
        "note": "无妄，意外、非分。借《周易》无妄卦名，指偶然非自致之福。"
      }
    ]
  },
  "3": {
    "0": [
      {
        "term": "自强不息",
        "note": "语出《周易·乾·象传》「天行健,君子以自强不息」,本谓效法天道刚健不止。"
      },
      {
        "term": "炉鼎",
        "reading": "lú dǐng",
        "note": "本为炼丹器具,道教内丹术语借指修炼之所,此处喻凭借之物。"
      },
      {
        "term": "至若",
        "reading": "zhì ruò",
        "note": "转语词,犹「至于」,引出下文别一层意思。"
      },
      {
        "term": "毫巅",
        "reading": "háo diān",
        "note": "毫毛之尖,极言细微;「妙到毫巅」谓精妙至于极处。"
      }
    ]
  },
  "4": {
    "0": [
      {
        "term": "肤功",
        "reading": "fū gōng",
        "note": "大功。肤训大,奏肤功谓成就大功。"
      },
      {
        "term": "猛鸷",
        "reading": "měng zhì",
        "note": "凶猛狠厉。鸷指鹰隼一类猛禽,引申为勇猛。"
      },
      {
        "term": "侔",
        "reading": "móu",
        "note": "相等、相当。「力不相侔」谓力量不对等。"
      },
      {
        "term": "亢上有悔",
        "note": "化用《周易》乾卦「亢龙有悔」语,谓居高过盛招悔咎。"
      },
      {
        "term": "攘",
        "reading": "rǎng",
        "note": "窃取、夺取。「尽攘为己有」谓全数攫取据为己有。"
      }
    ]
  },
  "5": {
    "0": [
      {
        "term": "兵不厌诈",
        "note": "语本兵家说,谓用兵以诈伪取胜不嫌其多。此处摘引为「诈」张目。"
      },
      {
        "term": "歧路多而忧亡羊",
        "note": "用《列子·说符》「歧路亡羊」事:岔路太多,羊走失难寻,喻多歧易迷。"
      },
      {
        "term": "操",
        "reading": "cāo",
        "note": "指曹操,东汉末权臣,后世多以「奸诈」形象立之,此借为「以诈兴」之例。"
      },
      {
        "term": "莽",
        "reading": "mǎng",
        "note": "指王莽,西汉末外戚,篡汉立新,旧史斥其矫饰,此借为「以诈得名」之例。"
      }
    ]
  },
  "6": {
    "0": [
      {
        "term": "兵法三十六",
        "note": "指《三十六计》,定本甚晚(明清间辑成),书中信手援引,正暴露成书时代之晚。"
      },
      {
        "term": "趋吉避凶",
        "note": "袭《易·系辞》语意,本指卜筮择吉,此处被裁为遇祸抽身的口诀。"
      },
      {
        "term": "束身归命",
        "note": "束缚自身、交付性命,谓彻底降伏听命于人。"
      },
      {
        "term": "乐天",
        "reading": "lè",
        "note": "语本《易·系辞》「乐天知命」,谓安顺天命而自得。"
      }
    ]
  },
  "7": {
    "0": [
      {
        "term": "鼎革",
        "reading": "dǐng gé",
        "note": "鼎新革故,指改朝换代、政权更替。"
      },
      {
        "term": "羸疾",
        "reading": "léi jí",
        "note": "羸,瘦弱;羸疾即虚弱之病。"
      },
      {
        "term": "廊庙枢机",
        "reading": "láng miào shū jī",
        "note": "廊庙指朝廷;枢机指中枢要害的权位。"
      },
      {
        "term": "四战之地",
        "note": "四面受敌、无险可守之地,喻处境凶险。"
      }
    ]
  },
  "8": {
    "0": [
      {
        "term": "几先",
        "reading": "jī xiān",
        "note": "几,事物萌动的细微征兆;几先即先于事机显露的苗头。"
      },
      {
        "term": "驹逝",
        "reading": "jū shì",
        "note": "驹,少壮骏马;驹逝喻光阴时机如骏马奔过,极言其速。"
      },
      {
        "term": "九天",
        "reading": "jiǔ tiān",
        "note": "古谓天有九重,九天指天之极高处,此喻渺远难寻。"
      },
      {
        "term": "杳不可寻",
        "reading": "yǎo bù kě xún",
        "note": "杳,深远不见踪影;言无处寻觅。"
      }
    ]
  }
}
