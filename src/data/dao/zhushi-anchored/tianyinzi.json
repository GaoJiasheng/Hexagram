{
  "1": {
    "0": [
      {
        "term": "虚气",
        "note": "虚灵之气。本书以人所禀之气为修养之本。"
      },
      {
        "term": "宅神于内",
        "note": "宅，安居、安置。谓使神安处于内而不外驰。"
      },
      {
        "term": "遗照于外",
        "note": "遗，留；照，光明。谓神明之光自然见于外。"
      },
      {
        "term": "劳逸",
        "note": "过劳与过逸。本书以八者失中皆足伤气，故并称为邪。"
      }
    ]
  },
  "2": {
    "0": [
      {
        "term": "易简",
        "note": "语出《周易·系辞上》「乾以易知，坤以简能」。"
      },
      {
        "term": "至道不繁，至人无为",
        "note": "所引「经曰」出处不详，语意本《老子》无为之说。"
      },
      {
        "term": "砼",
        "note": "非唐时所有之字，底本此处疑有讹误，姑仍其旧存疑。"
      }
    ]
  },
  "3": {
    "0": [
      {
        "term": "渐卦",
        "note": "《周易》第五十三卦，卦名取渐进有序之义。"
      },
      {
        "term": "修真达性",
        "note": "修其本真、通达本性。真与性为唐代道书常用的一组范畴。"
      },
      {
        "term": "五渐之门",
        "note": "斋戒、安处、存想、坐忘、神解五级次第的总名。"
      }
    ]
  },
  "4": {
    "0": [
      {
        "term": "休粮服气",
        "note": "道教旧说所谓辟谷与吐纳之法。本章明言其为权宜之说。"
      },
      {
        "term": "调中",
        "note": "本章自释之语，谓饮食有节而内不失其中。"
      },
      {
        "term": "畅外",
        "note": "本章自释之语，谓摩擦肌肤而通畅于外。"
      },
      {
        "term": "五行之气",
        "note": "金、木、水、火、土五者之气。汉唐道医之书据此论人身与物类。"
      }
    ]
  },
  "5": {
    "0": [
      {
        "term": "重裀广榻",
        "reading": "裀 yīn",
        "note": "裀，褥垫。谓层褥大床，指居处之奢侈。"
      },
      {
        "term": "人之魂阳而魄阴",
        "note": "旧说魂属阳而主神、魄属阴而主形，见于汉唐道医二家。"
      },
      {
        "term": "亢阳",
        "note": "亢，过盛。亢阳谓阳气太过；下文「淫阴」谓阴气过盛。"
      },
      {
        "term": "外曜",
        "note": "曜，光。谓户外的日光。"
      }
    ]
  },
  "6": {
    "0": [
      {
        "term": "存想",
        "note": "道教修习法门之名，谓存思身中之神与形。本书以收心复性释之。"
      },
      {
        "term": "营营浮光",
        "note": "营营，往来不息貌；浮光，外物虚浮之色。"
      },
      {
        "term": "归根曰静，静曰复命",
        "note": "《道德经》十六章语，本书引以证收心复性之义。"
      },
      {
        "term": "诚性存存",
        "note": "诚当作「成」。《周易·系辞上》「成性存存，道义之门」。"
      }
    ]
  },
  "7": {
    "0": [
      {
        "term": "坐忘",
        "note": "语出《庄子·大宗师》「离形去知，同于大通」。本书以存想之极释之。"
      },
      {
        "term": "形都泯",
        "note": "泯，灭尽。谓不复以形骸为念。"
      },
      {
        "term": "默而不答",
        "note": "以默、以瞑为答，仿《庄子》寓言问答之体。"
      },
      {
        "term": "了无所照",
        "note": "了，全然。谓能照所照俱忘，无复对待。"
      }
    ]
  },
  "8": {
    "0": [
      {
        "term": "三才",
        "note": "天、地、人。语出《周易·系辞下》兼三才而两之之说。"
      },
      {
        "term": "真如",
        "note": "佛教语，谓真实如常之体。本书借以言一性。"
      },
      {
        "term": "入四",
        "note": "底本此处有讹脱，整理者以「（？）」存疑，姑仍其旧。"
      },
      {
        "term": "人仙",
        "note": "道书所分仙品之名，与天仙、地仙并称。"
      }
    ]
  }
}
