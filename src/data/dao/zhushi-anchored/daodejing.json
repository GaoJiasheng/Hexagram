{
  "1": {
    "3": [{ "term": "徼", "reading": "jiào", "note": "边际、端倪。" }],
    "4": [{ "term": "玄", "note": "幽昧深远，不可名状。" }]
  },
  "2": {
    "2": [{ "term": "不辞", "note": "辞，推辞、干预。任其自然而不加干预。" }]
  },
  "3": {
    "0": [{ "term": "不见可欲", "reading": "见 xiàn", "note": "见，同「现」，显露。不显露可贪之物。" }]
  },
  "4": {
    "0": [
      { "term": "冲", "note": "虚。道体虚而不满。" },
      { "term": "湛", "reading": "zhàn", "note": "沉静幽隐貌。" },
      { "term": "象帝之先", "note": "象，似。似在天帝之先。" }
    ]
  },
  "5": {
    "0": [{ "term": "刍狗", "reading": "刍 chú", "note": "草扎之狗，祭祀用毕即弃，喻无所偏爱。" }],
    "2": [{ "term": "橐籥", "reading": "tuó yuè", "note": "风箱。橐为外囊，籥为送风之管。" }],
    "3": [{ "term": "数穷", "reading": "数 shuò", "note": "数，屡次；一说速。政令烦苛则屡陷困窘。" }]
  },
  "6": {
    "0": [
      { "term": "谷神", "note": "虚谷之神，喻道体虚无而生养不竭。" },
      { "term": "玄牝", "reading": "牝 pìn", "note": "牝，母性。玄牝喻道生万物而不见其形。" },
      { "term": "不勤", "note": "勤，尽。用之不尽。" }
    ]
  },
  "8": {
    "1": [{ "term": "几", "reading": "jī", "note": "近也。" }],
    "2": [{ "term": "正", "note": "通「政」，为政。" }]
  },
  "9": {
    "1": [{ "term": "揣而棁之", "reading": "揣 zhuī", "note": "揣，捶击；棁，通「锐」。捶打使之尖锐。" }]
  },
  "10": {
    "0": [{ "term": "营魄", "note": "魂魄。营即魂。" }],
    "2": [{ "term": "玄览", "note": "心如深邃明镜之观照；览，通「鉴」。" }],
    "4": [{ "term": "天门", "note": "耳目口鼻等感官；一说天机之门。" }]
  },
  "11": {
    "0": [{ "term": "毂", "reading": "gǔ", "note": "车轮中心穿轴之圆木。" }],
    "1": [
      { "term": "埏埴", "reading": "shān zhí", "note": "埏，揉和；埴，黏土。" },
      { "term": "户牖", "reading": "牖 yǒu", "note": "门窗。牖，窗。" }
    ]
  },
  "12": {
    "0": [
      { "term": "爽", "note": "伤败、失味。" },
      { "term": "畋", "reading": "tián", "note": "打猎。" }
    ],
    "1": [{ "term": "行妨", "note": "妨害操行。" }]
  },
  "13": {
    "0": [{ "term": "宠为下", "note": "得宠本是卑下之事，依附于人。" }]
  },
  "14": {
    "0": [
      { "term": "夷", "note": "无色无形曰夷。" },
      { "term": "希", "note": "无声曰希。" },
      { "term": "微", "note": "无形可触曰微。" },
      { "term": "致诘", "reading": "诘 jié", "note": "追问究诘。" }
    ],
    "1": [
      { "term": "皦", "reading": "jiǎo", "note": "明亮。" },
      { "term": "昧", "note": "昏暗。" },
      { "term": "绳绳", "note": "绵绵不绝貌。" }
    ],
    "4": [{ "term": "道纪", "note": "道的纲纪、头绪。" }]
  },
  "15": {
    "0": [{ "term": "豫焉", "note": "豫，迟疑审慎貌，如象之渡河。" }],
    "1": [{ "term": "犹兮", "note": "犹，警惕疑惧貌，如犬之多疑。" }],
    "5": [{ "term": "蔽不新成", "note": "蔽，敝旧。安于敝旧而不求速成；一说「而新成」。" }]
  },
  "16": {
    "2": [
      { "term": "芸芸", "note": "纷繁众多貌。" },
      { "term": "复命", "note": "复归本性天命。" }
    ],
    "10": [{ "term": "殆", "note": "危险。" }]
  },
  "17": {
    "0": [{ "term": "太上", "note": "最上等的统治者。" }],
    "5": [{ "term": "贵言", "note": "以言为贵，不轻易发号施令。" }]
  },
  "19": {
    "0": [
      { "term": "见素抱朴", "reading": "见 xiàn", "note": "见，同「现」。外显素淡，内守质朴。" },
      { "term": "有所属", "note": "属，归属依从。" }
    ]
  },
  "20": {
    "0": [{ "term": "唯之与阿", "reading": "阿 hē", "note": "唯，恭敬应诺；阿，怠慢呵应。" }],
    "2": [{ "term": "太牢", "note": "牛羊豕三牲具备的盛宴。" }],
    "3": [{ "term": "孩", "note": "同「咳」，婴儿笑。" }],
    "4": [{ "term": "儽儽", "reading": "léi léi", "note": "疲惫闲散貌。" }],
    "11": [{ "term": "飂", "reading": "liù", "note": "高风疾吹貌。" }],
    "14": [{ "term": "食母", "note": "食于母，受养于道。母指道。" }]
  },
  "21": {
    "0": [{ "term": "孔德", "note": "孔，大。大德。" }],
    "3": [{ "term": "窈兮冥兮", "reading": "窈 yǎo", "note": "深远暗昧貌。" }],
    "6": [{ "term": "众甫", "note": "甫，始。万物的开始。" }]
  },
  "22": {
    "6": [{ "term": "自见", "reading": "见 xiàn", "note": "自我表现。" }]
  },
  "23": {
    "0": [{ "term": "希言", "note": "少言，指少施政令。" }],
    "1": [{ "term": "飘风", "note": "狂风、暴风。" }]
  },
  "24": {
    "0": [{ "term": "企", "note": "踮起脚跟。" }],
    "1": [{ "term": "余食赘行", "reading": "行 xíng", "note": "剩饭赘瘤。行，一说通「形」。" }]
  },
  "25": {
    "1": [{ "term": "寂兮寥兮", "note": "寂，无声；寥，无形。" }],
    "7": [{ "term": "反", "note": "返也，返回本原。" }]
  },
  "26": {
    "1": [{ "term": "辎重", "reading": "辎 zī", "note": "载运器物粮食的车辆，喻厚重之本。" }],
    "2": [
      { "term": "荣观", "reading": "观 guàn", "note": "华美的宫阙楼台。" },
      { "term": "燕处", "note": "安居闲处。" }
    ]
  },
  "27": {
    "1": [{ "term": "瑕讁", "reading": "xiá zhé", "note": "瑕，玉病；讁，过失可指摘处。" }],
    "2": [{ "term": "筹策", "note": "古时计数用的竹码。" }],
    "3": [
      { "term": "关楗", "reading": "楗 jiàn", "note": "门闩。横曰关，竖曰楗。" },
      { "term": "绳约", "note": "绳索捆缚。" }
    ],
    "5": [{ "term": "袭明", "note": "袭，承袭内藏。内藏的明智。" }],
    "6": [{ "term": "资", "note": "凭资、借鉴。" }]
  },
  "28": {
    "0": [{ "term": "谿", "reading": "xī", "note": "山间溪涧，居下而众水归之。" }],
    "2": [{ "term": "忒", "reading": "tè", "note": "差错。" }],
    "5": [{ "term": "朴散", "note": "朴，未雕之原木。朴分散而成器物。" }],
    "6": [{ "term": "大制不割", "note": "完善之治不割裂本真。" }]
  },
  "29": {
    "0": [{ "term": "神器", "note": "神圣之物，不可强力把持。" }],
    "2": [
      { "term": "或歔或吹", "reading": "歔 xū", "note": "歔，缓嘘气使温；吹，急吹气使凉。" },
      { "term": "羸", "reading": "léi", "note": "羸弱。" },
      { "term": "隳", "reading": "huī", "note": "毁坏、坠落。" },
      { "term": "去泰", "note": "泰，过度。" }
    ]
  },
  "30": {
    "1": [{ "term": "好还", "reading": "好 hào", "note": "还，报应。用兵之事很快遭到还报。" }],
    "3": [{ "term": "果", "note": "成果、达成目的，谓济难而止。" }]
  },
  "31": {
    "0": [
      { "term": "佳兵", "note": "佳，美善；一说「佳」为「唯」之误。精良的兵器。" },
      { "term": "恬淡", "note": "安静淡泊，不以为美。" }
    ]
  },
  "32": {
    "0": [{ "term": "自宾", "note": "宾，服从。自动宾服。" }],
    "2": [{ "term": "始制有名", "note": "万物兴作，于是产生名分制度。" }]
  },
  "34": {
    "1": [{ "term": "衣养", "reading": "衣 yì", "note": "覆养。如衣被覆盖般养育。" }]
  },
  "35": {
    "0": [{ "term": "大象", "note": "大道之象，无形之象。" }],
    "2": [{ "term": "既", "note": "尽也。用之不尽。" }]
  },
  "36": {
    "0": [
      { "term": "歙", "reading": "xī", "note": "收敛、闭合。" },
      { "term": "微明", "note": "幽微的明智。" }
    ]
  },
  "37": {
    "2": [{ "term": "镇", "note": "安定、镇抚。" }]
  },
  "38": {
    "0": [
      { "term": "攘臂而扔", "reading": "攘 rǎng", "note": "攘臂，捋袖伸臂；扔，强拉。" },
      { "term": "前识", "note": "先见之明，自以为先知。" }
    ]
  },
  "39": {
    "1": [{ "term": "贞", "note": "正也，作天下的首领。" }],
    "3": [
      { "term": "蹶", "reading": "jué", "note": "跌倒、倾覆。" },
      { "term": "致数舆无舆", "reading": "舆 yú", "note": "舆，车；一说誉。追求过多反而失去。" },
      { "term": "琭琭", "reading": "lù lù", "note": "玉之华美貌。" },
      { "term": "珞珞", "reading": "luò luò", "note": "石之坚硬貌。" }
    ]
  }
}
