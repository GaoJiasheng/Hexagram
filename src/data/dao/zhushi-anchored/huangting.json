{
  "1": {
    "0": [
      {
        "term": "玉晨君",
        "note": "太上大道神格化的称号,上清派尊奉的大道之主。"
      },
      {
        "term": "蘂珠",
        "note": "即蘂珠宫,传说中天上仙宫之名;蘂同蕊。"
      },
      {
        "term": "琴心三叠",
        "note": "琴心谓心神和畅如琴音;三叠指上、中、下三丹田相叠如重楼。"
      },
      {
        "term": "三天",
        "note": "道教所说清微、禹余、大赤三天,为上界天境。"
      }
    ]
  },
  "2": {
    "0": [
      {
        "term": "关元",
        "reading": "guān yuán",
        "note": "穴位名,在脐下三寸,经中借指下丹田部位。"
      },
      {
        "term": "少阳",
        "note": "经中左右配阴阳,左为少阳,右为太阴,指身中部位。"
      },
      {
        "term": "列宿",
        "reading": "liè xiù",
        "note": "天上诸星宿,谓体内元气与星象相应分布。"
      },
      {
        "term": "三素云",
        "note": "道经中紫、黄、白三色云气,此指存思所见之象。"
      },
      {
        "term": "丹田",
        "note": "道家所指身中藏精聚气之处,有上中下三田。"
      }
    ]
  },
  "3": {
    "0": [
      {
        "term": "玉池",
        "note": "道经隐语,指口腔;以其润泽生津,喻为蓄玉之池。"
      },
      {
        "term": "灵液",
        "note": "指口中津液、唾液;道经视为养身之物,故称灵液。"
      },
      {
        "term": "广寒",
        "reading": "guǎng hán",
        "note": "本指月中宫阙,此借喻清虚高远之境。"
      },
      {
        "term": "泯泯",
        "reading": "mǐn mǐn",
        "note": "泯然无迹貌,此状神思湛寂、浑然之态。"
      }
    ]
  },
  "4": {
    "0": [
      {
        "term": "黄庭内人",
        "note": "黄庭中所存想的内神。黄庭指人身脏腑中境，存思之所主。"
      },
      {
        "term": "玉籥",
        "reading": "yù yuè",
        "note": "玉制的锁钥。籥为古之锁闩，此喻闭守门户。"
      },
      {
        "term": "枢机",
        "note": "门户转动的关键机栝，喻人身要害关窍。"
      },
      {
        "term": "三田",
        "note": "上、中、下三丹田，存思所谓藏精气之处。"
      },
      {
        "term": "灵台",
        "note": "本指心。《庄子·庚桑楚》有「不可内于灵台」语。"
      }
    ]
  },
  "5": {
    "0": [
      {
        "term": "中池",
        "note": "存思家所谓身中之府,旧注或指胆,或指脐下,黄庭以为内神所居处。"
      },
      {
        "term": "虎符",
        "reading": "hǔ fú",
        "note": "本古代调兵之信物,剖竹为虎形,合则为验;此借指内神所佩符信。"
      },
      {
        "term": "横津",
        "note": "内景隐语,指身中津液所聚、神灵所居之三寸之地。"
      },
      {
        "term": "隐芝",
        "note": "隐微之灵芝,经中以喻身中精气津液之滋养,非指山野草木。"
      }
    ]
  },
  "6": {
    "0": [
      {
        "term": "天中之岳",
        "note": "指头顶正中。岳喻其高耸如山，存思家以头为众脉所宗。"
      },
      {
        "term": "华盖",
        "reading": "huá gài",
        "note": "本帝王车上伞盖，此借指两眉，谓其覆于双目上如盖。"
      },
      {
        "term": "玄膺",
        "reading": "xuán yīng",
        "note": "膺，胸；玄膺指舌下咽喉一带，存思家视为津液上下之要道。"
      },
      {
        "term": "天汉",
        "reading": "tiān hàn",
        "note": "即银河、天河。汉本水名，引申指天上之河。"
      }
    ]
  },
  "7": {
    "0": [
      {
        "term": "泥丸",
        "reading": "ní wán",
        "note": "上清存思术语,指脑中之宫,即上丹田,为一身诸神之宗主。"
      },
      {
        "term": "九真",
        "note": "指泥丸宫所分九处脑室所居之神,各有名号居室。"
      },
      {
        "term": "罗裳",
        "reading": "luó cháng",
        "note": "罗,轻软丝织物;裳,下衣。指脑神所披轻软飞动的衣裙。"
      },
      {
        "term": "所存在心自相当",
        "note": "存,存思;相当,相应相合。谓存想得法则所守之神自与诸处相应。"
      }
    ]
  },
  "8": {
    "0": [
      {
        "term": "丹元",
        "note": "心神之名。心于五行属火,色赤,故以丹名其神。"
      },
      {
        "term": "皓华",
        "note": "肺神之名。肺色白,皓华取洁白光华之义。"
      },
      {
        "term": "翳郁",
        "reading": "yì yù",
        "note": "蓊郁茂盛貌,此状肝神含烟、草木翳翳之象。"
      },
      {
        "term": "玄冥",
        "note": "肾神之名。肾属水居北方,色玄黑,玄冥为水神旧称。"
      }
    ]
  },
  "9": {
    "0": [
      {
        "term": "华盖",
        "reading": "huá gài",
        "note": "本指帝王车上的伞盖，此喻肺居五脏之上、覆盖诸脏，故称肺为华盖。"
      },
      {
        "term": "七元之子",
        "note": "肺神之称。肺于五行属金，旧说配数应七，故曰七元之子。"
      },
      {
        "term": "中岳",
        "note": "五岳之中的嵩山。此以脏腑配五岳，肺开窍于鼻，故云外应中岳。"
      },
      {
        "term": "白元",
        "note": "存思中的肺神之名，色白配金，主调和肺气。"
      }
    ]
  },
  "10": {
    "0": [
      {
        "term": "丹元",
        "note": "上清派所称心神之名。下句「丹元家」谓心神所居之宫。"
      },
      {
        "term": "荣卫",
        "reading": "róng wèi",
        "note": "即营卫，营气与卫气，营行脉中、卫行脉外，主濡养护卫。"
      },
      {
        "term": "婆娑",
        "reading": "pó suō",
        "note": "盘旋舒缓、自在之貌，此状心神安坐从容。"
      },
      {
        "term": "登苏",
        "note": "苏醒、复活。登犹「乃」「即」，谓呼之即得复苏。"
      },
      {
        "term": "太霞",
        "note": "高天云霞，此指存思有成所至的高远清虚之境。"
      }
    ]
  },
  "11": {
    "0": [
      {
        "term": "青童神公子",
        "note": "肝神之名号。肝属木、色青，故称青童、公子。"
      },
      {
        "term": "关镜",
        "reading": "guān jìng",
        "note": "关窍门户。镜通『竟』，边界之意，指诸感官孔窍。"
      },
      {
        "term": "无英",
        "note": "存思家所谓肝神别名，人身中之神名，主肝木。"
      },
      {
        "term": "摄魂还魄",
        "note": "收摄魂、归复魄。旧说魂藏于肝、魄藏于肺。"
      }
    ]
  },
  "12": {
    "0": [
      {
        "term": "玄关",
        "note": "幽深玄妙之关窍。此指肾宫深隐之门户。"
      },
      {
        "term": "冥上玄",
        "note": "肾神之名与字。名冥，字上玄，存思家所拟脏神隐名。"
      },
      {
        "term": "九液",
        "note": "泛指周身各处津液。九言其多，非确数。"
      },
      {
        "term": "生门",
        "note": "丹道隐语，指下部生气之门户，一说指下丹田。"
      }
    ]
  },
  "13": {
    "0": [
      {
        "term": "戊己",
        "reading": "wù jǐ",
        "note": "十天干居中二干,五行属土;脾在五行配土,故脾宫属戊己。"
      },
      {
        "term": "黄裳",
        "reading": "huáng cháng",
        "note": "黄色下衣。脾色尚黄,此指脏神所居所服,喻中央土德。"
      },
      {
        "term": "太仓",
        "note": "本指胃,为受纳水谷之府;此借称脾胃运化之所。"
      },
      {
        "term": "尺宅",
        "reading": "chǐ zhái",
        "note": "存思术语,指面部;面为方尺之地,故称尺宅。"
      }
    ]
  },
  "14": {
    "0": [
      {
        "term": "六腑精",
        "note": "六腑指胆、胃、大肠、小肠、膀胱、三焦;此谓胆为六腑精气所聚。"
      },
      {
        "term": "曜威明",
        "note": "胆神之名,字威明;曜,光耀。上清经为脏腑各立神名。"
      },
      {
        "term": "玉旌",
        "reading": "yù jīng",
        "note": "玉色旌旗。旌为羽饰之旗,此状胆神威仪。"
      },
      {
        "term": "三元",
        "note": "上清存思术语,指上中下三丹田或三宫之神。"
      }
    ]
  },
  "15": {
    "0": [
      {
        "term": "太仓",
        "note": "指胃。胃为受纳水谷之府,故喻称太仓。"
      },
      {
        "term": "明堂",
        "note": "存思家所设脏神所居之宫名,此为脾神居处。"
      },
      {
        "term": "混康",
        "reading": "hùn kāng",
        "note": "脾神之名号;字灵元,名混康,皆存思家所拟脏神名。"
      },
      {
        "term": "金醴",
        "reading": "jīn lǐ",
        "note": "丹道隐语,指口中津液;与玉英皆喻唾津。"
      },
      {
        "term": "三虫",
        "note": "即三尸,道家谓人体内致衰损之虫,去之则康。"
      }
    ]
  },
  "16": {
    "0": [
      {
        "term": "三元",
        "note": "上清派指上元、中元、下元三处宫室之元气，一说指日月星三光之元。"
      },
      {
        "term": "五灵",
        "note": "五行(木火土金水)之灵，一说指五脏所主之神。"
      },
      {
        "term": "牖窗",
        "reading": "yǒu chuāng",
        "note": "牖即窗。闭牖窗喻收摄耳目、内敛神思。"
      },
      {
        "term": "玉珰",
        "reading": "yù dāng",
        "note": "玉制耳饰，此指身中神所衔之玉饰，为存思意象。"
      }
    ]
  },
  "17": {
    "0": [
      {
        "term": "灵台",
        "note": "本指心,道经存思家亦指脑中或两眉间之宫室,神明所居之处。"
      },
      {
        "term": "营卫",
        "reading": "yíng wèi",
        "note": "中医谓行于脉中之营气与脉外之卫气,此借指体内运行之气。"
      },
      {
        "term": "洞房紫极",
        "note": "存思术语,皆脑中宫室名,谓两眉间内入之深处。"
      },
      {
        "term": "公子",
        "note": "脑神之名,与下文白元相对,左右二神,存思所存想者。"
      },
      {
        "term": "七曜九元",
        "note": "七曜指日月五星;九元谓九天之元神,皆所存想之神。"
      }
    ]
  },
  "18": {
    "0": [
      {
        "term": "三关",
        "reading": "sān guān",
        "note": "经文自释为口、足、手三处;道经又有别指尾闾、夹脊、玉枕者,此章取前说。"
      },
      {
        "term": "九微",
        "reading": "jiǔ wēi",
        "note": "指身中幽深细微之处,极言隐秘难见,与下「幽且阴」互文。"
      },
      {
        "term": "天关",
        "reading": "tiān guān",
        "note": "天之门户,此以口当之,谓言语呼吸所出,系精神之枢机。"
      },
      {
        "term": "扉",
        "reading": "fēi",
        "note": "门扇,引申为门户。以足为地关之扉,谓行立所凭、生命所系。"
      }
    ]
  },
  "19": {
    "0": [
      {
        "term": "太一流珠",
        "note": "上清存思术语,指脑中所守的精气元神,流转如珠。"
      },
      {
        "term": "昆仑",
        "note": "丹道隐语,借神山喻人身头顶或脑部。"
      },
      {
        "term": "泥丸",
        "note": "上清家指脑中之宫,谓百神所聚、九真所居。"
      },
      {
        "term": "赤帝黄老",
        "note": "存思所设身神名,分主一身,与人魂魄相守。"
      }
    ]
  },
  "20": {
    "0": [
      {
        "term": "僊公公子",
        "reading": "xiān gōng gōng zǐ",
        "note": "存思所拟想的仙真之名，泛指可见于眼前的仙人。"
      },
      {
        "term": "朱鸟",
        "reading": "zhū niǎo",
        "note": "即朱雀，南方属火之象，此处喻心及其呼吸吞吐。"
      },
      {
        "term": "三气",
        "reading": "sān qì",
        "note": "上清经常语，指三丹田或三宫所主之气。"
      },
      {
        "term": "九道",
        "reading": "jiǔ dào",
        "note": "指身中九窍或九宫之通道。"
      },
      {
        "term": "正一含华",
        "reading": "zhèng yī hán huá",
        "note": "纯一不杂之气含蕴精华;正一即守一之要。"
      }
    ]
  },
  "21": {
    "0": [
      {
        "term": "八素",
        "reading": "bā sù",
        "note": "八方纯素之气;一说指八方素灵之神,为存思所聚。"
      },
      {
        "term": "泥丸夫人",
        "note": "脑中泥丸宫所主之女神,上清派泥丸诸神之一。"
      },
      {
        "term": "三灵殁",
        "reading": "sān líng mò",
        "note": "三魂之灵殒灭。殁,死。谓轻忽精气则身神俱丧。"
      },
      {
        "term": "寸田尺宅",
        "note": "丹道隐语,指三丹田与面部一尺之宅,为存思治生之所。"
      }
    ]
  },
  "22": {
    "0": [
      {
        "term": "三房",
        "note": "上清存思之三宫,泛指身中明堂、洞房、丹田等处宫室。"
      },
      {
        "term": "五芽",
        "reading": "wǔ yá",
        "note": "五方生气,亦作五牙,谓东南西北中五气之精,存思吞咽之。"
      },
      {
        "term": "六丁",
        "note": "道教阴神,丁卯、丁巳、丁未、丁酉、丁亥、丁丑六神,常受役护卫。"
      },
      {
        "term": "隐括",
        "reading": "yǐn kuò",
        "note": "本为矫正木材的工具,引申为收束、约束、把持。"
      }
    ]
  },
  "23": {
    "0": [
      {
        "term": "洞玄",
        "note": "上清派经书名号,与《玉篇》并举,指所修习的存思经典。"
      },
      {
        "term": "八景神",
        "reading": "bā jǐng shén",
        "note": "身中三部八景之神,上清存思所守的二十四位体内神。"
      },
      {
        "term": "璇玑",
        "reading": "xuán jī",
        "note": "本北斗星名,此借指身中关窍门户,谓太室之门。"
      },
      {
        "term": "因缘",
        "note": "此指身外攀求的凭借机缘,经意谓真在己身,不假外求。"
      }
    ]
  },
  "24": {
    "0": [
      {
        "term": "上清",
        "note": "上清派所奉天界仙境名，亦指此派所传经法。"
      },
      {
        "term": "死录除",
        "reading": "sǐ lù chú",
        "note": "勾除阴司死亡名册，谓得登仙籍、脱生死簿。"
      },
      {
        "term": "三神",
        "note": "黄庭家谓人身三部(脑、心、脐)所主之神。"
      },
      {
        "term": "臭如帑",
        "reading": "chòu rú tǎng",
        "note": "帑，藏钱府库；喻人世腥浊纷扰、铜臭逼人。"
      }
    ]
  },
  "25": {
    "0": [
      {
        "term": "三五合气",
        "note": "三与五相合于气;古以三五为天地阴阳交会之数。"
      },
      {
        "term": "隐地回八术",
        "note": "上清存思术名,谓隐遁地户、回旋八方之法。"
      },
      {
        "term": "洞房",
        "note": "脑中宫室名,在两眉间内入三寸,上清存思要处。"
      },
      {
        "term": "泥丸",
        "note": "脑中宫名,在头顶内,为一身之主。"
      }
    ]
  },
  "26": {
    "0": [
      {
        "term": "郁仪结璘",
        "reading": "yù yí jié lín",
        "note": "上清存思中日精之神名郁仪、月精之神名结璘,二语指奔日奔月之法。"
      },
      {
        "term": "玉清虚无老",
        "note": "玉清为道教三清天之一;虚无老指其中虚无自然之神真。"
      },
      {
        "term": "虎箓",
        "reading": "hǔ lù",
        "note": "道家符箓名,佩之以为身符,镇形辟邪。"
      },
      {
        "term": "金珰",
        "reading": "jīn dāng",
        "note": "金质佩饰,经中谓上清服佩之物,象身有金光。"
      },
      {
        "term": "东蒙",
        "note": "山名,即蒙山,在今山东蒙阴一带;此处借指仙真宴集之所。"
      }
    ]
  },
  "27": {
    "0": [
      {
        "term": "叵卒见",
        "reading": "pǒ cù jiàn",
        "note": "叵,不可;卒,通「猝」,仓促。谓不可仓促窥见。"
      },
      {
        "term": "顾眄",
        "reading": "gù miǎn",
