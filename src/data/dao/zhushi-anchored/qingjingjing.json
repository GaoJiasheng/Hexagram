    "2": [
      {
        "term": "上德不德",
        "note": "不自恃其德、不显德名。语本《道德经》三十八章。"
      },
      {
        "term": "著",
        "reading": "zhuó",
        "note": "执着、附着。"
      }
    ],
    "3": [
      {
        "term": "葛玄",
        "note": "三国吴道士，葛洪从祖，世称葛仙翁。"
      },
      {
        "term": "东华帝君",
        "note": "道教仙官，主领东方诸仙。"
      },
      {
        "term": "南宫",
        "note": "南方列仙之宫；一说炼度之宫。"
      }
    ],
