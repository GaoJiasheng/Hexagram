{
  "1": {
    "0": [
      {
        "term": "天尊",
        "note": "道教至高神格之称，此指灵宝天尊。本经托其名而传授。"
      },
      {
        "term": "左玄真人",
        "note": "道教仙真名号，六朝灵宝经中常见的受经者。"
      }
    ],
    "1": [
      {
        "term": "忤心",
        "note": "忤，违逆。谓无外事来扰逆其心。"
      },
      {
        "term": "内观",
        "note": "向内观照己心。唐代道书常用之语，与佛家内观相通。"
      }
    ],
    "2": [
      {
        "term": "的有",
        "note": "的，确实。谓确有其事的贪著，与下文浮游乱想相对。"
      },
      {
        "term": "照心",
        "note": "观照之心。与「动心」相对，为本经眼目所在。"
      },
      {
        "term": "住心",
        "note": "住，停滞。谓心黏着一处而不化。"
      },
      {
        "term": "不依一法",
        "note": "不依着任何一物一法。法，泛指心所对之事物。"
      }
    ],
    "3": [
      {
        "term": "去留交战",
        "note": "谓欲遣妄念与妄念欲留，二者在心中相争。"
      },
      {
        "term": "百体流行",
        "note": "百体，周身。流行，谓动荡不宁。"
      },
      {
        "term": "作意",
        "note": "留意、着意。谓于事上着意安顿其心。"
      },
      {
        "term": "千生之业",
        "note": "生，一世。谓历世修为所积之功业。"
      }
    ],
    "4": [
      {
        "term": "束心太急",
        "note": "束，约束。谓过分紧持其心，本经明戒此弊。"
      },
      {
        "term": "宽急得所",
        "note": "宽与急各得其宜，不偏于一边。"
      },
      {
        "term": "真宅",
        "note": "真正的居处。与下句「应迹」相对为言。"
      },
      {
        "term": "应迹",
        "note": "应物而现的形迹，非其本真。六朝佛道二家习用之语。"
      }
    ],
    "5": [
      {
        "term": "善巧方便",
        "note": "佛教语，谓因机施设的巧妙法门，此为道经取用。"
      },
      {
        "term": "实智若愚",
        "note": "谓真实的智慧不炫于外，语意近《老子》「大巧若拙」。"
      },
      {
        "term": "双美",
        "note": "谓定与慧两者俱善，不偏废其一。"
      }
    ],
    "6": [
      {
        "term": "是其祥也",
        "note": "祥，吉凶之先见者，此泛指定中所现之征象。"
      },
      {
        "term": "罣碍",
        "reading": "罣 guà",
        "note": "罣同「挂」。谓牵挂障碍。语见佛典。"
      },
      {
        "term": "旧业日销",
        "note": "业，行事所积。此承佛家业说而立言。"
      },
      {
        "term": "尘笼",
        "note": "谓尘世如樊笼，喻世累之拘系。"
      }
    ],
    "7": [
      {
        "term": "凡有七候",
        "note": "候，征候。七候为道书所设得道品位阶次的名目。"
      },
      {
        "term": "尘漏",
        "note": "尘，外境；漏，漏失。佛道二家谓为外境所染而失。"
      },
      {
        "term": "链形为气",
        "note": "链，同「炼」。此为道教修养品位说中的用语。"
      }
    ],
    "8": [
      {
        "term": "鉴力",
        "note": "鉴照之力。谓心如水镜而能照物之能。"
      },
      {
        "term": "色谢方空",
        "note": "色，形色形质；谢，凋落。谓待形骸消尽而后归空。"
      },
      {
        "term": "而说颂曰",
        "note": "颂，韵语的偈颂。本为佛经体例，唐代道经亦沿用。"
      }
    ],
    "9": [
      {
        "term": "境",
        "note": "心所对的外境。境、缘对举，皆言所待之条件。"
      }
    ],
    "10": [
      {
        "term": "真种性",
        "note": "种性，本有的性质根性。谓智与火各有其本然。"
      },
      {
        "term": "承流",
        "note": "承接流波。谓随流而下、逐末而忘其源。"
      }
    ],
    "11": [
      {
        "term": "起心欲息知",
        "note": "知，知见。谓强起一心以止心，反增其扰。"
      }
    ],
    "12": [
      {
        "term": "众妙门",
        "note": "《道德经》一章「众妙之门」，谓众妙所从出之门户。"
      }
    ]
  }
}
