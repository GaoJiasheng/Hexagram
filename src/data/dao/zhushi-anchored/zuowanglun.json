{
  "1": {
    "0": [
      {
        "term": "涸辙之鱼",
        "note": "语出《庄子·外物》，车辙积水将干中的鱼，喻困境待救。"
      },
      {
        "term": "弱丧",
        "note": "语出《庄子·齐物论》，谓自幼流落在外而忘归。"
      },
      {
        "term": "妙真经",
        "note": "道经名，全称《太上老君妙真经》，今已散佚，唯见后世征引。"
      },
      {
        "term": "我命在我，不属于天",
        "note": "《西升经》语。谓寿夭修短系于自身，不由天定。"
      }
    ],
    "1": [
      {
        "term": "朝菌",
        "note": "语出《庄子·逍遥游》，朝生暮死之菌，喻年寿短促。"
      },
      {
        "term": "知命",
        "note": "谓五十岁。《论语·为政》「五十而知天命」。"
      },
      {
        "term": "景烛",
        "note": "景，同「影」。风中烛影，喻光阴易逝。"
      },
      {
        "term": "枢翼",
        "note": "枢，门轴；翼，羽翼。谓总括大要之篇，本书末附之。"
      }
    ]
  },
  "2": {
    "0": [
      {
        "term": "卞和致刖",
        "note": "刖，断足之刑。卞和献璞玉不见信，两遭刖足，见《韩非子·和氏》。"
      },
      {
        "term": "伍子从诛",
        "note": "伍子胥谏吴王夫差不听，反被赐死。从诛，遭受诛戮。"
      },
      {
        "term": "希微",
        "note": "《道德经》十四章「听之不闻名曰希，搏之不得名曰微」。"
      },
      {
        "term": "罔象",
        "note": "恍惚无形之象。语本《庄子·天地》黄帝遗玄珠、罔象得之。"
      }
    ],
    "1": [
      {
        "term": "隳肢体",
        "note": "隳，毁弃。《庄子·大宗师》原作「堕肢体」，此引作隳。"
      },
      {
        "term": "大通",
        "note": "谓与万物浑然相通的大道。《庄子·大宗师》语。"
      },
      {
        "term": "怀宝求宝",
        "note": "怀中有宝而向外寻宝，喻道在己身而不自知。"
      },
      {
        "term": "信不足，有不信",
        "note": "《道德经》十七章语，谓诚信不足，故人有不信者。"
      }
    ]
  },
  "3": {
    "0": [
      {
        "term": "塞其兑，闭其门，终身不勤",
        "note": "《道德经》五十二章语。兑，孔窍；勤，劳苦。"
      },
      {
        "term": "遗问庆吊",
        "note": "遗问，馈赠问候；庆吊，贺喜与吊丧。皆世俗往还之礼。"
      },
      {
        "term": "机心",
        "note": "机巧计算之心。语本《庄子·天地》抱瓮丈人之说。"
      },
      {
        "term": "正业",
        "note": "此谓修道的本业，与世俗事缘相对。"
      }
    ],
    "1": [
      {
        "term": "开其兑，济其事，终身不救",
        "note": "《道德经》五十二章语，与上文「塞其兑」正相对。"
      },
      {
        "term": "醴交势合",
        "note": "醴，甜酒。《庄子·山木》「小人之交甘若醴」，谓以甘言相结。"
      },
      {
        "term": "不将不迎",
        "note": "《庄子·应帝王》语。将，送。谓物来不迎、物去不送。"
      },
      {
        "term": "无为名尸",
        "note": "《庄子·应帝王》语。尸，主也，谓不做名声的承载者。"
      }
    ]
  },
  "4": {
    "0": [
      {
        "term": "百神之师",
        "note": "师，统领。道教以人身脏腑各有其神，而心为其主。"
      },
      {
        "term": "住无所有",
        "note": "住，安住、止住。谓心不依着于任何对象。"
      },
      {
        "term": "归根",
        "note": "《道德经》十六章「夫物芸芸，各归其根」，谓复归本源。"
      },
      {
        "term": "知常",
        "note": "常，恒久不变之理。《道德经》十六章「知常曰明」。"
      }
    ],
    "1": [
      {
        "term": "盲定",
        "note": "本书所斥的邪定：一概断灭知觉、无所照察的枯寂之定。"
      },
      {
        "term": "以知害恬",
        "note": "知，知见；恬，恬淡。语本《庄子·缮性》恬知交养之说。"
      },
      {
        "term": "为子伤本",
        "note": "子谓枝末，本谓根柢。谓顾其末而反伤其根。"
      },
      {
        "term": "消息",
        "note": "消长进退。谓随时势而增减变通。"
      }
    ],
    "2": [
      {
        "term": "爱见",
        "note": "贪爱与偏执之见。见，成见、知见。"
      },
      {
        "term": "鹰鹯",
        "reading": "鹯 zhān",
        "note": "鹯为鹞类猛禽。鹰鹯并称，泛指猛禽。"
      },
      {
        "term": "虽有拱璧，以先驷马。不如坐进此道",
        "note": "《道德经》六十二章语。拱璧，合抱之璧。"
      },
      {
        "term": "吾言甚易知，甚易行",
        "note": "《道德经》七十章语，下句「天下莫能知」同出该章。"
      }
    ],
    "3": [
      {
        "term": "火不热",
        "note": "先秦名家辩题，见《庄子·天下》所记辩者二十一事。"
      },
      {
        "term": "破相",
        "note": "破除对事相的执着，佛家语。此指徒逞空谈之言。"
      },
      {
        "term": "鷇食",
        "reading": "鷇 kòu",
        "note": "鷇为待哺的雏鸟；鷇食谓雏鸟受哺于亲。"
      },
      {
        "term": "见卯而求时夜",
        "note": "卯当作「卵」；时夜谓司晨之鸡。语本《庄子·齐物论》。"
      }
    ]
  },
  "5": {
    "0": [
      {
        "term": "巢林一枝",
        "note": "语本《庄子·逍遥游》「鹪鹩巢于深林，不过一枝」。"
      },
      {
        "term": "饮河满腹",
        "note": "承上《庄子》语「偃鼠饮河，不过满腹」，谓所需有限。"
      },
      {
        "term": "知生之有分",
        "note": "分，分限、本分。谓生命所需自有其限度。"
      }
    ],
    "1": [
      {
        "term": "达生之情者",
        "note": "语出《庄子·达生》。达，通晓；情，实情。"
      },
      {
        "term": "分之外物",
        "note": "原文夹注语，释上句「生之所无以为」，谓分限之外之物。"
      },
      {
        "term": "随侯之珠",
        "note": "随侯所得夜明珠，古之至宝。语见《庄子·让王》。"
      },
      {
        "term": "千仞",
        "note": "仞，古长度名，七尺或八尺为一仞。千仞极言其高。"
      }
    ],
    "2": [
      {
        "term": "行名失己，非士也",
        "note": "《庄子·骈拇》语。行名，谓为求名声而行事。"
      },
      {
        "term": "抱元守一",
        "note": "道教修养论中的固守元气、专一不散之说。"
      },
      {
        "term": "过度神仙",
        "note": "过度，超度、越过。谓超出凡境而列于仙品。"
      }
    ]
  },
  "6": {
    "0": [
      {
        "term": "傥来",
        "note": "傥，偶然。《庄子·缮性》「物之傥来，寄者也」。"
      },
      {
        "term": "得见机前",
        "note": "机，事之端倪。谓于事端未显之先有所鉴察。"
      },
      {
        "term": "躁竞",
        "note": "急躁争竞。谓奔竞求进之心。"
      }
    ],
    "1": [
      {
        "term": "常无欲以观其妙",
        "note": "《道德经》一章语。谓于无欲之中观道之微妙。"
      },
      {
        "term": "虚襟",
        "note": "襟，胸怀。虚襟谓虚怀以受，不先存成见。"
      },
      {
        "term": "船舫",
        "note": "舫，两船相并。船舫泛指舟船，此为借喻。"
      }
    ],
    "2": [
      {
        "term": "袄妍",
        "note": "袄当作「妖」。袄妍谓妖艳之色，形讹而义可推。"
      },
      {
        "term": "恶道",
        "note": "佛教语，谓众生受苦的趣向。此为唐代道书取用佛家语。"
      },
      {
        "term": "业入而不可舍",
        "note": "语见《庄子·庚桑楚》。业，行事所积。"
      },
      {
        "term": "故不优",
        "note": "优当作「忧」。《周易·系辞上》「乐天知命，故不忧」。"
      }
    ],
    "3": [
      {
        "term": "及吾无身，吾有何患",
        "note": "《道德经》十三章语，谓患由有身而起。"
      },
      {
        "term": "真宰",
        "note": "真正的主宰。语出《庄子·齐物论》「若有真宰，而特不得其眹」。"
      },
      {
        "term": "枯体灰心",
        "note": "语本《庄子·齐物论》「形如槁木，心如死灰」。"
      },
      {
        "term": "讬生受气",
        "note": "讬同「托」。谓受形受气而更生，道书承佛家转生说之语。"
      }
    ],
    "4": [
      {
        "term": "生死理齐",
        "note": "齐，等同。语本《庄子·齐物论》齐生死之说。"
      },
      {
        "term": "后身成业",
        "note": "后身，来世之身。道书承佛家转生业说之语。"
      },
      {
        "term": "除情正信",
        "note": "除去情执，端正信心。信字承首章《信敬》而言。"
      },
      {
        "term": "鲍肆",
        "note": "鲍鱼之肆，卖咸鱼的铺子，喻久处而不觉其臭之地。"
      }
    ]
  },
  "7": {
    "0": [
      {
        "term": "宇泰定者，发乎天光",
        "note": "《庄子·庚桑楚》语。宇，心宇；天光，本明之照。"
      },
      {
        "term": "澡雪",
        "note": "澡，洗；雪，涤。谓洗涤使洁净。语本《庄子·知北游》。"
      },
      {
        "term": "以恬养智",
        "note": "《庄子·缮性》语，与下文「以智养恬」相对为说。"
      },
      {
        "term": "和理",
        "note": "中和之理。《庄子·缮性》「和理出其性」。"
      }
    ],
    "1": [
      {
        "term": "玄石饮羽",
        "note": "饮羽，箭没入至羽。旧传射石没羽之事，喻志专而力至。"
      },
      {
        "term": "朱夏殒霜",
        "note": "朱夏，盛夏。旧说冤怨感召而夏日陨霜，见汉人所记。"
      },
      {
        "term": "九幽",
        "note": "道书所谓地下幽暗之处；下文「三清」则为上界天境之名。"
      },
      {
        "term": "嗒焉坐忘",
        "reading": "嗒 tà",
        "note": "嗒焉，解体忘我貌。语本《庄子·齐物论》「嗒焉似丧其耦」。"
      }
    ]
  },
  "8": {
    "0": [
      {
        "term": "空心谷神",
        "note": "谷神，《道德经》六章语，谓虚而能应之神。空心，虚其心。"
      },
      {
        "term": "神人",
        "note": "道书所设修养品位之名，与真人、至人并称。"
      },
      {
        "term": "灵宝经",
        "note": "六朝出世的灵宝派经书之统称，与上清经并行于世。"
      },
      {
        "term": "尸解",
        "note": "道教旧说所谓遗其形骸而去的一种仙品之称。"
      }
    ],
    "1": [
      {
        "term": "同于道者，道亦得之",
        "note": "《道德经》二十三章语。"
      },
      {
        "term": "求以得，有罪以免",
        "note": "《道德经》六十二章语，本经引以证贵道之意。"
      },
      {
        "term": "理逾车室",
        "note": "车、室之喻见《道德经》十一章，言有无相资而为用。"
      },
      {
        "term": "六根",
        "note": "佛教语，谓眼、耳、鼻、舌、身、意六种感官。"
      }
    ]
  }
}
