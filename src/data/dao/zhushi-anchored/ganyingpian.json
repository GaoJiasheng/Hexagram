{
  "1": {
    "1": [
      {
        "term": "司过之神",
        "note": "司，掌管。专管记录人过错之神。"
      },
      {
        "term": "算",
        "note": "寿算。一算为百日，夺算即减寿。"
      }
    ],
    "2": [
      {
        "term": "三台",
        "note": "星官名，上台、中台、下台共六星。"
      },
      {
        "term": "三尸神",
        "note": "道教谓人身中三虫，伺人过失。"
      },
      {
        "term": "庚申日",
        "note": "干支纪日之一，六十日一遇，三尸上天言过之日。"
      },
      {
        "term": "夺纪",
        "note": "纪，十二年。夺纪即减寿十二年。"
      }
    ],
    "3": [
      {
        "term": "友悌",
        "reading": "悌 tì",
        "note": "兄友爱弟，弟敬顺兄。"
      },
      {
        "term": "矜孤恤寡",
        "reading": "矜 jīn",
        "note": "矜、恤皆怜悯体恤之义。"
      }
    ],
    "5": [
      {
        "term": "攻讦",
        "reading": "讦 jié",
        "note": "揭人之短而攻击。"
      },
      {
        "term": "希旨",
        "note": "希，迎合。迎合上意。"
      },
      {
        "term": "诛降戮服",
        "note": "杀戮已投降归服之人。"
      },
      {
        "term": "壅塞方术",
        "reading": "壅 yōng",
        "note": "壅，阻塞。阻塞他人技艺生路。"
      }
    ],
    "6": [
      {
        "term": "发蛰",
        "reading": "蛰 zhé",
        "note": "惊起冬眠之虫。"
      },
      {
        "term": "形人之丑",
        "note": "形，显露、张扬。"
      }
    ],
    "8": [
      {
        "term": "埋蛊厌人",
        "reading": "蛊 gǔ 厌 yā",
        "note": "埋蛊毒、行厌胜之术以害人。"
      },
      {
        "term": "鬪合",
        "reading": "鬪 dòu",
        "note": "挑拨使人争斗。"
      }
    ],
    "9": [
      {
        "term": "𫗪",
        "reading": "wèi",
        "note": "同「喂」，以食饲人。"
      },
      {
        "term": "左道",
        "note": "邪道、旁门。"
      },
      {
        "term": "谩蓦",
        "reading": "mán mò",
        "note": "欺瞒蒙骗。"
      }
    ],
    "10": [
      {
        "term": "晦腊",
        "note": "晦，月末之日；腊，岁终祭日。"
      },
      {
        "term": "八节",
        "note": "立春、春分、立夏、夏至、立秋、秋分、立冬、冬至。"
      },
      {
        "term": "三光",
        "note": "日、月、星。"
      }
    ],
    "12": [
      {
        "term": "漏脯",
        "reading": "脯 fǔ",
        "note": "腐坏有毒之肉干。"
      },
      {
        "term": "鸩",
        "reading": "zhèn",
        "note": "毒鸟，其羽浸酒可毒杀人。"
      }
    ],
    "13": [
      {
        "term": "胡不",
        "note": "胡，何。为何不。"
      }
    ]
  }
}