        "note": "夏后氏所传的半璧美玉,古之名玉。璜,半璧形玉器。"
      },
      {
        "term": "明月之珠",
        "note": "光泽如明月的宝珠,古之至宝。"
      },
      {
        "term": "洿辱",
        "reading": "wū rǔ",
        "note": "污下耻辱。洿同污,低下、污秽。"
      }
    ],
    "11": [
      {
        "term": "日月之蚀",
        "note": "日食月食。喻君子之过显而暂,过去仍复其明。"
      },
      {
        "term": "准绳",
        "note": "墨绳水准,喻仁义为衡量君子小人的标准。"
      }
    ],
    "12": [
      {
        "term": "夷狄蛮貊",
        "reading": "yí dí mán mò",
        "note": "古称四方异族,泛指中原以外之地。貊为北方部族。"
      },
      {
        "term": "间不容息",
        "note": "其间容不下一次喘息,极言时机短促不可失。"
      },
      {
        "term": "赤帝",
        "note": "传说炎帝,主火德。此谓其肆为火炎。"
      },
      {
        "term": "颛顼",
        "reading": "Zhuān xū",
        "note": "五帝之一,号高阳氏,传说诛共工而平水患。"
      }
    ],
    "13": [
      {
        "term": "神农",
        "note": "传说教民耕种的上古帝王,主农事,后托其名立重农之法。"
      },
      {
        "term": "刻镂",
        "reading": "kè lòu",
        "note": "雕刻镂饰。指器用上的繁文奢巧。"
      },
      {
        "term": "当年",
        "reading": "dāng nián",
        "note": "正当壮盛之年。指妇人盛年应织。"
      }
    ],
    "14": [
      {
        "term": "霸王之道",
        "note": "称霸成王之道。此指挟义讨伐、存亡继绝的用兵之道。"
      },
      {
        "term": "六畜",
        "reading": "liù chù",
        "note": "马、牛、羊、鸡、犬、豕,泛指家畜。"
      },
      {
        "term": "囹圄",
        "reading": "líng yǔ",
        "note": "监狱。出囹圄即释放在押之人。"
      },
      {
        "term": "渍米",
        "reading": "zì mǐ",
        "note": "用水浸泡米。此言百姓淘米备粮迎义兵。"
      }
    ],
    "15": [
      {
        "term": "折冲千里之外",
        "note": "在千里之外挫败敌人的攻势。冲为冲车,折冲谓克敌。"
      },
      {
        "term": "舆死扶伤",
        "reading": "yú sǐ fú shāng",
        "note": "用车载运死者,搀扶伤者。状战事惨烈。"
      },
      {
        "term": "行阵",
        "reading": "háng zhèn",
        "note": "行列阵势,指军队的布阵作战。"
      }
    ],
    "16": [
      {
        "term": "矢石若雨",
        "note": "箭与礧石如雨般落下,形容战阵之险。矢,箭;石,守城所掷之石。"
      },
      {
        "term": "争光",
        "note": "争相奋勇立功。光,功业荣光。"
      },
      {
        "term": "政天下",
        "reading": "zhèng tiān xià",
        "note": "匡正、统理天下。政通正。"
      }
    ]
  },
