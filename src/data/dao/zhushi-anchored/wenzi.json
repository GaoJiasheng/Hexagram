      },
      {
        "term": "朋党",
        "note": "为私利结成的派系党羽,与守职任贤相对。"
      }
    ],
    "3": [
      {
        "term": "金石",
        "note": "钟磬一类金石之乐器,定调后不可更改,喻道之恒常。"
      },
      {
        "term": "琴瑟",
        "note": "弦乐器,每奏一曲须重新调弦,喻随事变易的礼乐法制。"
      },
      {
        "term": "曲士",
        "reading": "qū shì",
        "note": "见识偏狭浅陋之士。《庄子·秋水》有「曲士不可语于道」。"
      },
      {
        "term": "讯寤于俗",
        "note": "被流俗所惊扰。讯寤一作「迅鹜」,谓为俗所惊动牵动。"
      }
    ],
    "4": [
      {
        "term": "三皇",
        "note": "传说上古帝王,说法不一,常指伏羲、神农、黄帝。"
      },
      {
        "term": "夏后氏",
        "note": "即夏朝、夏禹之族。后,君也,夏君称夏后。"
      },
      {
        "term": "方枘而内员凿",
        "reading": "fāng ruì nà yuán záo",
        "note": "方榫插入圆孔,扞格不入。喻泥古守法不合时宜。"
      }
    ],
    "6": [
      {
        "term": "众适",
        "note": "合乎众人之所宜、众人之所安。文子以此为义与法之本。"
      },
      {
        "term": "准绳",
        "note": "测平直的水准与墨绳,引申为法度标准。"
      },
      {
        "term": "检式",
        "note": "检束的法式、准则。谓君先以法自约束。"
      },
      {
        "term": "有司",
        "note": "主管其事的官吏。司,主管。"
      }
    ],
    "7": [
      {
        "term": "劝",
        "reading": "quàn",
        "note": "劝勉、勉励,使人努力向善。"
      },
      {
        "term": "守约而治广",
        "note": "持守简约之法而能治理广大。约,简要。"
      }
    ],
    "8": [
      {
        "term": "十围",
        "reading": "shí wéi",
        "note": "形容树木粗大。围为两臂合抱或两手围拢之长。"
      },
      {
        "term": "千钧",
        "reading": "qiān jūn",
        "note": "极重之量。一钧三十斤,千钧言其重。"
      },
      {
        "term": "关",
        "reading": "guān",
        "note": "门闩,横插门后使门闭合之木。此喻据要害以制大。"
      }
    ],
    "9": [
      {
        "term": "屈寸而申尺",
        "note": "屈缩一寸而伸展一尺。喻舍小就大、不计小节。申通伸。"
      },
      {
        "term": "訾行",
        "reading": "zǐ xíng",
        "note": "苛责挑剔他人行为。訾,非议、毁谤。"
      },
      {
        "term": "节疏",
        "note": "竹木枝节稀疏。喻体量大者不拘小节。"
      }
    ],
    "10": [
      {
