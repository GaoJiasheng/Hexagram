      },
      {
        "term": "辔衔",
        "reading": "pèi xián",
        "note": "辔为缰绳,衔为马口中横木(嚼子),驭马之具。"
      },
      {
        "term": "车舆",
        "reading": "chē yú",
        "note": "车厢、车子。此喻君主所凭借的权势。"
      }
