{
  "book": "daodejing",
  "title": "道德经",
  "chapters": [
    {
      "no": 1,
      "title": "一章",
      "paragraphs": [
        {
          "original": "道可道，非常道，名可名，非常名；",
          "translation": "可以言说的道，就不是恒常之道；可以称呼的名，就不是恒常之名。"
        },
        {
          "original": "无名，天地之始，有名，万物之母。",
          "translation": "「无名」是天地的开端，「有名」是万物的根源。"
        },
        {
          "original": "故常无欲，以观其妙，",
          "translation": "所以常处于「无欲」，以观照道的微妙；"
        },
        {
          "original": "常有欲，以观其徼；",
          "translation": "常处于「有欲」，以观察道的边际端倪。"
        },
        {
          "original": "此两者，同出而异名，同谓之玄。玄之又玄，众妙之门。",
          "translation": "这两者同出一源而名称不同，都可称之为玄。玄而又玄，正是一切奥妙的门户。"
        }
      ]
    },
    {
      "no": 2,
      "title": "二章",
      "paragraphs": [
        {
          "original": "天下皆知美之为美，斯恶已。皆知善之为善，斯不善已。故有无相生，难易相成，长短相较，高下相倾，音声相和，前后相随。",
          "translation": "天下都知道美之所以为美，丑的观念就产生了；都知道善之所以为善，不善的观念就产生了。所以有与无相互生成，难与易相互成就，长与短相互显现，高与下相互依倚，音与声相互应和，前与后相互随从。"
        },
        {
          "original": "是以圣人处无为之事，",
          "translation": "因此圣人以「无为」处事，"
        },
        {
          "original": "行不言之教；万物作焉而不辞，生而不有，为而不恃，",
          "translation": "施行不靠言辞的教化；任万物自然兴作而不加干预，生养万物而不据为己有，有所作为而不自恃其能，"
        },
        {
          "original": "功成而弗居。",
          "translation": "功业成就而不自居其功。"
        },
        {
          "original": "夫唯弗居，是以不去。",
          "translation": "正因为不居功，功绩才不会离他而去。"
        }
      ]
    },
    {
      "no": 3,
      "title": "三章",
      "paragraphs": [
        {
          "original": "不尚贤，使民不争；不贵难得之货，使民不为盗；不见可欲，使民心不乱。",
          "translation": "不推崇贤能之名，使民众不争竞；不珍视难得的财货，使民众不去偷盗；不显露可起贪欲之物，使民心不被扰乱。"
        },
        {
          "original": "是以圣人之治，虚其心，实其腹，",
          "translation": "所以圣人治理天下，使人心灵虚静，使人温饱充实，"
        },
        {
          "original": "弱其志，强其骨。",
          "translation": "削弱争竞的心志，强健民众的筋骨，"
        },
        {
          "original": "常使民无知无欲。",
          "translation": "常使民众没有伪诈之智、没有贪求之欲，"
        },
        {
          "original": "使夫智者不敢为也。",
          "translation": "使那些自作聪明的人不敢妄为。"
        },
        {
          "original": "为无为，则无不治。",
          "translation": "以无为的态度去作为，就没有治理不好的。"
        }
      ]
    },
    {
      "no": 4,
      "title": "四章",
      "paragraphs": [
        {
          "original": "道冲而用之或不盈，渊兮似万物之宗；挫其锐，解其纷，和其光，同其尘，湛兮似或存。吾不知谁之子，象帝之先。",
          "translation": "道是虚空的，用之却永不穷尽。深远啊，像是万物的宗主；它挫去锋锐，解开纷扰，调和光芒，混同尘俗，幽隐啊似亡而实存。我不知道它是谁的产物，似乎在天帝之先就已存在。"
        }
      ]
    },
    {
      "no": 5,
      "title": "五章",
      "paragraphs": [
        {
          "original": "天地不仁，以万物为刍狗；",
          "translation": "天地无所偏爱，把万物当作刍狗一样任其自生自灭；"
        },
        {
          "original": "圣人不仁，以百姓为刍狗。",
          "translation": "圣人无所偏爱，把百姓当作刍狗一样任其自作自息。"
        },
        {
          "original": "天地之间，其犹橐籥乎？虚而不屈，动而愈出。",
          "translation": "天地之间，不正像一具风箱吗？空虚而不会穷竭，越鼓动风越多。"
        },
        {
          "original": "多言数穷，不如守中。",
          "translation": "政令繁多反而加速困窘，不如持守虚静。"
        }
      ]
    },
    {
      "no": 6,
      "title": "六章",
      "paragraphs": [
        {
          "original": "谷神不死，是谓玄牝。玄牝之门，是谓天地根。緜緜若存，用之不勤。",
          "translation": "虚谷之神永不消亡，这就是玄妙的母性；玄牝之门，就是天地的根源。它绵绵不绝若有若无，作用无穷无尽。"
        }
      ]
    },
    {
      "no": 7,
      "title": "七章",
      "paragraphs": [
        {
          "original": "天长地久。天地所以能长且久者，以其不自生，",
          "translation": "天长地久。天地所以能长久，因为它们不为自己而生存，"
        },
        {
          "original": "故能长生。是以圣人后其身而身先；外其身而身存。非以其无私邪，故能成其私。",
          "translation": "所以能长久生存。因此圣人把自身置于人后，反而占先；把自身置之度外，反而保全。不正因为他无私吗？反而成就了他自身。"
        }
      ]
    },
    {
      "no": 8,
      "title": "八章",
      "paragraphs": [
        {
          "original": "上善若水。水善利万物而不争，处众人之所恶，",
          "translation": "最高的善像水一样。水善于滋利万物而不与之相争，停留在众人所厌恶的低处，"
        },
        {
          "original": "故几于道。",
          "translation": "所以最接近于道。"
        },
        {
          "original": "居善地，心善渊，与善仁，言善信，正善治，事善能，动善时。夫唯不争，故无尤。",
          "translation": "居处善于择地，心境善于渊静，交往善于仁爱，言语善于守信，为政善于治理，做事善于发挥所长，行动善于把握时机。正因为不争，所以没有过失。"
        }
      ]
    },
    {
      "no": 9,
      "title": "九章",
      "paragraphs": [
        {
          "original": "持而盈之，不如其已；",
          "translation": "执持盈满，不如适时停止；"
        },
        {
          "original": "揣而棁之，不可长保。",
          "translation": "锤尖磨利，难以长久保持。"
        },
        {
          "original": "金玉满堂，莫之能守；",
          "translation": "金玉满堂，没有谁能守得住；"
        },
        {
          "original": "富贵而骄，自遗其咎。",
          "translation": "富贵而骄横，是自己留下祸患。"
        },
        {
          "original": "功遂身退，天之道。",
          "translation": "功成名就而身退，才合于天道。"
        }
      ]
    },
    {
      "no": 10,
      "title": "十章",
      "paragraphs": [
        {
          "original": "载营魄抱一，能无离乎？",
          "translation": "魂魄安守于形体而抱守为一，能不分离吗？"
        },
        {
          "original": "专气致柔，能婴儿乎？",
          "translation": "专凝精气达到柔和，能像婴儿一样吗？"
        },
        {
          "original": "涤除玄览，能无疵乎？",
          "translation": "涤除心镜上的尘垢，能没有瑕疵吗？"
        },
        {
          "original": "爱国治民，能无知乎？",
          "translation": "爱民治国，能不用智巧吗？"
        },
        {
          "original": "天门开阖，能为雌乎？",
          "translation": "感官与外物开合应接，能守静持雌吗？"
        },
        {
          "original": "明白四达，能无为乎？",
          "translation": "明白通达四方，能不妄为吗？"
        },
        {
          "original": "生之，",
          "translation": "生养万物，"
        },
        {
          "original": "畜之。",
          "translation": "畜养万物。"
        },
        {
          "original": "生而不有，为而不恃，长而不宰，是谓玄德。",
          "translation": "生养而不据为己有，施为而不自恃其能，为长而不主宰，这就叫玄德。"
        }
      ]
    },
    {
      "no": 11,
      "title": "十一章",
      "paragraphs": [
        {
          "original": "三十辐共一毂，当其无，有车之用。",
          "translation": "三十根辐条共凑一个车毂，正因毂中有空处，才有车的作用。"
        },
        {
          "original": "埏埴以为器，当其无，有器之用。凿户牖以为室，当其无，有室之用。故有之以为利，无之以为用。",
          "translation": "揉和陶土做成器皿，正因器中空虚，才有器皿的作用；开凿门窗建造房屋，正因室内空虚，才有房屋的作用。所以「有」给人便利，「无」发挥着作用。"
        }
      ]
    },
    {
      "no": 12,
      "title": "十二章",
      "paragraphs": [
        {
          "original": "五色令人目盲，五音令人耳聋，五味令人口爽，驰骋畋猎令人心发狂，",
          "translation": "缤纷的色彩使人眼花，繁杂的音声使人耳聋，浓重的滋味使人口伤，纵马驰骋围猎使人心发狂，"
        },
        {
          "original": "难得之货令人行妨。",
          "translation": "难得的财货使人行为败坏。"
        },
        {
          "original": "是以圣人为腹不为目，故去彼取此。",
          "translation": "因此圣人但求安饱而不逐声色，所以舍弃那些、持守这些。"
        }
      ]
    },
    {
      "no": 13,
      "title": "十三章",
      "paragraphs": [
        {
          "original": "宠辱若惊，贵大患若身。何谓宠辱若惊？宠为下，得之若惊，失之若惊，是谓宠辱若惊。",
          "translation": "得宠和受辱都使人惊慌，重视大患如同重视自身。什么叫宠辱若惊？得宠本是卑下的事，得到它惊慌，失去它也惊慌，这就叫宠辱若惊。"
        },
        {
          "original": "何谓贵大患若身？",
          "translation": "什么叫贵大患若身？"
        },
        {
          "original": "吾所以有大患者，为吾有身，",
          "translation": "我所以有大患，是因为我有这个自身；"
        },
        {
          "original": "及吾无身，",
          "translation": "等到我不执着己身，"
        },
        {
          "original": "吾有何患？故贵以身为天下，若可寄天下；",
          "translation": "我还有什么祸患？所以能以贵身的态度去为天下的人，才可以把天下寄付于他；"
        },
        {
          "original": "爱以身为天下，若可托天下。",
          "translation": "能以爱身的态度去为天下的人，才可以把天下托付于他。"
        }
      ]
    },
    {
      "no": 14,
      "title": "十四章",
      "paragraphs": [
        {
          "original": "视之不见名曰夷，听之不闻名曰希，搏之不得名曰微。此三者，不可致诘，故混而为一。",
          "translation": "看它看不见，叫做夷；听它听不到，叫做希；摸它摸不着，叫做微。这三者无法追问到底，所以混而为一。"
        },
        {
          "original": "其上不皦，其下不昧。绳绳不可名，复归于无物。是谓无状之状，无物之象，",
          "translation": "它上面并不显得光亮，下面也不显得晦暗。绵绵不绝而难以名状，又归复于无物。这是没有形状的形状、不见物体的形象，"
        },
        {
          "original": "是谓惚恍。",
          "translation": "这就叫惚恍。"
        },
        {
          "original": "迎之不见其首，随之不见其后。执古之道，以御今之有。",
          "translation": "迎着它看不见它的头，跟着它看不见它的尾。把握亘古已有的道，来驾驭当今的万有。"
        },
        {
          "original": "能知古始，是谓道纪。",
          "translation": "能认识那远古的开端，这就叫道的纲纪。"
        }
      ]
    },
    {
      "no": 15,
      "title": "十五章",
      "paragraphs": [
        {
          "original": "古之善为士者，微妙玄通，深不可识。夫唯不可识，故强为之容。豫焉若冬涉川，",
          "translation": "古时善于行道之士，精微玄妙而通达，深邃得难以认识。正因难以认识，只好勉强形容他：迟疑审慎啊，像冬天涉过河川；"
        },
        {
          "original": "犹兮若畏四邻，",
          "translation": "警觉戒惕啊，像提防四邻的窥伺；"
        },
        {
          "original": "俨兮其若容，涣兮若冰之将释，敦兮其若朴，旷兮其若谷，混兮其若浊。",
          "translation": "恭敬庄重啊，像作宾客；涣然消融啊，像将化的冰；敦厚质朴啊，像未雕的素材；旷达开阔啊，像深山幽谷；浑朴含容啊，像浊水。"
        },
        {
          "original": "孰能浊以静之徐清？孰能安以久动之徐生？",
          "translation": "谁能在浑浊中安静下来慢慢澄清？谁能在安定中变动起来慢慢生长？"
        },
        {
          "original": "保此道者不欲盈，",
          "translation": "保有此道的人不求盈满，"
        },
        {
          "original": "夫唯不盈，故能蔽不新成。",
          "translation": "正因为不盈满，所以能安于敝旧而不急于求成。"
        }
      ]
    },
    {
      "no": 16,
      "title": "十六章",
      "paragraphs": [
        {
          "original": "致虚极，守静笃。",
          "translation": "致虚到极点，守静到笃实。"
        },
        {
          "original": "万物并作，吾以观复。",
          "translation": "万物一齐生长，我借此观察它们的循环往复。"
        },
        {
          "original": "夫物芸芸，各复归其根。归根曰静，是谓复命。复命曰常，",
          "translation": "万物纷纷纭纭，各自返回其根源。返回根源叫做静，这就叫复归本命。复归本命叫做常，"
        },
        {
          "original": "知常曰明。不知常，妄作凶。",
          "translation": "认识常道叫做明。不认识常道，轻举妄动就会招致凶险。"
        },
        {
          "original": "知常容，",
          "translation": "认识常道才能包容，"
        },
        {
          "original": "容乃公，",
          "translation": "能包容才能公正，"
        },
        {
          "original": "公乃全，",
          "translation": "能公正才能周全，"
        },
        {
          "original": "全乃天，",
          "translation": "能周全才能合于天，"
        },
        {
          "original": "天乃道，",
          "translation": "合于天才能合于道，"
        },
        {
          "original": "道乃久，",
          "translation": "合于道才能长久，"
        },
        {
          "original": "没身不殆。",
          "translation": "终身不会遭遇危殆。"
        }
      ]
    },
    {
      "no": 17,
      "title": "十七章",
      "paragraphs": [
        {
          "original": "太上，下知有之，",
          "translation": "最好的统治者，民众只知道有他存在；"
        },
        {
          "original": "其次，亲而誉之，",
          "translation": "次一等的，民众亲近而称誉他；"
        },
        {
          "original": "其次，畏之，",
          "translation": "再次的，民众畏惧他；"
        },
        {
          "original": "其次，侮之。",
          "translation": "最次的，民众轻侮他。"
        },
        {
          "original": "信不足焉，有不信焉。",
          "translation": "统治者诚信不足，民众自然不信任他。"
        },
        {
          "original": "悠兮其贵言，功成事遂，百姓皆谓：我自然。",
          "translation": "悠然啊他不轻易发号施令，功成事就之后，百姓都说：我们本来就是这样的。"
        }
      ]
    },
    {
      "no": 18,
      "title": "十八章",
      "paragraphs": [
        {
          "original": "大道废，有仁义；",
          "translation": "大道废弃了，才提倡仁义；"
        },
        {
          "original": "智慧出，有大伪；",
          "translation": "智巧出现了，才有严重的虚伪；"
        },
        {
          "original": "六亲不和，有孝慈；国家昏乱，有忠臣。",
          "translation": "家庭六亲不和，才显出孝慈；国家昏乱，才出现忠臣。"
        }
      ]
    },
    {
      "no": 19,
      "title": "十九章",
      "paragraphs": [
        {
          "original": "绝圣弃智，民利百倍；绝仁弃义，民复孝慈；绝巧弃利，盗贼无有。此三者以为文不足，故令有所属﹕见素抱朴，少私寡欲。",
          "translation": "弃绝圣智之名，民众获利百倍；弃绝仁义之名，民众复归孝慈；弃绝机巧货利，盗贼无从产生。这三句话作为文治纲领还不够，所以要让人有所归依：表现单纯、持守质朴，减少私心、降低欲望。"
        }
      ]
    },
    {
      "no": 20,
      "title": "二十章",
      "paragraphs": [
        {
          "original": "绝学无忧，唯之与阿，相去几何？善之与恶，相去若何？人之所畏，不可不畏。",
          "translation": "弃绝俗学就没有忧愁。应诺与呵斥，相差多少？善与恶，相差几何？人们所畏惧的，不能不畏惧。"
        },
        {
          "original": "荒兮其未央哉﹗",
          "translation": "茫茫无边啊，没有尽头！"
        },
        {
          "original": "众人熙熙，如享太牢，如春登台。",
          "translation": "众人熙熙攘攘，像赴丰盛的筵席，像春日登台揽胜。"
        },
        {
          "original": "我独泊兮其未兆，如婴儿之未孩；",
          "translation": "唯独我淡泊宁静无动于衷，像还不会笑的婴儿；"
        },
        {
          "original": "儽儽兮若无所归。",
          "translation": "疲倦闲散啊，像无家可归。"
        },
        {
          "original": "众人皆有余，而我独若遗。",
          "translation": "众人都有富余，唯独我像有所遗失。"
        },
        {
          "original": "我愚人之心也哉﹗",
          "translation": "我真是愚人的心肠啊！"
        },
        {
          "original": "沌沌兮，",
          "translation": "混混沌沌的，"
        },
        {
          "original": "俗人昭昭，",
          "translation": "世人都光耀自炫，"
        },
        {
          "original": "我独昏昏。俗人察察，",
          "translation": "唯独我昏昏昧昧。世人都精明审察，"
        },
        {
          "original": "我独闷闷。澹兮其若海，",
          "translation": "唯独我浑噩无所识别。沉静恬淡啊像大海，"
        },
        {
          "original": "飂兮若无止。",
          "translation": "飘逸无系啊像没有止境。"
        },
        {
          "original": "众人皆有以，",
          "translation": "众人都有所施展，"
        },
        {
          "original": "而我独顽似鄙。",
          "translation": "唯独我愚顽而鄙陋。"
        },
        {
          "original": "我独异于人，而贵食母。",
          "translation": "唯独我与众人不同，看重的是受养于道这个根本。"
        }
      ]
    },
    {
      "no": 21,
      "title": "二十一章",
      "paragraphs": [
        {
          "original": "孔德之容，惟道是从。",
          "translation": null
        },
        {
          "original": "道之为物，惟恍惟惚。",
          "translation": null
        },
        {
          "original": "惚兮恍兮，其中有象；恍兮惚兮，其中有物。",
          "translation": null
        },
        {
          "original": "窈兮冥兮，其中有精；",
          "translation": null
        },
        {
          "original": "其精甚真，其中有信。",
          "translation": null
        },
        {
          "original": "自今及古，其名不去，",
          "translation": null
        },
        {
          "original": "以阅众甫。",
          "translation": null
        },
        {
          "original": "吾何以知众甫之状哉？以此。",
          "translation": null
        }
      ]
    },
    {
      "no": 22,
      "title": "二十二章",
      "paragraphs": [
        {
          "original": "曲则全，",
          "translation": null
        },
        {
          "original": "枉则直，",
          "translation": null
        },
        {
          "original": "洼则盈，",
          "translation": null
        },
        {
          "original": "敝则新，",
          "translation": null
        },
        {
          "original": "少则得，多则惑。",
          "translation": null
        },
        {
          "original": "是以圣人抱一为天下式。",
          "translation": null
        },
        {
          "original": "不自见故明，不自是故彰，不自伐故有功，不自矜故长。夫唯不争，故天下莫能与之争。古之所谓曲则全者，岂虚言哉！诚全而归之。",
          "translation": null
        }
      ]
    },
    {
      "no": 23,
      "title": "二十三章",
      "paragraphs": [
        {
          "original": "希言自然。",
          "translation": null
        },
        {
          "original": "故飘风不终朝，骤雨不终日。孰为此者？天地。天地尚不能久，而况于人乎？",
          "translation": null
        },
        {
          "original": "故从事于道者，道者同于道，",
          "translation": null
        },
        {
          "original": "德者同于德，",
          "translation": null
        },
        {
          "original": "失者同于失。",
          "translation": null
        },
        {
          "original": "同于道者，道亦乐得之；同于德者，德亦乐得之；同于失者，失亦乐得之。",
          "translation": null
        },
        {
          "original": "信不足焉，有不信焉。",
          "translation": null
        }
      ]
    },
    {
      "no": 24,
      "title": "二十四章",
      "paragraphs": [
        {
          "original": "企者不立，",
          "translation": null
        },
        {
          "original": "跨者不行，自见者不明，自是者不彰，自伐者无功，自矜者不长。其在道也，曰余食赘行。",
          "translation": null
        },
        {
          "original": "物或恶之，故有道者不处。",
          "translation": null
        }
      ]
    },
    {
      "no": 25,
      "title": "二十五章",
      "paragraphs": [
        {
          "original": "有物混成，先天地生。",
          "translation": null
        },
        {
          "original": "寂兮寥兮，独立而不改，",
          "translation": null
        },
        {
          "original": "周行而不殆，可以为天下母。",
          "translation": null
        },
        {
          "original": "吾不知其名，",
          "translation": null
        },
        {
          "original": "字之曰道，",
          "translation": null
        },
        {
          "original": "强为之名曰大。",
          "translation": null
        },
        {
          "original": "大曰逝，",
          "translation": null
        },
        {
          "original": "逝曰远，远曰反。",
          "translation": null
        },
        {
          "original": "故道大，天大，地大，王亦大。",
          "translation": null
        },
        {
          "original": "域中有四大，",
          "translation": null
        },
        {
          "original": "而王居其一焉。",
          "translation": null
        },
        {
          "original": "人法地，地法天，天法道，道法自然。",
          "translation": null
        }
      ]
    },
    {
      "no": 26,
      "title": "二十六章",
      "paragraphs": [
        {
          "original": "重为轻根，静为躁君。",
          "translation": null
        },
        {
          "original": "是以圣人终日行不离辎重。",
          "translation": null
        },
        {
          "original": "虽有荣观，燕处超然。",
          "translation": null
        },
        {
          "original": "奈何万乘之主，而以身轻天下？轻则失本，躁则失君。",
          "translation": null
        }
      ]
    },
    {
      "no": 27,
      "title": "二十七章",
      "paragraphs": [
        {
          "original": "善行无辙迹，",
          "translation": null
        },
        {
          "original": "善言无瑕讁；",
          "translation": null
        },
        {
          "original": "善数不用筹策；",
          "translation": null
        },
        {
          "original": "善闭无关楗而不可开，善结无绳约而不可解。",
          "translation": null
        },
        {
          "original": "是以圣人常善救人，故无弃人；",
          "translation": null
        },
        {
          "original": "常善救物，故无弃物，是谓袭明。故善人者，不善人之师；",
          "translation": null
        },
        {
          "original": "不善人者，善人之资。",
          "translation": null
        },
        {
          "original": "不贵其师，不爱其资，虽智大迷，",
          "translation": null
        },
        {
          "original": "是谓要妙。",
          "translation": null
        }
      ]
    },
    {
      "no": 28,
      "title": "二十八章",
      "paragraphs": [
        {
          "original": "知其雄，守其雌，为天下谿。为天下谿，常德不离，复归于婴儿。",
          "translation": null
        },
        {
          "original": "知其白，守其黑，为天下式。",
          "translation": null
        },
        {
          "original": "为天下式，常德不忒，",
          "translation": null
        },
        {
          "original": "复归于无极。",
          "translation": null
        },
        {
          "original": "知其荣，守其辱，为天下谷，常德乃足，复归于朴。",
          "translation": null
        },
        {
          "original": "朴散则为器，圣人用之，则为官长，",
          "translation": null
        },
        {
          "original": "故大制不割。",
          "translation": null
        }
      ]
    },
    {
      "no": 29,
      "title": "二十九章",
      "paragraphs": [
        {
          "original": "将欲取天下而为之，吾见其不得已。天下神器，",
          "translation": null
        },
        {
          "original": "不可为也，为者败之，执者失之。",
          "translation": null
        },
        {
          "original": "故物或行或随，或歔或吹。或强或羸，或挫或隳。是以圣人去甚，去奢，去泰。",
          "translation": null
        }
      ]
    },
    {
      "no": 30,
      "title": "三十章",
      "paragraphs": [
        {
          "original": "以道佐人主者，不以兵强天下。",
          "translation": null
        },
        {
          "original": "其事好还。",
          "translation": null
        },
        {
          "original": "师之所处，荆棘生焉。大军之后，必有凶年。",
          "translation": null
        },
        {
          "original": "善有果而已，不敢以取强。",
          "translation": null
        },
        {
          "original": "果而勿矜，果而勿伐，果而勿骄。",
          "translation": null
        },
        {
          "original": "果而不得已，果而勿强。",
          "translation": null
        },
        {
          "original": "物壮则老，是谓不道，不道早已。",
          "translation": null
        }
      ]
    },
    {
      "no": 31,
      "title": "三十一章",
      "paragraphs": [
        {
          "original": "夫佳兵者，不祥之器，物或恶之，故有道者不处。君子居则贵左，用兵则贵右。兵者不祥之器，非君子之器，不得已而用之，恬淡为上。胜而不美，而美之者，是乐杀人。夫乐杀人者，则不可以得志于天下矣。吉事尚左，凶事尚右。偏将军居左，上将军居右，言以丧礼处之。杀人之众，以哀悲泣之，战胜，以丧礼处之。",
          "translation": null
        }
      ]
    },
    {
      "no": 32,
      "title": "三十二章",
      "paragraphs": [
        {
          "original": "道常无名，朴虽小，天下莫能臣也。侯王若能守之，万物将自宾。",
          "translation": null
        },
        {
          "original": "天地相合，以降甘露，民莫之令而自均。",
          "translation": null
        },
        {
          "original": "始制有名，名亦既有，夫亦将知止，知止所以不殆。",
          "translation": null
        },
        {
          "original": "譬道之在天下，犹川谷之于江海。",
          "translation": null
        }
      ]
    },
    {
      "no": 33,
      "title": "三十三章",
      "paragraphs": [
        {
          "original": "知人者智，自知者明。",
          "translation": null
        },
        {
          "original": "胜人者有力，自胜者强。",
          "translation": null
        },
        {
          "original": "知足者富。",
          "translation": null
        },
        {
          "original": "强行者有志。",
          "translation": null
        },
        {
          "original": "不失其所者久。",
          "translation": null
        },
        {
          "original": "死而不亡者寿。",
          "translation": null
        }
      ]
    },
    {
      "no": 34,
      "title": "三十四章",
      "paragraphs": [
        {
          "original": "大道泛兮，其可左右。",
          "translation": null
        },
        {
          "original": "万物恃之而生而不辞，功成不名有。衣养万物而不为主，常无欲，可名于小；",
          "translation": null
        },
        {
          "original": "万物归焉而不为主，可名为大。",
          "translation": null
        },
        {
          "original": "以其终不自为大，故能成其大。",
          "translation": null
        }
      ]
    },
    {
      "no": 35,
      "title": "三十五章",
      "paragraphs": [
        {
          "original": "执大象，天下往。",
          "translation": null
        },
        {
          "original": "往而不害，安平太。",
          "translation": null
        },
        {
          "original": "乐与饵，过客止。道之出口，淡乎其无味，视之不足见，听之不足闻，用之不足既。",
          "translation": null
        }
      ]
    },
    {
      "no": 36,
      "title": "三十六章",
      "paragraphs": [
        {
          "original": "将欲歙之，必固张之；将欲弱之，必固强之；将欲废之，必固兴之；将欲夺之，必固与之。是谓微明。",
          "translation": null
        },
        {
          "original": "柔弱胜刚强。鱼不可脱于渊，国之利器不可以示人。",
          "translation": null
        }
      ]
    },
    {
      "no": 37,
      "title": "三十七章",
      "paragraphs": [
        {
          "original": "道常无为",
          "translation": null
        },
        {
          "original": "而无不为。",
          "translation": null
        },
        {
          "original": "侯王若能守之，万物将自化。化而欲作，吾将镇之以无名之朴。",
          "translation": null
        },
        {
          "original": "无名之朴，夫亦将无欲。",
          "translation": null
        },
        {
          "original": "不欲以静，天下将自定。",
          "translation": null
        }
      ]
    },
    {
      "no": 38,
      "title": "三十八章",
      "paragraphs": [
        {
          "original": "上德不德，是以有德；下德不失德，是以无德。上德无为而无以为，下德为之而有以为。上仁为之而无以为，上义为之而有以为。上礼为之而莫之应， 则攘臂而扔之。故失道而后德，失德而后仁，失仁而后义，失义而后礼。夫礼者，忠信之薄，而乱之首。前识者，道之华，而愚之始。是以大丈夫处其厚，不居其薄；处其实，不居其华。故去彼取此。",
          "translation": null
        }
      ]
    },
    {
      "no": 39,
      "title": "三十九章",
      "paragraphs": [
        {
          "original": "昔之得一者，",
          "translation": null
        },
        {
          "original": "天得一以清，地得一以宁，神得一以灵，谷得一以盈，万物得一以生，侯王得一以为天下贞。其致之，",
          "translation": null
        },
        {
          "original": "天无以清将恐裂，",
          "translation": null
        },
        {
          "original": "地无以宁将恐发，神无以灵将恐歇，谷无以盈将恐竭，万物无以生将恐灭，侯王无以贵高将恐蹶。故贵以贱为本，高以下为基。是以侯王自称孤﹑寡﹑不谷。此非以贱为本邪？非乎？故致数舆无舆，不欲琭琭如玉，珞珞如石。",
          "translation": null
        }
      ]
    },
    {
      "no": 40,
      "title": "四十章",
      "paragraphs": [
        {
          "original": "反者道之动，",
          "translation": null
        },
        {
          "original": "弱者道之用。",
          "translation": null
        },
        {
          "original": "天下万物生于有，有生于无。",
          "translation": null
        }
      ]
    },
    {
      "no": 41,
      "title": "四十一章",
      "paragraphs": [
        {
          "original": "上士闻道，勤而行之；",
          "translation": null
        },
        {
          "original": "中士闻道，若存若亡；下士闻道，大笑之。不笑不足以为道。故建言有之﹕",
          "translation": null
        },
        {
          "original": "明道若昧，",
          "translation": null
        },
        {
          "original": "进道若退，",
          "translation": null
        },
        {
          "original": "夷道若颣，",
          "translation": null
        },
        {
          "original": "上德若谷，",
          "translation": null
        },
        {
          "original": "大白若辱，",
          "translation": null
        },
        {
          "original": "广德若不足，",
          "translation": null
        },
        {
          "original": "建德若偷，",
          "translation": null
        },
        {
          "original": "质真若渝，",
          "translation": null
        },
        {
          "original": "大方无隅，",
          "translation": null
        },
        {
          "original": "大器晚成，",
          "translation": null
        },
        {
          "original": "大音希声，",
          "translation": null
        },
        {
          "original": "大象无形，",
          "translation": null
        },
        {
          "original": "道隐无名。夫唯道，善贷且成。",
          "translation": null
        }
      ]
    },
    {
      "no": 42,
      "title": "四十二章",
      "paragraphs": [
        {
          "original": "道生一，一生二，二生三，三生万物。万物负阴而抱阳，冲气以为和。人之所恶，唯孤﹑寡﹑不谷，而王公以为称。故物或损之而益，或益之而损。",
          "translation": null
        },
        {
          "original": "人之所教，我亦教之。",
          "translation": null
        },
        {
          "original": "强梁者不得其死，吾将以为教父。",
          "translation": null
        }
      ]
    },
    {
      "no": 43,
      "title": "四十三章",
      "paragraphs": [
        {
          "original": "天下之至柔，驰骋天下之至坚。",
          "translation": null
        },
        {
          "original": "无有入无间，吾是以知无为之有益。",
          "translation": null
        },
        {
          "original": "不言之教，无为之益，天下希及之。",
          "translation": null
        }
      ]
    },
    {
      "no": 44,
      "title": "四十四章",
      "paragraphs": [
        {
          "original": "名与身孰亲？",
          "translation": null
        },
        {
          "original": "身与货孰多？",
          "translation": null
        },
        {
          "original": "得与亡孰病？",
          "translation": null
        },
        {
          "original": "是故甚爱必大费，多藏必厚亡，",
          "translation": null
        },
        {
          "original": "知足不辱，知止不殆，可以长久。",
          "translation": null
        }
      ]
    },
    {
      "no": 45,
      "title": "四十五章",
      "paragraphs": [
        {
          "original": "大成若缺，其用不弊。",
          "translation": null
        },
        {
          "original": "大盈若冲，其用不穷。",
          "translation": null
        },
        {
          "original": "大直若屈，其用不居。",
          "translation": null
        },
        {
          "original": "大巧若拙，其用不辍。",
          "translation": null
        },
        {
          "original": "大辩若讷，其用不差。",
          "translation": null
        },
        {
          "original": "躁胜寒，静胜热。清静为天下正。",
          "translation": null
        }
      ]
    },
    {
      "no": 46,
      "title": "四十六章",
      "paragraphs": [
        {
          "original": "天下有道，却走马以粪。",
          "translation": null
        },
        {
          "original": "天下无道，戎马生于郊。",
          "translation": null
        },
        {
          "original": "祸莫大于不知足；咎莫大于欲得。故知足之足，常足矣。",
          "translation": null
        }
      ]
    },
    {
      "no": 47,
      "title": "四十七章",
      "paragraphs": [
        {
          "original": "不出户，知天下；不闚牖，见天道。",
          "translation": null
        },
        {
          "original": "其出弥远，其知弥少。",
          "translation": null
        },
        {
          "original": "是以圣人不行而知，不见而名，",
          "translation": null
        },
        {
          "original": "不为而成。",
          "translation": null
        }
      ]
    },
    {
      "no": 48,
      "title": "四十八章",
      "paragraphs": [
        {
          "original": "为学日益，",
          "translation": null
        },
        {
          "original": "为道日损。",
          "translation": null
        },
        {
          "original": "损之又损，以至于无为。无为而无不为。",
          "translation": null
        },
        {
          "original": "取天下常以无事，",
          "translation": null
        },
        {
          "original": "及其有事，",
          "translation": null
        },
        {
          "original": "不足以取天下。",
          "translation": null
        }
      ]
    },
    {
      "no": 49,
      "title": "四十九章",
      "paragraphs": [
        {
          "original": "圣人无常心，以百姓心为心。",
          "translation": null
        },
        {
          "original": "善者，吾善之；不善者，吾亦善之，",
          "translation": null
        },
        {
          "original": "德善。",
          "translation": null
        },
        {
          "original": "信者，吾信之；不信者，吾亦信之，德信。圣人在天下歙歙，为天下浑其心，",
          "translation": null
        },
        {
          "original": "百姓皆注其耳目,",
          "translation": null
        },
        {
          "original": "圣人皆孩之。",
          "translation": null
        }
      ]
    },
    {
      "no": 50,
      "title": "五十章",
      "paragraphs": [
        {
          "original": "出生入死。",
          "translation": null
        },
        {
          "original": "生之徒，十有三；死之徒，十有三；人之生，动之死地，亦十有三。夫何故？以其生生之厚。盖闻善摄生者，陆行不遇兕虎，入军不被甲兵；兕无所投其角，虎无所措其爪，兵无所容其刃。夫何故？以其无死地。",
          "translation": null
        }
      ]
    },
    {
      "no": 51,
      "title": "五十一章",
      "paragraphs": [
        {
          "original": "道生之，德畜之，物形之，势成之。",
          "translation": null
        },
        {
          "original": "是以万物莫不尊道而贵德。",
          "translation": null
        },
        {
          "original": "道之尊，德之贵，夫莫之命而常自然。",
          "translation": null
        },
        {
          "original": "故道生之，德畜之。长之育之，亭之毒之，盖之覆之。",
          "translation": null
        },
        {
          "original": "生而不有，为而不恃，",
          "translation": null
        },
        {
          "original": "长而不宰。是谓玄德。",
          "translation": null
        }
      ]
    },
    {
      "no": 52,
      "title": "五十二章",
      "paragraphs": [
        {
          "original": "天下有始，以为天下母。",
          "translation": null
        },
        {
          "original": "既得其母，以知其子，既知其子，复守其母，没身不殆。",
          "translation": null
        },
        {
          "original": "塞其兑，闭其门，",
          "translation": null
        },
        {
          "original": "终身不勤。",
          "translation": null
        },
        {
          "original": "开其兑，济其事，终身不救。",
          "translation": null
        },
        {
          "original": "见小曰明，守柔曰强。",
          "translation": null
        },
        {
          "original": "用其光，",
          "translation": null
        },
        {
          "original": "复归其明，",
          "translation": null
        },
        {
          "original": "无遗身殃，是为习常。",
          "translation": null
        }
      ]
    },
    {
      "no": 53,
      "title": "五十三章",
      "paragraphs": [
        {
          "original": "使我介然有知，行于大道，唯施是畏。",
          "translation": null
        },
        {
          "original": "大道甚夷，而民好径。",
          "translation": null
        },
        {
          "original": "朝甚除，",
          "translation": null
        },
        {
          "original": "田甚芜，仓甚虚；",
          "translation": null
        },
        {
          "original": "服文彩，带利剑，厌饮食，财货有余；是为盗夸。非道也哉！",
          "translation": null
        }
      ]
    },
    {
      "no": 54,
      "title": "五十四章",
      "paragraphs": [
        {
          "original": "善建者不拔，",
          "translation": null
        },
        {
          "original": "善抱者不脱，",
          "translation": null
        },
        {
          "original": "子孙以祭祀不辍。",
          "translation": null
        },
        {
          "original": "修之于身，其德乃真；修之于家，其德乃余；",
          "translation": null
        },
        {
          "original": "修之于乡，其德乃长；修之于国，其德乃丰；修之于天下，其德乃普。故以身观身，以家观家，以乡观乡，以国观国，",
          "translation": null
        },
        {
          "original": "以天下观天下。",
          "translation": null
        },
        {
          "original": "吾何以知天下然哉？以此。",
          "translation": null
        }
      ]
    },
    {
      "no": 55,
      "title": "五十五章",
      "paragraphs": [
        {
          "original": "含德之厚，比于赤子。蜂虿虺蛇不螫，猛兽不据，攫鸟不搏。",
          "translation": null
        },
        {
          "original": "骨弱筋柔而握固。",
          "translation": null
        },
        {
          "original": "未知牝牡之合而全作，",
          "translation": null
        },
        {
          "original": "精之至也。终日号而不嗄，",
          "translation": null
        },
        {
          "original": "和之至也。知和曰常，",
          "translation": null
        },
        {
          "original": "知常曰明。",
          "translation": null
        },
        {
          "original": "益生曰祥。",
          "translation": null
        },
        {
          "original": "心使气曰强。",
          "translation": null
        },
        {
          "original": "物壮则老，谓之不道，不道早已。",
          "translation": null
        }
      ]
    },
    {
      "no": 56,
      "title": "五十六章",
      "paragraphs": [
        {
          "original": "知者不言，",
          "translation": null
        },
        {
          "original": "言者不知。",
          "translation": null
        },
        {
          "original": "塞其兑，闭其门，挫其锐，",
          "translation": null
        },
        {
          "original": "解其分，",
          "translation": null
        },
        {
          "original": "和其光，",
          "translation": null
        },
        {
          "original": "同其尘，",
          "translation": null
        },
        {
          "original": "是谓玄同。故不可得而亲，不可得而疏；",
          "translation": null
        },
        {
          "original": "不可得而利，不可得而害；",
          "translation": null
        },
        {
          "original": "不可得而贵，不可得而贱。",
          "translation": null
        },
        {
          "original": "故为天下贵。",
          "translation": null
        }
      ]
    },
    {
      "no": 57,
      "title": "五十七章",
      "paragraphs": [
        {
          "original": "以正治国，以奇用兵，以无事取天下。",
          "translation": null
        },
        {
          "original": "吾何以知其然哉？以此。天下多忌讳，而民弥贫；民多利器，国家滋昬；",
          "translation": null
        },
        {
          "original": "人多伎巧，奇物滋起；",
          "translation": null
        },
        {
          "original": "法令滋彰，盗贼多有。",
          "translation": null
        },
        {
          "original": "故圣人云﹕「我无为而民自化，我好静而民自正，我无事而民自富，我无欲而民自朴。」",
          "translation": null
        }
      ]
    },
    {
      "no": 58,
      "title": "五十八章",
      "paragraphs": [
        {
          "original": "其政闷闷，其民淳淳；",
          "translation": null
        },
        {
          "original": "其政察察，其民缺缺。",
          "translation": null
        },
        {
          "original": "祸兮福之所倚，福兮祸之所伏。孰知其极？其无正。",
          "translation": null
        },
        {
          "original": "正复为奇，",
          "translation": null
        },
        {
          "original": "善复为妖。",
          "translation": null
        },
        {
          "original": "人之迷，其日固久。",
          "translation": null
        },
        {
          "original": "是以圣人方而不割，",
          "translation": null
        },
        {
          "original": "廉而不刿，",
          "translation": null
        },
        {
          "original": "直而不肆，",
          "translation": null
        },
        {
          "original": "光而不燿。",
          "translation": null
        }
      ]
    },
    {
      "no": 59,
      "title": "五十九章",
      "paragraphs": [
        {
          "original": "治人事天，莫若啬。",
          "translation": null
        },
        {
          "original": "夫唯啬，是谓早服；",
          "translation": null
        },
        {
          "original": "早服谓之重积德；",
          "translation": null
        },
        {
          "original": "重积德则无不克，无不克则莫知其极；",
          "translation": null
        },
        {
          "original": "莫知其极，可以有国；",
          "translation": null
        },
        {
          "original": "有国之母，可以长久；",
          "translation": null
        },
        {
          "original": "是谓深根固柢，长生久视之道。",
          "translation": null
        }
      ]
    },
    {
      "no": 60,
      "title": "六十章",
      "paragraphs": [
        {
          "original": "治大国，若烹小鲜。",
          "translation": null
        },
        {
          "original": "以道莅天下，其鬼不神；",
          "translation": null
        },
        {
          "original": "非其鬼不神，其神不伤人；",
          "translation": null
        },
        {
          "original": "非其神不伤人，圣人亦不伤人。",
          "translation": null
        },
        {
          "original": "夫两不相伤，故德交归焉。",
          "translation": null
        }
      ]
    },
    {
      "no": 61,
      "title": "六十一章",
      "paragraphs": [
        {
          "original": "大国者下流，",
          "translation": null
        },
        {
          "original": "天下之交。",
          "translation": null
        },
        {
          "original": "天下之牝，",
          "translation": null
        },
        {
          "original": "牝常以静胜牡，以静为下。",
          "translation": null
        },
        {
          "original": "故大国以下小国，",
          "translation": null
        },
        {
          "original": "则取小国；",
          "translation": null
        },
        {
          "original": "小国以下大国，则取大国。",
          "translation": null
        },
        {
          "original": "故或下以取，或下而取。",
          "translation": null
        },
        {
          "original": "大国不过欲兼畜人，小国不过欲入事人。夫两者各得其所欲，大者宜为下。",
          "translation": null
        }
      ]
    },
    {
      "no": 62,
      "title": "六十二章",
      "paragraphs": [
        {
          "original": "道者万物之奥。",
          "translation": null
        },
        {
          "original": "善人之宝，",
          "translation": null
        },
        {
          "original": "不善人之所保。",
          "translation": null
        },
        {
          "original": "美言可以市，尊行可以加人。",
          "translation": null
        },
        {
          "original": "人之不善，何弃之有？",
          "translation": null
        },
        {
          "original": "故立天子，置三公，",
          "translation": null
        },
        {
          "original": "虽有拱璧以先驷马，不如坐进此道。",
          "translation": null
        },
        {
          "original": "古之所以贵此道者何？不曰以求得，有罪以免邪？故为天下贵。",
          "translation": null
        }
      ]
    },
    {
      "no": 63,
      "title": "六十三章",
      "paragraphs": [
        {
          "original": "为无为，事无事，味无味。",
          "translation": null
        },
        {
          "original": "大小多少，报怨以德。",
          "translation": null
        },
        {
          "original": "图难于其易，为大于其细；天下难事必作于易，天下大事必作于细。是以圣人终不为大，故能成其大。夫轻诺必寡信，多易必多难。是以圣人犹难之，",
          "translation": null
        },
        {
          "original": "故终无难矣",
          "translation": null
        }
      ]
    },
    {
      "no": 64,
      "title": "六十四章",
      "paragraphs": [
        {
          "original": "其安易持，其未兆易谋。",
          "translation": null
        },
        {
          "original": "其脆易泮，其微易散。",
          "translation": null
        },
        {
          "original": "为之于未有，",
          "translation": null
        },
        {
          "original": "治之于未乱。",
          "translation": null
        },
        {
          "original": "合抱之木，生于毫末；九层之台，起于累土；千里之行，始于足下。为者败之，执者失之。",
          "translation": null
        },
        {
          "original": "是以圣人无为故无败，无执故无失。民之从事，常于几成而败之。",
          "translation": null
        },
        {
          "original": "慎终如始，则无败事。是以圣人欲不欲，不贵难得之货；",
          "translation": null
        },
        {
          "original": "学不学，复众人之所过。",
          "translation": null
        },
        {
          "original": "以辅万物之自然，而不敢为。",
          "translation": null
        }
      ]
    },
    {
      "no": 65,
      "title": "六十五章",
      "paragraphs": [
        {
          "original": "古之善为道者，非以明民，将以愚之。",
          "translation": null
        },
        {
          "original": "民之难治，以其智多。",
          "translation": null
        },
        {
          "original": "故以智治国，国之贼，",
          "translation": null
        },
        {
          "original": "不以智治国，国之福。知此两者亦稽式。常知稽式，是谓玄德。玄德深矣，远矣，",
          "translation": null
        },
        {
          "original": "与物反矣，",
          "translation": null
        },
        {
          "original": "然后乃至大顺。",
          "translation": null
        }
      ]
    },
    {
      "no": 66,
      "title": "六十六章",
      "paragraphs": [
        {
          "original": "江海所以能为百谷王者，以其善下之，故能为百谷王。是以欲上民，必以言下之。欲先民，必以身后之。是以圣人处上而民不重，处前而民不害。是以天下乐推而不厌，以其不争，故天下莫能与之争。",
          "translation": null
        }
      ]
    },
    {
      "no": 67,
      "title": "六十七章",
      "paragraphs": [
        {
          "original": "天下皆谓我道大，似不肖。夫唯大，故似不肖。若肖，久矣其细也夫！",
          "translation": null
        },
        {
          "original": "我有三宝，持而保之。一曰慈，二曰俭，三曰不敢为天下先。",
          "translation": null
        },
        {
          "original": "慈故能勇，",
          "translation": null
        },
        {
          "original": "俭故能广，",
          "translation": null
        },
        {
          "original": "不敢为天下先，故能成器长。",
          "translation": null
        },
        {
          "original": "今舍慈且勇，",
          "translation": null
        },
        {
          "original": "舍俭且广，舍后且先，死矣！",
          "translation": null
        },
        {
          "original": "夫慈以战则胜，",
          "translation": null
        },
        {
          "original": "以守则固。天将救之，以慈卫之。",
          "translation": null
        }
      ]
    },
    {
      "no": 68,
      "title": "六十八章",
      "paragraphs": [
        {
          "original": "善为士者不武，",
          "translation": null
        },
        {
          "original": "善战者不怒，",
          "translation": null
        },
        {
          "original": "善胜敌者不与，",
          "translation": null
        },
        {
          "original": "善用人者为之下，是谓不争之德，是谓用人之力，",
          "translation": null
        },
        {
          "original": "是谓配天古之极。",
          "translation": null
        }
      ]
    },
    {
      "no": 69,
      "title": "六十九章",
      "paragraphs": [
        {
          "original": "用兵有言﹕「吾不敢为主而为客，不敢进寸而退尺。」是谓行无行，",
          "translation": null
        },
        {
          "original": "攘无臂，扔无敌，",
          "translation": null
        },
        {
          "original": "执无兵。",
          "translation": null
        },
        {
          "original": "祸莫大于轻敌，轻敌几丧吾宝。",
          "translation": null
        },
        {
          "original": "故抗兵相加，哀者胜矣。",
          "translation": null
        }
      ]
    },
    {
      "no": 70,
      "title": "七十章",
      "paragraphs": [
        {
          "original": "吾言甚易知，甚易行。天下莫能知，莫能行。",
          "translation": null
        },
        {
          "original": "言有宗，事有君。",
          "translation": null
        },
        {
          "original": "夫唯无知，是以不我知。",
          "translation": null
        },
        {
          "original": "知我者希，则我者贵。",
          "translation": null
        },
        {
          "original": "是以圣人被褐怀玉。",
          "translation": null
        }
      ]
    },
    {
      "no": 71,
      "title": "七十一章",
      "paragraphs": [
        {
          "original": "知不知上，不知知病。",
          "translation": null
        },
        {
          "original": "夫唯病病，是以不病。圣人不病，以其病病，是以不病。",
          "translation": null
        }
      ]
    },
    {
      "no": 72,
      "title": "七十二章",
      "paragraphs": [
        {
          "original": "民不畏威，则大威至。无狎其所居，无厌其所生。",
          "translation": null
        },
        {
          "original": "夫唯不厌，",
          "translation": null
        },
        {
          "original": "是以不厌。",
          "translation": null
        },
        {
          "original": "是以圣人自知不自见，",
          "translation": null
        },
        {
          "original": "自爱不自贵；",
          "translation": null
        },
        {
          "original": "故去彼取此。",
          "translation": null
        }
      ]
    },
    {
      "no": 73,
      "title": "七十三章",
      "paragraphs": [
        {
          "original": "勇于敢则杀，",
          "translation": null
        },
        {
          "original": "勇于不敢则活。",
          "translation": null
        },
        {
          "original": "此两者，或利或害。",
          "translation": null
        },
        {
          "original": "天之所恶，孰知其故？是以圣人犹难之。",
          "translation": null
        },
        {
          "original": "天之道，不争而善胜，",
          "translation": null
        },
        {
          "original": "不言而善应，",
          "translation": null
        },
        {
          "original": "不召而自来，",
          "translation": null
        },
        {
          "original": "𦈎然而善谋。",
          "translation": null
        },
        {
          "original": "天网恢恢，疏而不失。",
          "translation": null
        }
      ]
    },
    {
      "no": 74,
      "title": "七十四章",
      "paragraphs": [
        {
          "original": "民不畏死，奈何以死惧之？若使民常畏死，而为奇者，吾得执而杀之，孰敢？",
          "translation": null
        },
        {
          "original": "常有司杀者杀，夫代司杀者杀，是谓代大匠斲。",
          "translation": null
        },
        {
          "original": "夫代大匠斲者，希有不伤其手矣。",
          "translation": null
        }
      ]
    },
    {
      "no": 75,
      "title": "七十五章",
      "paragraphs": [
        {
          "original": "民之饥，以其上食税之多，是以饥。民之难治，以其上之有为，是以难治。民之轻死，以其上求生之厚，是以轻死。夫唯无以生为者，是贤于贵生。",
          "translation": null
        }
      ]
    },
    {
      "no": 76,
      "title": "七十六章",
      "paragraphs": [
        {
          "original": "人之生也柔弱，其死也坚强。",
          "translation": null
        },
        {
          "original": "万物草木之生也柔脆，其死也枯槁。",
          "translation": null
        },
        {
          "original": "故坚强者死之徒，柔弱者生之徒。",
          "translation": null
        },
        {
          "original": "是以兵强则不胜，",
          "translation": null
        },
        {
          "original": "木强则兵。",
          "translation": null
        },
        {
          "original": "强大处下，",
          "translation": null
        },
        {
          "original": "柔弱处上。",
          "translation": null
        }
      ]
    },
    {
      "no": 77,
      "title": "七十七章",
      "paragraphs": [
        {
          "original": "天之道，其犹张弓与？高者抑之，下者举之；有余者损之，不足者补之。天之道，损有余而补不足。",
          "translation": null
        },
        {
          "original": "人之道则不然，",
          "translation": null
        },
        {
          "original": "损不足以奉有余。",
          "translation": null
        },
        {
          "original": "孰能有余以奉天下？唯有道者。",
          "translation": null
        },
        {
          "original": "是以圣人为而不恃，功成而不处，其不欲见贤。",
          "translation": null
        }
      ]
    },
    {
      "no": 78,
      "title": "七十八章",
      "paragraphs": [
        {
          "original": "天下莫柔弱于水，而攻坚强者，莫之能胜，其无以易之。",
          "translation": null
        },
        {
          "original": "弱之胜强，柔之胜刚，天下莫不知莫能行。是以圣人云﹕「受国之垢，是谓社稷主；受国不祥，是为天下王。」正言若反。",
          "translation": null
        }
      ]
    },
    {
      "no": 79,
      "title": "七十九章",
      "paragraphs": [
        {
          "original": "和大怨，必有余怨，",
          "translation": null
        },
        {
          "original": "安可以为善？是以圣人执左契，",
          "translation": null
        },
        {
          "original": "而不责于人。有德司契，",
          "translation": null
        },
        {
          "original": "无德司彻。",
          "translation": null
        },
        {
          "original": "天道无亲，常与善人。",
          "translation": null
        }
      ]
    },
    {
      "no": 80,
      "title": "八十章",
      "paragraphs": [
        {
          "original": "小国寡民，",
          "translation": null
        },
        {
          "original": "使有什伯之器而不用，",
          "translation": null
        },
        {
          "original": "使民重死而不远徙。",
          "translation": null
        },
        {
          "original": "虽有舟舆，无所乘之；虽有甲兵，无所陈之。",
          "translation": null
        },
        {
          "original": "使人复结绳而用之，甘其食，美其服，安其居，乐其俗。邻国相望，鸡犬之声相闻，民至老死，不相往来。",
          "translation": null
        }
      ]
    },
    {
      "no": 81,
      "title": "八十一章",
      "paragraphs": [
        {
          "original": "信言不美，",
          "translation": null
        },
        {
          "original": "美言不信。",
          "translation": null
        },
        {
          "original": "善者不辩，辩者不善。",
          "translation": null
        },
        {
          "original": "知者不博，",
          "translation": null
        },
        {
          "original": "博者不知。",
          "translation": null
        },
        {
          "original": "圣人不积，",
          "translation": null
        },
        {
          "original": "既以为人己愈有，",
          "translation": null
        },
        {
          "original": "既以与人己愈多。",
          "translation": null
        },
        {
          "original": "天之道，利而不害；",
          "translation": null
        },
        {
          "original": "圣人之道，为而不争。",
          "translation": null
        }
      ]
    }
  ]
}
