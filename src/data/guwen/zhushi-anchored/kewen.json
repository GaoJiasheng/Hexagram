{
  "1": {
    "0": [
      {
        "term": "谢太傅",
        "note": "谢安，字安石，东晋名臣，卒后追赠太傅，故称。"
      },
      {
        "term": "内集",
        "note": "把家里人聚集在一起。内，家内。"
      },
      {
        "term": "胡儿",
        "note": "谢朗的小名，谢安次兄谢据之子。"
      },
      {
        "term": "无奕女",
        "note": "谢奕字无奕，谢安长兄；其女即谢道韫。"
      }
    ]
  },
  "2": {
    "0": [
      {
        "term": "陈太丘",
        "note": "陈寔，字仲弓，东汉颍川许县人，曾任太丘县长，故称。"
      },
      {
        "term": "元方",
        "note": "陈纪，字元方，陈寔长子，与父及弟陈谌并有高名。"
      },
      {
        "term": "尊君在不",
        "note": "尊君，敬称对方父亲，下文「家君」则谦称己父；不，同「否」。"
      },
      {
        "term": "相委而去",
        "note": "委，舍弃；相，偏指一方，此指丢下我。"
      }
    ]
  },
  "3": {
    "0": [
      {
        "term": "澹泊",
        "reading": "dàn bó",
        "note": "同「淡泊」，恬淡寡欲、不慕名利。课本作「淡泊」。"
      },
      {
        "term": "慆慢",
        "reading": "tāo màn",
        "note": "怠惰放纵。慆，怠慢；慢，懈怠。课本作「淫慢」。"
      },
      {
        "term": "险躁",
        "note": "轻薄浮躁。险，轻佻不稳；躁，急躁。"
      },
      {
        "term": "接世",
        "note": "与社会相接，为世所用。"
      }
    ]
  },
  "4": {
    "0": [
      {
        "term": "缀行",
        "reading": "zhuì",
        "note": "缀，连接。缀行谓紧跟着走，前后相连不断。"
      },
      {
        "term": "苫蔽成丘",
        "reading": "shàn",
        "note": "苫，用草帘、席子等覆盖。苫蔽，遮盖；谓柴草堆遮盖起来像小山。"
      },
      {
        "term": "洞其中，意将隧入",
        "note": "洞，打洞；隧，挖通道。二字皆名词用作动词。"
      },
      {
        "term": "止露尻尾",
        "reading": "kāo",
        "note": "尻，屁股。止，通「只」，上文「止有剩骨」同。"
      }
    ]
  },
  "5": {
    "0": [
      {
        "term": "溉汲",
        "reading": "gài jí",
        "note": "溉，浇灌；汲，打水。出溉汲，谓出门打水浇田。"
      },
      {
        "term": "国人",
        "note": "居住在国都里的人。先秦「国」多指都城。"
      },
      {
        "term": "闻之于宋君",
        "note": "闻，使……听到。谓此事传到了宋君耳中。"
      },
      {
        "term": "求能之若此",
        "note": "课本作「求闻之若此」。一说「能」为「闻」之误，谓像这样求得传闻。"
      }
    ]
  },
  "6": {
    "0": [
      {
        "term": "当涂",
        "note": "当道，指身居要职、掌握权柄。涂，通「途」。"
      },
      {
        "term": "博士",
        "note": "官名。汉武帝置五经博士，专掌经学传授的学官。"
      },
      {
        "term": "寻阳",
        "reading": "xún yáng",
        "note": "古县名，汉置，在今湖北黄梅西南，濒临长江。"
      },
      {
        "term": "吴下阿蒙",
        "note": "吴下，吴地；阿，名前昵称词头。指当年学识浅陋的吕蒙。"
      }
    ]
  },
  "7": {
    "0": [
      {
        "term": "陈康肃公尧咨",
        "note": "陈尧咨，字嘉谟，北宋阆州人，真宗咸平三年进士第一，谥康肃。"
      },
      {
        "term": "自矜",
        "note": "自夸，自以为了不起。矜，夸耀。"
      },
      {
        "term": "睨",
        "reading": "nì",
        "note": "斜着眼看。"
      },
      {
        "term": "颔",
        "reading": "hàn",
        "note": "点头。「微颔之」即微微点头。"
      }
    ],
    "1": [
      {
        "term": "但手熟尔",
        "note": "但，只；尔，同「耳」，罢了。下文「惟手熟尔」同。"
      },
      {
        "term": "杓",
        "reading": "sháo",
        "note": "同「勺」。「酌油沥之」即舀油使之一滴滴注下。"
      },
      {
        "term": "庄生",
        "note": "即庄周。「解牛」出《庄子·养生主》庖丁为文惠君解牛事。"
      },
      {
        "term": "斵轮",
        "reading": "zhuó lún",
        "note": "斵，同「斫」，砍削。出《庄子·天道》轮扁斫轮事。"
      }
    ]
  },
  "8": {
    "0": [
      {
        "term": "蕃",
        "reading": "fán",
        "note": "多。甚蕃，非常多。"
      },
      {
        "term": "濯清涟",
        "reading": "zhuó qīng lián",
        "note": "濯，洗；清涟，水清而有微波，指清水。"
      },
      {
        "term": "亭亭净植",
        "note": "亭亭，耸立的样子；植，立。谓洁净挺直地立着。"
      },
      {
        "term": "亵玩",
        "reading": "xiè wán",
        "note": "亵，亲近而不庄重。亵玩，凑近玩弄，有轻慢之意。"
      }
    ],
    "1": [
      {
        "term": "隐逸者",
        "note": "隐居避世的人。陶渊明辞官归田，爱菊，故以菊为隐逸之花。"
      },
      {
        "term": "噫",
        "reading": "yī",
        "note": "叹词，相当于「唉」。"
      },
      {
        "term": "鲜",
        "reading": "xiǎn",
        "note": "少。鲜有闻，很少听说。"
      },
      {
        "term": "宜乎",
        "note": "当然，应当。宜乎众矣，人当然多了。"
      }
    ]
  },
  "9": {
    "0": [
      {
        "term": "圮",
        "reading": "pǐ",
        "note": "倒塌，坍毁。"
      },
      {
        "term": "木柿",
        "reading": "mù fèi",
        "note": "木片、刨花。柿当作「杮」，音fèi，与柿子之「柿」形近而异，课本作「杮」。"
      },
      {
        "term": "讲学家",
        "note": "讲论程朱理学的儒者，即道学先生。设帐，设馆授徒。"
      },
      {
        "term": "河兵",
        "note": "清代河道衙门所辖、专司治河防汛的兵丁。"
      }
    ]
  },
  "10": {
    "0": [
      {
        "term": "三峡",
        "note": "瞿塘峡、巫峡、西陵峡的合称，在今重庆奉节至湖北宜昌之间。"
      },
      {
        "term": "略无阙处",
        "note": "略无，全无、毫无；阙，通「缺」，缺口、中断。"
      },
      {
        "term": "自非亭午夜分",
        "note": "自非，若不是；亭午，正午；夜分，半夜。"
      },
      {
        "term": "曦月",
        "note": "曦，日光，此指太阳；曦月即日与月。"
      }
    ],
    "1": [
      {
        "term": "襄陵",
        "note": "襄，上、漫上；陵，丘陵。语本《尚书·尧典》「怀山襄陵」。"
      },
      {
        "term": "沿溯",
        "reading": "yán sù",
        "note": "顺流而下为沿，逆流而上为溯；此指上下水的航路。"
      },
      {
        "term": "朝发白帝，暮到江陵",
        "note": "白帝，白帝城，在今重庆奉节东；江陵，今湖北荆州。"
      },
      {
        "term": "虽乘奔御风，不以疾也",
        "note": "奔，飞奔的马；御，驾。以，如；一说作「以为」解，谓也不觉其快。"
      }
    ],
    "2": [
      {
        "term": "绝",
        "reading": "jué",
        "note": "极。「绝巘」即极高的山峰；巘（yǎn），高峻的山峰。"
      },
      {
        "term": "柽柏",
        "reading": "chēng bǎi",
        "note": "柽，柽柳，落叶小乔木；柽柏即柽柳与柏树。课本作「怪柏」。"
      },
      {
        "term": "飞潄",
        "reading": "fēi shù",
        "note": "潄，同「漱」，冲刷、冲荡。谓泉瀑飞流冲荡于山峰间。"
      },
      {
        "term": "清荣峻茂",
        "note": "水清、树荣、山峻、草茂，四字各指一物。"
      }
    ],
    "3": [
      {
        "term": "晴初霜旦",
        "note": "晴初，天刚放晴时；霜旦，下霜的早晨。"
      },
      {
        "term": "属引",
        "reading": "zhǔ yǐn",
        "note": "属，连接；引，延长。谓猿啸声接连不断。"
      },
      {
        "term": "哀转久绝",
        "note": "转，通「啭」，声音婉转；绝，消失。谓哀声婉转，很久才消失。"
      },
      {
        "term": "巴东",
        "note": "郡名，东汉末置，治鱼复（今重庆奉节东），辖三峡西段一带。"
      }
    ]
  },
  "11": {
    "0": [
      {
        "term": "沉鳞",
        "note": "潜游水中的鱼。以「鳞」代鱼，属借代；沉，指潜在水下。"
      },
      {
        "term": "欲界之仙都",
        "note": "欲界，佛教三界之一，有食色之欲的众生所居，此指人间；仙都，仙人所居处。"
      },
      {
        "term": "康乐",
        "note": "指南朝宋谢灵运，袭封康乐公，世称谢康乐，以山水诗著称。"
      },
      {
        "term": "与其奇",
        "reading": "yù",
        "note": "与，参与，此指欣赏、领略；其奇，这里的奇丽景色。"
      }
    ]
  },
  "12": {
    "0": [
      {
        "term": "元丰六年",
        "note": "元丰，宋神宗年号（1078—1085）。元丰六年即公元1083年。"
      },
      {
        "term": "户",
        "note": "门。一说指窗户。"
      },
      {
        "term": "承天寺",
        "note": "寺名，故址在今湖北黄冈城南。"
      },
      {
        "term": "张怀民",
        "note": "名梦得，字怀民，一字偓佺，清河人。元丰六年亦贬黄州，初寓承天寺。"
      }
    ],
    "1": [
      {
        "term": "空明",
        "note": "澄澈透明。"
      },
      {
        "term": "藻荇",
        "reading": "zǎo xìng",
        "note": "藻、荇皆水生植物。荇，荇菜，叶浮于水面。"
      },
      {
        "term": "盖",
        "note": "推测之词，犹言大概是；此处可解作「原来是」。"
      },
      {
        "term": "但",
        "note": "只，只是。非转折之「但是」。"
      }
    ],
    "2": [
      {
        "term": "黄州",
        "note": "州名，治所在今湖北黄冈。"
      },
      {
        "term": "团练副使",
        "note": "宋代州团练使之副，贬官多挂此衔；苏轼时本州安置，不得签书公事。"
      },
      {
        "term": "苏某",
        "note": "苏轼自称，「某」代其名「轼」。"
      }
    ]
  },
  "13": {
    "0": [
      {
        "term": "富阳至桐庐",
        "note": "富阳、桐庐皆县名，今属浙江杭州，富春江流经其间。"
      },
      {
        "term": "缥碧",
        "reading": "piǎo bì",
        "note": "青白色。缥本指青白色的丝帛。"
      },
      {
        "term": "寒树",
        "note": "使人看了有寒意的树，形容林木茂密；一说指耐寒常绿的树。"
      },
      {
        "term": "轩邈",
        "reading": "xuān miǎo",
        "note": "轩，高；邈，远。此作动词，谓群山竞相往高处、远处伸展。"
      }
    ],
    "1": [
      {
        "term": "千转",
        "reading": "qiān zhuàn",
        "note": "转，通「啭」，鸟鸣婉转之声，此指蝉长鸣不已。"
      },
      {
        "term": "鸢飞戾天",
        "reading": "yuān fēi lì tiān",
        "note": "语出《诗·大雅·旱麓》。鸢，鹰类猛禽；戾，至。此喻极力攀高者。"
      },
      {
        "term": "经纶世务",
        "note": "经纶，本指整理丝缕，引申为筹划治理；世务，世间政务。"
      },
      {
        "term": "横柯",
        "reading": "héng kē",
        "note": "横斜的树枝。柯，草木的枝茎。"
      }
    ]
  },
  "14": {
    "0": [
      {
        "term": "篁竹",
        "reading": "篁 huáng",
        "note": "成片的竹林。篁，竹林。"
      },
      {
        "term": "珮环",
        "note": "玉珮、玉环，古人系在衣带上的佩玉，行动时相击有声。"
      },
      {
        "term": "为坻，为屿，为嵁，为岩",
        "reading": "坻 chí · 嵁 kān",
        "note": "坻，水中高地；屿，小岛；嵁，不平的岩石；岩，高出水面的石崖。"
      },
      {
        "term": "蒙络摇缀，参差披拂",
        "note": "蒙络，遮掩缠绕；摇缀，摇动下垂；参差，长短不齐；披拂，随风飘动。"
      }
    ],
    "1": [
      {
        "term": "可百许头",
        "note": "大约一百来条。可，大约；许，表约数；头，量词，犹言条。"
      },
      {
        "term": "佁然",
        "reading": "yǐ",
        "note": "呆呆不动的样子。"
      },
      {
        "term": "俶尔",
        "reading": "chù",
        "note": "忽然。"
      },
      {
        "term": "翕忽",
        "reading": "xī",
        "note": "轻快敏捷的样子。"
      }
    ],
    "2": [
      {
        "term": "斗折蛇行",
        "note": "像北斗七星那样曲折，像蛇爬行那样蜿蜒；斗、蛇为名词作状语。"
      },
      {
        "term": "明灭可见",
        "note": "溪水时而看得见，时而看不见。明，显现；灭，隐没。"
      },
      {
        "term": "犬牙差互",
        "reading": "差 cī",
        "note": "像狗的牙齿那样交错不齐。差互，交错。"
      }
    ],
    "3": [
      {
        "term": "凄神寒骨",
        "note": "使心神凄凉，使骨头发寒；凄、寒皆使动用法。"
      },
      {
        "term": "悄怆幽邃",
        "reading": "qiǎo chuàng · suì",
        "note": "悄怆，忧伤的样子；幽邃，幽静深远。邃，深。"
      },
      {
        "term": "过清",
        "note": "过于凄清冷寂。清，凄清。"
      }
    ],
    "4": [
      {
        "term": "吴武陵",
        "note": "信州人，元和初进士，因事流放永州，与柳宗元交游。"
      },
      {
        "term": "宗玄",
        "note": "柳宗元的堂弟。"
      },
      {
        "term": "隶而从者",
        "note": "跟随同去的人。隶，随从。"
      },
      {
        "term": "崔氏二小生",
        "note": "姓崔的两个年轻人；一说为柳宗元姐夫崔简之子。小生，年轻人。"
      }
    ]
  },
  "15": {
    "0": [
      {
        "term": "王叔远",
        "note": "名毅，字叔远，明末虞山（今江苏常熟）人，以微雕名。"
      },
      {
        "term": "因势象形",
        "note": "顺着材料原有形状，雕成物象。象，模拟。"
      },
      {
        "term": "贻",
        "reading": "yí",
        "note": "赠送。"
      },
      {
        "term": "大苏泛赤壁",
        "note": "大苏即苏轼，对弟苏辙「小苏」而言；元丰五年两游黄州赤壁，作前后《赤壁赋》。"
      }
    ],
    "1": [
      {
        "term": "有奇",
        "reading": "yǒu jī",
        "note": "有余，多一点。奇，零数。"
      },
      {
        "term": "篛篷",
        "reading": "ruò péng",
        "note": "箬竹叶编的船篷。篛同「箬」，课本即作「箬篷」。"
      },
      {
        "term": "山高月小，水落石出",
        "note": "语出苏轼《后赤壁赋》；左刻「清风徐来，水波不兴」出前《赤壁赋》。"
      },
      {
        "term": "石青糁之",
        "reading": "shí qīng sǎn zhī",
        "note": "用石青涂填字的刻痕。石青，蓝色矿物颜料；糁，涂抹。"
      }
    ],
    "2": [
      {
        "term": "佛印",
        "note": "宋僧了元，号佛印，与苏轼交好，后世多附会其轶事。"
      },
      {
        "term": "鲁直",
        "note": "黄庭坚，字鲁直，号山谷道人，北宋诗人、书家，与苏轼并称「苏黄」。"
      },
      {
        "term": "不属",
        "reading": "bù zhǔ",
        "note": "不相类似，不相关联。属，类属、连属。"
      },
      {
        "term": "诎",
        "reading": "qū",
        "note": "同「屈」，弯曲。"
      }
    ],
    "3": [
      {
        "term": "椎髻",
        "reading": "chuí jì",
        "note": "梳成椎形的发髻，形如棒槌，多为仆役村民发式。"
      },
      {
        "term": "啸呼",
        "note": "撮口发出长声，高声呼叫。"
      },
      {
        "term": "蒲葵扇",
        "note": "用蒲葵叶制成的扇子，即葵扇。"
      },
      {
        "term": "视端容寂",
        "note": "目光平视，神色安静。端，正；寂，静。"
      }
    ],
