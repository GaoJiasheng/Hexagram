    "9": [
      {
        "term": "背下陵高",
        "note": "离开低处，登上高处。陵，登。"
      },
      {
        "term": "耿耿",
        "note": "心中不安、不能成眠的样子。"
      },
      {
        "term": "抗策",
        "note": "举起马鞭。抗，举；策，马鞭。"
      }
    ]
  }
