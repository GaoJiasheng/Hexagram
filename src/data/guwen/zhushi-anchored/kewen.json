{
  "1": {
    "0": [
      {
        "term": "谢太傅",
        "note": "谢安，字安石，东晋名臣，卒后追赠太傅，故称。"
      },
      {
        "term": "胡儿",
        "note": "谢朗的小名，谢安次兄谢据之子。"
      },
      {
        "term": "差可拟",
        "note": "差不多可以相比。差，大体；拟，比拟。"
      },
      {
        "term": "无奕",
        "note": "谢奕，字无奕，谢安长兄；其女即谢道韫。"
      }
    ]
  },
  "2": {
    "0": [
      {
        "term": "陈太丘",
        "note": "陈寔，东汉颍川许县人，曾任太丘县长，故称。元方即其长子陈纪。"
      },
      {
        "term": "尊君在不",
        "note": "尊君，敬称对方之父；下文家君，谦称己父。不，通“否”。"
      },
      {
        "term": "相委而去",
        "reading": "wěi",
        "note": "委，舍弃。相，偏指一方，指丢下对方。"
      },
      {
        "term": "引之",
        "note": "引，拉，牵。之，指元方。"
      }
    ]
  },
  "3": {
    "0": [
      {
        "term": "淫慢",
        "note": "放纵懈怠。淫，过度、放纵；慢，怠惰。旧底本作「慆慢」，慆亦怠慢义。"
      },
      {
        "term": "险躁",
        "note": "轻薄急躁。险，轻薄、不庄重。"
      },
      {
        "term": "枯落",
        "note": "枯枝落叶，喻年岁老去而一无所成。"
      },
      {
        "term": "接世",
        "note": "接触世事，为社会所用。"
      }
    ]
  },
  "4": {
    "0": [
      {
        "term": "屠",
        "note": "屠户，以宰杀牲畜卖肉为业的人。"
      },
      {
        "term": "止有剩骨",
        "note": "止，通「只」，仅仅。"
      },
      {
        "term": "缀行甚远",
        "note": "缀，连接，此指紧跟不舍。"
      }
    ],
    "1": [
      {
        "term": "投以骨",
        "note": "即「以骨投之」，介宾后置，把骨头扔给狼。"
      },
      {
        "term": "并驱如故",
        "note": "并驱，一起追赶；如故，和原来一样。"
      }
    ],
    "2": [
      {
        "term": "积薪其中",
        "note": "积，堆积；薪，柴草。其中，在麦场里。"
      },
      {
        "term": "苫蔽成丘",
