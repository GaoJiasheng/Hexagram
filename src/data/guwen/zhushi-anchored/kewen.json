      {
        "term": "轻袿",
        "reading": "qīng guī",
        "note": "轻柔的上衣。袿，妇女所穿的上衣。"
      }
    ],
    "7": [
      {
        "term": "屏翳",
        "reading": "píng yì",
        "note": "神名，旧说或为雨师、云神、风神，此与「收风」相应，指风神。"
      },
      {
        "term": "川后",
        "note": "河川之神。"
      },
      {
        "term": "冯夷",
        "reading": "píng yí",
        "note": "传说中的河伯，即黄河之神。"
      },
      {
        "term": "文鱼",
        "note": "有斑纹的鱼，旧说有翅能飞。"
      }
    ],
    "8": [
      {
        "term": "清阳",
        "note": "阳通「扬」，指眉目之间。《诗·郑风》有「清扬婉兮」。"
      },
      {
        "term": "浪浪",
        "reading": "láng láng",
        "note": "泪流不止的样子。"
      },
      {
        "term": "太阴",
        "note": "极阴幽暗之处，李善注谓众神所居，此指洛神所处的水府。"
      },
      {
        "term": "神宵",
        "note": "宵，一说通「消」，谓神影消逝；一说指幽暗。"
      }
