      },
      {
        "term": "弛担",
        "note": "弛，放下、卸下；担，担子。"
      },
      {
        "term": "眈眈相向",
        "note": "眈眈，注视貌；相向，朝着屠户。"
      }
    ],
    "3": [
      {
        "term": "犬坐",
        "note": "像狗一样蹲坐，名词作状语。"
      },
      {
        "term": "洞其中",
        "note": "洞，名词作动词，打洞。"
      },
      {
        "term": "尻尾",
        "note": "尻，读kāo，屁股；尾，尾巴。"
      },
      {
        "term": "假寐",
        "note": "假装睡觉。寐，睡。"
      }
    ],
    "4": [
      {
        "term": "黠",
        "reading": "xiá",
        "note": "读xiá，狡猾。"
      },
      {
        "term": "顷刻两毙",
        "note": "顷刻，一会儿；两毙，两只都被杀死。"
      },
      {
        "term": "变诈几何哉",
        "note": "变诈，作假欺骗；几何，多少。"
      },
      {
        "term": "止增笑耳",
        "note": "止，只；耳，罢了，句末语气词。"
      }
    ]
  },
  "5": {
    "0": [
      {
        "term": "溉汲",
        "note": "溉，浇灌；汲，从井中打水。"
      },
      {
        "term": "穿井",
        "note": "穿，凿通。穿井即凿井、打井。"
      },
      {
        "term": "闻之于宋君",
        "note": "使宋国国君听到这件事。闻，使动用法。"
      },
      {
        "term": "得一人之使",
        "note": "使，役使。谓得到一个人的劳力可供使唤。"
      }
    ]
  },
  "6": {
    "0": [
      {
        "term": "当涂",
        "reading": "dāng tú",
        "note": "当道，居要职掌权。涂，通“途”。"
      },
      {
        "term": "博士",
        "note": "古代学官名，汉以来专掌儒家经学的传授。"
      },
      {
        "term": "寻阳",
        "reading": "xún yáng",
        "note": "县名，在今湖北黄梅西南，时属吴。"
      },
      {
        "term": "吴下阿蒙",
        "note": "吴下，指吴地；阿蒙，对吕蒙的昵称，阿为名前亲昵词头。"
      }
    ]
  },
  "7": {
    "0": [
      {
        "term": "陈康肃公",
        "note": "陈尧咨，北宋阆州人，咸平间进士第一，谥康肃。公，尊称。"
      },
      {
        "term": "释担",
        "note": "放下担子。释，放下。"
      },
      {
        "term": "睨",
        "reading": "nì",
        "note": "斜着眼看。"
      },
      {
        "term": "颔",
        "reading": "hàn",
        "note": "点头。"
      }
    ],
    "1": [
      {
        "term": "轻吾射",
        "note": "轻视我的射箭本领。轻，用作动词，看轻。"
      },
      {
        "term": "酌油",
        "note": "舀油、倒油。酌，本指斟酒，此指舀取。"
      },
      {
        "term": "杓",
        "reading": "sháo",
        "note": "同「勺」，舀取液体的器具。"
      },
      {
        "term": "沥之",
        "note": "使油细细地滴注下去。沥，液体下滴。"
      }
    ]
  },
  "8": {
    "0": [
      {
        "term": "甚蕃",
        "reading": "fán",
        "note": "蕃，多。甚蕃，很多。"
      },
      {
        "term": "李唐",
        "note": "唐朝皇帝姓李，故称李唐。"
      },
      {
        "term": "濯清涟",
        "reading": "zhuó",
        "note": "濯，洗。清涟，清澈的水波。"
      },
      {
        "term": "亵玩",
        "reading": "xiè",
        "note": "亵，亲近而不庄重。亵玩，靠近玩弄。"
      }
    ],
    "1": [
      {
        "term": "隐逸者",
        "note": "隐居避世的人。钟嵘《诗品》称陶渊明为古今隐逸诗人之宗。"
      },
      {
        "term": "鲜有闻",
        "reading": "xiǎn",
        "note": "鲜，少。很少听说。"
      },
      {
        "term": "宜乎众矣",
        "note": "宜，当然，理所当然。众，多。"
      }
    ]
  },
  "9": {
    "0": [
      {
        "term": "圮",
        "reading": "pǐ",
        "note": "倒塌，坍毁。"
      },
      {
        "term": "木柿",
        "reading": "mù fèi",
