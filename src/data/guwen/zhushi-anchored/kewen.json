      {
        "term": "廽忆",
        "reading": "huí yì",
        "note": "廽、囬皆「回」的异体字;下文㕔、厛皆「厅」的异体字。"
      },
      {
        "term": "望日",
        "note": "农历每月十五日。"
      },
      {
        "term": "有身",
        "note": "怀有身孕。"
      },
      {
        "term": "寸管",
        "note": "毛笔。管,笔杆,此指笔。"
      }
    ],
    "4": [
      {
        "term": "第",
        "note": "但、只是。"
      },
      {
        "term": "瓜分之日",
        "note": "清末列强竞划势力范围,时论有「瓜分中国」之忧,此指国土被分割之时。"
      },
      {
        "term": "眼成穿而骨化石",
        "note": "望穿双眼、身化为石,化用望夫石传说,极言久盼不归。"
      },
      {
        "term": "破镜能重圆",
        "note": "陈将亡,徐德言破镜与妻乐昌公主各执其半,后凭镜重聚。见孟棨《本事诗》。"
      }
    ],
    "5": [
      {
        "term": "依新",
        "note": "林觉民长子林依新。"
      },
      {
        "term": "亗",
        "reading": "suì",
        "note": "「岁」的异体字。"
      },
      {
        "term": "腹中之物",
        "note": "时陈意映有孕,即后来的遗腹子林仲新。"
      },
      {
        "term": "意洞",
        "note": "林觉民的字。"
      }
    ],
    "6": [
      {
        "term": "九泉",
        "note": "地下深处,指人死后埋葬之所。"
      },
      {
        "term": "心电感应",
        "note": "谓人与人心意可隔远相通,清末由西方传入的说法。"
      }
    ],
    "7": [
      {
        "term": "的的",
        "note": "的确、实在。"
      },
      {
        "term": "偶我",
        "note": "与我结为配偶,即嫁给我。偶,配偶,此作动词。"
      },
      {
        "term": "巾短情长",
        "note": "此信写于一方白布巾上,故言巾短。"
      },
      {
        "term": "模拟",
        "note": "揣摩、推想。"
      }
    ],
    "8": [
      {
        "term": "辛未",
        "note": "1911年干支为辛亥,此作辛未,一般认为是仓促笔误。"
      },
      {
        "term": "念六",
        "note": "二十六日。念,用同「廿」。农历三月廿六即公历1911年4月24日。"
      },
      {
        "term": "四鼓",
        "note": "四更天,约当凌晨一时至三时。"
      }
    ],
    "9": [
      {
        "term": "诸母",
        "note": "伯母、叔母等家中母辈妇女。"
      },
      {
        "term": "通文",
        "note": "通晓文字,能读能写。"
      }
    ]
  },
  "23": {
    "0": [
      {
        "term": "黄初三年",
        "note": "魏文帝曹丕年号，公元222年。《魏志》记植朝京师在四年，李善疑此有误。"
      },
      {
        "term": "京师",
        "note": "京城，指魏都洛阳。"
      },
      {
        "term": "宓妃",
        "reading": "fú fēi",
        "note": "传说为伏羲氏之女，溺死于洛水，遂为洛水之神。"
      },
      {
        "term": "宋玉对楚王神女之事",
        "note": "指宋玉《高唐赋》《神女赋》，述楚王与巫山神女梦中相遇之事。"
      }
    ],
    "1": [
      {
        "term": "伊阙",
        "note": "山名，即今洛阳南的龙门，两山对峙如阙。"
      },
      {
        "term": "轘辕",
        "reading": "huán yuán",
        "note": "山名，在今河南偃师东南，山路盘曲往复。"
      },
      {
        "term": "税驾",
        "reading": "tuō jià",
        "note": "税通「脱」，解下驾车之马，指停车歇息。"
      },
      {
        "term": "蘅皋",
        "note": "长着杜蘅的水边高地。蘅，香草杜蘅；皋，水边地。"
      }
    ],
    "2": [
      {
        "term": "援",
        "note": "拉，拽。"
      },
      {
        "term": "觌",
        "reading": "dí",
        "note": "见，看见。"
      },
      {
        "term": "彼何人斯",
        "note": "斯，句末语气词。《诗·小雅》有《何人斯》篇。"
      }
    ],
    "3": [
      {
        "term": "河洛",
        "note": "黄河与洛水，此偏指洛水。"
      },
      {
        "term": "君王",
        "note": "曹植时为藩王，故御者称之为君王。"
      },
      {
        "term": "无迺",
        "note": "迺同「乃」。无乃，莫非、恐怕是，表推测。"
      }
    ],
    "4": [
      {
        "term": "襛纤得衷",
        "reading": "nóng xiān dé zhōng",
        "note": "襛，肥；纤，瘦；衷同「中」，适中。"
      },
      {
        "term": "靥辅承权",
        "reading": "yè fǔ chéng quán",
        "note": "靥辅，面颊上的酒窝；权同「颧」，颧骨。"
      },
      {
        "term": "华琚",
        "reading": "huá jū",
        "note": "华美的佩玉。琚，佩玉名。"
      },
      {
        "term": "远游之文履",
        "note": "远游，鞋名；文履，饰有花纹的鞋。"
      }
    ],
    "5": [
      {
        "term": "采旄",
        "note": "采同「彩」；旄，竿头饰以牦牛尾的旗。"
      },
      {
        "term": "羌",
        "reading": "qiāng",
        "note": "楚辞常用的句首语气词，无实义。"
      },
      {
        "term": "琼珶",
        "reading": "qióng dì",
        "note": "美玉。"
      },
      {
        "term": "交甫之弃言",
        "note": "《列仙传》载郑交甫遇江汉二女，得其佩，行数步佩与女俱失。弃言，背弃约言。"
      }
    ],
    "6": [
      {
        "term": "南湘之二妃",
        "note": "舜妃娥皇、女英，相传死于湘水之间，为湘水之神。"
      },
      {
        "term": "汉滨之游女",
        "note": "汉水女神。《诗·周南·汉广》：「汉有游女，不可求思。」"
