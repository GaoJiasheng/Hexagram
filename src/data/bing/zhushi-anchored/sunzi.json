      },
      {
        "term": "钝兵挫锐",
        "note": "兵器钝坏、锐气受挫,喻军力久战而疲。"
      },
      {
        "term": "拙速",
        "reading": "zhuō sù",
        "note": "宁取笨拙而求速决,不逞机巧而陷久战。"
      }
    ],
    "1": [
      {
        "term": "役不再籍",
