{
  "1": {
    "0": [
      {
        "term": "孙子",
        "note": "指孙武,春秋末齐人,以兵法见吴王阖闾,《史记》有传。"
      },
      {
        "term": "经之以五事",
        "reading": "jīng zhī yǐ wǔ shì",
        "note": "经,经纬、衡量。谓以五项根本之事统量战争。"
      },
      {
        "term": "校之以七计",
        "reading": "jiào zhī yǐ qī jì",
        "note": "校,比较核校。谓以七种对比核校敌我之情。"
      },
      {
        "term": "索其情",
        "note": "索,探求。情,实情、情势。谓探求胜负之实情。"
      }
    ],
    "1": [
      {
        "term": "曲制",
        "note": "军队部曲之编制与节度。曹操注:部曲、幡帜、金鼓之制。"
      },
      {
        "term": "官道",
        "note": "百官将吏的职分与统属之道。"
      },
      {
        "term": "主用",
        "note": "主,掌管;用,军资财用。谓掌管军需费用。"
      },
      {
        "term": "孰",
        "reading": "shú",
        "note": "疑问代词,哪一个、谁。"
      }
    ],
    "2": [
      {
        "term": "诡道",
        "reading": "guǐ dào",
        "note": "诡,诈变。谓用兵以诈变为本,因敌制宜而无常法。"
      },
      {
        "term": "怒而挠之",
        "reading": "nù ér náo zhī",
        "note": "挠,挑逗、撩拨。谓敌将易怒则激之使失常。"
      },
      {
        "term": "卑而骄之",
        "note": "卑,谓敌卑下示弱。一说我示弱辞卑以骄敌。"
      },
      {
        "term": "佚而劳之",
        "reading": "yì ér láo zhī",
        "note": "佚,同逸,安逸。谓敌安逸则设法使其疲困。"
      }
    ],
    "3": [
      {
        "term": "庙算",
        "reading": "miào suàn",
        "note": "古者出兵先于庙堂谋议筹算,谓之庙算。"
      },
      {
        "term": "得算多也",
        "note": "得算,所得之胜筹。谓筹谋周密、胜面多。"
      }
    ]
  },
  "2": {
    "0": [
      {
