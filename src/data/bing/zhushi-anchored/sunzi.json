  "8": {
    "0": [
      {
        "term": "圮地",
        "reading": "pǐ dì",
        "note": "山林险阻、沮泽难行之地。圮,毁坏、塌坏。"
      },
      {
        "term": "衢地",
        "reading": "qú dì",
        "note": "四通八达、与多国接界之地。衢,交通要道。"
      },
      {
        "term": "绝地",
        "note": "前不得进、后不得退、粮道不继的孤绝之地。"
      },
      {
        "term": "九变",
        "note": "随地形敌情变化而灵活处置的种种权变。九,极言其多。"
      }
    ],
    "1": [
      {
        "term": "杂于利害",
        "note": "杂,兼也、参合也。谓利害两面兼顾参酌。"
      },
      {
        "term": "屈诸侯者以害",
        "note": "屈,使之屈服。以其所畏忌之害相逼。"
      },
      {
        "term": "役诸侯者以业",
        "note": "役,驱使。业,使之疲于奔命之事。"
      }
    ],
    "3": [
      {
        "term": "五危",
        "note": "将帅性情上的五种偏失,临阵足以致败。"
      },
      {
        "term": "忿速",
        "note": "忿,易怒;速,急躁。谓性情褊急、易被激动。"
      },
      {
        "term": "覆军杀将",
        "note": "覆,倾覆、覆灭。谓全军溃败、主将被杀。"
      }
    ]
  },
  "9": {
    "0": [
      {
        "term": "绝山依谷",
        "note": "绝，横越；翻越山地须傍依溪谷，便取水草、隐蔽。"
      },
      {
        "term": "视生处高",
        "note": "生，向阳开阔之地；据视野开阔的高处。"
      },
      {
        "term": "斥泽",
        "reading": "chì zé",
        "note": "斥，盐碱地；斥泽即盐碱沼泽地带。"
      },
      {
        "term": "黄帝之所以胜四帝",
        "note": "传说黄帝胜四方之帝而定天下，古兵家托始之辞。"
      }
    ],
    "1": [
      {
        "term": "贵阳而贱阴",
