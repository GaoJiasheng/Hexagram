      },
      {
        "term": "石",
        "reading": "dàn",
        "note": "古容量、重量单位,此为草料计量之名。"
      }
    ],
    "4": [
      {
        "term": "更其旌旗",
        "reading": "gēng qí jīng qí",
        "note": "更,改换;换去敌车旌旗,改作己方标识。"
      },
      {
        "term": "卒善而养之",
        "note": "对俘卒善加抚养任用,不加杀戮。"
      }
    ],
    "5": [
      {
        "term": "司命",
        "reading": "sī mìng",
        "note": "本为掌人寿命的星神,此喻将领操民众生死之权。"
      }
    ]
  },
  "3": {
    "0": [
      {
        "term": "全国为上",
        "note": "全，保全、使完整；使敌国整个降服而不加破坏为上策。"
      },
      {
        "term": "破军",
        "note": "击破敌人之军。军，周制万二千五百人为一军，此泛指大编制部队。"
      },
      {
        "term": "全伍为上",
        "reading": "wǔ",
        "note": "伍，最小编制单位，五人为伍。卒、旅、军逐级递增，言由大至小皆贵全。"
      },
      {
        "term": "不战而屈人之兵",
        "note": "屈，使屈服。不经交战而使敌军屈服，本篇主旨所在。"
      }
    ],
    "1": [
      {
        "term": "上兵伐谋",
        "note": "上兵，用兵上策。伐谋，以谋略破敌之计。曹操注：敌始有谋，伐之易也。"
      },
      {
        "term": "伐交",
        "note": "交，邦交、外交。从外交上孤立、瓦解敌方的结盟。"
      },
      {
        "term": "轒辒",
        "reading": "fén wēn",
        "note": "古代攻城战车，四轮蒙以皮革，用以掩护士卒接近城墙。"
      },
      {
        "term": "距𬮱",
        "reading": "jù yīn",
        "note": "距，堆筑；𬮱，攀城用的土山。一说为窥察城内的瞭望设施。"
      }
    ],
    "2": [
      {
        "term": "拔人之城",
        "note": "拔，攻克、夺取。攻下敌城。"
      },
      {
        "term": "必以全争于天下",
        "note": "全，保全之道，与篇首「全国为上」相应，以不破坏的方式争胜天下。"
      },
      {
        "term": "兵不顿",
        "reading": "dùn",
        "note": "顿，通「钝」，疲敝、挫损。军队不致疲钝受损。"
      }
    ],
    "3": [
      {
        "term": "倍则分之",
        "note": "倍，一倍之兵。兵力一倍于敌则设法分散敌势，再以局部优势取之。"
      },
      {
        "term": "敌则能战之",
        "note": "敌，匹敌、势均。兵力相当则当能与之交战。"
      },
      {
        "term": "小敌之坚",
        "note": "坚，固执坚守。弱小一方若一味硬拼坚守。"
      },
      {
        "term": "大敌之擒",
        "note": "擒，俘获。终为强大一方所擒。"
      }
    ],
    "4": [
      {
        "term": "国之辅",
        "note": "辅，本指车旁夹木，引申为辅佐。将领为国君之辅弼。"
      },
      {
        "term": "辅周",
        "note": "周，周密、严密。辅佐周备无缺。"
      },
      {
        "term": "辅隙",
        "reading": "xì",
        "note": "隙，缝隙、缺漏。辅佐有疏漏、与君不合。"
      }
    ],
    "5": [
      {
        "term": "縻军",
        "reading": "mí",
        "note": "縻，牛缰绳，引申为束缚、牵制。指君主乱命使军队进退失据如被绊缚。"
