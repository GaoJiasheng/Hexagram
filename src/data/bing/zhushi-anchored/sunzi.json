      },
      {
        "term": "养生而处实",
        "note": "养生，近水草便给养；处实，据给养充足之地。"
      },
      {
        "term": "水沫",
        "note": "上游降雨后顺流而下的泡沫，预示水将暴涨。"
      }
    ],
    "2": [
      {
        "term": "天井、天牢、天罗、天陷、天隙",
        "note": "所列五种险恶地形，低洼、围困、罗网、陷没、狭缝之地。"
      },
      {
        "term": "潢井",
        "reading": "huáng jǐng",
        "note": "潢，低洼积水处；潢井即地势低下积水的洼地。"
      },
      {
        "term": "蘙荟",
        "reading": "yì huì",
        "note": "草木茂密遮蔽之处。"
      },
      {
        "term": "伏奸",
        "note": "潜伏的敌兵与奸细。"
      }
    ],
    "3": [
      {
        "term": "众草多障者，疑也",
        "note": "草丛中多设障碍，是敌布疑阵以惑我。"
      },
      {
        "term": "辞卑而益备者，进也",
        "note": "言辞谦卑而暗中加紧戒备，是将进攻之兆。"
      },
      {
        "term": "无约而请和者，谋也",
        "note": "未经约定而来求和，必另有图谋。"
      },
      {
        "term": "粟马肉食",
        "note": "以粮喂马、杀马为食，示军已绝粮、置之死地。"
      },
      {
        "term": "谆谆翕翕",
        "reading": "zhūn zhūn xī xī",
        "note": "谆谆，絮絮低语；翕翕，聚拢私议状，谓将失众心。"
      }
    ],
    "4": [
      {
        "term": "无武进",
        "note": "武进，恃勇冒进；谓不轻率逞勇而进。"
      },
      {
        "term": "易敌",
        "reading": "yì dí",
        "note": "易，轻视；轻敌而不加谋虑。"
      }
    ],
    "5": [
      {
        "term": "亲附",
        "note": "士卒亲近归附于将。"
      },
      {
        "term": "令之以文，齐之以武",
        "note": "文谓恩信教化，武谓军法纪律；恩威并施。"
      },
      {
        "term": "与众相得",
        "note": "将帅与部众相处融洽、上下相得。"
      }
    ]
  },
  "10": {
