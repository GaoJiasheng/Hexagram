    "3": [
      {
        "term": "赴深溪",
        "note": "溪,深谷。喻同赴危险绝境。"
      },
      {
        "term": "骄子",
        "note": "娇纵之子;喻只受厚爱而不堪役使之兵。"
      }
    ],
    "4": [
