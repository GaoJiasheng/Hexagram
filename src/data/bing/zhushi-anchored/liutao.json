      {
        "term": "隘塞",
        "reading": "ài sài",
        "note": "隘，险狭之地；塞，边塞关防。泛指险要难行之处。"
      },
      {
        "term": "定次",
        "note": "次，止息、宿处。定次谓安顿好营宿之所。"
      }
    ]
  },
