{
  "1": {
    "0": [
      {
        "term": "彨",
        "reading": "chī",
        "note": "同「螭」，古传说中无角的龙；一说似蛟而黄。"
      },
      {
        "term": "罴",
        "reading": "pí",
        "note": "棕熊，体大力强，毛棕褐色。此与龙、虎并举，喻所获非寻常之物。"
      },
      {
        "term": "缗",
        "reading": "mín",
        "note": "钓鱼用的丝线。下文「缗微」「缗调」「缗隆」分言丝之细、适中、粗。"
      },
      {
        "term": "擅天下之利者则失天下",
        "note": "擅，独占。谓君独享天下之利则众叛，与「同天下之利」相对，为本篇主旨。"
      }
    ]
  },
  "2": {
    "0": [
      {
        "term": "熙熙",
        "reading": "xī xī",
        "note": "纷纷攘攘、众多繁盛貌,状天下扰攘。"
      },
      {
        "term": "不肖",
        "reading": "bù xiào",
        "note": "不贤、不才。肖,似;不肖谓不似其善者。"
      },
      {
        "term": "甍桷椽楹",
        "reading": "méng jué chuán yíng",
        "note": "甍,屋脊;桷椽,方圆椽木;楹,堂前柱。皆屋木。"
      },
      {
        "term": "鳏寡孤独",
        "reading": "guān guǎ gū dú",
        "note": "老无妻、老无夫、幼无父、老无子者,四种穷民。"
      }
    ]
  },
  "3": {
    "0": [
      {
        "term": "台榭",
        "reading": "tái xiè",
        "note": "高土筑成的方台叫台,台上所建木屋叫榭,泛指供观游的楼台亭阁。"
      },
      {
        "term": "赋敛",
        "reading": "fù liǎn",
        "note": "赋指田赋兵车之征,敛指征收。合指国家向百姓征取的赋税。"
      },
      {
        "term": "苛扰",
        "reading": "kē rǎo",
        "note": "苛细烦扰,指官吏政令苛刻、骚扰百姓使其不得安生。"
      },
      {
        "term": "驭民",
        "reading": "yù mín",
        "note": "驭本指驾驭车马,引申为统治、管理。驭民即治理百姓。"
      }
    ]
  },
  "4": {
    "0": [
      {
        "term": "太公",
        "note": "即吕尚,姜姓吕氏,字子牙,周文王、武王之师,辅周灭商,封于齐"
      },
      {
        "term": "为上惟临",
        "reading": "wéi shàng wéi lín",
        "note": "临:居上视下而监临。谓君居上位,其要在监临臣下。"
      },
      {
        "term": "高山仰止",
        "reading": "gāo shān yǎng zhǐ",
        "note": "语本《诗·小雅·车舝》「高山仰止,景行行止」。仰:仰望;止为语助"
      },
      {
        "term": "辐辏",
        "reading": "fú còu",
        "note": "辏:车辐聚于毂。喻天下耳目之闻见如辐之凑毂,一齐汇向君主。"
      }
    ]
  },
  "5": {
    "0": [
      {
        "term": "寝疾",
        "reading": "qǐn jí",
        "note": "卧病在床。寝，卧；疾，病。"
      },
      {
        "term": "社稷",
        "reading": "shè jì",
        "note": "社为土神，稷为谷神，合指国家。"
      },
      {
        "term": "属汝",
        "reading": "zhǔ rǔ",
        "note": "属，通「嘱」，托付。谓以国事托付于你。"
      },
      {
        "term": "知非而处",
        "note": "明知其错而安处不改。处，安居。"
      }
    ]
  },
  "6": {
    "0": [
      {
        "term": "六守",
        "reading": "liù shǒu",
        "note": "人君应持守、并据以择人的六项德能:仁义忠信勇谋。"
      },
      {
        "term": "三宝",
        "reading": "sān bǎo",
        "note": "立国之三大本业:大农、大工、大商,关乎国用充足。"
      },
      {
        "term": "付之而观其无转",
        "note": "转,变易、转向。委以重任以察其忠贞不移。"
      },
      {
        "term": "事之而观其无穷",
        "note": "事,委以变故之事;穷,窘困无策。察其应变之才。"
      }
    ]
  },
  "7": {
    "0": [
      {
        "term": "守土",
        "note": "守护、保有疆土。土指君主所守的国土封域,引申为守住治国的根本与权柄。"
      },
      {
        "term": "国柄",
        "note": "治国的权柄。柄本义器物把手,引申为可操持之权力。下文「利器」与此同指。"
      },
      {
        "term": "无掘壑而附丘",
        "reading": "wú jué hè ér fù qiū",
        "note": "不要挖低深谷去增高土丘。壑,深谷;附,增益。喻损本益人而失其平。"
      },
      {
        "term": "日中必彗",
        "reading": "rì zhōng bì huì",
        "note": "彗通「暳」,曝晒。正午阳盛宜曝物;喻当其时则当机立断,失时无及。"
      }
    ]
  },
  "8": {
    "0": [
      {
        "term": "斋",
        "reading": "zhāi",
        "note": "斋戒。沐浴更衣、节制嗜欲以致敬，古人请教大道前的庄重之礼。"
      },
      {
        "term": "北面再拜",
        "note": "面朝北方两次行礼。臣居北面君，此处文王自处弟子之位以示尊师问道。"
      },
      {
        "term": "牧之",
        "note": "牧养之。以牧畜喻治民，谓君上养护教导百姓。"
      },
      {
        "term": "经纪",
        "note": "纲纪、条理。谓圣人以四时之道为治理天地的法则次序。"
      },
      {
        "term": "民动而为机",
        "note": "机，弩牙、机括，引申为触发之关键。谓民心一动便成牵动得失的枢机。"
      }
    ]
  },
  "9": {
    "0": [
      {
        "term": "池榭",
        "reading": "chí xiè",
        "note": "池沼与台上的亭榭，泛指供游乐的园林建筑。"
      },
      {
        "term": "任气游侠",
        "note": "任性使气、以武犯禁的游侠之徒。任气，放纵意气。"
      },
      {
        "term": "万乘之主",
        "reading": "wàn shèng",
        "note": "拥有万辆兵车的大国之君。乘，四马一车，古以兵车数计国力。"
      },
      {
        "term": "巫蛊左道",
        "reading": "wū gǔ",
        "note": "巫蛊，以邪术诅咒害人；左道，不正的方术邪道。"
      }
    ]
  },
  "10": {
    "0": [
      {
        "term": "不肖",
        "reading": "bù xiào",
        "note": "不才,不贤。肖谓似其先,不肖即不似贤者,引申为没有才德。"
      },
      {
        "term": "比周",
        "reading": "bǐ zhōu",
        "note": "结党营私。比谓阿党,周谓亲密;合指为私利相互勾结。"
      },
      {
        "term": "按名督实",
        "note": "依所授官职名分考核其实际政绩,即循名责实之法。"
      },
      {
        "term": "将相分职",
        "note": "武将与文相各分职掌。将相分理军政,各举所辖之才。"
      }
    ]
  },
  "11": {
    "0": [
      {
        "term": "存劝",
        "reading": "cún quàn",
        "note": "存,保有、维系;劝,勉励。赏所以维系勉励之意,使人向善。"
      },
      {
        "term": "示惩",
        "reading": "shì chéng",
        "note": "示,昭示;惩,警戒。罚以昭示警戒,使人知所畏。"
      },
      {
        "term": "用罚者贵必",
        "note": "必,谓必行不赦。用刑贵在言出必践,不因人废法。"
      },
      {
        "term": "阴化",
        "reading": "yīn huà",
        "note": "阴,暗中、潜移;化,感化。谓未亲见者亦于无形中受感化。"
      }
    ]
  },
  "12": {
    "0": [
      {
        "term": "文王在丰",
        "reading": "fēng",
        "note": "丰,周文王所迁都邑,在今陕西西安西南沣水西岸。"
      },
      {
        "term": "全胜不斗",
        "note": "完满取胜而不必交战,谓以谋取胜、兵不血刃。"
      },
      {
        "term": "鸷鸟将击，卑飞敛翼",
        "reading": "zhì",
        "note": "鸷鸟,鹰隼之属猛禽。喻圣人将动先示弱藏形。"
      },
      {
        "term": "草菅胜谷",
        "reading": "jiān",
        "note": "菅,茅类杂草。杂草盖过庄稼,喻政荒田芜。"
      }
    ]
  },
  "13": {
    "0": [
      {
        "term": "万物皆遒",
        "reading": "qiú",
        "note": "遒,聚集、迫近,此谓万物蓬勃壮盛、各遂其生。"
      },
      {
        "term": "大纪",
        "note": "纲纪、纲领。谓分封贤人立万国为治天下之大纲。"
      },
      {
        "term": "群曲化直",
        "note": "曲谓邪曲不正,直谓端方;化邪曲之俗为正直之风。"
      },
      {
        "term": "障之则止",
        "reading": "zhàng",
        "note": "障,堵塞、阻拦。以治水喻治民,堵则壅止。"
      },
      {
        "term": "太上因之",
        "note": "太上,最上等;因,顺任、依循。谓上策顺民之常性而治。"
      }
    ]
  },
  "14": {
    "0": [
      {
        "term": "文伐",
        "note": "不动干戈、以谋略离间敌国的手段,与「武伐」(用兵)相对。文,谓非武力之法。"
      },
      {
        "term": "稽留其使",
        "reading": "jī liú qí shǐ",
        "note": "稽留,扣留、滞留。谓故意扣住敌国派来的使臣不放归。"
      },
      {
        "term": "欲锢其心",
        "reading": "yù gù qí xīn",
        "note": "锢,本指以金属熔液堵塞,引申为封闭、禁锢。谓封闭敌君心智使其昏惑。"
      },
      {
        "term": "淫声",
        "note": "靡靡之乐、过度奢华之音。古以郑卫之音为淫声,谓其乱人心志。"
      }
    ]
  },
  "15": {
    "0": [
      {
        "term": "怀天下",
        "reading": "huái tiān xià",
        "note": "怀,安抚、使归附。谓使天下人心归向。"
      },
      {
        "term": "彻天下者",
        "reading": "chè tiān xià zhě",
        "note": "彻,通达。谓使天下政令道路通畅无阻者。"
      },
      {
        "term": "天下贼之",
        "reading": "tiān xià zéi zhī",
        "note": "贼,视为贼寇、害之。谓天下以之为仇敌。"
      },
      {
        "term": "惟有道者处之",
        "reading": "wéi yǒu dào zhě chǔ zhī",
        "note": "处,据有、居其位。谓唯有德者可主天下。"
      }
    ]
  },
  "16": {
    "0": [
      {
        "term": "莫过于一",
        "note": "莫:没有什么。一:专一、归一,谓用兵贵在号令谋划归于一致而不可分,下「独往独来"
      },
      {
        "term": "阶于道",
        "reading": "jiē yú dào",
        "note": "阶:阶梯,引申为凭借、趋近。谓「一」乃通向道的阶梯。"
      },
      {
        "term": "几于神",
        "reading": "jī yú shén",
        "note": "几:接近。神:神妙莫测之境。谓「一」近于神妙。"
      },
      {
        "term": "凶器",
        "note": "不祥之器。《老子》「兵者不祥之器」,谓兵戈杀伐故曰凶,圣王不得已而用。"
      },
      {
        "term": "存而不知亡",
        "note": "只知现今之存而不思将来之亡。下「乐而不知殃」同,皆诫居安思危。"
      }
    ]
  },
  "17": {
    "0": [
      {
        "term": "三疑",
        "note": "三件疑虑,指攻强、离亲、散众三事难措手而生的顾虑。"
      },
      {
        "term": "因之",
        "note": "因,顺应、凭借;谓顺敌之势而施谋,不强攻硬取。"
      },
      {
        "term": "太强必折，太张必缺",
        "note": "助敌至极强极张,则物极必反、自致折损,纵敌之术。"
      },
      {
        "term": "塞其明",
        "note": "明,君主的耳目聪察;塞其明谓蔽其视听,使昏聩不知外情。"
      },
      {
        "term": "啗之以利",
        "reading": "dàn zhī yǐ lì",
        "note": "啗,通「啖」,以食饵诱之,引申为以利诱惑。"
      }
    ]
  },
  "18": {
    "0": [
      {
        "term": "股肱羽翼",
        "reading": "gǔ gōng yǔ yì",
        "note": "股肱,大腿与上臂,喻得力辅臣;羽翼,鸟翼,喻辅佐之助。合指辅弼之才。"
      },
      {
        "term": "以应天道",
        "note": "七十二之数应一岁七十二候,取与天道相合之义。古兵书每托天数以示法度。"
      },
      {
        "term": "符验",
        "note": "符瑞应验。古以天象祥瑞为天意征验,天文之官考校其应否。"
      },
      {
        "term": "诡符节，谬号令",
        "note": "诡、谬皆作变易、假乱解。谓伪造符节、乱布号令,军中诈术。"
      },
      {
        "term": "金疮",
        "reading": "jīn chuāng",
        "note": "金刃所致之创伤,即兵刃战伤。方士主治此类创伤及疾病。"
      }
    ]
  },
  "19": {
    "0": [
      {
        "term": "五材",
        "reading": "wǔ cái",
        "note": "为将所需五种素质：勇、智、仁、信、忠。材，材质禀赋。"
      },
      {
        "term": "可遗也",
        "reading": "kě wèi yě",
        "note": "遗，赠予、馈送，谓以财货贿之。贪利之将可以财利引诱。"
      },
      {
        "term": "命在于将",
        "note": "国家存亡之命系于将领，极言将权之重。"
      },
      {
        "term": "兵不两胜，亦不两败",
        "note": "交战双方不会俱胜或俱败，胜负必有所归，言战事不可不慎。"
      }
    ]
  },
  "20": {
    "0": [
      {
        "term": "简练",
        "reading": "jiǎn liàn",
        "note": "简,选择;练,训练。谓选拔并训练。"
      },
      {
        "term": "中情",
        "note": "内心的真实情态,与「外貌」对举。"
      },
      {
        "term": "悾悾",
        "reading": "kōng kōng",
        "note": "诚恳老实貌。《论语》有「悾悾而不信」。"
      },
      {
        "term": "静悫",
        "reading": "jìng què",
        "note": "悫,诚实谨厚。静悫谓沉静诚实。"
      },
      {
        "term": "八征",
        "note": "征,验证、考验。考察人才的八种方法。"
      }
    ]
  },
  "21": {
    "0": [
      {
        "term": "避正殿",
        "note": "君主离开正殿常朝之位,示遇危难自责变礼。古礼有灾异避正殿之制。"
      },
      {
        "term": "社稷",
        "reading": "shè jì",
        "note": "社为土神,稷为谷神,合祭于国都,因以代指国家政权。"
      },
      {
        "term": "斧钺",
        "reading": "fǔ yuè",
        "note": "斧、钺皆刑杀之器,君授将以示赋予生杀征伐之权,为出师授命之信物。"
      },
      {
        "term": "见其虚则进，见其实则止",
        "note": "虚指空隙薄弱,实指充实坚备。兵家避实击虚之旨,《孙子》虚实篇所主。"
