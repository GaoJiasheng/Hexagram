      },
      {
        "term": "赏赉",
        "reading": "shǎng lài",
        "note": "赏赐。赉，赐予。"
      },
      {
        "term": "审开塞",
        "note": "审察当开当塞之事。开塞，开通与闭塞，引申为施政取舍。"
      }
    ],
    "3": [
      {
        "term": "至聪之听",
        "note": "最为聪敏的听察。聪，耳明，引申为善察下情。"
      },
      {
        "term": "仂",
        "reading": "lè",
        "note": "余数、余力。指赋敛取用之外所余者。"
      }
    ],
    "4": [
      {
        "term": "二术",
        "note": "两种方法、两种凭借。术，途径手段。此指文武分官之道。"
      },
      {
        "term": "俎豆",
        "reading": "zǔ dòu",
        "note": "祭祀盛食的礼器。俎载牲体，豆盛菹醢，引申指祭祀典礼。"
      },
      {
        "term": "游说间谍",
        "reading": "yóu shuì jiàn dié",
        "note": "游说，纵横游谈之士；间谍，刺探敌情者。"
      }
    ],
    "5": [
      {
        "term": "继世",
