      },
      {
        "term": "更造易常",
        "reading": "gēng zào yì cháng",
        "note": "擅改成法、变易常制。更、易皆变更义。"
      },
      {
        "term": "商贾",
        "reading": "shāng gǔ",
        "note": "商人。行卖曰商，坐贩曰贾。此指囤积牟利者。"
      },
      {
        "term": "垂听",
        "note": "俯身倾听。谓君上虚心听纳下情。"
      }
    ]
  },
  "11": {
    "0": [
      {
        "term": "肥墝",
        "reading": "féi qiāo",
        "note": "墝同硗，土地坚硬瘠薄。肥墝即肥沃与贫瘠。"
      },
      {
        "term": "日断机",
        "note": "整日停下织机不织。断，犹辍、停。"
      }
    ],
    "2": [
      {
