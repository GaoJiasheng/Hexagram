      },
      {
        "term": "婚姻",
        "note": "此指姻亲,即因婚配而结成的亲属。"
      },
      {
        "term": "肆宅",
        "reading": "sì zhái",
        "note": "肆,店铺;宅,住宅。商贾经营起居之所。"
      },
      {
        "term": "囹圄",
        "reading": "líng yǔ",
        "note": "监狱的通称。"
      }
    ]
  },
  "10": {
    "0": [
      {
        "term": "四民",
        "note": "指士、农、工、商四类民众，古代社会的四种职业之分。"
      },
      {
