  "15": {
    "0": [
      {
        "term": "左、右、中军",
        "note": "古军制分军为三部:左军、右军、中军,各设统属,各有职守。"
      },
      {
        "term": "逾分而上请",
        "reading": "yú fèn ér shàng qǐng",
