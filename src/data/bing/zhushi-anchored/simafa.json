    ],
    "16": [
      {
        "term": "性州异",
        "note": "州，州域、地方；谓人之禀性因地域而各不相同。"
      }
    ],
    "17": [
      {
        "term": "未获道",
        "note": "获道，得用兵之道；自矜兵甲之利即为尚未得道。"
      }
    ],
    "18": [
      {
        "term": "无复先术",
        "note": "复，沿用；术，战法；再战不重蹈前次之法，以求变胜。"
      }
    ],
    "19": [
      {
        "term": "堪物智也",
        "note": "堪，胜任、裁断；谓能裁断事物即是智。"
      },
      {
        "term": "人自洽",
        "note": "洽，和睦相得；谓以让求和则人自然融洽。"
      }
    ],
    "20": [
      {
        "term": "闲窕",
        "reading": "xián tiǎo",
        "note": "闲，安舒；窕，宽裕；指敌从容有余、力未疲者，当避之。"
      }
    ]
  },
  "5": {
    "0": [
      {
        "term": "用寡固，用众治",
        "note": "兵少须求阵势稳固，兵多须求部伍整治。固谓坚不可破，治谓众而不乱。"
      },
      {
        "term": "远裹而阙之",
        "reading": "yuǎn guǒ ér quē zhī",
        "note": "裹，包围；阙，留缺口。围三阙一，留生路使敌不作困斗，与《孙子》「围师必阙」同旨。"
      },
      {
        "term": "擅利",
        "reading": "shàn lì",
        "note": "擅，专据、独占。谓抢占有利地形地势。"
      },
      {
        "term": "释旗",
        "note": "释，放下。放倒旗帜以隐蔽行迹、伪示无备，乘机反扑。"
      }
    ],
    "1": [
      {
        "term": "历沛",
        "reading": "lì pèi",
        "note": "历，经过；沛，水草丛杂的沼泽。谓行经沮洳之地宜速过。"
      },
      {
        "term": "历圯",
        "reading": "lì pǐ",
        "note": "圯，毁坏、坍塌难行之处。经此当疾行勿留。"
      },
      {
        "term": "兼舍环龟",
        "reading": "jiān shè huán guī",
        "note": "舍，止营。环绕高地结营，形如龟背隆起，取四面下视、水不能浸之利。"
      }
    ],
    "2": [
      {
        "term": "设而观其作",
        "note": "设，陈兵设阵。布阵以诱观敌方举动，伺其虚实而后应。"
      },
      {
        "term": "循而勿鼓",
        "note": "循，沿阵固守。守势者不先击鼓进兵，待敌先动。鼓，击鼓进军。"
      },
      {
        "term": "屯而伺之",
        "reading": "tún ér sì zhī",
        "note": "屯，屯聚兵力；伺，窥伺。攻势者聚兵以候敌之隙。"
      }
    ],
    "3": [
      {
        "term": "加其卒",
        "reading": "jiā qí cù",
        "note": "卒，同「猝」，仓卒。乘敌仓促未备而加击。"
      },
      {
        "term": "致其屈",
        "note": "致，使至；屈，困窘穷竭。设法使敌陷于力尽势穷。"
      },
      {
        "term": "袭其规",
        "note": "规，谋划、图谋。袭击敌所图谋经营之处。"
      },
      {
        "term": "夺其虑",
        "note": "夺，劫夺、扰乱；虑，思虑谋算。乱其心计使不能决。"
      }
    ],
    "4": [
      {
        "term": "从奔",
        "reading": "cóng bēn",
        "note": "从，追逐；奔，奔逃之敌。谓追击败走之敌。"
      },
      {
        "term": "止不路",
        "note": "中途停驻而不循正道。疑有伏兵诱敌，故当虑而戒之。"
      }
    ],
    "5": [
      {
        "term": "敌都",
        "note": "敌方都城。近逼敌都，进退皆须预筹道路，防其断后反击。"
      },
      {
        "term": "返虑",
        "note": "返，撤返；虑，预谋。退兵当先谋好归路，免遭追蹑。"
      }
    ],
    "6": [
      {
        "term": "先则弊",
        "reading": "xiān zé bì",
        "note": "弊，疲困。抢先妄动则力先竭而疲敝。"
      },
      {
        "term": "慑",
        "reading": "shè",
        "note": "畏惧、丧气。落后则气沮而生怯。"
      },
      {
        "term": "书亲绝",
        "note": "书，家书；亲，亲属。绝家信以断思家之念。"
      },
      {
        "term": "弃任节食",
        "reading": "qì rèn jié shí",
        "note": "任，负载、辎重；节食，省减口粮。轻装减粮以激发死战之志。"
      }
    ]
  }
}
