      },
      {
        "term": "申教诏",
        "reading": "shēn jiào zhào",
        "note": "申明教令与告诫。诏,告诫、教令。"
      },
      {
        "term": "讯厥众",
        "reading": "xùn jué zhòng",
        "note": "询问士众。厥,其;讯,问。"
      },
      {
        "term": "变嫌推疑",
        "note": "辨别可疑之处、推断疑难之事。"
      }
    ],
    "1": [
      {
        "term": "服正",
        "note": "使人服从正道、正法。"
      },
      {
        "term": "成耻",
        "note": "养成知耻之心,使人有羞恶则勇于战。"
      },
      {
        "term": "小罪乃杀",
        "note": "小罪亦诛,以立威戒众,使不敢犯大罪。"
      }
    ],
    "2": [
      {
