{
  "1": {
    "0": [
      {
        "term": "正不获意则权",
        "note": "行正道而不能达成本意，则用权宜之变。权，本指称锤，引申为权衡变通。"
      },
      {
        "term": "月食班师",
        "reading": "yuè shí bān shī",
        "note": "遇月食则收兵。班师，还师。古以月食为天变，故止战。"
      },
      {
        "term": "见说",
        "reading": "xiàn yuè",
        "note": "被人悦服。见，被；说，通「悦」。"
      }
    ],
    "1": [
      {
        "term": "不历民病",
        "note": "不在百姓有疾疫之时用兵。历，遭逢；民病，民众疫疾。"
      },
      {
        "term": "不加丧",
        "note": "不趁敌国有丧事而加兵。加，施加、进攻。"
      },
      {
        "term": "兼爱民",
        "note": "对敌我两国之民一并爱护。兼，并、同时。"
      }
    ],
    "2": [
      {
        "term": "大恺",
        "reading": "dà kǎi",
        "note": "盛大的凯乐之礼。恺，通「凯」，军胜还师所奏之乐。"
      },
      {
        "term": "春搜秋狝",
        "reading": "chūn sōu qiū xiǎn",
        "note": "春猎曰搜、秋猎曰狝，借田猎演练军事。"
      },
      {
        "term": "振旅",
        "reading": "zhèn lǚ",
        "note": "整顿、操练军队。旅，军队。"
      }
    ],
    "3": [
      {
        "term": "纵绥不过三舍",
        "reading": "zòng tuí bù guò sān shè",
        "note": "放纵退兵不过三舍。绥，退却；一舍三十里，三舍九十里。"
      },
      {
        "term": "成列而皷",
        "reading": "chéng liè ér gǔ",
        "note": "列好阵才击鼓进攻。皷，同「鼓」，击鼓为进军号令。"
      },
      {
        "term": "舍服",
        "reading": "shě fú",
        "note": "赦免降服者。舍，通「赦」；服，降服之人。"
      },
      {
        "term": "民纪",
        "note": "治民的纲纪、准则。纪，纲纪、法度。"
      }
    ],
    "4": [
      {
        "term": "官民之德",
        "note": "依百姓之德能授以官职。官，用作动词，任用。"
      },
      {
        "term": "狱弭而兵寝",
        "reading": "yù mǐ ér bīng qǐn",
        "note": "讼狱平息、刀兵止息。弭，止息；寝，息止。"
      }
    ],
    "5": [
      {
        "term": "五刑",
        "note": "古代五种刑罚，旧说为墨、劓、剕、宫、大辟。"
      },
      {
        "term": "巡狩",
        "reading": "xún shòu",
        "note": "天子巡行视察诸侯所守之地。狩，通「守」。"
      },
      {
        "term": "冢宰",
        "reading": "zhǒng zǎi",
        "note": "周官六卿之首，总领百官，此司征师之事。"
      },
      {
        "term": "后土四海神祇",
        "reading": "hòu tǔ sì hǎi shén qí",
        "note": "土地之神与四海之神。后土，土神；神祇，天神地神。"
      }
    ],
    "6": [
      {
        "term": "暴神祇",
        "reading": "bào shén qí",
        "note": "侵扰、亵渎神灵。暴，侵犯；神祇，所征国之神。"
      },
      {
        "term": "无毁土功",
        "note": "不毁坏沟洫堤防等水土工程。土功，土木水利之工。"
      },
      {
        "term": "无燔墙屋",
        "reading": "wú fán qiáng wū",
        "note": "不焚烧房舍。燔，焚烧。"
      },
      {
        "term": "不校勿敌",
        "reading": "bù jiào wù dí",
        "note": "不抵抗就不与之为敌。校，较量、抵抗。"
      }
    ],
    "7": [
      {
        "term": "正复厥职",
        "reading": "zhèng fù jué zhí",
        "note": "纠正、恢复其原有职守。厥，其；复，恢复。"
      }
    ],
    "8": [
      {
        "term": "以材力说诸侯",
        "reading": "yǐ cái lì yuè zhū hóu",
        "note": "用财物力量使诸侯悦服。材，通「财」；说，通「悦」。"
      },
      {
        "term": "维诸侯",
        "note": "维系、笼络诸侯。维，系、联结。"
      },
      {
        "term": "比小事大",
        "reading": "bǐ xiǎo shì dà",
        "note": "使小国亲附、奉事大国。比，亲附；事，事奉。"
      }
    ],
    "9": [
      {
        "term": "凭弱犯寡则眚之",
        "reading": "píng ruò fàn guǎ zé shěng zhī",
        "note": "恃强凌弱欺孤，则削其地。凭，恃；眚，减损、削地。"
      },
      {
        "term": "暴内陵外则坛之",
        "reading": "bào nèi líng wài zé shàn zhī",
        "note": "对内暴虐对外欺凌，则废其君。坛，通「𫮃」，谓废黜。"
      },
      {
        "term": "放弑其君则残之",
        "reading": "fàng shì qí jūn zé cán zhī",
        "note": "放逐弑杀其君，则诛灭之。弑，以下犯上之杀；残，灭。"
      },
      {
        "term": "犯令陵政则杜之",
        "reading": "fàn lìng líng zhèng zé dù zhī",
        "note": "违令慢政，则杜绝其与邻往来。杜，塞、绝。"
      }
    ]
  },
  "2": {
    "0": [
      {
        "term": "纯取灋天地",
        "reading": "fǎ",
        "note": "灋同法，取法。谓纯一地取法天地。"
      },
      {
        "term": "士庶",
        "note": "士人与庶民，泛指在下之众。"
      }
    ],
    "1": [
      {
        "term": "伦经",
        "note": "纲常伦序，指尊卑等级的常道。"
      },
      {
        "term": "相陵",
        "reading": "líng",
        "note": "陵同凌，侵越、欺压。"
      }
    ],
    "2": [
      {
        "term": "国容不入军",
        "note": "国容即治国的礼仪威仪，谓不带入军中。"
      },
      {
        "term": "不伐之士",
        "reading": "fá",
        "note": "伐，夸功。不自夸其功的士人。"
      },
      {
        "term": "上戮",
        "reading": "lù",
        "note": "戮，诛杀。上戮即最重的诛罚。"
      }
    ],
    "4": [
      {
        "term": "纵缓",
        "note": "放纵迟缓退却之敌而不紧逼。一作纵绥。"
      },
      {
        "term": "难诱",
        "note": "不追远则不致被敌诱入埋伏。"
      }
    ],
    "5": [
      {
        "term": "有虞氏",
        "note": "指虞舜之世，上古帝王之一。"
      },
      {
        "term": "夏后氏",
        "note": "指夏代，大禹所建，后氏为其号。"
      },
      {
        "term": "交刃",
        "note": "两军兵刃相接，谓临阵接战。"
      },
      {
        "term": "三王",
        "note": "指夏、殷、周三代之王。"
      }
    ],
    "6": [
      {
        "term": "长兵以卫",
        "note": "戈矛等长兵器用于护卫远击。"
      },
      {
        "term": "钝则不济",
        "note": "济，成事。兵器钝重则不能成功。"
      }
    ],
    "7": [
      {
        "term": "戎车",
        "note": "兵车、战车。"
      },
      {
        "term": "钩车",
        "note": "夏代战车名，以端正为先。"
      },
      {
        "term": "元戎",
        "note": "周代战车名，大兵车，以精良为先。"
      }
    ],
    "8": [
      {
        "term": "玄首",
        "note": "玄，黑色。谓以黑色为旗之首。"
      }
    ],
    "9": [
      {
        "term": "章",
        "note": "旌旗衣甲上的徽识图样。"
      },
      {
        "term": "白戎",
        "note": "取虎之白色；一说西方兵象。"
      }
    ],
    "10": [
      {
        "term": "民诎",
        "reading": "qū",
        "note": "诎同屈，屈抑、不振。"
      },
      {
        "term": "诈慝",
        "reading": "tè",
        "note": "慝，邪恶。诈慝即奸诈邪恶之人。"
      },
      {
        "term": "致刃",
        "note": "兵刃相接，谓近战交锋。"
      },
      {
        "term": "逐奔不逾列",
        "note": "追击溃敌不越出本行列。"
      }
    ],
    "11": [
      {
        "term": "民德废",
        "note": "废，废弛、败坏。"
      },
      {
        "term": "介者不拜",
        "note": "介，披甲。甲士行军礼不下拜。"
      },
      {
        "term": "兵车不式",
        "reading": "shì",
        "note": "式同轼，凭轼为敬，兵车上不行此礼。"
      },
      {
        "term": "不齿",
        "note": "不论年齿次序，临危不依长幼为序。"
      }
    ],
    "12": [
      {
        "term": "简民",
        "note": "简，怠慢、轻忽，谓怠慢之民。"
      },
      {
        "term": "罚不迁列",
        "note": "迁列，改换行列。行刑就地，不移易处所。"
      },
      {
        "term": "亡等",
        "reading": "wú",
        "note": "亡同无，谓泯灭争等差之心。"
      },
      {
        "term": "分恶",
        "note": "分担过咎，各以不善归己。"
      }
    ],
    "13": [
      {
        "term": "戍兵",
        "reading": "shù",
        "note": "戍守边防的兵役。"
      },
      {
        "term": "相报",
        "note": "上下相互报答、回应。"
      }
    ],
    "14": [
      {
        "term": "恺歌",
        "reading": "kǎi",
        "note": "恺同凯，得胜所奏之乐歌。"
      },
      {
        "term": "偃伯灵台",
        "reading": "yǎn",
        "note": "偃，息止；伯通霸，指武事。谓于灵台偃息兵戈。"
      }
    ]
  },
  "3": {
    "0": [
      {
        "term": "定爵位",
        "note": "确定官爵等级,使将士各有职守名分。"
      },
      {
        "term": "收游士",
