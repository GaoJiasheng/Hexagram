      }
    ],
    "5": [
      {
        "term": "龟胜微行",
        "note": "卜得吉兆而隐密行动。龟,占卜;微行,潜行不露。"
      },
      {
        "term": "堪物",
        "reading": "kān wù",
        "note": "能胜任器用之事。堪,胜任、承当。"
      },
      {
        "term": "烦陈",
        "reading": "fán zhèn",
        "note": "繁盛严整之阵。陈同阵;烦,盛多。"
      }
    ],
    "6": [
      {
        "term": "枝柱",
        "reading": "zhī zhǔ",
        "note": "互相牵制抵触,不能协同。"
      },
      {
        "term": "吟旷",
        "note": "呻吟而旷废其事,谓军心怨苦废弛。"
      },
      {
        "term": "参伍",
        "reading": "cān wǔ",
        "note": "错综交互、彼此参验配合。"
      },
      {
        "term": "战权",
        "note": "作战的权变之术,因敌制宜而不拘常法。"
      }
    ],
    "7": [
      {
        "term": "间远",
        "reading": "jiàn yuǎn",
        "note": "侦察远方。间,刺探、侦候。"
      },
      {
        "term": "刃上",
        "note": "兵刃相接之际,即临阵交战之时。"
      }
    ],
    "8": [
      {
        "term": "威利章",
        "note": "威严锐利得以彰显。章同彰。"
      },
      {
        "term": "听诛",
        "note": "听受诛罚之令。"
      },
      {
        "term": "无谁其名",
        "note": "不追问受诛者的名姓,谓执法不徇情。谁,诘问。"
      }
    ],
    "9": [
      {
        "term": "灭厉祥",
        "note": "消除灾厉与妖祥。厉,灾疫;祥此指妖异之兆。"
      },
      {
        "term": "成其溢",
        "note": "促成敌人盈满骄溢,使其自致败亡。"
      },
      {
        "term": "兼用其人",
        "note": "怀服敌方之众而并为己用。"
      }
    ],
