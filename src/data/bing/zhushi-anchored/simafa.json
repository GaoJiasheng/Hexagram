      },
      {
        "term": "四守",
        "note": "荣、利、耻、死,士所守持以效命者。"
      },
      {
        "term": "容色积威",
        "note": "以神色仪容积聚威严,使人慑服改意。"
      }
    ],
    "11": [
      {
        "term": "蹈敌制地",
        "note": "踏入敌境而控制地形。蹈,践、入。"
      },
      {
        "term": "以职命之",
        "note": "按各人职守而分派命令。"
      }
    ],
    "12": [
      {
        "term": "身以将之",
        "note": "亲身率领之。将,率领、统御。"
      },
      {
        "term": "三乃成章",
        "note": "施行至三次而成定式。章,法式、条理。"
      },
      {
        "term": "人生之宜谓之灋",
        "reading": "fǎ",
        "note": "顺人本性所宜而行即为法。灋,古法字。"
      }
    ],
    "13": [
      {
        "term": "御其服",
        "note": "统御规范军中服饰等第。御,治、制。"
      },
      {
        "term": "百官无淫服",
        "note": "百官不得僭越穿戴逾分之服。淫,过、滥。"
      },
      {
        "term": "日成行微",
        "note": "每日有所成而行事精微不露。"
      }
    ],
    "14": [
      {
        "term": "事专",
        "note": "专断行事,不拘常正之法。"
      },
      {
        "term": "行其不复",
        "note": "施行非常之法而不可再用者,以济一时之急。复,重复。"
      }
    ]
