      },
      {
        "term": "怿众",
        "reading": "yì zhòng",
        "note": "使军众喜悦。怿,喜悦。"
      },
      {
        "term": "右兵",
        "note": "重视兵器。右,崇尚、看重。"
      },
      {
        "term": "殳矛",
        "reading": "shū máo",
        "note": "殳为竹木长杖兵,矛为长刺兵,皆守御之器。"
      }
    ],
    "3": [
      {
