{
  "1": {
    "0": [
      {
        "term": "吴起",
        "reading": "Wú Qǐ",
        "note": "战国卫人，兵家、政治家，先后仕鲁、魏、楚，《吴子》托名其作。"
      },
      {
        "term": "儒服",
        "note": "儒者所穿之服。起本以儒术进，故服儒服见君。"
      },
      {
        "term": "兵机",
        "note": "用兵的机谋、谋略。机，机要、关键。"
      },
      {
        "term": "魏文侯",
        "note": "战国魏国开国之君，名斯，礼贤下士，魏因之强。"
      }
    ],
    "1": [
      {
        "term": "见占隐",
        "note": "占，推测。从显露之象推测隐微之情。"
      },
      {
        "term": "丹青",
        "note": "丹砂与青雘，古代绘画颜料，此谓彩绘。"
      },
      {
        "term": "承桑氏",
        "note": "上古传说部族之君，修德废武而亡国。"
      },
      {
        "term": "有扈氏",
        "note": "夏初部族，启伐之于甘，此谓恃勇而丧社稷。"
      }
    ],
    "2": [
      {
        "term": "捧觞",
        "reading": "pěng shāng",
        "note": "觞，酒器。捧觞，举酒以敬，示隆礼。"
      },
      {
        "term": "醮",
        "reading": "jiào",
        "note": "古礼中尊者酌酒于卑者而不酬之礼，此谓庙中酌酒授任。"
      },
      {
        "term": "西河",
        "note": "地区名，在今陕西黄河以西一带，魏之西境，吴起守之拒秦。"
      },
      {
        "term": "钧解",
        "note": "钧，同「均」，势均；解，罢兵。谓势均力敌而罢战。"
      }
    ],
    "3": [
      {
        "term": "出陈",
        "note": "陈，同「阵」，军阵。出陈，布列军阵。"
      },
      {
        "term": "元龟",
        "note": "大龟。古以龟甲灼裂之纹占卜吉凶，元龟尤贵。"
      },
      {
        "term": "造大事",
        "note": "造，兴办、举行。大事指军旅征伐之事。"
      }
    ],
    "4": [
      {
        "term": "反本复始",
        "note": "返归根本、复返初始，谓道使人不忘其本。"
      },
      {
        "term": "绥之以道",
        "reading": "suí",
        "note": "绥，安抚。以道安定百姓。"
      },
      {
        "term": "成汤讨桀",
        "note": "商汤伐夏桀而代之，儒兵家举为顺天应人之例。"
      },
      {
        "term": "周武伐纣",
        "note": "周武王伐商纣而灭之，与汤伐桀并称汤武革命。"
      }
    ],
    "5": [
      {
        "term": "制国治军",
        "note": "制，治理。治理国家、整治军队。"
      },
      {
        "term": "五胜者祸",
        "note": "屡战屡胜则民疲国敝，故五胜反招祸，戒黩武。"
      },
      {
        "term": "数胜",
        "reading": "shuò",
        "note": "数，屡次。屡战屡胜。"
      }
    ],
    "6": [
      {
        "term": "积恶",
        "note": "积，积久；恶，怨仇。谓积久而成之仇怨。"
      },
      {
        "term": "因怒兴师",
        "note": "因一时愤怒而起兵，即下文所谓「刚」。"
      },
      {
        "term": "以权服",
        "note": "权，权变、机谋。以权变制服逆兵。"
      }
    ],
    "7": [
      {
        "term": "料人",
        "note": "料，量度、考核。考量百姓之才力以分等编伍。"
      },
      {
        "term": "齐桓",
        "note": "齐桓公，春秋五霸之首，任管仲，九合诸侯。"
      },
      {
        "term": "晋文",
        "note": "晋文公重耳，继齐桓为霸，城濮败楚。"
      },
      {
        "term": "秦缪",
        "note": "秦穆公，春秋秦君，称霸西戎，「缪」同「穆」。"
      }
    ],
    "8": [
      {
        "term": "陈必定",
        "note": "陈同「阵」。军阵必能稳固安定。"
      },
      {
        "term": "不肖",
        "note": "不才、不贤。与「贤者」对举。"
      },
      {
        "term": "有司",
        "note": "主管其事的官吏。司，职掌。"
      }
    ],
    "9": [
      {
        "term": "楚庄王",
        "note": "春秋五霸之一，问鼎中原，此以其忧勤为戒。"
      },
      {
        "term": "申公",
        "note": "楚大夫，一说即申叔时，谏庄王之臣。"
      },
      {
        "term": "其殆矣",
        "reading": "dài",
        "note": "殆，危险。其，大概、恐怕。"
      },
      {
        "term": "君说之",
        "reading": "yuè",
        "note": "说，同「悦」，喜悦。"
      }
    ]
  },
  "2": {
    "0": [
      {
        "term": "六国兵四守",
        "note": "秦楚赵齐燕韩六国之兵从四面环守魏境。魏处中原，四邻皆敌，故曰势不便。"
      }
    ],
    "1": [
      {
        "term": "三晋",
        "note": "韩、赵、魏三家分晋而立，合称三晋。此指与魏接壤者。"
      },
      {
        "term": "陈",
        "reading": "zhèn",
        "note": "通「阵」，军队列阵。下文「击此之道」诸句之陈皆同。"
      },
      {
        "term": "悫",
        "reading": "què",
        "note": "谨厚诚实。「燕性悫」言燕人性情朴谨。"
      },
      {
        "term": "虎贲之士",
        "reading": "hǔ bēn",
        "note": "勇猛如虎奔之士。贲，奔走。古以虎贲称骁勇精锐。"
      },
      {
        "term": "五兵",
        "note": "古指戈、殳、戟、酋矛、夷矛五种兵器，泛指各类兵器。"
      }
    ],
    "2": [
      {
        "term": "祅祥数起",
        "reading": "yāo xiáng",
        "note": "妖异之兆屡屡出现。祅同「妖」，祥指征兆，谓军中讹言怪象。"
      },
      {
        "term": "薪刍",
        "reading": "xīn chú",
        "note": "薪为柴，刍为草。指军中燃料与牲口草料。"
      },
      {
        "term": "见可而进，知难而退",
        "note": "见有利可乘则进，知有险难则退。语本古《军志》兵家通则。"
      }
    ],
    "3": [
      {
        "term": "荡荡无虑",
        "note": "散漫空疏、全无戒备谋虑之貌。"
      },
      {
        "term": "匈匈",
        "reading": "xiōng xiōng",
        "note": "喧扰不安貌。「三军匈匈」谓军中惊扰浮动。"
      },
      {
        "term": "百战不殆",
        "reading": "bù dài",
        "note": "百战而不致危。殆，危险。语近《孙子》「百战不殆」。"
      }
    ],
    "4": [
      {
        "term": "审敌虚实",
        "note": "虚实为兵家要义：虚指敌之空虚薄弱，实指其充实坚固。"
      },
      {
        "term": "失时不从",
        "note": "错失战机、行动不相协从。从，顺、合。"
      },
      {
        "term": "选锐",
        "note": "选拔精锐之卒。锐指劲勇善战者，用为冲锋陷阵之先。"
      }
    ]
  },
  "3": {
    "0": [
      {
        "term": "刍秣",
        "reading": "chú mò",
        "note": "喂牲口的草料。刍指草，秣指谷料。"
      },
      {
        "term": "膏锏",
        "reading": "gāo jiàn",
        "note": "锏为车轴上的金属衬套，膏锏即给车轴上油润滑。"
      }
    ],
    "1": [
      {
        "term": "应麾",
        "reading": "yìng huī",
        "note": "麾为指挥用的旌旗；应麾即随旗号指向而行动。"
      },
      {
        "term": "父子之兵",
        "note": "上下相亲如父子之军队，喻将卒同心、不可离散。"
      }
    ],
    "3": [
      {
        "term": "立尸之地",
        "note": "横陈尸体之地，谓战场凶险、必有死伤。"
      },
      {
        "term": "狐疑",
        "note": "迟疑不决。相传狐性多疑，故以喻犹豫。"
      }
    ],
    "4": [
      {
        "term": "教戒",
        "reading": "jiào jiè",
        "note": "教练与告诫，谓平时训练士卒。"
      },
      {
        "term": "三军",
        "note": "古制大国设上、中、下三军，泛指全军。"
      }
    ],
    "5": [
      {
        "term": "什伍",
        "reading": "shí wǔ",
        "note": "古代军队编制，五人为伍，十人为什。"
      },
      {
        "term": "厮养",
        "reading": "sī yǎng",
        "note": "军中供役使的杂务，如打柴炊饭、饲马等。"
      },
      {
        "term": "严办",
        "note": "严整地准备，此指披甲整装、整备器械。"
      }
    ],
    "6": [
      {
        "term": "天灶",
        "note": "大山谷的入口，地形低陷如灶口，行军所忌。"
      },
      {
        "term": "龙头",
        "note": "大山的顶端，地势高峻，行军所忌。"
      },
      {
        "term": "招摇",
        "reading": "zhāo yáo",
        "note": "北斗第七星（摇光），古以之定方位、为军旗所象。"
      }
    ],
    "7": [
      {
        "term": "凉庑",
        "reading": "liáng wǔ",
        "note": "庑为堂下廊屋，凉庑指夏日供马遮阳的凉棚。"
      },
      {
        "term": "毛鬣",
        "reading": "máo liè",
        "note": "鬣指马颈上的长毛，毛鬣泛指马的鬃毛。"
      },
      {
        "term": "鞍、勒、衔、辔",
        "note": "马具：鞍为马鞍，勒为带嚼笼头，衔为口中嚼子，辔为缰绳。"
      }
    ]
  },
  "4": {
    "0": [
      {
        "term": "轻合",
        "reading": "qīng hé",
        "note": "轻率与敌交战。合,交锋、接战。"
      },
      {
        "term": "约",
        "reading": "yuē",
        "note": "此指法令简省。下文「法令省而不烦」即释此。"
      }
    ],
    "1": [
      {
        "term": "气机",
        "reading": "qì jī",
        "note": "用兵四关键之一,指掌控三军士气张弛之机。"
      },
      {
        "term": "管辖",
        "reading": "guǎn xiá",
        "note": "车轴两端的键。管为轴端套,辖为穿轴之销,固轮使不脱。"
      },
      {
        "term": "橹楫",
        "reading": "lǔ jí",
        "note": "橹为大桨,楫为短桨,泛指行船之具。"
      }
    ],
    "2": [
      {
        "term": "鼙鼓金铎",
        "reading": "pí gǔ jīn duó",
        "note": "鼙为骑用小鼓,金铎为铜铃,皆军中号令之器。"
      },
      {
        "term": "麾帜",
        "reading": "huī zhì",
        "note": "麾为指挥用旗,帜为标识之旗。"
      }
    ],
    "3": [
      {
        "term": "因形用权",
        "reading": "yīn xíng yòng quán",
        "note": "依敌我形势而行权变。权,与「常」相对,谓机变。"
      },
      {
        "term": "草楚幽秽",
        "reading": "cǎo chǔ yōu huì",
        "note": "楚,丛生草木;幽秽,深密芜杂。状沼泽荒草蔽塞。"
      },
      {
        "term": "风飙",
        "reading": "fēng biāo",
        "note": "暴风、狂风。飙,疾风。"
      }
    ],
    "4": [
      {
        "term": "尝",
        "reading": "cháng",
        "note": "试探。以轻兵接触探敌虚实曰尝。"
      },
      {
        "term": "北",
        "reading": "běi",
        "note": "败走、败退。「务于北」谓佯装败退。"
      },
      {
        "term": "讙哗",
        "reading": "huān huá",
        "note": "喧闹吵嚷。讙同「喧」。"
      }
    ]
  },
  "5": {
    "0": [
      {
        "term": "旌旗旛麾",
        "reading": "jīng qí fān huī",
        "note": "皆军中指挥用旗。旛为狭长垂旗，麾为指挥旗。"
      },
      {
        "term": "金鼓笳笛",
        "reading": "jīn gǔ jiā dí",
        "note": "金即铙钲，鸣金示退；鼓示进；笳笛为夜战传令管乐。"
      },
      {
        "term": "再吹而聚",
        "reading": "zài chuī ér jù",
        "note": "再，第二次。号角吹第二声则集合。"
      }
    ],
    "1": [
      {
        "term": "邀之于阨",
        "reading": "yāo zhī yú è",
        "note": "邀，半路拦击；阨同隘，险狭之地。"
      },
      {
        "term": "以一击十",
        "note": "以少敌众。下文以十击百、以千击万递言寡击众之术。"
      }
    ],
    "2": [
      {
        "term": "各军一衢",
        "reading": "gè jūn yī qú",
        "note": "衢，四通之道。谓每军占据一路。"
      },
      {
        "term": "斩使焚书",
        "note": "杀其来使、焚其文书，绝其和议以决战。"
      },
      {
        "term": "衔枚",
        "reading": "xián méi",
        "note": "枚形如箸，横衔口中以止喧，行军求其无声。"
      },
      {
        "term": "佯北",
        "reading": "yáng běi",
        "note": "北，败走。佯北谓诈败诱敌。"
      }
    ],
    "3": [
      {
        "term": "薄我",
        "reading": "bó wǒ",
        "note": "薄，逼近、迫近。谓敌逼压我军。"
      },
      {
        "term": "以方从之",
        "note": "以方阵随而追击之。方阵四面御敌，利于寡当众。"
      }
    ],
    "4": [
      {
        "term": "谿谷",
        "reading": "xī gǔ",
        "note": "谿同溪。两山间有水之地。"
      },
      {
        "term": "鼓噪",
        "reading": "gǔ zào",
        "note": "擂鼓呐喊以振军威、慑敌气。"
      },
      {
        "term": "且射且虏",
        "note": "且…且…，一边…一边…。边射杀边俘获。"
      }
    ],
    "5": [
      {
        "term": "谷战",
        "note": "于山谷狭地之战。地狭兵不得展，故募材士轻兵为之。"
      },
      {
        "term": "材士",
        "reading": "cái shì",
        "note": "材同才。骁勇有力之士。"
      },
      {
        "term": "出旌列旆",
        "reading": "chū jīng liè pèi",
        "note": "旆，旗末垂饰之旒，泛指军旗。张旗示众以惑敌。"
      },
      {
        "term": "荧之",
        "reading": "yíng zhī",
        "note": "荧，炫惑、眩乱。谓张旗以惑乱敌人。"
      }
    ],
    "6": [
      {
        "term": "没辕",
        "reading": "mò yuán",
        "note": "辕，车前驾马之直木。没辕谓水深淹及车辕。"
      },
      {
        "term": "舟楫",
        "reading": "zhōu jí",
        "note": "楫，船桨。舟楫泛指船只渡具。"
      },
      {
        "term": "为奇以胜之",
        "reading": "wéi qí",
        "note": "奇，出其不意之兵，与正相对。设奇兵以制胜。"
      },
      {
        "term": "半渡而薄之",
        "note": "乘敌渡水及半、首尾不接时逼击，兵家常法。"
      }
    ],
    "7": [
      {
        "term": "贵高贱下",
        "note": "贵、贱犹言重、轻。用车重高地而避低洼。"
      },
      {
        "term": "逐其迹",
        "note": "迹，车辙马迹。循敌车迹之路而追，知其路可行。"
      }
    ],
    "8": [
      {
        "term": "暴寇",
        "reading": "bào kòu",
        "note": "凶暴来掠之寇敌。"
      },
      {
        "term": "不属",
        "reading": "bù zhǔ",
        "note": "属，连接。不属谓行伍断绝、掉队跟不上。"
      },
      {
        "term": "其兵可覆",
        "reading": "qí bīng kě fù",
        "note": "覆，倾覆、歼灭。谓可一举破其军。"
      }
    ],
    "9": [
      {
        "term": "御其禄秩",
        "reading": "yù qí lù zhì",
        "note": "御，统御、管控；禄秩，官俸品级，此指府库财赋。"
      },
      {
        "term": "无刊其木",
        "reading": "wú kān qí mù",
        "note": "刊，砍削。勿伐其树木，示不残民。"
      },
      {
        "term": "燔其积聚",
        "reading": "fán qí jī jù",
        "note": "燔，焚烧；积聚，囤积之粮货。勿烧其储积。"
      }
    ]
  },
  "6": {
    "0": [
      {
        "term": "发号布令",
        "note": "发布军令号令。号、令同义连用,指军中政令。"
      },
      {
        "term": "交兵接刃",
        "note": "两军交战、兵刃相接,谓近身搏杀之际。"
      }
    ],
    "2": [
      {
        "term": "庙廷",
        "reading": "miào tíng",
        "note": "宗庙的庭院。古者飨功、誓师多于宗庙行之。"
      },
      {
        "term": "上牢",
        "reading": "shàng láo",
        "note": "牢指祭飨所用牲畜;上牢谓牲牢之上等,牛羊豕俱备者。"
      },
      {
        "term": "介胄",
        "reading": "jiè zhòu",
        "note": "介谓铠甲,胄谓头盔。介胄即披甲戴盔,引申为武装。"
      },
      {
        "term": "西河",
        "note": "魏地名,在今陕西东部黄河西岸,吴起曾守此拒秦。"
      }
    ],
    "3": [
