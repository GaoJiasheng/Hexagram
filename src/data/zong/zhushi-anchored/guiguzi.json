{
  "1": {
    "0": [
      {
        "term": "粤若稽古",
        "reading": "yuè ruò jī gǔ",
        "note": "考察上古之事。粤若为发语词,稽古即考察古事,《尚书》起首习用语。"
      },
      {
        "term": "见变化之朕",
        "reading": "zhèn",
        "note": "朕谓征兆、迹象。一说本指舟缝,引申为隐微可见之兆。"
      },
      {
        "term": "无为以牧之",
        "reading": "mù",
        "note": "牧本义牧养牲畜,引申为驾驭、统御;此谓顺其情而制之。"
      },
      {
        "term": "捭阖",
        "reading": "bǎi hé",
        "note": "本篇术语。捭谓开、言、属阳,阖谓闭、默、属阴。一说捭即分开。"
      },
      {
        "term": "圆方之门户",
        "reading": "yuán fāng",
        "note": "圆指变通、方指守正,喻应物之枢要,万事所从出入。"
      }
    ]
  },
  "2": {
    "0": [
      {
        "term": "大化者",
        "note": "以大道教化天下之人；化，教化感化。一说指通晓造化大道者。"
      },
      {
        "term": "钓语",
        "note": "如垂钓般以言辞探引对方，使其吐露实情。鬼谷术语。"
      },
      {
        "term": "罝网",
        "reading": "jū wǎng",
        "note": "捕捉鸟兽的网。罝，捕兽之网。"
      },
      {
        "term": "螣蛇",
        "reading": "téng shé",
        "note": "传说能腾云驾雾的神蛇，此喻所指必中、灵验无差。"
      }
    ]
  },
  "3": {
    "0": [
      {
        "term": "内揵",
        "reading": "nèi jiàn",
        "note": "内,进献说辞以入君心;揵,扣合君主所谋。一说揵通楗,门闩,喻契合。"
      },
      {
        "term": "蛈母",
        "reading": "tiě mǔ",
        "note": "即母蛛,一说蛈蝪、土蜘蛛。喻母子相随、出入无迹,以状内合之亲。"
      },
      {
        "term": "隐度",
        "reading": "yǐn duó",
        "note": "暗中揣度。隐,潜藏不露;度,估量。"
      },
      {
        "term": "若管取揵",
        "note": "管谓锁管,揵谓门闩。以钥开锁,喻内合之严丝合缝。"
      },
      {
        "term": "退为大仪",
        "note": "退身引去乃最高法则。仪,法度、准则。一说大仪指天地。"
      }
    ]
  },
  "4": {
    "0": [
      {
        "term": "巇者，罅也",
        "reading": "xī zhě xià yě",
        "note": "巇，山间裂缝；罅，缝隙。释篇名「抵巇」之巇即事物间的裂缝、隙漏。"
      },
      {
        "term": "眹",
        "reading": "zhèn",
        "note": "通「朕」，征兆、迹象。「有眹」谓裂缝初起已有可察之兆。"
      },
      {
        "term": "牙蘖",
        "reading": "yá niè",
        "note": "牙通「芽」，蘖为树根新生之芽；喻祸患萌生的端绪。"
      },
      {
        "term": "五帝",
        "reading": "wǔ dì",
        "note": "上古五位帝王，旧说指黄帝、颛顼、帝喾、尧、舜；下文三王指夏禹、商汤、周文武。"
      }
    ]
  },
  "5": {
    "0": [
      {
        "term": "飞箝",
        "reading": "fēi qián",
        "note": "本篇术语。飞,激扬褒奖以张其势;箝,钳持牵系使不脱。先激扬而后箝制谓飞箝"
      },
      {
        "term": "钩箝",
        "reading": "gōu qián",
        "note": "钩取与箝持。以言辞钩出对方实情而后箝制之。"
      },
      {
        "term": "隐括",
        "reading": "yǐn kuò",
        "note": "亦作檃栝,本指矫正木材曲直之器,引申为矫正、补正使合度。"
      },
      {
        "term": "抵巇",
        "reading": "dǐ xī",
        "note": "本书篇名,亦其术。巇,缝隙裂痕;抵,弥塞或乘隙。乘其间隙而制之。"
      }
    ]
  },
  "6": {
    "0": [
      {
        "term": "化转环属",
        "note": "事态像圆环般辗转相连、变化不断。属,连接。"
      },
      {
        "term": "飞箝之术",
        "reading": "fēi qián",
        "note": "本书《飞箝》篇所论之术,以言辞钩取实情再加钳制。"
      },
      {
        "term": "伊尹五就汤，五就桀",
        "note": "传伊尹往来商汤与夏桀间以观其志,终佐汤灭夏。就,归就。"
      },
      {
        "term": "知𥈠",
        "reading": "zhì ruì",
        "note": "𥈠同睿,深明通达。一说指见识明察。"
      }
    ]
  },
  "7": {
    "0": [
      {
        "term": "揣诸侯之情",
        "reading": "chuǎi",
        "note": "揣,度量、估测。揣情即揣摩对方真实意图、处境与好恶。"
      },
      {
        "term": "不肖",
        "reading": "bù xiào",
        "note": "不才、无德,与「贤」相对。肖,似;不肖谓不似先人之贤。"
      },
      {
        "term": "賔客",
        "reading": "bīn",
        "note": "賔即「宾」之异体。賔客指依附于诸侯门下的食客、谋士。"
      },
      {
        "term": "蜎飞蠕动",
        "reading": "yuān rú",
        "note": "蜎,蚊类幼虫,引申指飞虫;蠕动,虫豸缓行。泛指微细生物。"
      }
    ]
  },
  "8": {
    "0": [
      {
        "term": "塞窌匿端",
        "reading": "sè jiào nì duān",
        "note": "窌,地窖。塞住窖口、藏起头绪,喻深藏行迹使人不见。"
      },
      {
        "term": "符应在彼",
        "note": "符,内心相应之征兆。摩术施于此而内符显于彼。"
      },
      {
        "term": "谋之于阴",
        "note": "阴谓暗中、隐密;阳谓显明处。圣人暗谋而显成,故称神明。"
      },
      {
        "term": "道数与时相偶",
        "reading": "ǒu",
        "note": "偶,配合。法则术数须与时机相配,事乃成。"
      }
    ]
  },
  "9": {
    "0": [
      {
        "term": "资之也",
        "reading": "zī",
        "note": "资,凭借、取资。指借重对方力量为己所用。"
      },
      {
        "term": "钓几也",
        "reading": "jī",
        "note": "几,隐微之情。钓几,钓取对方隐微的真情。"
      },
      {
        "term": "謟而干忠",
        "reading": "tāo",
        "note": "謟通谄,谄媚;干,求取。一说谓以谄求人信己之忠。"
      },
      {
        "term": "众口烁金",
        "reading": "shuò",
        "note": "烁,熔化。众口可熔金,喻众言足以混淆是非。"
      }
    ]
  },
  "10": {
    "0": [
      {
        "term": "三仪",
        "reading": "sān yí",
        "note": "谋划的三个层级,即下文上、中、下三等,以之参验而生奇计。"
      },
      {
        "term": "司南",
        "reading": "sī nán",
        "note": "古代指示方向的器具,指南车之属,此喻揣度才能实情如辨方向。"
      },
      {
        "term": "三才",
        "reading": "sān cái",
        "note": "指上文仁人、勇士、智者三种人才。"
      },
      {
        "term": "阴道而阳取之",
        "note": "暗中筹划行事,而在明处取得成效;阴谓隐,阳谓显。"
      }
    ]
  },
  "11": {
    "0": [
      {
