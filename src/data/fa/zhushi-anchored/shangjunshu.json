      },
      {
        "term": "甘龙",
        "note": "秦孝公时大夫,反对变法,下文与商鞅论辩。"
      },
      {
        "term": "御于君",
        "note": "御,侍奉、陪侍;谓陪侍在国君身边。"
      }
    ],
    "1": [
      {
        "term": "代立",
        "note": "代,继承;立,君位。谓继位为君。"
      },
      {
        "term": "社稷",
        "reading": "shè jì",
        "note": "社为土神,稷为谷神;古以社稷代指国家政权。"
      },
      {
        "term": "错法",
