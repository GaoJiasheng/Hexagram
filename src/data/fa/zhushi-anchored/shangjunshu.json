    "2": [
      {
        "term": "中法",
        "reading": "zhòng fǎ",
        "note": "合于法度。中，符合、切中。"
      },
      {
        "term": "彊",
        "reading": "qiáng",
        "note": "「强」的异体字，强盛。"
      }
    ]
  },
  "22": {
    "0": [
      {
        "term": "禁使",
        "note": "禁止与驱使;指君主约束、役使臣民。本篇篇题,论君主驭下之术。"
      },
      {
        "term": "势数",
        "reading": "shì shù",
        "note": "势指客观形势、地位,数指法度术数。商鞅以为治国当恃势数而不恃人之强信。"
      },
      {
        "term": "飞蓬",
