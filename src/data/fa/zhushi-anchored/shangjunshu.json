      },
      {
        "term": "吏习而民安",
        "note": "习,熟习;官吏熟悉旧法,百姓安于旧习。"
      },
      {
        "term": "孰察",
        "note": "孰,通熟,仔细;孰察即仔细考察。"
      }
    ],
    "5": [
      {
