        "note": "刀剑等近身兵器，此引申指持短兵的近卫之兵。"
      }
    ],
    "2": [
      {
        "term": "盈论",
        "note": "盈，满；论，计功。斩首达到规定定额而论功行赏。"
      },
      {
        "term": "上造",
        "note": "秦二十等爵第二级。下文簪褭、公乘、庶长等皆爵名。"
      },
      {
        "term": "大良造",
        "note": "秦二十等爵第十六级，商鞅曾任此爵，秦前期最高军政长官。"
      },
      {
        "term": "税邑",
        "note": "所赐食邑，受爵者收取其地若干家之赋税。"
      },
      {
        "term": "受客",
        "note": "客谓食客；准其畜养食客。"
      }
    ],
    "3": [
      {
        "term": "狱法",
        "note": "断狱论罪之法。狱，讼案、刑案。"
      },
      {
        "term": "隶仆",
        "note": "奴隶仆役。高爵者犯罪，不罚为他人之奴仆。"
      },
      {
        "term": "贬",
        "note": "降夺爵级。下文「已」谓罢黜其爵。"
      },
      {
        "term": "墓树",
        "note": "坟上所植之树，按官爵级数定其多寡，以别尊卑。"
      }
    ],
    "4": [
      {
        "term": "国司空",
        "note": "官名，掌工程营造，此司估量城防尺寸。"
      },
      {
        "term": "最启",
        "note": "最，首功；启，开。攻城先破者评为头等之功。"
      },
      {
        "term": "燔柱",
        "note": "燔，焚烧。烧城基支柱使城崩，古攻城术。"
      },
      {
        "term": "陷队之士",
        "note": "突陷敌阵之敢死士，每面城墙十八人。"
      },
      {
        "term": "黥劓",
        "note": "黥，刺面涂墨；劓，割鼻。皆肉刑，以辱罚怯战者。"
      }
    ]
  },
  "19": {
    "0": [
      {
        "term": "六虱",
        "reading": "liù shī",
        "note": "商君书所斥六种害政之事，虱喻蠹蚀国力者；下章列其目。"
      },
      {
        "term": "利出一孔",
        "note": "使利禄只从耕战一途而出，绝其余径，令民专于农战。"
      },
      {
        "term": "重强",
        "reading": "chóng qiáng",
        "note": "加倍之强。富而后治、治而后富相成，故曰重强。"
      }
    ],
    "1": [
      {
        "term": "常官",
        "note": "国家固有常设之职，此指农、商、官三种本职。"
      },
      {
        "term": "岁",
        "note": "六虱之一，谓农人讲求年成有余而苟且偷安。"
      },
      {
        "term": "治大国，小；治小国，大",
        "note": "治大国当如治小国之细密，治小国当如治大国之顾全大局。"
      }
    ],
    "2": [
      {
        "term": "离娄",
        "reading": "Lí Lóu",
        "note": "传为黄帝时人，目力极明，能见百步之外秋毫；孟子亦称其明。"
      },
      {
        "term": "乌获",
        "reading": "Wū Huò",
        "note": "战国秦武王时力士，能举千钧，与任鄙、孟说齐名。"
      },
      {
        "term": "唐蔑死于垂沙",
        "note": "楚将唐蔑（唐昧）于垂沙之役败于齐韩魏联军而死，事在前301年。"
      },
      {
        "term": "庄𫏋发于内",
        "reading": "Zhuāng Qiāo",
        "note": "庄𫏋，战国楚人，曾率众于楚境内起事，致楚分裂。"
      }
    ]
  },
  "20": {
    "0": [
      {
        "term": "外事",
        "note": "对外之事，指对外用兵作战，与下章「内事」(务农)相对。"
      },
      {
        "term": "淫道",
        "note": "使民弃农去战的放纵歧途，指辩智、游宦、文学私名三者。"
      },
      {
        "term": "游宦",
        "reading": "yóu huàn",
        "note": "离乡四处奔走以求仕进谋官，法家视为弃农去战之徒。"
      },
      {
        "term": "设鼠而饵以狸",
        "note": "摆鼠为局却用猫作诱饵，喻手段与目的相违、必不能成；狸即野猫。"
      }
    ],
    "1": [
      {
        "term": "内事",
        "note": "对内之事，指农耕，与上章「外事」(作战)相对。"
      },
      {
        "term": "末事",
        "note": "指工商技巧之业。法家重农抑商，称农为本、商工为末。"
      },
      {
        "term": "籴",
        "reading": "dí",
        "note": "买进粮食，与卖出粮食的「粜」(tiào)相对。"
      },
      {
        "term": "地利",
        "note": "指土地耕作所生之利，即务农之业。"
      }
    ],
    "2": [
      {
        "term": "边利",
        "note": "边境征战所得之利，如军功爵赏。商君主张尽归于战士以劝战。"
      },
      {
        "term": "市利",
        "note": "市场交易之利。商君主张尽归于农，以重农抑末。"
      }
    ]
  },
  "21": {
    "0": [
      {
        "term": "五官",
        "note": "泛指分掌各职的众官。古以司徒、司马、司空、司士、司寇为五官，此处指百官分职。"
      },
      {
