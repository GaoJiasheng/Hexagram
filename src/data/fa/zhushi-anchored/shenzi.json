{
  "1": {
    "0": [
      {
        "term": "辟户牖",
        "reading": "bì hù yǒu",
        "note": "辟，开。户，门。牖，窗。谓开门窗采光。"
      },
      {
        "term": "准上而比于下",
        "note": "准，以为准则。比，参照。谓以君上为则、参照下情。"
      }
    ],
    "1": [
      {
        "term": "毛嫱",
        "reading": "máo qiáng",
        "note": "古代美女名，与西施并称，传为越王宠姬。"
      },
      {
        "term": "皮倛",
        "reading": "pí qī",
        "note": "倛，古驱疫所戴丑陋假面;皮倛谓丑恶面具戏装。"
      },
      {
        "term": "緆",
        "reading": "xì",
        "note": "细布，精细的麻葛之衣。"
      },
      {
        "term": "矰",
        "reading": "zēng",
        "note": "系丝绳以射飞鸟的短箭。"
      },
      {
        "term": "五伯",
        "reading": "wǔ bà",
        "note": "即五霸，春秋齐桓、晋文等霸主。伯，通霸。"
      }
    ],
    "2": [
      {
        "term": "国家日缪",
        "reading": "guó jiā rì miù",
        "note": "缪，通谬，乖乱败坏。日缪，一天天败坏。"
      },
      {
        "term": "道理匮",
        "note": "道理，指治理之条理法度。匮，匮乏不足。"
      }
    ],
    "3": [
      {
        "term": "理无由通",
        "note": "理，治理之道。无由通，无从畅达。谓无尊者则治道不行。"
      },
      {
        "term": "一人心",
        "note": "一，统一，使动用法。谓统一人心。"
      }
    ],
    "4": [
      {
        "term": "投钩",
        "reading": "tóu gōu",
        "note": "钩，抓阄之具。投钩，抓阄，以偶然定分。"
      },
      {
        "term": "投策",
        "reading": "tóu cè",
        "note": "策，签。投策，抽签，以偶然分马。"
      },
      {
        "term": "蓍龟",
        "reading": "shī guī",
        "note": "蓍草与龟甲，古占卜之具，此喻立公共之识。"
      },
      {
        "term": "书契",
        "reading": "shū qì",
        "note": "契券文书。古刻木为契、剖分为信，以立公信。"
      },
      {
        "term": "羡赏",
        "reading": "xiàn shǎng",
        "note": "羡，余、滥。羡赏，法外滥施的赏赐。"
      }
    ]
  },
  "2": {
    "0": [
      {
        "term": "天道因则大，化则细",
        "note": "因,顺应物性;化,强为改变。顺则成大,逆改则狭小,本篇主旨。"
      },
      {
        "term": "自为",
        "reading": "zì wéi",
        "note": "为自己打算、谋自身之利。慎子以为人情皆自为,治术当顺而用之。"
      },
      {
        "term": "不臣",
        "reading": "bù chén",
        "note": "不收为臣属。臣此处用如动词。"
      },
      {
        "term": "入难",
        "reading": "rù nàn",
        "note": "共赴危难、一同涉险。难,患难、祸患。"
      }
    ]
  },
  "3": {
    "0": [
      {
        "term": "大君",
        "note": "至高无上的君主。下文「太上」即指此。"
      },
      {
        "term": "兼畜下者也",
        "note": "兼容并畜养在下者。畜，养也。"
      },
      {
        "term": "因民之能为资",
        "note": "凭借民众的才能作为凭借。因，凭借、顺任。"
      },
      {
        "term": "无能去取焉",
        "note": "没有什么可去除舍弃的。去取，犹言取舍、去留。"
      }
    ],
    "1": [
      {
        "term": "仰成而已",
        "note": "仰赖现成之功罢了，谓坐享其成。"
      },
      {
        "term": "蒙劳",
        "note": "蒙受劳苦。蒙，承受、担当。"
      },
      {
        "term": "自覆掩",
        "note": "自我遮蔽掩藏，谓藏私不尽其能。"
      },
      {
        "term": "逆乱之道",
        "note": "悖逆祸乱之道。逆，违悖。"
      }
    ],
    "2": [
      {
        "term": "尽被下",
        "note": "全面覆盖下属。被，覆盖、加于。"
      },
      {
        "term": "不赡",
        "reading": "shàn",
        "note": "不足、不能周给。赡，供给、足。"
      }
    ],
    "3": [
      {
        "term": "躬事",
        "note": "亲身办理具体事务。躬，亲自。"
      },
      {
        "term": "君臣易位",
        "note": "君臣对调位置。易，交换。"
      },
      {
        "term": "倒逆",
        "note": "颠倒悖逆，谓君臣职分错置。"
      }
    ]
  },
  "4": {
    "0": [
      {
        "term": "比干",
        "reading": "bǐ gān",
        "note": "商纣王叔父,谏纣不听,被剖心而死,古之忠臣典型。"
      },
      {
        "term": "子胥",
        "reading": "zǐ xū",
        "note": "伍子胥,吴国大夫,屡谏夫差,终被赐死,与比干并称忠臣。"
      },
      {
        "term": "瞽叟",
        "reading": "gǔ sǒu",
        "note": "舜之父,顽愚屡欲害舜;此谓舜终放逐其父。"
      },
      {
        "term": "运非",
        "reading": "yùn fēi",
        "note": "运,转;颠倒是非之谓,指桀之恶名。"
      }
    ]
  },
  "5": {
    "0": [
      {
        "term": "嬖妾",
        "reading": "bì qiè",
        "note": "受宠幸的妾。嬖,宠爱。"
      },
      {
        "term": "庶孽",
        "reading": "shù niè",
        "note": "妾媵所生之子。孽,旁出非正之子。"
      },
      {
        "term": "两位",
        "note": "两相并立而处于同等之位,势均不分尊卑。"
      },
      {
        "term": "孽疑其宗",
        "note": "庶子之位与宗子相疑混。宗,嫡长一系之宗子。"
      }
    ]
  },
  "6": {
    "0": [
      {
        "term": "策",
        "reading": "cè",
        "note": "竹制签筹,用以抽取定分,犹今之抽签。"
      },
      {
        "term": "钩",
        "reading": "gōu",
        "note": "探取之具,用以阄取定分,犹今之抓阄。"
      },
      {
        "term": "弗躬",
        "reading": "fú gōng",
        "note": "弗,不;躬,亲身。谓君不亲自裁断其事。"
      },
      {
        "term": "各以其分",
        "reading": "gè yǐ qí fèn",
        "note": "分,名分、应得之份。谓各依本分受其赏罚。"
      }
    ]
  },
  "7": {
    "0": [
      {
        "term": "据法倚数",
        "note": "凭依法度与术数。数指治国法则、术数，与「法」并举，谓君主治事的客观准据。"
      },
      {
        "term": "无法之劳，不图于功",
        "reading": "bù tú yú gōng",
        "note": "图，计度、计算。谓不合于法度的勤劳，不计入功绩加以奖赏。"
      },
      {
        "term": "法不遗爱",
        "note": "遗，遗漏、放过。谓执法不因私爱而对所亲爱者网开一面。"
      },
      {
        "term": "唯法所在",
        "note": "唯，只、惟独。谓政事一断于法，惟法度所在为依归，不取决于君主好恶。"
      }
    ]
  },
