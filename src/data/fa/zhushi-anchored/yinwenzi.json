{
  "1": {
    "0": [
      {
        "term": "仲尼",
        "reading": "zhòng ní",
        "note": "孔子字仲尼。下引语见《论语·子路》正名之说。"
      },
      {
        "term": "正名",
        "note": "端正名分,使名实相符、名当其实。"
      }
    ],
    "2": [
      {
        "term": "万物之奥",
        "reading": "ào",
        "note": "奥,室之西南隅,引申为深藏、奥藏。语出《老子》六十二章。"
      },
      {
        "term": "名分日离",
        "reading": "fèn",
        "note": "名分,名位与本分。谓善与不善之分判日益清楚。"
      }
    ],
    "3": [
      {
        "term": "无为而自治",
        "note": "道家语,不施作为而天下自然得治。"
      },
      {
        "term": "徼终",
        "reading": "jiào",
        "note": "徼,边际、尽头。徼终犹言到达终点。"
      }
    ],
    "5": [
      {
        "term": "况谓之名",
        "reading": "kuàng",
        "note": "况谓,比拟称谓,指带评判色彩的称呼,如贤愚爱憎。"
      },
      {
        "term": "齐俗之法",
        "note": "齐,划一、整齐。划一风俗、统一异同的法度。"
      },
      {
        "term": "平准之法",
        "note": "平准,衡量校准,指度量衡一类标准之法。"
      },
      {
        "term": "律度权量",
        "reading": "lǜ dù quán liàng",
        "note": "律,定音律管;度,长短;权,轻重;量,容积。"
      }
    ],
    "6": [
      {
        "term": "密用",
        "note": "秘密运用,不令外人知。术为君主驭下之隐秘手段。"
      },
      {
        "term": "妄窥",
        "reading": "wàng kuī",
        "note": "胡乱窥探。窥,偷看、探察。"
      }
    ],
    "8": [
      {
        "term": "顽嚚凶愚",
        "reading": "wán yín",
        "note": "顽,愚钝;嚚,口不道忠信、奸诈愚妄。皆指恶名。"
      }
    ],
    "10": [
      {
        "term": "通称",
        "note": "通用之称,可附于多种事物,如「好」可言好牛好马。"
      },
      {
        "term": "无方",
        "note": "没有定准、不固定一处。方,常法、定向。"
      }
    ],
    "11": [
      {
        "term": "五臭",
        "reading": "wǔ xiù",
        "note": "臭,气味。五臭谓膻、焦、香、腥、腐五种气味。"
      },
      {
        "term": "韵商而舍征",
        "reading": "shāng;zhǐ",
        "note": "商、征,五音之二。韵,喜爱其声韵;舍,舍弃。"
      },
      {
        "term": "好膻而恶焦",
        "reading": "shān",
        "note": "膻,羊臊味;焦,烧焦味。各举一气味为好恶之例。"
      }
    ],
    "12": [
      {
        "term": "聋、瞽",
        "reading": "gǔ",
        "note": "瞽,盲人。聋瞽并举,谓耳目不聪明者。"
      }
    ],
    "13": [
      {
        "term": "病诸",
        "note": "病,以为难、患苦;诸,「之乎」合音。谓贤圣亦以此为难。"
      }
    ],
    "15": [
      {
        "term": "坚伪偏抗",
        "note": "坚执、虚伪、偏激、抗争,指无益于事的过激之行。"
      }
    ],
    "17": [
      {
        "term": "工倕",
        "reading": "chuí",
        "note": "倕,传为尧时巧匠,一说舜臣,古以为巧工之代称。"
      }
    ],
    "18": [
      {
        "term": "夷其险",
        "reading": "yí",
        "note": "夷,铲平、削平。谓凭道铲平险阻。"
      }
    ],
    "20": [
      {
        "term": "田骈",
        "reading": "tián pián",
        "note": "战国齐稷下学者,属道家黄老一派,与彭蒙、慎到同流。"
      },
      {
        "term": "彭蒙",
        "note": "战国齐人,稷下学者,田骈之师,主齐物贵分。"
      },
      {
        "term": "游宦",
        "reading": "yóu huàn",
        "note": "离乡到他国求取官职。宦,做官。"
      },
      {
        "term": "雉兔",
        "reading": "zhì",
        "note": "雉,野鸡。雉兔指野外无主之禽兽,故众人逐之。"
      }
    ],
    "25": [
      {
        "term": "齐桓好衣紫",
        "reading": "huán",
        "note": "齐桓公爱穿紫衣,事见《韩非子·外储说左上》,喻上行下效。"
      },
      {
        "term": "楚庄爱细腰",
        "note": "楚庄王好细腰,臣下节食求瘦,故一国有饥色。"
      }
    ],
    "26": [
      {
        "term": "文公以俭矫之",
        "note": "晋文公重耳以俭朴风化矫正晋国奢风。矫,匡正。"
      },
      {
        "term": "怒蛙而轼之",
        "reading": "shì",
        "note": "轼,车前横木,凭轼为致敬之礼。勾践向怒蛙凭轼以励士勇。"
      },
      {
        "term": "脱粟之饭",
        "reading": "sù",
        "note": "脱粟,仅去谷皮的糙米。谓饮食粗简。"
      }
    ],
    "33": [
      {
        "term": "宣王好射",
        "note": "齐宣王。下文用强弓三石却自称九石,即悦名丧实之例。"
      },
      {
        "term": "三石",
        "reading": "dàn",
        "note": "石,古弓力与重量单位,一石约百二十斤。三石言弓力。"
      }
    ],
    "34": [
      {
        "term": "黄公",
        "note": "齐人,寓言人物,好谦毁女致女嫁不出,见违名失实。"
      },
      {
        "term": "国色",
        "note": "容貌冠绝一国之美女。"
      },
      {
        "term": "鳏夫",
        "reading": "guān",
        "note": "鳏,老而无妻者。"
      }
    ],
    "35": [
      {
        "term": "山雉",
        "reading": "zhì",
        "note": "山中野鸡。楚人诳称为凤凰,寓名实相违。"
      },
      {
        "term": "十金",
        "note": "金,货币单位,先秦或以一镒(二十两)为一金。"
      },
      {
        "term": "上大夫禄",
        "note": "上大夫,卿下之高级官爵。禄,俸给。"
      }
    ],
    "37": [
      {
        "term": "五伯",
        "reading": "wǔ bà",
        "note": "伯通霸,即春秋五霸,齐桓晋文等。"
      },
      {
        "term": "幽、厉",
        "reading": "yōu lì",
        "note": "周幽王、周厉王,西周乱亡之君,与桀纣并举为失时之败。"
      }
    ],
    "38": [
      {
        "term": "宋公",
        "note": "宋襄公。泓之战不击未阵之楚军而败,见《左传》僖公二十二年。"
      },
      {
        "term": "目夷",
        "reading": "mù yí",
        "note": "公子目夷,字子鱼,宋襄公庶兄,谏半渡而击。"
      },
      {
        "term": "未悉济而击之",
        "reading": "jì",
        "note": "济,渡水。趁敌未尽渡河时攻击。"
      }
    ],
    "39": [
      {
        "term": "召忽、夷吾",
        "reading": "shào hū;yí wú",
        "note": "召忽、管仲(名夷吾)同奉公子纠。召忽死之,管仲后相齐。"
      },
      {
        "term": "鲍叔牙",
        "reading": "bào shū yá",
        "note": "齐大夫,奉公子小白(齐桓公),后荐管仲为相。"
      },
      {
        "term": "奔莒",
        "reading": "jǔ",
        "note": "莒,周代诸侯国,在今山东莒县。奔,出逃。"
      }
    ],
    "40": [
      {
        "term": "骊姬之谮",
        "reading": "lí jī;zèn",
        "note": "骊姬,晋献公宠妃,谮害太子申生,逼重耳出亡。谮,诬陷。"
      }
    ]
  },
  "2": {
    "0": [
      {
        "term": "五帝三王",
        "note": "五帝指黄帝、颛顼、帝喾、尧、舜,三王指夏禹、商汤、周文武,泛指上古圣王。"
      },
      {
        "term": "弥纶天地",
        "reading": "mí lún",
        "note": "弥纶,包举、统括。谓周遍统括天地。"
      },
      {
        "term": "餐挹",
        "reading": "cān yì",
        "note": "挹,舀取。餐挹犹言取用、汲取。"
      }
    ],
    "1": [
      {
        "term": "六征",
        "note": "征,征兆、迹象。六征即衰、亡、昌、强、治、乱六种国情之兆。"
      },
      {
        "term": "多媵",
        "reading": "duō yìng",
        "note": "媵,陪嫁的姬妾。多媵谓姬妾众多。"
      },
      {
        "term": "支庶繁字",
        "note": "支庶,宗族旁支;字,生育、繁衍。谓旁支子孙繁多。"
      },
      {
        "term": "封疆修理",
        "note": "封疆,边境疆界;修理,修治整饬。谓边防修治完备。"
      }
    ],
    "2": [
      {
        "term": "治主",
        "note": "治主,使天下大治的君主,犹言圣明之君。"
      },
      {
        "term": "奸",
        "reading": "jiān",
        "note": "奸,奸宄,为非作歹、犯法作乱之人。"
      },
      {
        "term": "不轨",
        "note": "轨,遵循、合于法度。不轨谓不遵守法度。"
      }
    ],
    "3": [
      {
        "term": "孔丘摄鲁相",
        "note": "摄,代理。诛少正卯一事见《荀子·宥坐》,后世多疑为诸子托辞。"
      },
      {
        "term": "少正卯",
        "reading": "shào zhèng mǎo",
        "note": "少正为官名,卯为其名,鲁国大夫,以善辩闻名。"
      },
      {
        "term": "顺非而泽",
        "note": "顺着错误的言行而加以文饰润色。泽,润饰。"
      },
      {
        "term": "尹谐",
        "note": "传说商汤所诛之乱政者,事不详,与下文潘正、华士等并举。"
      }
    ],
    "4": [
      {
        "term": "佞辩",
        "reading": "nìng biàn",
        "note": "佞,巧言谄媚;佞辩谓花言巧语、强词夺理。"
      },
      {
        "term": "荧惑",
        "reading": "yíng huò",
        "note": "荧惑,迷惑、惑乱。"
      },
      {
        "term": "眉睫之闲",
        "note": "闲同「间」。谓极短促的瞬间,形容察人之速。"
      }
    ],
    "5": [
      {
        "term": "恶紫之夺朱",
        "note": "语出《论语·阳货》。朱为正色,紫为间色,孔子恶以邪夺正,喻邪佞乱正。"
      },
      {
        "term": "利口之覆邦家",
        "note": "利口,巧言善辩之口;覆,倾覆。谓巧辩之人倾覆国家,本《论语·阳货》。"
      }
    ],
    "6": [
      {
        "term": "以政治国，以奇用兵，以无事取天下",
        "note": "语出《老子》五十七章。政,正道;奇,出奇制胜之术;无事,清静无为。"
      },
      {
        "term": "矫抑",
        "note": "矫,矫正;抑,抑制。谓矫正抑制残暴之情。"
      }
    ],
    "7": [
      {
        "term": "民不畏死，如何以死惧之",
        "note": "语本《老子》七十四章,通行本作「奈何以死惧之」。"
      },
      {
        "term": "不赖其生",
        "note": "赖,依靠、凭借。谓百姓活着无所依靠、不安于生。"
      }
    ],
    "8": [
      {
        "term": "田子",
        "note": "即田骈,战国齐国稷下学者,道家、黄老一派,主张「贵齐」。"
      },
      {
        "term": "宋子",
        "note": "即宋钘,战国宋国人,稷下学者,主张「情欲寡」「见侮不辱」。"
      },
      {
        "term": "彭蒙",
        "reading": "péng méng",
        "note": "战国齐人,田骈之师,稷下道家,主张齐万物、弃是非。"
      },
      {
        "term": "越次",
        "note": "越过应答的次序,谓不待轮到自己而抢先答话。"
      }
    ],
    "9": [
      {
        "term": "庄里丈人",
        "note": "庄里,里巷名;丈人,对老者的尊称。此为寓言中人,非实指。"
      },
      {
        "term": "殴",
        "reading": "ōu",
        "note": "本为人名(小儿子之名),与「殴打」之「殴」同字,故吏误以为命其行殴。"
      },
      {
        "term": "几殪",
        "reading": "jī yì",
        "note": "殪,死。几殪谓几乎被打死。原文「几殪计」之「计」疑为衍讹。"
      },
      {
        "term": "康衢",
        "reading": "kāng qú",
        "note": "康衢,四通八达的大道,此用作地名。"
      }
    ],
    "10": [
      {
        "term": "璞",
        "reading": "pú",
        "note": "本指未雕琢的玉。郑人谓未理之玉为璞,周人谓未风干之鼠为璞,同名异实。"
      },
      {
        "term": "未腊",
        "reading": "wèi xī",
        "note": "腊,把肉风干制成干肉。未腊谓未经风干处理。"
      },
      {
        "term": "郑贾",
        "reading": "zhèng gǔ",
        "note": "贾,商人。郑贾即郑国商人。"
      }
    ],
    "11": [
      {
        "term": "去贵妻，卖爱妾",
        "note": "去,休弃。谓休掉正妻、卖掉爱妾,举其势必能行的严令为例。"
      }
    ],
    "12": [
      {
        "term": "虚临其国",
        "note": "虚临,徒有其名地君临。谓空有君位而不能实治其国。"
      }
    ],
    "14": [
      {
        "term": "大趣",
        "note": "趣同「趋」,趋向。大趣谓人情共通的大趋向。"
      },
      {
        "term": "一槩",
        "reading": "yī gài",
        "note": "槩同「概」,刮平斗斛的木尺。一概谓一律、不加分别。"
      },
      {
        "term": "君子之邮",
        "reading": "jūn zǐ zhī yóu",
        "note": "邮同「尤」,过失。谓即便是君子也会有的过错。"
      }
    ],
    "15": [
      {
        "term": "禄施",
        "note": "禄,俸禄;施,恩惠。禄施谓俸禄恩惠之施予。"
      }
    ],
    "16": [
      {
        "term": "请赇",
        "reading": "qǐng qiú",
        "note": "赇,财物、贿赂。请赇谓有所请托、求取财物;一说指有求于己。"
      },
      {
        "term": "致亲致疏",
        "note": "致,招致、导致。谓本无招致亲近或疏远的固定缘由。"
      }
    ],
    "17": [
      {
        "term": "穷独",
        "note": "穷,困厄无依;独,孤独无亲。穷独泛指孤苦无依之人。"
      },
      {
        "term": "共矜",
        "reading": "gòng jīn",
        "note": "矜,怜悯、同情。共矜谓共同怜悯。"
      }
    ],
    "18": [
      {
        "term": "酬",
        "reading": "chóu",
        "note": "酬,酬答、回报、满足。「弗酬」谓不予回报、不满足其所望。"
      },
      {
        "term": "赋敛",
        "reading": "fù liǎn",
        "note": "赋,田赋;敛,征收。赋敛谓赋税的征收。"
      },
      {
        "term": "君位替矣",
        "note": "替,废弃、衰替。谓君位将被废替倾覆。"
      }
    ]
  }
}
