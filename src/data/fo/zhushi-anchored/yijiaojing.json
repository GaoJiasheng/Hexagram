{
  "1": {
    "0": [
      {
        "term": "释迦牟尼佛",
        "reading": "Shìjiāmóuní",
        "note": "佛教创始人,本释迦族,牟尼意为寂默、圣者。"
      },
      {
        "term": "转法轮",
        "note": "佛初次说法称转法轮,法轮喻佛法摧破烦恼如轮碾物。"
      },
      {
        "term": "阿若憍陈如",
        "note": "佛初转法轮所度五比丘之一,最先悟道。"
      },
      {
        "term": "娑罗双树",
        "note": "佛涅槃处之双树,娑罗为乔木名,树成对故称双树。"
      }
    ],
    "1": [
      {
        "term": "波罗提木叉",
        "note": "梵语,意为别解脱、戒本,指比丘所持戒律条文。"
      },
      {
        "term": "四供养",
        "note": "供养僧众之四事:衣服、饮食、卧具、汤药。"
      }
    ],
    "2": [
      {
        "term": "禅定",
        "note": "梵语禅那意译,止息散乱、心专一境的修习。"
      }
    ],
    "3": [
      {
        "term": "五根",
        "note": "此处指眼耳鼻舌身五种感官,非信进念定慧之五根。"
      },
      {
        "term": "五欲",
        "note": "色声香味触五境引发之欲,或财色名食睡五欲。"
      },
      {
        "term": "阬埳",
        "reading": "kēng kǎn",
        "note": "坑陷、深坑。阬同坑。"
      }
    ],
    "5": [
      {
        "term": "初夜后夜",
        "note": "古印度分夜为初、中、后三时,各约四小时。"
      },
      {
        "term": "黑蚖",
        "reading": "hēi yuán",
        "note": "蚖为蝮蛇类毒蛇,黑蚖喻潜伏心中的烦恼。"
      },
      {
        "term": "无常",
        "note": "诸法生灭变迁、无固定不变,佛教三法印之一。"
      }
    ],
    "6": [
      {
        "term": "甘露",
        "note": "梵语阿密哩多,印度传说不死之药,喻佛法妙味。"
      },
      {
        "term": "白衣",
        "note": "在家人,印度俗人多着白衣,别于僧人染衣。"
      }
    ],
    "7": [
      {
        "term": "应器",
        "note": "即钵,梵语钵多罗,僧人乞食所用之器,量腹而受。"
      },
      {
        "term": "憍慢",
        "reading": "jiāo màn",
        "note": "骄傲自大之心,憍同骄。"
      }
    ],
    "8": [
      {
        "term": "谄曲",
        "note": "心不正直、曲意逢迎以求媚于人。"
      },
      {
        "term": "涅槃",
        "note": "梵语,意为寂灭、圆寂,烦恼永尽、不生不灭的境界。"
      }
    ],
    "9": [
      {
        "term": "知足",
        "note": "于所得知量而止、不更贪求,佛门修行德目。"
      }
    ],
    "10": [
      {
        "term": "帝释",
        "note": "梵语释提桓因,忉利天主,佛教护法天神。"
      }
    ],
    "12": [
      {
        "term": "善知识",
        "note": "能引人入正道的良师益友。"
      },
      {
        "term": "不忘念",
        "note": "即正念不失,系念于所修法而不散忘。"
      }
    ],
    "13": [
      {
        "term": "法相",
        "note": "诸法显现的相状、性质。"
      }
    ],
    "14": [
      {
        "term": "无明",
        "note": "愚痴不明事理、不见真实,十二因缘之首。"
      },
      {
        "term": "天眼",
        "note": "五眼之一,能见远近粗细及未来生死之眼。"
      },
      {
        "term": "闻思修",
        "note": "由听闻、思惟、修习而生的三种智慧,称三慧。"
      }
    ],
    "15": [
      {
        "term": "戏论",
        "note": "无意义、与正理相违、徒乱心神的言论分别。"
      }
    ],
    "16": [
      {
        "term": "世尊",
        "note": "佛十号之一,为世所尊重者。"
      }
    ],
    "17": [
      {
        "term": "四谛",
        "note": "苦集灭道四种真理,佛教根本教义。"
      },
      {
        "term": "阿[少/免]楼驮",
        "note": "即阿那律,佛弟子,以天眼第一著称。"
      }
    ],
    "19": [
      {
        "term": "一劫",
        "note": "梵语劫波,极长的时间单位。"
      },
      {
        "term": "法身",
        "note": "佛三身之一,指佛所证常住不灭的真如法性之体。"
      }
    ],
    "21": [
      {
        "term": "灭度",
        "note": "即涅槃,灭烦恼、度苦海,谓圣者命终入寂。"
      }
    ]
  }
}
