{
  "1": {
    "0": [
      {
        "term": "如是我闻",
        "note": "经首通例,谓我亲闻佛如此说,阿难结集所立,以示信而有征。"
      }
    ],
    "1": [
      {
        "term": "舍卫国",
        "reading": "shè wèi guó",
        "note": "古印度憍萨罗国都城,梵名室罗伐,佛多次于此说法。"
      },
      {
        "term": "衹树给孤独园",
        "reading": "qí shù gěi gū dú yuán",
        "note": "祇陀太子捐树、给孤独长者布金购地所建精舍,佛说法地之一。"
      },
      {
        "term": "大比丘僧",
        "note": "受具足戒之男众出家者称比丘,德高者称大;僧谓和合众。"
      },
      {
        "term": "阿罗汉",
        "reading": "ā luó hàn",
        "note": "梵语,声闻乘极果,断尽烦恼、应受供养之圣者。"
      }
    ],
    "3": [
      {
        "term": "佛土",
        "note": "佛所教化之国土,一佛土含三千大千世界,十万亿言其遥远。"
      },
      {
        "term": "阿弥陀",
        "reading": "ē mí tuó",
        "note": "梵语,后文释为无量光、无量寿,西方极乐世界教主。"
      },
      {
        "term": "栏楯",
        "reading": "lán shǔn",
        "note": "栏杆,纵为栏,横为楯,围绕之饰。"
      }
    ],
    "4": [
      {
        "term": "八功德水",
        "note": "经说极乐池水具澄净、清冷、甘美等八种殊胜功德,故名。"
      },
      {
        "term": "玻瓈",
        "reading": "bō lí",
        "note": "即玻璃,古指水晶类宝玉,七宝之一。"
      },
      {
        "term": "砗磲",
        "reading": "chē qú",
        "note": "大型海贝之壳,色白如玉,佛家列为七宝之一。"
      }
    ],
    "5": [
      {
        "term": "曼陀罗华",
        "reading": "màn tuó luó huā",
        "note": "梵语,意译适意花、天妙花,天界所降之瑞花。"
      },
      {
        "term": "六时",
        "note": "古印度分昼夜为六时:昼三时、夜三时,即终日不断。"
      },
      {
        "term": "衣裓",
        "reading": "yī gē",
        "note": "盛花之衣襟或布兜,一说为承花之器。"
      },
      {
        "term": "经行",
        "reading": "jīng xíng",
        "note": "于一定处所往复行走,以摄心调身,佛门修习之法。"
      }
    ],
    "6": [
      {
        "term": "迦陵频伽",
        "reading": "jiā líng pín qié",
        "note": "梵语,意译妙音鸟,传为出壳即能鸣、音声和雅之鸟。"
      },
      {
        "term": "五根",
        "note": "信、进、念、定、慧五种能生善法之根,三十七道品之一类。"
      },
      {
        "term": "七菩提分",
        "note": "又称七觉支,择法、精进、喜、轻安、念、定、舍七种觉法。"
      },
      {
        "term": "三恶道",
        "note": "地狱、饿鬼、畜生三种苦报之趣,极乐国中无此。"
      }
    ],
    "7": [
      {
        "term": "阿僧祇劫",
        "reading": "ā sēng qí jié",
        "note": "阿僧祇,梵语,意为无数;劫为极长时间单位,极言其久。"
      },
      {
        "term": "声闻",
        "note": "闻佛声教而悟四谛、证罗汉果者,小乘行人之通称。"
      }
    ],
    "8": [
      {
        "term": "阿鞞跋致",
        "reading": "ā pí bá zhì",
        "note": "梵语,意译不退转,谓修行不再退堕之位。"
      },
      {
        "term": "一生补处",
        "note": "菩萨阶位最高者,仅余一生即补佛位,如弥勒之于此世。"
      },
      {
        "term": "上善人",
        "note": "指德行最上之圣者,即往生彼国之诸大菩萨。"
      }
    ],
    "9": [
      {
        "term": "善根福德因缘",
        "note": "善根谓宿世修善之根,福德谓福业,因缘谓助成之条件。"
      },
      {
        "term": "执持名号",
        "note": "持守忆念阿弥陀佛之名,净土法门所谓持名念佛。"
      },
      {
        "term": "一心不乱",
        "note": "专注一念、心不散动之定境,此处为持名所成之心境。"
      }
    ],
    "10": [
      {
        "term": "阿閦鞞佛",
        "reading": "ā chù pí fó",
        "note": "梵语,意译不动佛,东方妙喜世界之教主。"
      },
      {
        "term": "广长舌相",
        "note": "佛三十二相之一,舌广而长,表所言真实不虚。"
      },
      {
        "term": "三千大千世界",
        "note": "佛教宇宙观:千小世界为小千,千小千为中千,千中千为大千。"
      }
    ],
    "18": [
      {
        "term": "娑婆",
        "reading": "suō pó",
        "note": "梵语,意译堪忍,谓此世界众生堪能忍受诸苦烦恼。"
      },
      {
        "term": "五浊恶世",
        "note": "劫浊、见浊、烦恼浊、众生浊、命浊俱起之浊乱时世。"
      },
      {
        "term": "释迦牟尼",
        "reading": "shì jiā móu ní",
        "note": "梵语,意译能仁寂默,即本师佛之名号。"
      }
    ],
    "19": [
      {
        "term": "阿修罗",
        "reading": "ā xiū luó",
        "note": "梵语,意译非天,六道之一,好斗诤而福报近天之众生。"
      }
    ]
  }
}
