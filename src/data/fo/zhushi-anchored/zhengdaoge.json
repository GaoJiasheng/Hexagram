{
  "1": {
    "1": [
      {
        "term": "绝学无为",
        "note": "断绝俗学、无所造作。「绝学」语本《老子》,此借指泯绝知见。"
      },
      {
        "term": "无明",
        "reading": "wú míng",
        "note": "梵 avidyā,愚痴暗昧、不明真理,十二因缘之首。"
      },
      {
        "term": "法身",
        "note": "梵 dharmakāya,佛三身之一,指真如理体。"
      }
    ],
    "2": [
      {
        "term": "五蕴",
        "reading": "wǔ yùn",
        "note": "色受想行识五种聚合,构成身心,旧译五阴。"
      },
      {
        "term": "三毒",
        "note": "贪、瞋、痴三种根本烦恼。"
      },
      {
        "term": "天真佛",
        "note": "本然天成、非修而得之佛性。"
      }
    ],
    "3": [
      {
        "term": "实相",
        "note": "诸法真实不变之相,即真如本体。"
      },
      {
        "term": "阿鼻",
        "reading": "ā bí",
        "note": "梵 avīci,意为无间,八热地狱中最苦者。"
      },
      {
        "term": "拔舌",
        "note": "拔舌地狱,妄语者所堕,以钳拔舌受苦。"
      }
    ],
    "4": [
      {
        "term": "如来禅",
        "note": "依如来所说、契证真如的禅,对「祖师禅」而言。"
      },
      {
        "term": "六度",
        "note": "布施、持戒、忍辱、精进、禅定、般若六种波罗蜜。"
      },
      {
        "term": "六趣",
        "note": "六道:天、人、阿修罗、畜生、饿鬼、地狱。"
      },
      {
        "term": "大千",
        "note": "三千大千世界,佛教一佛所化之广大世界。"
      }
    ],
    "6": [
      {
        "term": "无生",
        "note": "诸法本不生不灭,证此即得无生法忍。"
      },
      {
        "term": "机关木人",
        "note": "以机括牵动的木偶,喻无情识、不能自悟者。"
      }
    ],
    "7": [
      {
        "term": "四大",
        "note": "地、水、火、风,构成色身的四种元素。"
      },
      {
        "term": "随饮啄",
        "note": "随缘饮食,任运度日,语本鸟之自然饮啄。"
      },
      {
        "term": "大圆觉",
        "note": "圆满觉悟,即如来究竟之觉。"
      }
    ],
    "8": [
      {
        "term": "真乘",
        "note": "真实的教法、究竟一乘。"
      }
    ],
    "9": [
      {
        "term": "摩尼珠",
        "reading": "mó ní",
        "note": "梵 maṇi,如意宝珠,喻自性清净心。"
      },
      {
        "term": "如来藏",
        "note": "梵 tathāgatagarbha,众生本具的如来性体。"
      },
      {
        "term": "六般神用",
        "note": "六根的神妙作用;一说指六神通。"
      }
    ],
    "10": [
      {
        "term": "五根",
        "note": "信、进、念、定、慧五种善根。"
      },
      {
        "term": "五力",
        "note": "由五根增长所成的信进念定慧五力。"
      }
    ],
    "11": [
      {
        "term": "涅槃",
        "reading": "niè pán",
        "note": "梵 nirvāṇa,寂灭、烦恼永尽的解脱境界。"
      }
    ],
    "12": [
      {
        "term": "释子",
        "note": "释迦之弟子,即出家僧人。"
      },
      {
        "term": "缕褐",
        "reading": "lǚ hè",
        "note": "粗麻织成的破旧衣服。"
      }
    ],
    "13": [
      {
        "term": "三身四智",
        "note": "法、报、化三身与转识所成的四种智慧。"
      },
      {
        "term": "八解六通",
        "note": "八解脱与六神通,皆禅定所成功德。"
      }
    ],
    "14": [
      {
        "term": "上士",
        "note": "上等根器之人,与中士、下士相对。"
      },
      {
        "term": "垢衣",
        "note": "污秽之衣,喻覆盖自性的烦恼。"
      }
    ],
    "15": [
      {
        "term": "甘露",
        "note": "梵 amṛta,天人不死之药,喻佛法滋味。"
      },
      {
        "term": "不思议",
        "note": "不可思议,超越心思言议的境界。"
      }
    ],
    "16": [
      {
        "term": "善知识",
        "note": "能引人入正道的良师益友。"
      },
      {
        "term": "慈忍力",
        "note": "慈悲与忍辱之力。"
      }
    ],
    "17": [
      {
        "term": "定慧",
        "note": "禅定与智慧,佛门修行二门。"
      },
      {
        "term": "恒沙",
        "note": "恒河沙数,喻数量极多。"
      }
    ],
    "18": [
      {
        "term": "师子吼",
        "note": "佛说法无畏,如狮子吼震慑群兽。"
      },
      {
        "term": "香象",
        "note": "发情期之大象,力大,喻外道势盛。"
      },
      {
        "term": "天龙",
        "note": "天众与龙众,护法八部之二。"
      }
    ],
    "19": [
      {
        "term": "曹谿",
        "reading": "cáo xī",
        "note": "曹溪,六祖慧能弘法之地,在今广东韶关。"
      }
    ],
    "20": [
      {
        "term": "然灯佛",
        "note": "梵 Dīpaṃkara,过去佛,曾为释迦授成佛之记。"
      },
      {
        "term": "忍辱仙",
        "note": "释迦前身,被歌利王割截肢体而不生瞋恨。"
      }
    ],
    "22": [
      {
        "term": "兰若",
        "reading": "lán rě",
        "note": "梵 araṇya 阿兰若之略,寂静的修行处。"
      },
      {
        "term": "岑崟",
        "reading": "cén yín",
        "note": "山势高峻的样子。"
      },
      {
        "term": "阒寂",
        "reading": "qù jì",
        "note": "寂静无声。"
      }
    ],
    "23": [
      {
        "term": "有为法",
        "note": "因缘造作、有生灭变迁之法,对无为法而言。"
      },
      {
        "term": "住相布施",
        "note": "执着相状而行的布施,有漏而不究竟。"
      }
    ],
    "25": [
      {
        "term": "如意珠",
        "note": "如意宝珠,喻本具的自性真心。"
      }
    ],
    "26": [
      {
        "term": "戒珠",
        "note": "以珠喻戒,持戒清净如明珠。"
      }
    ],
    "27": [
      {
        "term": "降龙钵",
        "note": "传说高僧以钵降伏毒龙之典。"
      },
      {
        "term": "解虎锡",
        "note": "锡杖,僧人持杖,传有以锡杖解斗虎之事。"
      },
      {
        "term": "两钴",
        "reading": "liǎng gǔ",
        "note": "锡杖头两股金环,「钴」指环钮。"
      }
    ],
    "29": [
      {
        "term": "沙界",
        "note": "如恒沙之多的世界。"
      },
      {
        "term": "森罗",
        "note": "森然罗列,指万象纷然并陈。"
      }
    ],
    "30": [
      {
        "term": "豁达空",
        "note": "误解空义、流于断灭的「恶取空」。"
      },
      {
        "term": "拨因果",
        "note": "否定因果,即拨无因果的邪见。"
      }
    ],
    "32": [
      {
        "term": "心意识",
        "note": "心、意、识,泛指一切分别妄想之识。"
      },
      {
        "term": "禅门",
        "note": "禅宗法门。"
      }
    ],
    "33": [
      {
        "term": "慧剑",
        "note": "以剑喻智慧,能斩断烦恼。"
      },
      {
        "term": "般若",
        "reading": "bō rě",
        "note": "梵 prajñā,照见诸法实相的根本智慧。"
      },
      {
        "term": "金刚",
        "note": "梵 vajra,坚利不坏,喻智用之锐。"
      },
      {
        "term": "天魔",
        "note": "欲界第六天魔王波旬,常障碍修行。"
      }
    ],
    "34": [
      {
        "term": "慈云",
        "note": "以云喻慈悲,普覆众生。"
      },
      {
        "term": "三乘",
        "note": "声闻、缘觉、菩萨三种修行教法。"
      },
      {
        "term": "五性",
        "note": "法相宗五种种性:声闻、缘觉、菩萨、不定、无性。"
      }
    ],
    "35": [
      {
        "term": "醍醐",
        "reading": "tí hú",
        "note": "由乳精炼的上味,喻佛法最上乘之味。"
      }
    ],
    "37": [
      {
        "term": "八万门",
        "note": "八万四千法门之略,喻法门无量。"
      },
      {
        "term": "三祇劫",
        "reading": "sān qí jié",
        "note": "三大阿僧祇劫,菩萨成佛所历极长时劫。"
      }
    ],
    "38": [
      {
        "term": "湛然",
        "reading": "zhàn rán",
        "note": "澄澈清明、寂静不动的样子。"
      }
    ],
    "39": [
      {
        "term": "大施门",
        "note": "广大布施之门,喻平等普施的法门。"
      }
    ],
    "40": [
      {
        "term": "摩诃般若",
        "reading": "mó hē bō rě",
        "note": "梵 mahā-prajñā,大智慧。"
      }
    ],
    "41": [
      {
        "term": "迦叶",
        "reading": "jiā shè",
        "note": "摩诃迦叶,佛十大弟子,禅宗西天初祖。"
      },
      {
        "term": "传灯",
        "note": "以灯喻法,师徒授受称传灯。"
      },
      {
        "term": "二十八代",
        "note": "禅宗西天自迦叶至达摩共二十八祖。"
      }
    ],
    "42": [
      {
        "term": "菩提达摩",
        "note": "梵 Bodhidharma,西天二十八祖、东土禅宗初祖。"
      },
      {
        "term": "六代传衣",
        "note": "达摩至慧能六代,以传袈裟为信。"
      }
    ],
    "43": [
      {
        "term": "二十空门",
        "note": "般若经所说二十种空,如内空、外空等。"
      }
    ],
    "44": [
      {
        "term": "根",
        "note": "六根,能生识之主,此喻心。"
      },
      {
        "term": "尘",
        "note": "六尘,根所对之境,此喻法。"
      }
    ],
    "45": [
      {
        "term": "末法",
        "note": "佛灭后正法、像法之后,教存而修证渐衰之时。"
      },
      {
        "term": "顿教",
        "note": "不历阶次、直了成佛的教法,对渐教而言。"
      }
    ],
    "46": [
      {
        "term": "无间业",
        "note": "感无间地狱之恶业,即五逆等极重罪。"
      },
      {
        "term": "正法轮",
        "note": "佛所说正法,如轮摧破烦恼、辗转不停。"
      }
    ],
    "47": [
      {
        "term": "栴檀",
        "reading": "zhān tán",
        "note": "梵 candana,旃檀香木,林中无杂树。"
      }
    ],
    "48": [
      {
        "term": "师子儿",
        "note": "狮子之子,喻禅门得法的真传弟子。"
      },
      {
        "term": "野干",
        "reading": "yě gān",
        "note": "似狐之兽,喻冒充法王的外道。"
      },
      {
        "term": "法王",
        "note": "佛于法自在,称法中之王。"
      }
    ],
    "49": [
      {
        "term": "圆顿教",
        "note": "圆满顿悟、一念成佛的教法。"
      },
      {
        "term": "断常坑",
        "note": "断见与常见两种邪见,如坑陷人。"
      }
    ],
    "56": [
      {
        "term": "无生",
        "note": "诸法无生灭,即实相之理。"
      }
    ]
  }
}
