{
  "1": {
    "0": [
      {
        "term": "至心",
        "note": "至诚专一之心,毫无杂念。"
      },
      {
        "term": "八大人觉",
        "note": "大人(佛菩萨)所觉悟的八种法门,即本经纲目。"
      }
    ],
    "1": [
      {
        "term": "四大",
        "note": "地、水、火、风,谓构成色身万物的四种元素。"
      },
      {
        "term": "五阴",
        "reading": "wǔ yīn",
        "note": "亦作五蕴,色受想行识,聚合而成身心。"
      },
      {
        "term": "罪薮",
        "reading": "zuì sǒu",
        "note": "薮,聚集之地;谓身形为众罪所聚。"
      }
    ],
    "2": [
      {
        "term": "无为",
        "note": "不造作、离贪染的清净,非世俗无所事事。"
      }
    ],
    "3": [
      {
        "term": "菩萨",
        "note": "菩提萨埵略称,求觉悟而度众生者。"
      },
      {
        "term": "安贫守道",
        "note": "安于贫素而持守正道。"
      }
    ],
    "4": [
      {
        "term": "四魔",
        "note": "烦恼魔、五阴魔、死魔、天魔,四种障道之魔。"
      },
      {
        "term": "阴界狱",
        "note": "以五阴、十八界喻为困缚众生的牢狱。"
      }
    ],
    "5": [
      {
        "term": "辩才",
        "note": "善于言说论义之才,四无碍辩之一。"
      }
    ],
    "6": [
      {
        "term": "等念怨亲",
        "note": "对仇怨与亲爱一律平等看待。"
      }
    ],
    "7": [
      {
        "term": "五欲",
        "note": "色声香味触,或财色名食睡所生贪着。"
      },
      {
        "term": "三衣",
        "note": "僧人所持安陀会、郁多罗、僧伽梨三衣。"
      },
      {
        "term": "瓦钵",
        "note": "陶制食器,僧人乞食所用之器。"
      },
      {
        "term": "梵行",
        "note": "清净离欲之行,梵即清净义。"
      }
    ],
    "8": [
      {
        "term": "大乘",
        "note": "自度度他、广济众生之教,别于小乘自度。"
      },
      {
        "term": "炽然",
        "reading": "chì rán",
        "note": "如火炽盛燃烧之貌。"
      }
    ],
    "9": [
      {
        "term": "法身",
        "note": "佛之真身,以理法为体,非血肉之身。"
      },
      {
        "term": "涅槃",
        "reading": "niè pán",
        "note": "梵语音译,谓灭尽烦恼、不生不灭的境界。"
      },
      {
        "term": "菩提",
        "note": "梵语音译,觉、智之义,指觉悟。"
      },
      {
        "term": "正觉",
        "note": "真正之觉悟,即成佛之果。"
      }
    ]
  }
}
