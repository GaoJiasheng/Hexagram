{
  "1": {
    "0": [
      { "term": "明明德", "note": "前一「明」是动词,彰明;「明德」指人本有的光明德性。" },
      { "term": "亲民", "note": "亲爱民众。程颐、朱熹读「亲」为「新」,谓鼓舞振作、使民自新。" },
      { "term": "止于至善", "note": "达到至善之境而安守不迁。止,所当止之地。" },
      { "term": "格物", "note": "穷究事物之理。格,至、穷至(朱熹义);一说格,正也(王守仁义)。" },
      { "term": "致知", "note": "推极自己的知识,使无所不尽。" },
      { "term": "壹是", "note": "一概、一律。" }
    ],
    "1": [
      { "term": "自谦", "reading": "qiè", "note": "「谦」读为「慊」,自我满足、心安理得。" },
      { "term": "慎其独", "note": "在无人独处、唯己自知之时也戒慎不苟。" },
      { "term": "厌然", "reading": "yān", "note": "躲躲闪闪、遮掩之貌。" },
      { "term": "心广体胖", "reading": "pán", "note": "「胖」音盘,安舒。心宽坦则身体舒泰。" }
    ],
    "2": [
      { "term": "淇澳", "reading": "yù", "note": "淇水弯曲的岸边。淇,卫国水名;澳,水涯曲处。" },
      { "term": "瑟兮僩兮", "reading": "xiàn", "note": "瑟,庄严缜密;僩,武毅、宽宏。形容君子神态。" },
      { "term": "恂栗", "reading": "xún", "note": "戒惧、战栗。指内心严敬。" },
      { "term": "於戏", "reading": "wū hū", "note": "叹词,犹「呜呼」。" }
    ],
    "3": [
      { "term": "克明德", "note": "能彰明德性。克,能。语出《尚书·康诰》。" },
      { "term": "峻德", "note": "崇高广大的德性。峻,大。" }
    ],
    "4": [
      { "term": "盘铭", "note": "刻在沐浴之盘上的箴言。汤,商朝开国之君成汤。" },
      { "term": "作新民", "note": "振起民众,使之自新。作,振作。" }
    ],
    "5": [
      { "term": "邦畿", "reading": "jī", "note": "国都及其周围千里之地。畿,王都直辖区域。" },
      { "term": "缗蛮", "reading": "mín", "note": "鸟鸣声,一作「绵蛮」。" },
      { "term": "缉熙", "reading": "jī xī", "note": "缉,继续;熙,光明。谓德光明不已。" }
    ],
    "6": [
      { "term": "听讼", "note": "审理诉讼案件。听,审断。" },
      { "term": "无情者", "note": "隐情不实、无理强辩之人。情,实。" }
    ],
    "7": [
      { "term": "忿懥", "reading": "zhì", "note": "愤怒。程颐谓「身有」之「身」当作「心」。" }
    ],
    "8": [
      { "term": "辟", "reading": "pì", "note": "偏私、偏向。谓溺于私情而失公允。" },
      { "term": "哀矜", "note": "怜悯、同情。" },
      { "term": "敖惰", "reading": "ào", "note": "敖,傲慢;惰,怠慢轻忽。" }
    ],
    "9": [
      { "term": "偾事", "reading": "fèn", "note": "败坏、覆败大事。" },
      { "term": "蓁蓁", "reading": "zhēn", "note": "枝叶繁密茂盛貌。" },
      { "term": "不忒", "reading": "tè", "note": "没有差错。忒,差误。" }
    ],
    "10": [
      { "term": "絜矩", "reading": "xié", "note": "絜,度量;矩,曲尺。推己度人、以己心量人心的为政法则。" },
      { "term": "师尹", "note": "周代执政的太师尹氏。语出《诗·小雅·节南山》。" },
      { "term": "彦圣", "note": "彦,美士;圣,通明。指德才出众之人。" },
      { "term": "媢嫉", "reading": "mào", "note": "媢,忌妒;嫉,憎恨。妒贤忌能。" },
      { "term": "伐冰之家", "note": "丧祭能用冰的卿大夫之家。喻有身份的贵族。" },
      { "term": "聚敛之臣", "note": "为君主搜刮民财的家臣。" }
    ]
  }
}
