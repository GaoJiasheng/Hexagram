{
  "1": {
    "0": [
      { "term": "天命之谓性", "note": "上天所赋予人的禀赋叫做「性」。命,赋予;性,即理。" },
      { "term": "率性", "reading": "shuài", "note": "率,循、顺。顺着本性而行便是「道」。" },
      { "term": "须臾", "reading": "xū yú", "note": "片刻、一会儿。" },
      { "term": "慎其独", "note": "在唯己自知的独处之时也戒慎不苟。" },
      { "term": "中节", "reading": "zhòng", "note": "中,合于;节,节度法度。情发而皆合度。" }
    ],
    "1": [
      { "term": "时中", "note": "随时处于中道,无过无不及。" },
      { "term": "无忌惮", "reading": "dàn", "note": "肆意妄为、毫无畏惧顾忌。" }
    ],
    "3": [
      { "term": "不肖", "reading": "xiào", "note": "不贤、不才。肖,似;不肖谓不似贤者。" }
    ],
    "5": [
      { "term": "迩言", "reading": "ěr", "note": "浅近之言。迩,近。" },
      { "term": "两端", "note": "过与不及两个极端;执两端而用其中。" }
    ],
    "6": [
      { "term": "罟擭", "reading": "gǔ huò", "note": "罟,网;擭,装有机关的捕兽笼。" },
      { "term": "期月", "reading": "jī", "note": "整一个月。期,周。" }
    ],
    "7": [
      { "term": "拳拳服膺", "reading": "yīng", "note": "牢牢捧持、放在心上。膺,胸。" }
    ],
    "9": [
      { "term": "衽金革", "reading": "rèn", "note": "以兵器铠甲为卧席,谓时刻备战。衽,卧席。" },
      { "term": "强哉矫", "reading": "jiǎo", "note": "矫,强健貌。「这才是真强啊」的赞叹。" },
      { "term": "不变塞", "note": "塞,困穷未达之时;不改变穷时的操守。" }
    ],
    "10": [
      { "term": "素隐行怪", "note": "探求隐僻、行为怪异。素,朱熹据《汉书》作「索」(探求)。" },
      { "term": "遁世", "reading": "dùn", "note": "避世隐居。" }
    ],
    "11": [
      { "term": "费而隐", "reading": "fèi", "note": "费,作用广大;隐,本体隐微。" },
      { "term": "鸢飞戾天", "reading": "yuān lì", "note": "鸢,鹰类;戾,至。喻道之上下昭著。语出《诗·大雅·旱麓》。" }
    ],
    "12": [
      { "term": "伐柯", "reading": "kē", "note": "砍取斧柄。柯,斧柄;手中之柄即取法之样式。" },
      { "term": "慥慥", "reading": "zào", "note": "笃实诚恳之貌。" }
    ],
    "13": [
      { "term": "素其位", "note": "素,安于现状。安于当下的处境去行其所当行。" },
      { "term": "居易以俟命", "reading": "sì", "note": "安居平易以等待天命。俟,等待。" },
      { "term": "正鹄", "reading": "gǔ", "note": "箭靶的中心。正、鹄皆靶心。" }
    ],
    "14": [
      { "term": "行远必自迩", "reading": "ěr", "note": "走远路必从近处起步。迩,近。" },
      { "term": "妻帑", "reading": "nú", "note": "帑,通「孥」,子女。妻帑即妻子儿女。" }
    ],
    "15": [
      { "term": "体物", "note": "为万物之体、显现于万物之中。" },
      { "term": "齐明盛服", "reading": "zhāi", "note": "齐,通「斋」,斋戒洁净;盛服,穿戴整齐的礼服。" },
      { "term": "矧可射思", "reading": "shěn yì", "note": "矧,何况;射,厌怠;思,语助词。语出《诗·大雅·抑》。" }
    ],
    "16": [
      { "term": "栽者培之", "note": "可栽培的就培育它(倾者覆之,顺其自然而成毁)。" }
    ],
    "17": [
      { "term": "缵", "reading": "zuǎn", "note": "继承、接续。" },
      { "term": "壹戎衣", "note": "一着戎装(伐纣);一说「戎衣」即「殷」,谓一举灭殷。" },
      { "term": "期之丧", "reading": "jī", "note": "为期一周年的丧服。" }
    ],
    "18": [
      { "term": "昭穆", "reading": "zhāo mù", "note": "宗庙神主左昭右穆的排列次序,别父子远近。" },
      { "term": "旅酬", "note": "祭后宴饮,众人依次相互劝酒。" },
      { "term": "燕毛", "note": "宴饮时按须发(年纪)排定座次。燕,通「宴」。" },
      { "term": "禘尝", "reading": "dì cháng", "note": "禘,天子宗庙大祭;尝,秋祭。" }
    ],
    "19": [
      { "term": "蒲卢", "reading": "pú lú", "note": "芦苇(郑玄注),喻政教易于滋长;一说蜾蠃(细腰蜂)。" },
      { "term": "亲亲之杀", "reading": "shài", "note": "杀,差等、递减。亲爱亲族有亲疏厚薄之差。" }
    ],
    "20": [
      { "term": "九经", "note": "治理天下国家的九条常法:修身、尊贤、亲亲等。" },
      { "term": "既禀称事", "reading": "xì lǐn chèn", "note": "既禀(饩廪),发放粮饷;称事,与劳绩相称。" },
      { "term": "豫则立", "note": "豫,预先准备。凡事预先准备就能成功。" },
      { "term": "择善而固执", "note": "选择善而坚守不放。固执,坚持不舍。" }
    ],
    "22": [
      { "term": "赞天地之化育", "note": "赞,赞助、参助。助成天地生养万物之功。" },
      { "term": "与天地参", "reading": "sān", "note": "参,并立为三。与天、地并列为三才。" }
    ],
    "23": [
      { "term": "致曲", "note": "曲,一偏、一隅。从局部的善上推致用功。" }
    ],
    "24": [
      { "term": "祯祥", "reading": "zhēn", "note": "吉祥的征兆。" },
      { "term": "妖孽", "reading": "niè", "note": "反常的凶兆。草木之怪为妖,虫豸之怪为孽。" },
      { "term": "蓍龟", "reading": "shī", "note": "蓍草与龟甲,古人占卜之具。" }
    ],
    "25": [
      { "term": "不诚无物", "note": "没有真诚,事物便无以成立、等于无物。" },
      { "term": "时措之宜", "note": "随时施用都得其所宜。措,施行。" }
    ],
    "26": [
      { "term": "其为物不贰", "note": "天地之道作为存在专一不二、诚而无妄。" },
      { "term": "鼋鼍", "reading": "yuán tuó", "note": "鼋,大鳖;鼍,扬子鳄。" },
      { "term": "於穆不已", "reading": "wū", "note": "於,叹词;穆,深远。赞天命深远不息。语出《诗·周颂》。" }
    ],
    "27": [
      { "term": "优优大哉", "note": "优优,充裕宽宏之貌。" },
      { "term": "尊德性", "note": "尊崇、涵养本有的德性。与「道问学」并举,后为朱陆之争所本。" },
      { "term": "道问学", "note": "由问学之功致知穷理。道,由。" },
      { "term": "至道不凝", "note": "凝,聚成、成就。至道不会凝聚成功。" }
    ],
    "28": [
      { "term": "杞不足征", "reading": "qǐ", "note": "杞,夏的后裔之国;征,验证。文献不足以验证夏礼。" }
    ],
    "29": [
      { "term": "三重", "note": "议礼、制度、考文三件治国要务。一说三王之礼。" },
      { "term": "不缪", "reading": "miù", "note": "缪,通「谬」,错误。" }
    ],
    "30": [
      { "term": "祖述", "note": "远宗、效法。祖述尧舜,谓远承尧舜之道。" },
      { "term": "宪章", "note": "近守、取法。宪章文武,谓取法文王武王。" },
      { "term": "复帱", "reading": "fù dào", "note": "帱,覆盖。无不覆盖。" },
      { "term": "敦化", "note": "使万物敦厚化育。大德敦化,与「小德川流」相对。" }
    ],
    "31": [
      { "term": "蛮貊", "reading": "mò", "note": "古称南方、北方的少数部族。貊,北方部族。" },
      { "term": "霜露所队", "reading": "zhuì", "note": "队,通「坠」,降落。" }
    ],
    "32": [
      { "term": "经纶", "note": "整理丝缕,引申为治理天下、规划纲纪。" },
      { "term": "肫肫其仁", "reading": "zhūn", "note": "肫肫,诚挚恳切之貌。" }
    ],
    "33": [
      { "term": "衣锦尚䌹", "reading": "jiǒng", "note": "锦衣外罩麻单衣。䌹(同絅),罩衫;恶其文采太露。" },
      { "term": "屋漏", "note": "室内西北隅幽暗之处。「不愧屋漏」谓暗室不欺。" },
      { "term": "𫓧钺", "reading": "fū yuè", "note": "𫓧(铡刀)与大斧,古刑具。" },
      { "term": "无声无臭", "reading": "xiù", "note": "臭,气味。无声无气,喻天道之极致。" }
    ]
  }
}
