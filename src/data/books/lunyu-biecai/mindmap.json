{
  "id": "root",
  "label": "论语别裁",
  "note": "南怀瑾 1974 年起在台北开讲《论语》,学生蔡策一堂一堂记录整理,先在报纸上连载,1976 年结集成书。「别裁」二字是他自己下的定语——另一种裁法,不是正统经解。这本书让几代普通读者第一次觉得孔子是个活人;它在训诂上的问题也同样多。两句话都得说。",
  "children": [
    {
      "id": "jianglu",
      "label": "这不是一本书,是一场讲",
      "note": "体裁先于内容:口头讲、别人记、报上连载、事后成书。它所有的长处和短处,都是从这个体裁里长出来的。",
      "ref": {
        "ch": 1
      },
      "children": [
        {
          "id": "jl-form",
          "label": "讲录的长处与通病",
          "children": [
            {
              "id": "jl-f1",
              "label": "有现场感:能听见语气、停顿、笑场"
            },
            {
              "id": "jl-f2",
              "label": "**写出来的书能回改,讲出来的话不能**——跑题、重复、无出处都从这儿来"
            }
          ]
        },
        {
          "id": "jl-audience",
          "label": "听众决定了讲法",
          "children": [
            {
              "id": "jl-a1",
              "label": "台下是社会上的成年人,不是文史系学生"
            },
            {
              "id": "jl-a2",
              "label": "所以例子全是做事、用人、应酬、下不来台"
            }
          ]
        },
        {
          "id": "jl-name",
          "label": "「别裁」是一句自我声明",
          "children": [
            {
              "id": "jl-n1",
              "label": "别,是别于正统;裁,是另一种裁剪"
            },
            {
              "id": "jl-n2",
              "label": "**他没有自称这是定论**"
            }
          ]
        }
      ]
    },
    {
      "id": "qiang",
      "label": "他要拆的那堵墙:朱注与「圣人腔」",
      "note": "从元代起,朱熹《四书章句集注》成了科举的标准答案。一种读法被当成唯一读法,七百年。",
      "ref": {
        "ch": 2
      },
      "children": [
        {
          "id": "qi-wall",
          "label": "墙是怎么砌起来的",
          "children": [
            {
              "id": "qi-w1",
              "label": "读《论语》先读注,注怎么说就怎么是"
            },
            {
              "id": "qi-w2",
              "label": "考试要照这个答,答错了不中——七百年,读法和经文长在了一起"
            }
          ]
        },
        {
          "id": "qi-tone",
          "label": "什么叫「圣人腔」",
          "children": [
            {
              "id": "qi-t1",
              "label": "孔子被讲成不苟言笑的道德符号,一句家常话读出满纸训诫"
            },
            {
              "id": "qi-t3",
              "label": "**人味儿是这样一点点被修掉的**"
            }
          ]
        },
        {
          "id": "qi-fair",
          "label": "但这堵墙被他画歪了几处",
          "children": [
            {
              "id": "qi-f1",
              "label": "他笔下的「宋儒」常是简化过的刻板像,朱注本身细致得多"
            },
            {
              "id": "qi-f3",
              "label": "立靶子打,是他被批评最多的一处"
            }
          ]
        }
      ]
    },
    {
      "id": "xueer",
      "label": "学而:开篇三句被讲成了什么",
      "note": "通行读法把它当三件不相干的乐事;他把它读成一个做学问的人的一生。这是全书的样板,长处短处都在里面。",
      "ref": {
        "ch": 3
      },
      "children": [
        {
          "id": "xe-three",
          "label": "一个人的一生",
          "children": [
            {
              "id": "xe-t1",
              "label": "学,是做人做事的体验,不只是读书"
            },
            {
              "id": "xe-t2",
              "label": "「远方」也可以是时间上的远——后世才有知音"
            },
            {
              "id": "xe-t3",
              "label": "一辈子没人懂也不怨,才叫君子"
            }
          ]
        },
        {
          "id": "xe-fan",
          "label": "「无友不如己者」的翻案",
          "children": [
            {
              "id": "xe-f1",
              "label": "旧解:不要跟不如自己的人交朋友"
            },
            {
              "id": "xe-f2",
              "label": "他说这样一讲,孔子就势利了"
            },
            {
              "id": "xe-f3",
              "label": "改读成:没有哪个朋友是全无可取的"
            }
          ]
        },
        {
          "id": "xe-both",
          "label": "长处与短处同时在这里",
          "children": [
            {
              "id": "xe-b1",
              "label": "长处:讲完你会想认识这个孔子"
            },
            {
              "id": "xe-b2",
              "label": "短处:好几处新解并无版本依据"
            }
          ]
        }
      ]
    },
    {
      "id": "weizheng",
      "label": "为政:「为政以德」不是道德说教",
      "note": "他把这一篇讲成一门领导学——台下坐着的,正是要带人的人。",
      "ref": {
        "ch": 4
      },
      "children": [
        {
          "id": "wz-de",
          "label": "德在这里近于「得」",
          "children": [
            {
              "id": "wz-d1",
              "label": "不是道德口号,是领导者自身立得住的那点分量"
            },
            {
              "id": "wz-d2",
              "label": "北辰居其所而众星共之:不动,而人自然围过来"
            },
            {
              "id": "wz-d3",
              "label": "**要人服气,先得有让人服气的东西**"
            }
          ]
        },
        {
          "id": "wz-kanren",
          "label": "看人的三层",
          "children": [
            {
              "id": "wz-k1",
              "label": "视其所以、观其所由、察其所安"
            },
            {
              "id": "wz-k2",
              "label": "做什么、为什么做、做完安不安心——第三层最难藏"
            }
          ]
        },
        {
          "id": "wz-buqi",
          "label": "「君子不器」",
          "children": [
            {
              "id": "wz-q1",
              "label": "器是有固定用途的家伙什,人一旦被磨成专用零件,就只剩那一个用处"
            },
            {
              "id": "wz-q2",
              "label": "他讲成:先做一个整个的人,再去做那件事"
            }
          ]
        }
      ]
    },
    {
      "id": "bayi",
      "label": "八佾与里仁:礼的本意与仁的落处",
      "note": "礼不是排场,是分寸;仁不是名词,是人与人之间过得去的那点讲究。",
      "ref": {
        "ch": 5
      },
      "children": [
        {
          "id": "by-li",
          "label": "礼的本意不是排场",
          "children": [
            {
              "id": "by-l1",
              "label": "八佾舞于庭,越的是分寸不是场面"
            },
            {
              "id": "by-l2",
              "label": "礼与其奢也宁俭——**排场越大,离礼往往越远**"
            }
          ]
        },
        {
          "id": "by-ren",
          "label": "仁的落处",
          "children": [
            {
              "id": "by-r1",
              "label": "不是抽象的道德名词,是待人接物的分寸"
            },
            {
              "id": "by-r2",
              "label": "「朝闻道,夕死可矣」——他讲这个「道」讲得很重"
            }
          ]
        },
        {
          "id": "by-xiao",
          "label": "他说「小人」多半只是小人物",
          "children": [
            {
              "id": "by-x1",
              "label": "君子喻于义,小人喻于利:两种在意的东西"
            },
            {
              "id": "by-x2",
              "label": "**这个分辨拔掉了不少刺,但用过头会把孔子的批评削平**"
            }
          ]
        }
      ]
    },
    {
      "id": "gongye",
      "label": "公冶长、雍也:孔子怎么看人",
      "note": "这两篇是一份孔门人物志——孔子当面评点学生,褒贬都不留情面。",
      "ref": {
        "ch": 6
      },
      "children": [
        {
          "id": "gy-ren",
          "label": "看的是人,不是名声",
          "children": [
            {
              "id": "gy-r1",
              "label": "把女儿嫁给坐过牢的公冶长"
            },
            {
              "id": "gy-r2",
              "label": "子贡问自己是什么,答「瑚琏也」——好器皿,但仍是器"
            }
          ]
        },
        {
          "id": "gy-hua",
          "label": "「宰予昼寝」的著名改读",
          "children": [
            {
              "id": "gy-h1",
              "label": "他采「画寝」说:不是白天睡觉,是把寝室画花了"
            },
            {
              "id": "gy-h2",
              "label": "理由:孔子骂的「不可雕」「不可杇」都是装修的话"
            },
            {
              "id": "gy-h3",
              "label": "**自圆其说,版本上却无据——他的典型手法**"
            }
          ]
        },
        {
          "id": "gy-zai",
          "label": "「再,斯可矣」",
          "children": [
            {
              "id": "gy-z1",
              "label": "季文子三思而后行,孔子说想两次就够了"
            },
            {
              "id": "gy-z2",
              "label": "想到第三遍,往往开始替自己找退路"
            }
          ]
        }
      ]
    },
    {
      "id": "shuer",
      "label": "述而、泰伯:一个自称「述而不作」的人",
      "note": "他说「述」本身就是极大的创造:把散掉的东西接起来传下去,比另起炉灶更难。",
      "ref": {
        "ch": 7
      },
      "children": [
        {
          "id": "se-shu",
          "label": "述而不作是谦虚还是自任",
          "children": [
            {
              "id": "se-s1",
              "label": "孔子的自我定位就在这四个字里"
            },
            {
              "id": "se-s2",
              "label": "**传承者不是二等的创造者**"
            }
          ]
        },
        {
          "id": "se-guai",
          "label": "子不语怪力乱神",
          "children": [
            {
              "id": "se-g1",
              "label": "不谈,不等于否定"
            },
            {
              "id": "se-g2",
              "label": "他兼讲佛道,借此讲三家互看——也是最招批评的地方之一"
            }
          ]
        },
        {
          "id": "se-min",
          "label": "「民可使由之,不可使知之」",
          "children": [
            {
              "id": "se-m1",
              "label": "字面读法像愚民,他不接受,另作断句与解释为孔子开脱"
            },
            {
              "id": "se-m3",
              "label": "**这类回护式解经,学界的意见最大**"
            }
          ]
        }
      ]
    },
    {
      "id": "zihan",
      "label": "子罕、乡党:圣人的日常",
      "note": "《乡党》通篇记孔子怎么吃、怎么穿、怎么坐。旧读法把它当繁文缛节的清单,他读成「圣人也是人」的证据。",
      "ref": {
        "ch": 8
      },
      "children": [
        {
          "id": "zh-ri",
          "label": "把琐碎读成教养",
          "children": [
            {
              "id": "zh-r1",
              "label": "衣食坐卧的讲究,是一个人对分寸的自觉"
            },
            {
              "id": "zh-r2",
              "label": "不是规矩管着他,是他自己愿意那样"
            }
          ]
        },
        {
          "id": "zh-jiu",
          "label": "厩焚,不问马",
          "children": [
            {
              "id": "zh-j1",
              "label": "马棚烧了,孔子退朝回来只问伤人没有"
            },
            {
              "id": "zh-j2",
              "label": "一句话见一个人心里什么排在前面"
            }
          ]
        },
        {
          "id": "zh-song",
          "label": "岁寒然后知松柏之后凋",
          "children": [
            {
              "id": "zh-s1",
              "label": "他不把它讲成豪言"
            },
            {
              "id": "zh-s2",
              "label": "只说人是要到那个时候才看得出来的"
            }
          ]
        }
      ]
    },
    {
      "id": "xianjin",
      "label": "先进、颜渊:因材施教的现场",
      "note": "同一个问题问两遍,孔子给出相反的答案——教育不是发讲义,是看人下药。",
      "ref": {
        "ch": 9
      },
      "children": [
        {
          "id": "xj-cai",
          "label": "一个压,一个推",
          "children": [
            {
              "id": "xj-c1",
              "label": "子路太冲,所以按住他;冉有太退,所以推他一把"
            },
            {
              "id": "xj-c2",
              "label": "**答案不同,不是孔子前后矛盾**"
            }
          ]
        },
        {
          "id": "xj-shizuo",
          "label": "侍坐一章",
          "children": [
            {
              "id": "xj-s1",
              "label": "三个学生说治国,曾皙说春天去河边吹吹风"
            },
            {
              "id": "xj-s2",
              "label": "孔子叹了口气:我跟曾点一样——讲的是一个人到底想过什么日子"
            }
          ]
        },
        {
          "id": "xj-sheng",
          "label": "「未知生,焉知死」",
          "children": [
            {
              "id": "xj-g1",
              "label": "不是拒答,是排次序"
            },
            {
              "id": "xj-g2",
              "label": "眼前的人事还没弄明白,谈鬼神太早"
            }
          ]
        }
      ]
    },
    {
      "id": "zilu",
      "label": "子路、宪问:政事与出处",
      "note": "从「必也正名乎」到「知其不可而为之」——做事的人怎么在这个世上落脚。",
      "ref": {
        "ch": 10
      },
      "children": [
        {
          "id": "zl-zheng",
          "label": "「必也正名乎」",
          "children": [
            {
              "id": "zl-z1",
              "label": "名分乱了话就说不清,话说不清事就办不成"
            },
            {
              "id": "zl-z2",
              "label": "他讲成一条很现实的行政链条"
            }
          ]
        },
        {
          "id": "zl-bao",
          "label": "「以德报怨」根本不是孔子的话",
          "children": [
            {
              "id": "zl-b1",
              "label": "是别人拿来问的,孔子反问:那拿什么报德? 答案是以直报怨、以德报德"
            },
            {
              "id": "zl-b3",
              "label": "**这条常识纠正,是全书流传最广的贡献之一**"
            }
          ]
        },
        {
          "id": "zl-zhi",
          "label": "知其不可而为之",
          "children": [
            {
              "id": "zl-h1",
              "label": "守城人给孔子下的六字判词"
            },
            {
              "id": "zl-h2",
              "label": "不是不知道做不成,是知道了还去做"
            }
          ]
        }
      ]
    },
    {
      "id": "weiling",
      "label": "卫灵公到微子:困厄中的孔门",
      "note": "断粮、被笑、被劝退隐。这几篇里的孔子最不像圣人,也最像一个人。",
      "ref": {
        "ch": 11
      },
      "children": [
        {
          "id": "wl-qiong",
          "label": "在陈绝粮",
          "children": [
            {
              "id": "wl-q1",
              "label": "随行的人病倒,子路发火:君子也有穷的时候吗"
            },
            {
              "id": "wl-q2",
              "label": "答:君子固穷,小人穷斯滥矣"
            },
            {
              "id": "wl-q3",
              "label": "**穷不是问题,穷了以后乱来才是**"
            }
          ]
        },
        {
          "id": "wl-yin",
          "label": "隐者的讥讽",
          "children": [
            {
              "id": "wl-y1",
              "label": "长沮桀溺、荷蓧丈人一路笑他:天下已经这样了,躲吧"
            },
            {
              "id": "wl-y2",
              "label": "孔子说鸟兽不可与同群——他要留在人堆里"
            }
          ]
        },
        {
          "id": "wl-hu",
          "label": "一处必须留心的回护",
          "children": [
            {
              "id": "wl-h1",
              "label": "「唯女子与小人为难养也」,他试图另解开脱——这类解释多属曲说"
            },
            {
              "id": "wl-h3",
              "label": "**一本书可以既好用,又在某些地方靠不住**"
            }
          ]
        }
      ]
    },
    {
      "id": "zizhang",
      "label": "子张、尧曰:收尾与传承",
      "note": "《子张》全是弟子的话——老师已经不在场了。一个学派是从这里开始成形的。",
      "ref": {
        "ch": 12
      },
      "children": [
        {
          "id": "zz-hou",
          "label": "孔子不在场的一篇",
          "children": [
            {
              "id": "zz-h1",
              "label": "子张、子夏、子游、曾子、子贡各说各的,彼此也有分歧"
            },
            {
              "id": "zz-h2",
              "label": "子贡护师:仲尼日月也,无得而逾焉"
            }
          ]
        },
        {
          "id": "zz-you",
          "label": "「学而优则仕」被误读了千百年",
          "children": [
            {
              "id": "zz-y1",
              "label": "优是「有余力」,不是「优秀」"
            },
            {
              "id": "zz-y2",
              "label": "学有余力就去做事,做事有余力就回来学"
            },
            {
              "id": "zz-y3",
              "label": "**这类字义纠正是他很实在的功劳**"
            }
          ]
        },
        {
          "id": "zz-ming",
          "label": "收在「不知命,无以为君子」",
          "children": [
            {
              "id": "zz-m1",
              "label": "全书以学开头,以知命收尾,他把首尾读成一处呼应"
            },
            {
              "id": "zz-m2",
              "label": "这也是他「每篇是一整篇文章」主张的收束"
            }
          ]
        }
      ]
    },
    {
      "id": "zhengyi",
      "label": "争议:学界为什么不认这本书",
      "note": "争议不是新派老派之争,而是「讲得通」和「讲得对」之间的差别。这一章必须说得足够充分。",
      "ref": {
        "ch": 13
      },
      "children": [
        {
          "id": "zy-guge",
          "label": "全书骨架就是最大的争议",
          "children": [
            {
              "id": "zy-g1",
              "label": "他主张《论语》每一篇都是前后连贯的一整篇文章"
            },
            {
              "id": "zy-g2",
              "label": "通说:篇名只取首句二三字,篇内各章多不相连"
            },
            {
              "id": "zy-g3",
              "label": "**前提一旦不成立,那些串联就成了他自己的创作**"
            }
          ]
        },
        {
          "id": "zy-xun",
          "label": "训诂上的硬伤",
          "children": [
            {
              "id": "zy-x1",
