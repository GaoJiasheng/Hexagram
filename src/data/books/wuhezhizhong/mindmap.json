{
  "id": "root",
  "label": "乌合之众",
  "note": "古斯塔夫·勒庞，1895。群体心理学的开山之作，观察犀利而方法粗糙——值得研读，不宜照单全收。",
  "children": [
    {
      "id": "ch1",
      "label": "群体的一般特征",
      "ref": { "ch": 1 },
      "children": [
        {
          "id": "psych-crowd",
          "label": "「心理群体」不等于一群人",
          "children": [
            {
              "id": "psych-crowd-def",
              "label": "一千个人偶然挤在广场上还不算群体；只有当他们的感情与思想转向同一个方向、自觉的个性消失时，才形成勒庞所说的「心理群体」。"
            },
            {
              "id": "psych-crowd-chem",
              "label": "他用了个化学比喻：氢和氧化合成水，性质与原来的元素完全不同——群体心理不是个人心理的平均数，而是化合出的新东西。"
            }
          ]
        },
        {
          "id": "lose-self",
          "label": "个性退场，无意识上台",
          "children": [
            {
              "id": "lose-self-hypnosis",
              "label": "融入群体的人像被催眠：自觉人格消退，教养与理智这层「薄漆」剥落，行为交给无意识本能接管。",
              "note": "勒庞强调：群体在智力上总低于孤立的个人，但在感情上既可以更坏、也可以更好——它能烧杀抢掠，也能慷慨赴死。"
            }
          ]
        },
        {
          "id": "three-mechanisms",
          "label": "三个机制：匿名、传染、暗示",
          "children": [
            {
              "id": "mechanisms-detail",
              "label": "匿名让责任感蒸发（法不责众），情绪像病毒一样人传人，暗示则让人如同梦游——三者叠加，个人成了「不再受自己意志支配的玩偶」。"
            },
            {
              "id": "mechanisms-side",
              "label": "【批判】现代社会心理学的 SIDE 模型已修正此说：匿名并不让人「丧失理智」，而是让人从个人身份切换到群体身份，行为仍遵循该群体的规范——暴民只是可能性之一，不是必然。"
            }
          ]
        }
      ]
    },
    {
      "id": "ch2",
      "label": "群体的感情与道德观",
      "ref": { "ch": 2 },
      "children": [
        {
          "id": "impulsive",
          "label": "冲动、多变、急躁",
          "children": [
            {
              "id": "impulsive-leaf",
              "label": "群体像被风摆布的树叶：刺激直接变成行动，不经过深思；它可以转瞬从血腥暴虐跳到极端慷慨，唯独做不到持之以恒。"
            }
          ]
        },
        {
          "id": "credulity",
          "label": "轻信与集体幻觉",
          "children": [
            {
              "id": "credulity-frigate",
              "label": "群体用形象思考，一个人的错觉会传染给所有人：勒庞举军舰寻找失事船只的例子——全舰官兵都「看见」了载满幸存者的木筏，驶近才发现是几根漂着树叶的树枝。",
              "note": "由此他提醒：受千百人共同「目击」证实的事件，也可能与事实完全不符——目击者的人数不是证据的强度。"
            }
          ]
        },
        {
          "id": "exaggerate",
          "label": "感情夸张专横，道德可上可下",
          "children": [
            {
              "id": "exaggerate-extreme",
              "label": "群体的感情只有简单和极端两个档位：怀疑一出口就变成不容置疑的证据，轻微的反感立刻膨胀成深仇大恨。"
            },
            {
              "id": "exaggerate-caveat",
              "label": "【批判】勒庞在这里反复把群体比作「妇人和儿童」、归因于「种族气质」——这是 19 世纪的性别与种族伪科学，今天已被推翻；把这些段落当时代标本剥离掉，不影响其余观察的成立。"
            }
          ]
        }
      ]
    },
    {
      "id": "ch3",
      "label": "群体的观念、推理与想象力",
      "ref": { "ch": 3 },
      "children": [
        {
          "id": "simplified-ideas",
          "label": "观念必须简化变形才能进入群体",
          "children": [
            {
              "id": "ideas-slogan",
              "label": "再高深的学说，要被群体接受，必须先简化成一句绝对、不容分辨的口号；观念渗入无意识要花几代人，过时之后退场也同样缓慢。"
            }
          ]
        },
        {
          "id": "crowd-logic",
          "label": "群体的「推理」是形象串联",
          "children": [
            {
              "id": "logic-association",
              "label": "群体的逻辑是把表面相似的东西直接连起来，就像「吃下勇敢敌人的心脏就能获得他的勇气」——不辨真伪，只认联想。"
            }
          ]
        },
        {
          "id": "imagination",
          "label": "形象统治着群体的想象力",
          "children": [
            {
              "id": "imagination-drama",
              "label": "打动群体的从来不是事实本身，而是事实呈现的戏剧性方式：一场轰动的事故画面，胜过一千条逐年下降的安全统计。"
            },
            {
              "id": "imagination-rule",
              "label": "勒庞断言「掌握了影响群众想象力的艺术，就掌握了统治他们的艺术」——这句话是观察权力的透镜，不是操作手册。"
            }
          ]
        }
      ]
    },
    {
      "id": "ch4",
      "label": "群体信仰的宗教形式",
      "ref": { "ch": 4 },
      "children": [
        {
          "id": "religious-form",
          "label": "一切群体信念都长着宗教的模样",
          "children": [
            {
              "id": "religious-structure",
              "label": "群体的信仰无论内容是神、主义还是领袖，结构都相同：盲目服从、不容讨论、渴望传播——勒庞称之为「宗教感情」。"
            },
            {
              "id": "religious-atheism",
              "label": "即使是无神论，一旦被群体接受，也会以宗教狂热的方式被信奉：换了崇拜对象，没换心理结构。"
            }
          ]
        },
        {
          "id": "history-reading",
          "label": "用这把钥匙重读历史",
          "children": [
            {
              "id": "history-events",
              "label": "圣巴托罗缪大屠杀、宗教战争、大革命的恐怖统治，在勒庞看来都不是帝王的个人意志，而是群体宗教感情发作的产物。"
            }
          ]
        }
      ]
    },
    {
      "id": "ch5",
      "label": "意见与信念的间接因素",
      "ref": { "ch": 5 },
      "children": [
        {
          "id": "race-factor",
          "label": "「种族」因素——须批判着读",
          "children": [
            {
              "id": "race-caveat",
              "label": "勒庞把「种族气质」列为决定群体信念的头号间接因素；这是 19 世纪种族伪科学，「民族性格由血统遗传决定」之说早已被现代学术抛弃——把它替换成「文化传统的惯性」再读，才有可取之处。"
            }
          ]
        },
        {
          "id": "tradition-time",
          "label": "传统与时间",
          "children": [
            {
              "id": "tradition-leaf",
              "label": "民族是活在过去里的生物，真正的主人是传统；观念的生根与衰亡都以世代计——时间才是唯一真正的变革者。"
            }
          ]
        },
        {
          "id": "institution-edu",
          "label": "制度与教育的祛魅",
          "children": [
            {
              "id": "institution-fruit",
              "label": "制度是果不是因：给一个民族换一部宪法，改不了它的深层习性——勒庞借此嘲讽「制度万能」的迷信。"
            },
            {
              "id": "edu-critique",
              "label": "他抨击法国的填鸭式应试教育：背课本替代真实历练，只批量制造「拿着文凭的不满者」——这是全书至今仍被频繁引用的少数段落之一。"
            }
          ]
        }
      ]
    },
    {
      "id": "ch6",
      "label": "意见的直接因素",
      "ref": { "ch": 6 },
      "children": [
        {
          "id": "words-formulas",
          "label": "词语与套话的魔力",
          "children": [
            {
              "id": "words-vague",
              "label": "「自由」「平等」「民主」这类词的威力与其确切含义无关，词义越模糊威力反而越大，像咒语一样唤起宏大形象。"
            },
            {
              "id": "words-rename",
              "label": "政治家的老练之处，是在事物惹人厌恶时给它换个新名字：同一种税换个叫法，抵触就消解大半。"
            }
          ]
        },
        {
          "id": "illusion",
          "label": "幻觉优先于真理",
          "children": [
            {
              "id": "illusion-rule",
              "label": "群体从不渴求真理：谁能供给幻觉，谁就能统治他们；谁去戳破幻觉，谁就成为群体的祭品。"
            }
          ]
        },
        {
          "id": "reason-powerless",
          "label": "经验迟钝，理性无力",
          "children": [
            {
              "id": "reason-leaf",
              "label": "经验要在好几代人身上重复才能撼动一个牢固的错误信念，而理性论证对群体几乎无效——所以演说家诉诸感情而非逻辑，辩论从来赢不了信仰。"
            }
          ]
        }
      ]
    },
    {
      "id": "ch7",
      "label": "群体的领袖及其说服手法",
      "ref": { "ch": 7 },
      "children": [
        {
          "id": "who-leaders",
          "label": "领袖是什么人",
          "children": [
            {
              "id": "leaders-will",
              "label": "群体像仆从一样本能地寻找并服从有意志的人；领袖往往不是思想家而是行动者——自己先被信念催眠，再去催眠众人，偏执的狂信者常常胜过犹豫的智者。"
            }
          ]
        },
        {
          "id": "three-tricks",
          "label": "三板斧：断言、重复、传染",
          "children": [
            {
              "id": "tricks-detail",
              "label": "断言：不带论证、不留余地的简洁肯定最能钻进群体头脑；重复：同一句话说上千遍，就沉入无意识变成「人人都知道」；传染：情绪与信念像细菌，在人群里指数级扩散。"
            },
            {
              "id": "tricks-warning",
              "label": "【提醒】这三板斧后来被广告、公关与政治宣传照单全收——在这里读它，是为了在被人使用时一眼认出，不是学着去用。"
            }
          ]
        },
        {
          "id": "prestige",
          "label": "名望：让批判力瘫痪的魔力",
          "children": [
            {
              "id": "prestige-types",
              "label": "名望分两种：先天的（头衔、财富、制服）与个人的（拿破仑式的磁力）；它的本质是麻痹我们的批判能力，只剩下惊叹与敬畏。"
            },
            {
              "id": "prestige-fall",
              "label": "名望靠成功续命，一旦失败立刻反噬——昨天被膜拜的偶像，今天会被同一群人踩进泥里，群体报复退位的旧神格外凶狠。"
            }
          ]
        }
      ]
    },
    {
      "id": "ch8",
      "label": "信念与意见的变化范围",
      "ref": { "ch": 8 },
      "children": [
        {
          "id": "fixed-beliefs",
          "label": "牢固的普遍信念",
          "children": [
            {
              "id": "beliefs-pillar",
              "label": "大信念（宗教、封建观念、某种主义）是文明的骨架：确立要几百年，根除也要几百年；哲学上站不住脚，从不妨碍它统治人心。"
            }
          ]
        },
        {
          "id": "floating-opinions",
          "label": "多变的表层意见",
          "children": [
            {
              "id": "opinions-ripple",
              "label": "大信念之上漂着一层像水面涟漪般起灭不定的日常意见，随时尚与报纸摇摆。"
            },
            {
              "id": "opinions-media",
              "label": "勒庞观察到当时的报刊已放弃引导、只知迎合读者，意见于是空前善变——把「报刊」换成「社交媒体信息流」，这段一百多年前的诊断至今眼熟。"
            }
          ]
        }
      ]
    },
    {
      "id": "ch9",
      "label": "群体的分类",
      "ref": { "ch": 9 },
      "children": [
        {
          "id": "hetero-homo",
          "label": "异质性群体与同质性群体",
          "children": [
            {
              "id": "classify-leaf",
              "label": "异质性群体成分混杂（街头群众、议会），同质性群体有共同纽带（宗派、身份团体、阶级）——全书主要解剖的是前者。"
            }
          ]
        },
        {
          "id": "anonymity-degree",
          "label": "匿名程度决定责任感",
          "children": [
            {
              "id": "anonymity-leaf",
              "label": "街头的无名群体最不负责任，陪审团、议会这类有名有姓的群体要好一些：越匿名越敢越界——这条线索贯穿后面四章的比较。"
            }
          ]
        }
      ]
    },
    {
      "id": "ch10",
      "label": "所谓的犯罪群体",
      "ref": { "ch": 10 },
      "children": [
        {
          "id": "crime-quotes",
          "label": "「犯罪」要打引号",
          "children": [
            {
              "id": "crime-conscience",
              "label": "法律上有罪，心理上却往往「无罪」：群体罪行的动机是暗示，参与者事后带着完成义务般的清白良心。"
            }
          ]
        },
        {
          "id": "september-case",
          "label": "九月屠杀这个样本",
          "children": [
            {
              "id": "september-leaf",
              "label": "屠杀监狱囚犯的暴徒自设「法庭」走程序、给被赦免者欢呼、干完还去当局请赏，同时把死者的钱包首饰如数上交——凶残与「诚实」并存，因为两者都出自对群体规范的服从，而非个人算计。"
            }
          ]
        }
      ]
    },
    {
      "id": "ch11",
      "label": "刑事案件的陪审团",
      "ref": { "ch": 11 },
