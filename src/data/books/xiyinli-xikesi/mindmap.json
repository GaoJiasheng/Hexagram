{
  "id": "root",
  "label": "吸引力法则",
  "note": "Esther & Jerry Hicks《The Law of Attraction》(2006),「亚伯拉罕」教义,现代吸引力法则的源头文本之一;本图为研读梳理,如实呈现主张并保留批判视角",
  "children": [
    {
      "id": "ch1-origin",
      "label": "缘起·一本通灵书",
      "ref": { "ch": 1 },
      "children": [
        {
          "id": "hicks-abraham",
          "label": "埃丝特自称通灵传讯「亚伯拉罕」——一组「非物质意识」借她之口说话",
          "children": [
            {
              "id": "qa-format",
              "label": "杰瑞提问、埃丝特出神传讯,问答整理成书——全书名义上的「作者」不是人类。"
            },
            {
              "id": "tape-to-bestseller",
              "label": "1980年代靠录音带起家,2006年成书,又借《秘密》电影的东风成为全球畅销书。"
            }
          ]
        },
        {
          "id": "new-thought-roots",
          "label": "教义并非原创:是19世纪「新思潮」(New Thought)运动的现代翻新",
          "children": [
            {
              "id": "quimby-lineage",
              "label": "「同类相吸、心想事成」可追溯到 Quimby、《思考致富》等新思潮谱系,并非亚伯拉罕首创。"
            },
            {
              "id": "term-1877",
              "label": "「吸引力法则」一词早在19世纪就已出现,希克斯版本是它最成功的一次现代包装。"
            }
          ]
        },
        {
          "id": "book-promise",
          "label": "书的许诺:掌握三大法则,人生一切领域皆可刻意改善",
          "children": [
            {
              "id": "three-laws",
              "label": "全书骨架是三块:吸引力法则(世界怎么运作)、刻意创造(怎么用)、允许的艺术(怎么不挡自己的路)。"
            },
            {
              "id": "reading-stance",
              "label": "研读姿态:先如实理解它说了什么,再回头检验它站不站得住——见第7枝。"
            }
          ]
        }
      ]
    },
    {
      "id": "ch2-law",
      "label": "吸引力法则·万物皆振动",
      "ref": { "ch": 2 },
      "children": [
        {
          "id": "like-attracts-like",
          "label": "同类相吸:你持续专注什么,就把什么吸进生活",
          "children": [
            {
              "id": "definition",
              "label": "书中定义:「与其自身相似者,即被其吸引」——想法像磁铁,吸来与它频率一致的人、事、境遇。"
            },
            {
              "id": "worry-equals-want",
              "label": "所以在它看来,「担心欠债」和「渴望有钱」是同一种专注的两个面——你盯着的都是「缺钱」。"
            }
          ]
        },
        {
          "id": "vibration",
          "label": "万物皆振动:宇宙、身体、情绪、念头都被说成有频率",
          "children": [
            {
              "id": "vibration-claim",
              "label": "书里把一切存在都描述为振动,频率相近者互相吸引,想法即是向宇宙发出的信号。"
            },
            {
              "id": "vibration-caveat",
              "label": "注意:这里的「振动/频率」是借来的物理词,书中从头到尾没有给出可测量的定义。",
              "note": "这是信念语言,不是物理学"
            }
          ]
        },
        {
          "id": "transmitter",
          "label": "你是一座发射塔:无时无刻不在广播自己的频率",
          "children": [
            {
              "id": "no-word-no",
              "label": "「你所想即你所得」,不管想的是想要的还是不想要的——法则不认识「不要」这个词。"
            },
            {
              "id": "saying-no-is-yes",
              "label": "书中名句:对一件事喊「不」就是对它喊「是」——你喊「我不要生病」,发出的仍是「生病」的振动。"
            }
          ]
        },
        {
          "id": "no-exceptions",
          "label": "法则被说成宇宙第一法则:无例外、不休息、不评判",
          "children": [
            {
              "id": "echo-metaphor",
              "label": "它不奖善罚恶,只如实回应你的专注——像山谷回声,你喊什么它回什么。"
            },
            {
              "id": "dangerous-corollary",
              "label": "推论(也是全书最危险处):你生活中的一切,都是你自己「吸引」来的——此推论的伦理后果见第7枝。",
              "note": "受害者有罪论的种子就埋在这里"
            }
          ]
        }
      ]
    },
    {
      "id": "ch3-creation",
      "label": "刻意创造·想法与期待",
      "ref": { "ch": 3 },
      "children": [
        {
          "id": "creation-formula",
          "label": "创造公式:想法(发愿)+期待(信)=显化",
          "children": [
            {
              "id": "formula-detail",
              "label": "光想没用:想法必须配上「期待或相信」,愿望与信念方向一致时,事情才开始成形。"
            },
            {
              "id": "mixed-signal",
              "label": "「想要却不信自己会得到」的人,发出的是矛盾信号——书中说这正是多数人求而不得的原因。"
            }
          ]
        },
        {
          "id": "belief-as-thought",
          "label": "信念不神秘:它只是你反复想到习惯成自然的想法",
          "children": [
            {
              "id": "keep-thinking",
              "label": "「信念只是你不断在想的想法」——所以改信念=挑一串新想法反复去想,想熟了它就成了信。"
            },
            {
              "id": "soft-statements",
              "label": "书中建议从松的说法起步(「事情正在变好」),硬掰「我很富有」反而会激起内心的不信。"
            }
          ]
        },
        {
          "id": "attention-compounds",
          "label": "专注会复利:念头保持得越久,汇入的同类念头越多、势头越大",
          "children": [
            {
              "id": "17-68-seconds",
              "label": "书中给出精确数字:纯粹专注17秒,同类想法开始汇入;满68秒,振动「足以启动显化」——数字本身没有任何实证来源。",
              "note": "精确感是修辞,不是测量"
            },
            {
              "id": "early-correction",
              "label": "刚萌芽的念头最容易调头,所以要在情绪还轻微时就纠偏,别等它滚成雪球。"
            }
          ]
        },
        {
          "id": "default-vs-deliberate",
          "label": "从「无意创造」到「刻意创造」:多数人在用观察代替选择",
          "children": [
            {
              "id": "observe-replicate",
              "label": "多数人盯着现状想,于是不断复制现状——看什么是什么,就吸来更多「什么是什么」。"
            },
            {
              "id": "live-in-thought-first",
              "label": "刻意创造者把注意力从「现实如何」挪到「我要它如何」,先在想法里把那个生活活出来。"
            }
          ]
        }
      ]
    },
    {
      "id": "ch4-allowing",
      "label": "允许的艺术·停止抗拒",
      "ref": { "ch": 4 },
      "children": [
        {
          "id": "resistance",
          "label": "抗拒是唯一的堵点:一边想要,一边盯着「它还没来」",
          "children": [
            {
              "id": "brake-and-gas",
              "label": "书中比喻:愿望是踩油门,怀疑、着急、匮乏感是同时踩着的刹车——车不动不是油门不够。"
            },
            {
              "id": "allowing-is-release",
              "label": "「允许」不是再加一层努力,而是松手:停止发出与愿望相反的振动,信任它自己会来。"
            }
          ]
        },
        {
          "id": "allowing-vs-tolerating",
          "label": "允许≠容忍:容忍是咬牙忍受,允许是真的不起波澜",
          "children": [
            {
              "id": "tolerator-still-attracts",
              "label": "容忍者仍死盯着不想要的东西,按书的逻辑他仍在吸引它;允许者看见了,但频率不为所动。"
            },
            {
              "id": "allow-others",
              "label": "对人同理:允许的艺术是让别人按他们的方式活,而不因看不惯就搅乱自己的频率。"
            }
          ]
        },
        {
          "id": "wellbeing-stream",
          "label": "教义的底色:幸福安好是「默认水流」,你只需停止逆流",
          "children": [
            {
              "id": "river-metaphor",
              "label": "书中说 well-being 像一条河,不必争取,只需松开抓着岸边枯枝(旧念头)的手,顺流即达。"
            },
            {
              "id": "no-uninvited",
              "label": "「没有邀请的振动,谁也进不了你的经验」——这句安慰话反过来,就是把受害也归因于受害者,危险处见第7枝。",
              "note": "同一句话既是鸡汤也是刀子"
            }
          ]
        }
      ]
    },
    {
      "id": "ch5-emotions",
      "label": "情绪量表·情绪是仪表",
      "ref": { "ch": 5 },
      "children": [
        {
          "id": "guidance-system",
          "label": "情绪是仪表盘:实时显示当下想法与你真正想要的之间的偏差",
          "children": [
            {
              "id": "feel-bad-off-course",
              "label": "感觉糟=这个想法正把你带离愿望;感觉好=方向对了——情绪不用分析,只用读数。"
            },
            {
              "id": "better-or-worse",
              "label": "所以该问的不是「这个想法对不对」,而是「这个想法让我感觉更好还是更糟」。"
            }
          ]
        },
        {
          "id": "reach-for-better",
          "label": "方法只有一个动作:从当下的感受,够向「感觉稍好一点」的想法",
          "children": [
            {
              "id": "one-rung",
              "label": "不要求一步从绝望跳到喜悦——从绝望够到愤怒,在量表上已经是实打实的进步。"
            },
            {
              "id": "ladder-operation",
              "label": "操作感像给情绪装了个爬梯:每次只爬一格,够得着的那一格才算数,够不着的说了也白说。"
            }
          ]
        },
        {
          "id": "scale-ladder",
          "label": "量表是一条从喜悦到无力的梯子(后续著作细化为22级)",
          "children": [
            {
              "id": "scale-bands",
              "label": "顶端是喜悦、感恩、自由;中段是无聊、沮丧、愤怒;底端是恐惧、绝望、无力。"
            },
            {
              "id": "anger-above-despair",
              "label": "愤怒在梯子上高于绝望——对被压垮的人,「生气起来」反而是好转的一步,这是书里最反直觉的主张之一。"
            }
          ]
        }
      ]
    },
    {
      "id": "ch6-techniques",
      "label": "对照与技法",
      "ref": { "ch": 6 },
      "children": [
        {
          "id": "contrast",
          "label": "对照(contrast):讨厌的经历不是惩罚,是澄清器",
          "children": [
            {
              "id": "rocket-of-desire",
              "label": "每次确认「我不要什么」,都同时在心里射出一支「我要什么」的火箭(rocket of desire)。"
            },
            {
              "id": "dont-linger",
              "label": "所以书中不劝你躲开糟糕经历,只劝你别在糟糕里久留——取完「对照」给的信息就走。"
            }
          ]
        },
        {
          "id": "segment-intending",
          "label": "分段设定(Segment Intending):把一天切成段,进段前先预设意图",
          "children": [
            {
              "id": "segment-examples",
              "label": "上车前、开会前、接电话前,花几秒想清楚「这一段我想要它是什么样」。"
            },
            {
              "id": "implementation-intention",
              "label": "剥掉振动话术,这其实是给注意力换挡的仪式——很接近心理学里的执行意图(if-then 计划)。"
            }
          ]
        },
        {
          "id": "creative-workshop",
          "label": "创造工坊(Creative Workshop):每天约15分钟,在心里预演已实现的生活",
          "children": [
            {
              "id": "workshop-method",
              "label": "在感觉好的时候进工坊,把想要的画面细节化,直到「感觉它已经是真的」为止。"
            },
            {
              "id": "workshop-is-play",
              "label": "书中强调工坊是玩不是苦干:感觉不好时硬做观想,等于带着刹车踩油门,白费。"
            }
          ]
        },
        {
          "id": "pivoting-gratitude",
          "label": "枢纽转向与感恩:日常纠偏的小杠杆",
          "children": [
            {
              "id": "pivoting",
              "label": "枢纽(pivoting):一发现自己在想「不要的」,立刻问「那我要的是什么?」,就地掉头。"
            },
            {
              "id": "gratitude-levers",
              "label": "感恩清单、「这不重要,一切都好」的口头禅——都是把频率抬回去的随身小工具。"
            }
          ]
        }
      ]
    },
    {
      "id": "ch7-critique",
      "label": "批判性回望",
      "ref": { "ch": 7 },
      "children": [
        {
          "id": "not-science",
          "label": "这是信念体系,不是科学:「振动」「频率」经不起物理学检验",
          "children": [
            {
              "id": "no-falsifiable",
              "label": "想法是神经活动,不会向宇宙广播能吸附同类事件的「频率」——书中没有任何可证伪的预测。"
            },
            {
              "id": "numbers-rhetoric",
              "label": "17秒、68秒这类精确数字没有任何实验支撑,精确感本身就是一种修辞术。"
            },
            {
              "id": "law-word-abuse",
              "label": "「法则」一词是僭越:物理法则人人可重复验证,而吸引力法则的失败案例总能被解释成「你还有抗拒」——不可能输的理论,也就无所谓赢。"
            }
          ]
        },
        {
          "id": "channeling-problem",
          "label": "通灵不可验证:「亚伯拉罕」的权威无法检验,也无需为错误负责",
          "children": [
            {
              "id": "authority-untouchable",
              "label": "教义的正确性全押在「非物质意识更高明」上——这是诉诸权威,而这个权威原则上无法被质询。"
            },
            {
              "id": "dissociation-view",
              "label": "出神传讯在心理学上更接近解离或自动化言语现象,不需要超自然解释。"
            }
          ]
        },
        {
          "id": "victim-blaming",
          "label": "最危险的推论:「一切都是你吸引来的」=受害者有罪论",
          "note": "本书伦理上最需警惕的一条线",
          "children": [
            {
              "id": "cruel-logic",
              "label": "按此逻辑,疾病、贫穷、被侵害都成了当事人「振动不对」的结果——这在道德上残忍,在事实上错误。"
            },
            {
              "id": "empathy-erosion",
              "label": "它还会劝人以「保护频率」为名远离求助者与坏消息,长期侵蚀同情心与现实感。"
            },
            {
              "id": "structural-blindness",
              "label": "贫困、歧视、疫病等结构性问题被化约为个人心念,恰好消解了改变现实条件的动力。"
            }
          ]
        },
        {
          "id": "real-psychology",
          "label": "书里真正管用的部分,正经心理学都有更诚实的版本",
          "children": [
            {
              "id": "cbt-parallel",
              "label": "「关注解决而非问题」≈解决焦点疗法;「够向更好的想法」≈认知行为疗法里的认知重评。"
            },
            {
              "id": "rehearsal-parallel",
              "label": "分段设定≈执行意图,创造工坊≈心理预演与意象训练,感恩练习的益处有实证——但都不需要「向宇宙下单」。"
            },
            {
              "id": "mechanism-is-you",
              "label": "乐观与期待确实影响行为与坚持(自我效能、安慰剂效应)——起作用的机制是你自己,不是宇宙。"
            }
          ]
        }
      ]
    }
  ]
}
