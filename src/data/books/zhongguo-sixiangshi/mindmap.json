{
  "id": "root",
  "label": "中国思想史",
  "note": "葛兆光两卷本,1998 与 2000 年先后出版。它要回答的不是「中国人想过什么」,而是一个更根本的问题:思想史这门学问,到底应该写谁、写什么、拿什么材料写。",
  "children": [
    {
      "id": "daolun",
      "label": "导论:思想史该怎么写",
      "note": "全书的问题意识都在这里。篇幅极长,常被单独抽出来当方法论文章读,影响甚至超过正文。",
      "ref": { "ch": 1 },
      "children": [
        {
          "id": "dl-old",
          "label": "旧写法的毛病",
          "children": [
            {
              "id": "dlo-1",
              "label": "只写留下名字的那几十个人"
            },
            {
              "id": "dlo-2",
              "label": "像一场接力赛:孔孟—老庄—程朱—陆王"
            },
            {
              "id": "dlo-3",
              "label": "没有大思想家的年代,就成了空白页"
            }
          ]
        },
        {
          "id": "dl-new",
          "label": "他要换的三件事",
          "children": [
            {
              "id": "dln-1",
              "label": "补上「一般」的那一层,不只写高峰"
            },
            {
              "id": "dln-2",
              "label": "平缓的年代同样有思想史"
            },
            {
              "id": "dln-3",
              "label": "材料从经典扩到类书、日书、碑刻、图像"
            }
          ]
        },
        {
          "id": "dl-borrow",
          "label": "眼光是从哪儿借的",
          "children": [
            {
              "id": "dlb-1",
              "label": "长时段的史学:水面下的部分变得极慢"
            },
            {
              "id": "dlb-3",
              "label": "但落点始终在中国材料,不是套理论"
            }
          ]
        },
        {
          "id": "dl-lost",
          "label": "还要找回「失踪者」",
          "children": [
            {
              "id": "dll-1",
              "label": "后人只记住胜出的那一支"
            },
            {
              "id": "dll-2",
              "label": "当时同样有力的说法被淘汰出局"
            },
            {
              "id": "dll-3",
              "label": "思想史不该只是一份获奖名单"
            }
          ]
        }
      ]
    },
    {
      "id": "yiban",
      "label": "一般知识、思想与信仰世界",
      "note": "全书最核心、也最被争论的一个概念。它指的是当时人人默认、无须论证的常识。",
      "ref": { "ch": 2 },
      "children": [
        {
          "id": "yb-two",
          "label": "「一般」的两层意思",
          "children": [
            {
              "id": "ybt-1",
              "label": "普遍的:大多数人共享"
            },
            {
              "id": "ybt-2",
              "label": "平均的:不是最高的那一层,是中位的那一层"
            }
          ]
        },
        {
          "id": "yb-what",
          "label": "它由什么构成",
          "children": [
            {
              "id": "ybw-1",
              "label": "历法节气:哪天宜做什么"
            },
            {
              "id": "ybw-2",
              "label": "风水堪舆:房子朝哪、坟怎么埋"
            },
            {
              "id": "ybw-3",
              "label": "医方禁忌:病从哪来、怎么禳解"
            },
            {
              "id": "ybw-4",
              "label": "神灵谱系:该拜谁、以什么次序拜"
            }
          ]
        },
        {
          "id": "yb-nature",
          "label": "它的性质:不必论证",
          "children": [
            {
              "id": "ybn-2",
              "label": "正因为不必论证,才最难被撼动"
            },
            {
              "id": "ybn-3",
              "label": "支配多数人生活的是它,不是哲学命题"
            }
          ]
        },
        {
          "id": "yb-three",
          "label": "知识 · 思想 · 信仰 为什么并列",
          "children": [
            {
              "id": "ybr-1",
              "label": "观念是站在技术性知识之上的"
            },
            {
              "id": "ybr-2",
              "label": "宇宙图式先是历算数术,后来才成义理"
            },
            {
              "id": "ybr-3",
              "label": "信仰不是附属品,与前两者同层"
            }
          ]
        }
      ]
    },
    {
      "id": "shanggu",
      "label": "第一卷 · 上古",
      "note": "第一卷大致从思想的起点写起。这一段没有成体系的著作,他改用器物、仪式与数术来看观念的雏形。",
      "ref": { "ch": 3 },
      "children": [
        {
          "id": "sg-start",
          "label": "起点不在文字,在器物与仪式",
          "children": [
            {
              "id": "sgs-1",
              "label": "玉器、方位、数字里已经有秩序感"
            },
            {
              "id": "sgs-2",
              "label": "考古材料被当作思想史材料来用"
            }
          ]
        },
        {
          "id": "sg-wu",
          "label": "巫觋与数术:最早的知识垄断",
          "children": [
            {
              "id": "sgw-1",
              "label": "谁能通天,谁就握着解释权"
            },
            {
              "id": "sgw-2",
              "label": "卜筮在当时是推理术,不是迷信"
            }
          ]
        },
        {
          "id": "sg-cosmos",
          "label": "宇宙图式先于哲学",
          "children": [
            {
              "id": "sgc-1",
              "label": "天圆地方、四方与中央"
            },
            {
              "id": "sgc-2",
              "label": "后来的义理是在这套图上长出来的"
            }
          ]
        },
        {
          "id": "sg-caution",
          "label": "读这一段要留个心",
          "children": [
            {
              "id": "sgu-1",
              "label": "材料稀薄,结论多为推断"
            },
            {
              "id": "sgu-2",
              "label": "他自己也把话说得留有余地"
            }
          ]
        }
      ]
    },
    {
      "id": "chunqiu",
      "label": "第一卷 · 春秋战国",
      "note": "他关心的不是「百家争鸣」本身,而是诸子共同站着的那块地面。",
      "ref": { "ch": 4 },
      "children": [
        {
          "id": "cq-notvoid",
          "label": "诸子不是凭空冒出来的",
          "children": [
            {
              "id": "cqn-1",
              "label": "他们共享一套更早的知识背景"
            },
            {
              "id": "cqn-2",
              "label": "分歧发生在共同前提之上"
            }
          ]
        },
        {
          "id": "cq-bg",
          "label": "那套背景是什么",
          "children": [
            {
              "id": "cqb-1",
              "label": "王官之学下移,知识散入民间"
            },
            {
              "id": "cqb-2",
              "label": "数术方技:历、卜、医、兵、农"
            },
            {
              "id": "cqb-3",
              "label": "出土日书显示,普通人关心的是宜忌"
            }
          ]
        },
        {
          "id": "cq-read",
          "label": "所以要读的不止诸子",
          "children": [
            {
              "id": "cqr-1",
              "label": "简帛一类出土材料同等重要"
            },
            {
              "id": "cqr-2",
              "label": "它们记的正是没有署名的常识"
            }
          ]
        },
        {
          "id": "cq-fix",
          "label": "一处纠正",
          "children": [
            {
              "id": "cqf-1",
              "label": "「百家」是后人整理出来的图景"
            },
            {
              "id": "cqf-2",
              "label": "当时并没有那么整齐的学派边界"
            }
          ]
        }
      ]
    },
    {
      "id": "qinhan",
      "label": "第一卷 · 秦汉",
      "note": "一统之后,思想怎么也跟着一统。他的答案是:不靠说服,靠制度与日用。",
      "ref": { "ch": 5 },
      "children": [
        {
          "id": "qh-unify",
          "label": "统一不是消灭异见",
          "children": [
            {
              "id": "qhu-1",
              "label": "而是给出一套通用的语言"
            },
            {
              "id": "qhu-2",
              "label": "阴阳五行成了公共语法"
            }
          ]
        },
        {
          "id": "qh-three",
          "label": "三条落地的路",
          "children": [
            {
              "id": "qht-1",
              "label": "经学取得官方地位"
            },
            {
              "id": "qht-2",
              "label": "国家祭祀确定拜什么、怎么拜"
            },
            {
              "id": "qht-3",
              "label": "灾异与谶纬把天意接进政治"
            }
          ]
        },
        {
          "id": "qh-common",
          "label": "常识是怎么定型的",
          "children": [
            {
              "id": "qhc-1",
              "label": "一套宇宙图式一直铺到日常"
            },
            {
              "id": "qhc-2",
              "label": "朝廷礼制与民间历忌共用一套道理"
            },
            {
              "id": "qhc-3",
              "label": "这一段最能看出他的主张管不管用"
            }
          ]
        }
      ]
    },
    {
      "id": "weijin",
      "label": "第一卷 · 魏晋至唐",
      "note": "旧的解释失灵,外来的世界图像进来。第一卷大致处理到七世纪为止。",
      "ref": { "ch": 6 },
      "children": [
        {
          "id": "wj-loose",
          "label": "旧秩序松动",
          "children": [
            {
              "id": "wjl-1",
              "label": "汉代那套宇宙论解释力下降"
            },
            {
              "id": "wjl-2",
              "label": "玄学是在重问被搁置的前提"
            }
          ]
        },
        {
          "id": "wj-fo",
          "label": "外来的冲击",
          "children": [
            {
              "id": "wjf-1",
              "label": "佛教带来另一套世界图像与来世观"
            },
            {
              "id": "wjf-2",
              "label": "译经同时带进天文、医学、语言学知识"
            },
            {
              "id": "wjf-3",
              "label": "站内释典十经可对读"
            }
          ]
        },
        {
          "id": "wj-dao",
          "label": "道教成立",
          "children": [
            {
              "id": "wjd-1",
              "label": "民间信仰被整理成有经典、有教团的宗教"
            },
            {
              "id": "wjd-2",
              "label": "站内道藏诸经可对读"
            }
          ]
        },
        {
          "id": "wj-three",
          "label": "三教并存不等于和解",
          "children": [
            {
              "id": "wjt-1",
              "label": "竞争的是解释权与仪式空间"
            },
            {
              "id": "wjt-2",
              "label": "一般人的信仰是混着用的"
            }
          ]
        }
      ]
    },
    {
      "id": "song",
      "label": "第二卷 · 宋代",
      "note": "他问的不是理学怎么产生,而是理学怎么变成了人人默认的常识——这是全书方法最见功力的一段。",
      "ref": { "ch": 7 },
      "children": [
        {
          "id": "sd-question",
          "label": "换了一个问题",
          "children": [
            {
              "id": "sdq-1",
              "label": "学说与常识是两回事"
            },
            {
              "id": "sdq-2",
              "label": "变成常识,才算真正进入思想史的底层"
            }
          ]
        },
        {
          "id": "sd-how",
          "label": "靠什么下沉",
          "children": [
            {
              "id": "sdh-1",
              "label": "科举把某一路解释变成必读"
            },
            {
              "id": "sdh-2",
              "label": "家礼与乡约把义理变成动作"
            },
            {
              "id": "sdh-3",
              "label": "蒙学、族谱、家训进入每一个家庭"
            }
          ]
        },
        {
          "id": "sd-slow",
          "label": "时间比想象的长",
          "children": [
            {
              "id": "sds-1",
              "label": "宋人立说,普及要到元明以后"
            },
            {
              "id": "sds-2",
              "label": "常识的变化以世代计,不以朝代计"
            }
          ]
        },
        {
          "id": "sd-cost",
          "label": "一个副产品",
          "children": [
            {
              "id": "sdc-1",
              "label": "一旦成为常识,就不再被论证"
            },
            {
              "id": "sdc-2",
              "label": "于是也失去了被认真怀疑的机会"
            }
          ]
        }
      ]
    },
    {
      "id": "mingqing",
      "label": "第二卷 · 明清",
      "note": "第二卷大致写到十九世纪。真正的动摇不在器物,在知识的地基。",
      "ref": { "ch": 8 },
      "children": [
        {
          "id": "mq-wang",
          "label": "学说走到边上",
          "children": [
            {
              "id": "mqw-1",
              "label": "讲学下沉到市井,听众换了人"
            },
            {
              "id": "mqw-2",
              "label": "多元同时意味着失序,士人开始不安"
            }
          ]
        },
        {
          "id": "mq-kaoju",
          "label": "清代的转向",
          "children": [
            {
              "id": "mqk-1",
              "label": "义理之争转成文字与考据"
            },
            {
              "id": "mqk-2",
              "label": "求真取代论道,思想变成知识"
            }
          ]
        },
        {
          "id": "mq-west",
          "label": "世界图像被撬动",
          "children": [
            {
              "id": "mqx-1",
              "label": "传教士带来的历算与舆图"
            },
            {
              "id": "mqx-2",
              "label": "「天下之中」的位置第一次被追问"
            }
          ]
        },
        {
          "id": "mq-crack",
          "label": "十九世纪的裂口",
          "children": [
            {
              "id": "mqc-1",
              "label": "冲击最深的一层是常识而非器物"
            },
            {
              "id": "mqc-2",
              "label": "常识一旦失效,思想才真正动摇"
            }
          ]
        }
      ]
    },
    {
      "id": "deshi",
      "label": "方法的得失",
      "note": "这部书改变了中国思想史的写法,也留下了几个至今没有解决的难题。争议要如实看,不必替它辩护。",
      "ref": { "ch": 9 },
      "children": [
        {
          "id": "ds-gain",
          "label": "公认的贡献",
          "children": [
            {
              "id": "dsg-1",
              "label": "思想史的材料范围被永久扩大了"
            },
            {
              "id": "dsg-2",
              "label": "平缓期不再是空白页"
            }
          ]
        },
        {
          "id": "ds-doubt",
          "label": "被质疑的地方",
          "children": [
            {
              "id": "dsd-1",
              "label": "「一般知识」边界不清,难以操作"
            },
            {
              "id": "dsd-2",
              "label": "留下来的文本仍多出自识字精英之手"
            },
            {
              "id": "dsd-3",
              "label": "用精英的书还原常识,有循环之嫌"
            }
          ]
        },
        {
          "id": "ds-gap",
          "label": "主张与实践之间",
          "children": [
            {
              "id": "dsp-1",
              "label": "两卷在多大程度上兑现了导论,学界有讨论"
            },
            {
              "id": "dsp-2",
              "label": "有看法认为重心仍偏在经典与精英文本"
            },
            {
              "id": "dsp-3",
              "label": "体量巨大,详略取舍也受质疑"
            }
          ]
        },
        {
          "id": "ds-border",
          "label": "一个悬着的边界",
          "children": [
            {
              "id": "dsb-1",
              "label": "若历法风水皆入,思想史与文化史如何分"
            },
            {
              "id": "dsb-2",
              "label": "强调连续,会不会低估断裂"
            }
          ]
        },
        {
          "id": "ds-use",
          "label": "该怎么用这部书",
          "children": [
            {
              "id": "dsu-1",
              "label": "先读导论,把问题意识拿走"
            },
            {
              "id": "dsu-2",
              "label": "正文按需查阅,不必线性读完"
            },
            {
              "id": "dsu-3",
              "label": "把它当一种提问方式,不当一份定论"
            }
          ]
        }
      ]
    }
  ]
}
