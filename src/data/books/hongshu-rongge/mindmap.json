{
  "id": "root",
  "label": "红书",
  "children": [
    {
      "id": "what-it-is",
      "label": "它是什么·手抄巨册",
      "ref": { "ch": 1 },
      "children": [
        {
          "id": "physical-book",
          "label": "一册红皮烫金的对开手抄巨册",
          "note": "书名 Liber Novus(新书),因红色皮面通称《红书》",
          "children": [
            {
              "id": "physical-book-calligraphy",
              "label": "荣格用中世纪哥特体花字把幻象誊抄在对开羊皮式纸页上,亲手绘满曼陀罗与神话图像,像一部现代人的中世纪泥金抄本。"
            },
            {
              "id": "physical-book-unfinished",
              "label": "这册书断续写绘了约十六年(1915 至约 1930),最终没有完成——末页停在一句写到一半的话上。"
            }
          ]
        },
        {
          "id": "structure-three-parts",
          "label": "三部结构:Liber Primus、Liber Secundus、Scrutinies",
          "children": [
            {
              "id": "structure-content",
              "label": "第一册与第二册记录 1913–1914 年间密集的幻象与内心对话,Scrutinies(审视)是更晚的自我剖析,并收入《对亡者的七次布道》。"
            },
            {
              "id": "structure-black-books",
              "label": "底稿是几本当场速记的「黑册子」,红书是二次誊抄与加工:先有滚烫的体验,再有文学与图像的慢火锻造。"
            }
          ]
        },
        {
          "id": "hidden-then-published",
          "label": "尘封八十年,2009 年才出版",
          "children": [
            {
              "id": "hidden-safe",
              "label": "荣格生前拒绝出版,书稿在他身后长年锁在银行保险柜里,直到学者索努·沙姆达萨尼多年劝说,家族才同意面世。"
            },
            {
              "id": "published-2009",
              "label": "2009 年影印加注释的英译本出版即成文化事件——人们第一次直接看到「荣格心理学的私人源头」长什么样。"
            }
          ]
        }
      ]
    },
    {
      "id": "origin",
      "label": "缘起·与弗洛伊德决裂",
      "ref": { "ch": 2 },
      "children": [
        {
          "id": "break-with-freud",
          "label": "1913 年与弗洛伊德决裂",
          "children": [
            {
              "id": "break-reason",
              "label": "决裂的导火索是荣格在《转化的象征》里重新解释力比多,深层分歧是两人对无意识的看法根本不同:弗洛伊德看到被压抑的欲望,荣格看到创造的源泉。"
            },
            {
              "id": "break-cost",
              "label": "决裂让 38 岁的荣格一并失去导师、学派与国际声望,他辞去国际精神分析学会主席与大学教职,陷入方向尽失的中年危机。"
            }
          ]
        },
        {
          "id": "visions-flood",
          "label": "洪水与血海的幻象来袭",
          "children": [
            {
              "id": "visions-content",
              "label": "1913 年秋起,他反复「看见」滔天洪水淹没欧洲、血海浮尸的画面,一度认真怀疑自己正在走向精神分裂。"
            },
            {
              "id": "visions-war",
              "label": "1914 年 8 月一战爆发,他转而把这些幻象理解为对时代灾难的预感——个人的深渊与时代的深渊在他这里接通了。"
            }
          ]
        },
        {
          "id": "decision-descend",
          "label": "他决定主动跳下去",
          "children": [
            {
              "id": "descend-experiment",
              "label": "与其坐等被无意识淹没,他选择在清醒状态下主动「下潜」,把这场危机当成对自己心灵的一次实验。"
            },
            {
              "id": "descend-lost-soul",
              "label": "红书开篇是一段自白:他重新找到了「深处之灵」,要动身寻回自己在追逐功名的岁月里丢失的灵魂。"
            }
          ]
        }
      ]
    },
    {
      "id": "method",
      "label": "方法·积极想象",
      "ref": { "ch": 3 },
      "children": [
        {
          "id": "active-imagination",
          "label": "积极想象:清醒地走进幻象",
          "note": "荣格后来对这套方法的正式命名",
          "children": [
            {
              "id": "ai-how",
              "label": "做法大意是:放松而不入睡,盯住一个内心意象,允许它自行变化、自行开口,自我则作为在场者与它对话。"
            },
            {
              "id": "ai-metaphor",
              "label": "像把梦搬到白天来做,但做梦的人始终睁着眼——既不导演剧情,也不中途退场。"
            }
          ]
        },
        {
          "id": "not-daydream-not-madness",
          "label": "它不是白日梦,也不是发疯",
          "children": [
            {
              "id": "vs-fantasy",
              "label": "与被动幻想的区别在于自我全程在场并承担立场:该反驳时反驳,该拒绝时拒绝,而不是被意象牵着走。"
            },
            {
              "id": "vs-psychosis",
              "label": "与精神病性幻觉的区别(这是荣格自己的辩护)在于自愿开始、可以中止、事后有批判性反思——不过这条界线学界至今仍有讨论。"
            }
          ]
        },
        {
          "id": "ritual-record",
          "label": "记录本身是仪式",
          "children": [
            {
              "id": "record-flow",
              "label": "他先在黑册子里当场速记,再以哥特体书法与绘画誊入红书——缓慢的抄写和上色本身,就是消化幻象的过程。"
            },
            {
              "id": "record-discipline",
              "label": "那些年他把这套流程称作「最艰难的实验」:白天照常执业看诊,晚上准时「下去」,像科学家守着自己的观测站。"
            }
          ]
        }
      ]
    },
    {
      "id": "inner-figures",
      "label": "内心的众生",
      "ref": { "ch": 4 },
      "children": [
        {
          "id": "two-spirits",
          "label": "时代之灵与深处之灵",
          "children": [
            {
              "id": "spirits-contrast",
              "label": "「时代之灵」催人追逐用处、成就与理性,「深处之灵」则逼人面对灵魂、意义与永恒——红书就是后者夺回话语权的记录。"
            },
            {
              "id": "spirits-balance",
              "label": "荣格并未简单站队:他承认自己前半生都在服侍时代之灵,下潜正是为了补上被牺牲掉的另一半。"
            }
          ]
        },
        {
          "id": "my-soul",
          "label": "他呼唤「我的灵魂」",
          "children": [
            {
              "id": "soul-call",
              "label": "开篇他像呼喊失散的亲人一样呼唤:「我的灵魂,你在哪里?」——灵魂在书中是一个会回嘴、会指路、也会捉弄他的「她」。"
            },
            {
              "id": "soul-anima",
              "label": "这个内在女性形象后来被提炼成「阿尼玛」概念:男性心灵中人格化的另一极。"
            }
          ]
        },
        {
          "id": "elijah-salome-serpent",
          "label": "以利亚、莎乐美与大蛇",
          "children": [
            {
              "id": "es-figures",
              "label": "先知以利亚与盲眼的莎乐美结伴出现,一个代表先见与思,一个代表情欲与爱,黑色大蛇盘在两者之间。"
            },
            {
              "id": "es-lesson",
              "label": "莎乐美声称荣格正是她要爱的人,令他极度抗拒——学会不逃开这种让人不适的内在人物,是「对质」的第一课。"
            }
          ]
        },
        {
          "id": "philemon",
          "label": "斐乐蒙:内心的导师",
          "children": [
            {
              "id": "philemon-lesson",
              "label": "长着翠鸟翅膀的老人斐乐蒙教给他决定性的一课:心里的思想不是「我造出来的」,它们像林中的动物一样自有其生命。"
            },
            {
              "id": "philemon-guru",
              "label": "荣格说,斐乐蒙之于他,如同印度人所说的古鲁——一位住在心里、而非现实中的老师。"
            }
          ]
        }
      ]
    },
    {
      "id": "confrontation-mandala",
      "label": "与无意识对质·曼陀罗自性",
      "ref": { "ch": 5 },
      "children": [
        {
          "id": "confrontation",
          "label": "对质,而非压抑或投降",
          "children": [
            {
              "id": "confront-negotiate",
              "label": "荣格把这场功课称作「与无意识的对质」:既不把意象斥为胡思乱想,也不把它们的话当圣旨,而是平等地谈判。"
            },
            {
              "id": "confront-argue",
              "label": "书里他常与灵魂和众人物激烈争吵——接纳深处不等于放弃判断,这是红书与「任凭神启」式的通灵根本不同之处。"
            }
          ]
        },
        {
          "id": "seven-sermons",
          "label": "《对亡者的七次布道》",
          "children": [
            {
              "id": "sermons-scene",
              "label": "Scrutinies 的高潮处,亡灵从耶路撒冷归来,喊着「我们没有找到我们要找的」,斐乐蒙替荣格向他们连讲七夜。"
            },
            {
              "id": "sermons-content",
              "label": "布道谈「普累若麻」(未分化的充溢)与个体的分化,神学色彩浓烈;这是红书中唯一在荣格生前私下印行过的部分。"
            }
          ]
        },
        {
          "id": "mandala",
          "label": "曼陀罗:画出心的秩序",
          "children": [
            {
              "id": "mandala-daily",
              "label": "1916 年起他每天清晨画一幅小圆图,后来发现这些同心圆会随心境失衡而变形——曼陀罗成了他观测内心状态的仪表盘。"
            },
            {
              "id": "mandala-center",
              "label": "他由此得出红书的核心发现之一:心灵有一个自发趋向的中心,一切道路都通向它,发展不是直线而是绕行。"
            }
          ]
        },
        {
          "id": "self-center",
          "label": "自性:中心不是自我",
          "children": [
            {
              "id": "self-def",
              "label": "那个中心他名之为「自性」(Selbst):人格整体的组织点,日常的「我」只是绕着它转的一颗行星。"
            },
            {
              "id": "self-image",
              "label": "红书插画里那些著名的城堡形、花朵形曼陀罗(如「永恒之窗」),就是自性在图像里的显形。"
            }
          ]
        }
      ]
    },
    {
      "id": "what-grew",
      "label": "长出了什么·原型个体化",
      "ref": { "ch": 6 },
      "children": [
        {
          "id": "collective-unconscious",
          "label": "集体无意识与原型",
          "children": [
            {
              "id": "cu-inference",
              "label": "荣格从「这些人物不是我编的」这一切身体验出发,推论人类心底共享着一层更深的无意识,其中住着反复出现的形式——原型。"
            },
            {
              "id": "cu-caveat",
              "label": "以利亚、莎乐美、斐乐蒙分别沉淀为智慧老人、阿尼玛等原型的样本;需要说明:这套推广属于诠释性理论,经验证据至今有争议。"
            }
          ]
        },
        {
          "id": "individuation",
          "label": "个体化:成为你自己",
          "children": [
            {
              "id": "individuation-def",
              "label": "个体化指人格在与无意识的长期对话中逐步整合阴影与对立面、绕着自性成形的过程——红书正是荣格本人的个体化档案。"
            },
            {
              "id": "individuation-warning",
              "label": "它不是自我膨胀:书中一再警告,把深处的内容据为己有会导向自我神化,荣格称之为与「英雄」认同的危险,英雄在书里必须死去。"
            }
          ]
        },
        {
          "id": "mother-lode",
          "label": "分析心理学的母矿",
          "children": [
            {
              "id": "lode-lava",
              "label": "荣格晚年自述:一生的工作都源自那些年的想象,后来的理论不过是把当年滚烫的岩浆加以分类、翻译成科学语言。"
            },
            {
              "id": "lode-refusal",
              "label": "灵魂曾在书中劝他「这是艺术」,他断然拒绝——他坚持这是自然与体验,这场争执预告了他终生在科学与体验之间的走钢丝。"
            }
          ]
        }
      ]
    },
    {
      "id": "how-to-read",
      "label": "怎么读·地位与争议",
      "ref": { "ch": 7 },
      "children": [
        {
          "id": "subjective-experiment",
          "label": "主观自我实验,不是实证科学",
          "children": [
            {
              "id": "n-of-one",
              "label": "红书是一个样本量为一的自我实验:材料全部来自荣格本人的内心,无法重复、无法证伪,应当作第一手体验文献而非科学证据来读。"
            },
            {
              "id": "theory-vs-record",
              "label": "由它推广出的集体无意识、原型等概念属于诠释框架,主流实证心理学并不接受为已证事实——研读时宜把「体验记录」与「理论主张」分开称重。"
            }
          ]
        },
        {
          "id": "publication-ethics",
          "label": "公开私密文本的争议",
          "children": [
            {
              "id": "ethics-consent",
              "label": "这是一部荣格生前未授权出版的私人文献,家族数十年拒绝示人;身后公开它是否合乎他本意,至今仍是一个伦理争点。"
            },
            {
              "id": "ethics-both-sides",
              "label": "支持者认为不出版就无法诚实理解荣格思想的来源;批评者则担心一部私密的狂喜文本被断章取义,甚至被神化。"
            }
          ]
        },
        {
          "id": "madness-debate",
          "label": "天才下潜,还是精神危机?",
          "children": [
            {
              "id": "debate-positions",
              "label": "有论者称这几年是「创造性疾病」乃至精神病发作;荣格派学者(如沙姆达萨尼)则强调他全程执业看诊、家庭与社会功能完好,是一场自愿的方法性实验。"
            },
            {
              "id": "debate-suspend",
              "label": "读者不必急着裁决:承认文本诞生于极端心理状态,与承认其思想价值,两件事可以同时成立。"
            }
          ]
        },
        {
          "id": "reading-posture",
          "label": "研读姿势",
          "children": [
            {
              "id": "posture-document",
              "label": "把它当作思想史与心理学史文献、一份罕见的内在过程档案来读,而不是占卜手册、通灵指南或修行秘籍。"
            },
            {
              "id": "posture-route",
              "label": "入手建议:先读沙姆达萨尼的导言与脚注,配合《回忆·梦·思考》「直面无意识」一章,再进正文,图像与文字对照着看。"
            },
            {
              "id": "posture-language",
              "label": "书中的神话与神学语汇(神、亡灵、布道)是心理体验的表达方式,荣格自己也提醒读者不要照字面当作超自然实录来接收。"
            }
          ]
        }
      ]
    }
  ]
}
