{
  "id": "root",
  "label": "人间词话",
  "note": "王国维 1908 年发表于《国粹学报》的手定稿六十四则。体裁是旧的「词话」,骨子里却装了一套从叔本华、康德那里带回来的美学问题意识——他要给「这首词好在哪里」找一个可以说出口的标准。",
  "children": [
    {
      "id": "jingjie",
      "label": "境界:全书的总纲",
      "note": "开篇第一则就把话说死:词以境界为最上。此后六十三则,几乎都是这一句的注脚。",
      "ref": {
        "ch": 1
      },
      "children": [
        {
          "id": "jingjie-def",
          "label": "境界不是「景色」",
          "children": [
            {
              "id": "jj-1",
              "label": "写情写景都算,关键在「真」"
            },
            {
              "id": "jj-2",
              "label": "喜怒哀乐亦人心中之一境界"
            },
            {
              "id": "jj-3",
              "label": "所以它是个评判标准,不是题材分类"
            }
          ]
        },
        {
          "id": "jingjie-why",
          "label": "为什么要立这个标准",
          "children": [
            {
              "id": "jw-1",
              "label": "旧词话多是印象式点评:妙、佳、不俗"
            },
            {
              "id": "jw-2",
              "label": "说了等于没说——无法争论,也无法教人"
            },
            {
              "id": "jw-3",
              "label": "他要一个能拿来量、能拿来吵架的尺"
            }
          ]
        },
        {
          "id": "jingjie-rank",
          "label": "有境界则自成高格",
          "children": [
            {
              "id": "jr-1",
              "label": "格调、气象、神韵都被收编为它的下位概念"
            },
            {
              "id": "jr-2",
              "label": "这是一次术语的兼并,不只是提法之争"
            }
          ]
        }
      ]
    },
    {
      "id": "zaoxie",
      "label": "造境与写境",
      "note": "理想与写实的分野。但他随即说:二者颇难分别。这句「难分别」比那个分类本身更要紧。",
      "ref": {
        "ch": 2
      },
      "children": [
        {
          "id": "zx-pair",
          "label": "两种诗人",
          "children": [
            {
              "id": "zx-1",
              "label": "造境:理想家,自心中构出一个世界"
            },
            {
              "id": "zx-2",
              "label": "写境:写实家,就眼前所见落笔"
            }
          ]
        },
        {
          "id": "zx-blur",
          "label": "但界限是模糊的",
          "children": [
            {
              "id": "zb-1",
              "label": "大诗人所造之境必合乎自然"
            },
            {
              "id": "zb-2",
              "label": "所写之境亦必邻于理想"
            },
            {
              "id": "zb-3",
              "label": "分类是脚手架,不是结论"
            }
          ]
        }
      ]
    },
    {
      "id": "youwo",
      "label": "有我之境与无我之境",
      "note": "全书流传最广的一对概念,也是最容易被读浅的一对。",
      "ref": {
        "ch": 3
      },
      "children": [
        {
          "id": "yw-you",
          "label": "有我之境:以我观物",
          "children": [
            {
              "id": "yy-1",
              "label": "物皆著我之色彩"
            },
            {
              "id": "yy-2",
              "label": "「泪眼问花花不语」——花本不会答,是人先哭了"
            }
          ]
        },
        {
          "id": "yw-wu",
          "label": "无我之境:以物观物",
          "children": [
            {
              "id": "yu-1",
              "label": "不知何者为我,何者为物"
            },
            {
              "id": "yu-2",
              "label": "「采菊东篱下,悠然见南山」"
            },
            {
              "id": "yu-3",
              "label": "不是没有人,是人不再挡在前面"
            }
          ]
        },
        {
          "id": "yw-rank",
          "label": "两者有高下吗",
          "children": [
            {
              "id": "yr-1",
              "label": "他说无我之境「唯于静中得之」,古人为之者少"
            },
            {
              "id": "yr-2",
              "label": "语气里有偏好,但没说有我之境不好"
            },
            {
              "id": "yr-3",
              "label": "后人常把偏好读成了等级"
            }
          ]
        }
      ]
    },
    {
      "id": "gebuge",
      "label": "隔与不隔",
      "note": "整本书里最好用的一把尺——它可以直接拿去读任何一首词。",
      "ref": {
        "ch": 4
      },
      "children": [
        {
          "id": "gb-what",
          "label": "什么叫隔",
          "children": [
            {
              "id": "gw-1",
              "label": "语语都在目前,便是不隔"
            },
            {
              "id": "gw-2",
              "label": "隔不是难懂,是中间垫了东西"
            },
            {
              "id": "gw-3",
              "label": "垫的往往是典故、套语、现成的漂亮话"
            }
          ]
        },
        {
          "id": "gb-use",
          "label": "怎么用这把尺",
          "children": [
            {
              "id": "gu-1",
              "label": "读到一句,先问:我看见了吗"
            },
            {
              "id": "gu-2",
              "label": "看见了是不隔;只觉得「写得真好」多半是隔"
            },
            {
              "id": "gu-3",
              "label": "这也是他抑南宋的主要理由"
            }
          ]
        }
      ]
    },
    {
      "id": "sanjing",
      "label": "三种境界",
      "note": "被引用最多、也被误用最多的一节。它本是讲治学的比方,今天多被当成励志格言。",
      "ref": {
        "ch": 5
      },
      "children": [
        {
          "id": "sj-three",
          "label": "三句借来的词",
          "children": [
            {
              "id": "sj-1",
              "label": "昨夜西风凋碧树,独上高楼,望尽天涯路(晏殊)"
            },
            {
              "id": "sj-2",
              "label": "衣带渐宽终不悔,为伊消得人憔悴(柳永)"
            },
            {
              "id": "sj-3",
              "label": "众里寻他千百度…那人却在,灯火阑珊处(辛弃疾)"
            }
          ]
        },
        {
          "id": "sj-caveat",
          "label": "他自己加的免责声明",
          "children": [
            {
              "id": "sc-1",
              "label": "「然遽以此意解释诸词,恐晏、欧诸公所不许也」"
            },
            {
              "id": "sc-2",
              "label": "他知道这是借用,不是原意"
            },
            {
              "id": "sc-3",
              "label": "今人引用时几乎从不带上这句"
            }
          ]
        },
        {
          "id": "sj-misread",
          "label": "别读成励志",
          "children": [
            {
              "id": "sm-1",
              "label": "第三境不是「努力就有回报」"
            },
            {
              "id": "sm-2",
              "label": "是停下、回头,发现它一直在那儿"
            },
            {
              "id": "sm-3",
              "label": "苦寻本身并不保证蓦然回首"
            }
          ]
        }
      ]
    },
    {
      "id": "cishi",
      "label": "词与诗的分野",
      "note": "词能言诗之所不能言,而不能尽诗之所能言。这句是他给词的定位。",
      "ref": {
        "ch": 6
      },
      "children": [
        {
          "id": "cs-pair",
          "label": "各有各的短长",
          "children": [
            {
              "id": "cp-1",
              "label": "词长于幽微、曲折、说不清的那一层"
            },
            {
              "id": "cp-2",
              "label": "诗长于铺陈、议论、把话说尽"
            }
          ]
        },
        {
          "id": "cs-yaomiao",
          "label": "要眇宜修",
          "children": [
            {
              "id": "cy-1",
              "label": "词的美是精细而带点娇柔的那一种"
            },
            {
              "id": "cy-2",
              "label": "所以词写家国也须从一己之情入手"
            }
          ]
        }
      ]
    },
    {
      "id": "beisong",
      "label": "推五代北宋",
      "note": "他的偏爱毫不掩饰:词至李后主而眼界始大,感慨遂深。",
      "ref": {
        "ch": 7
      },
      "children": [
        {
          "id": "bs-houzhu",
          "label": "为什么是李后主",
          "children": [
            {
              "id": "bh-1",
              "label": "「变伶工之词而为士大夫之词」"
            },
            {
              "id": "bh-2",
              "label": "亡国之后,他把个人的痛写成了人人的痛"
            },
            {
              "id": "bh-3",
              "label": "「俨有释迦、基督担荷人类罪恶之意」——评价高到出格"
            }
          ]
        },
        {
          "id": "bs-others",
          "label": "其余几家",
          "children": [
            {
              "id": "bo-1",
              "label": "冯延巳:堂庑特大,开北宋一代风气"
            },
            {
              "id": "bo-2",
              "label": "欧阳修、秦观:各有其至"
            },
            {
              "id": "bo-3",
              "label": "苏辛:豪放里仍有一段深婉"
            }
          ]
        }
      ]
    },
    {
      "id": "nansong",
      "label": "抑南宋",
      "note": "全书争议最大的部分。他对姜夔的判词几乎是不留情面的。",
      "ref": {
        "ch": 8
      },
      "children": [
        {
          "id": "ns-baishi",
          "label": "对姜夔的判词",
          "children": [
            {
              "id": "nb-1",
              "label": "「格调虽高,然无一语道著」"
            },
            {
              "id": "nb-2",
              "label": "「如雾里看花,终隔一层」"
            },
            {
              "id": "nb-3",
              "label": "问题不在功力,在中间那层东西"
            }
          ]
        },
        {
          "id": "ns-fair",
          "label": "这判词公平吗",
          "children": [
            {
              "id": "nf-1",
              "label": "后世学者多认为对南宋失之偏颇"
            },
            {
              "id": "nf-2",
              "label": "他用「不隔」一把尺量了所有人"
            },
            {
              "id": "nf-3",
              "label": "尺越好用,越容易被用过头"
            }
          ]
        }
      ]
    },
    {
      "id": "chizi",
      "label": "赤子之心与阅世",
      "note": "他给天才开了个两难的条件:要保有赤子之心,又要阅世够深。",
      "ref": {
        "ch": 9
      },
      "children": [
        {
          "id": "cz-heart",
          "label": "词人者,不失其赤子之心者也",
          "children": [
            {
              "id": "ch-1",
              "label": "生于深宫之中,长于妇人之手——他说这正是李后主的长处"
            },
            {
              "id": "ch-2",
              "label": "不谙世故,故所见者真"
            }
          ]
        },
        {
          "id": "cz-world",
          "label": "但客观之诗人不可不多阅世",
          "children": [
            {
              "id": "cw-1",
              "label": "阅世愈深则材料愈丰富愈变化"
            },
            {
              "id": "cw-2",
              "label": "主观之诗人则反是:阅世愈浅性情愈真"
            },
            {
              "id": "cw-3",
              "label": "两条路,他没说哪条更高"
            }
          ]
        }
      ]
    },
    {
      "id": "laulu",
      "label": "此书的来路与命运",
      "note": "旧瓶装新酒:词话的体裁,德国美学的骨头。而它的现代命运,与王国维本人的结局一样耐人寻味。",
      "ref": {
        "ch": 10
      },
      "children": [
        {
          "id": "ll-source",
          "label": "骨头是外来的",
          "children": [
            {
              "id": "ls-1",
              "label": "叔本华:意志与表象、天才论、静观"
            },
            {
              "id": "ls-2",
              "label": "康德一路的无功利审美"
            },
            {
              "id": "ls-3",
              "label": "但他没有照搬,而是换成了中国批评能接住的词"
            }
          ]
        },
        {
          "id": "ll-fate",
          "label": "它后来怎么了",
          "children": [
            {
              "id": "lf-1",
              "label": "成了二十世纪中国文学批评引用最多的书之一"
            },
            {
              "id": "lf-2",
              "label": "「三种境界」被抽出来当励志语,离原意最远"
            },
            {
              "id": "lf-3",
              "label": "1927 年他自沉昆明湖,此书遂被追加了许多身后之意"
            }
          ]
        },
        {
          "id": "ll-today",
          "label": "今天还能怎么用",
          "children": [
            {
              "id": "lt-1",
              "label": "把「不隔」当读诗的随身尺"
            },
            {
              "id": "lt-2",
              "label": "把「有我/无我」当写作时的自检"
            },
            {
              "id": "lt-3",
              "label": "别把它当权威判决,当同好的意见更合适"
            }
          ]
        }
      ]
    }
  ]
}
