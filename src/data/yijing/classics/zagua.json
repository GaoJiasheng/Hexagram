{
  "book": "zagua",
  "title": "杂卦",
  "chapters": [
    {
      "no": 1,
      "title": "一篇",
      "paragraphs": [
        {
          "original": "乾刚坤柔，比乐师忧。",
          "translation": "乾刚健，坤柔顺；比亲附而乐，师兴众而忧。"
        },
        {
          "original": "临、观之义，或与或求。",
          "translation": "临、观二卦的意义，一是施与，一是求观。"
        },
        {
          "original": "屯见而不失其居，蒙杂而著。",
          "translation": "屯，初生显现而不离其居所；蒙，幼稚混杂而渐趋显明。"
        },
        {
          "original": "震起也，艮止也。",
          "translation": "震是兴起，艮是静止。"
        },
        {
          "original": "损、益，盛衰之始也。",
          "translation": "损、益二卦，是盛衰的开端。"
        },
        {
          "original": "大畜时也，无妄灾也。",
          "translation": "大畜在于把握时机，无妄则有意外之灾。"
        },
        {
          "original": "萃聚，而升不来也。",
          "translation": "萃是聚集，升是上往而不返。"
        },
        {
          "original": "谦轻，而豫怠也。",
          "translation": "谦是自轻己身，豫则易生怠惰。"
        },
        {
          "original": "噬嗑食也，贲无色也。",
          "translation": "噬嗑是咬合进食，贲是文饰本无定色。"
        },
        {
          "original": "兑见，而巽伏也。",
          "translation": "兑显现于外，巽潜伏于内。"
        },
        {
          "original": "随无故也，蛊则饬也。",
          "translation": "随是舍旧无故而随人，蛊则是整饬乱事。"
        },
        {
          "original": "剥烂也，复反也。",
          "translation": "剥是剥落溃烂，复是返回正道。"
        },
        {
          "original": "晋昼也，明夷诛也。",
          "translation": "晋是白昼（光明上进），明夷是光明被诛伤。"
        },
        {
          "original": "井通，而困相遇也。",
          "translation": "井是通养于人，困是刚被掩而相遇于穷。"
        },
        {
          "original": "咸速也，恒久也。",
          "translation": "咸是感应迅速，恒是恒久长守。"
        },
        {
          "original": "涣离也，节止也。",
          "translation": "涣是离散，节是节止。"
        },
        {
          "original": "解缓也，蹇难也。",
          "translation": "解是缓解，蹇是艰难。"
        },
        {
          "original": "睽外也，家人内也。",
          "translation": "睽是乖离于外，家人是和睦于内。"
        },
        {
          "original": "否、泰，反其类也。",
          "translation": "否、泰，是互相反转的两类。"
        },
        {
          "original": "大壮则止，遁则退也。",
          "translation": "大壮则知止，遁则身退。"
        },
        {
          "original": "大有众也，同人亲也。",
          "translation": "大有是所有者众，同人是与人相亲。"
        },
        {
          "original": "革去故也，鼎取新也。",
          "translation": "革是去除旧的，鼎是取用新的。"
        },
        {
          "original": "小过过也，中孚信也。",
          "translation": "小过是过越，中孚是诚信。"
        },
        {
          "original": "丰多故也，亲寡旅也。",
          "translation": "丰是多事之秋，亲附者少便是旅。"
        },
        {
          "original": "离上，而坎下也。",
          "translation": "离（火）炎上，坎（水）润下。"
        },
        {
          "original": "小畜寡也，履不处也。",
          "translation": "小畜是所蓄寡少，履是行而不安处。"
        },
        {
          "original": "需不进也，讼不亲也。",
          "translation": "需是等待而不冒进，讼是争而不相亲。"
        },
        {
          "original": "大过颠也，姤遇也，柔遇刚也。",
          "translation": "大过是颠覆，姤是相遇——阴柔遇上阳刚。"
        },
        {
          "original": "渐女归待男行也，颐养正也，既济定也。",
          "translation": "渐是女子出嫁待男方亲迎而行，颐是养之以正，既济是事已安定。"
        },
        {
          "original": "归妹女之终也，未济男之穷也。",
          "translation": "归妹是女子的归宿，未济是男子的困穷（阳皆失位）。"
        },
        {
          "original": "夬决也，刚决柔也。君子道长，小人道消也。",
          "translation": "夬是决断，阳刚决去阴柔——君子之道增长，小人之道消亡。"
        }
      ]
    }
  ]
}
