{
  "book": "zagua",
  "title": "杂卦",
  "chapters": [
    {
      "no": 1,
      "title": "一篇",
      "paragraphs": [
        {
          "original": "乾刚坤柔，比乐师忧。",
          "translation": null
        },
        {
          "original": "临、观之义，或与或求。",
          "translation": null
        },
        {
          "original": "屯见而不失其居，蒙杂而著。",
          "translation": null
        },
        {
          "original": "震起也，艮止也。",
          "translation": null
        },
        {
          "original": "损、益，盛衰之始也。",
          "translation": null
        },
        {
          "original": "大畜时也，无妄灾也。",
          "translation": null
        },
        {
          "original": "萃聚，而升不来也。",
          "translation": null
        },
        {
          "original": "谦轻，而豫怠也。",
          "translation": null
        },
        {
          "original": "噬嗑食也，贲无色也。",
          "translation": null
        },
        {
          "original": "兑见，而巽伏也。",
          "translation": null
        },
        {
          "original": "随无故也，蛊则饬也。",
          "translation": null
        },
        {
          "original": "剥烂也，复反也。",
          "translation": null
        },
        {
          "original": "晋昼也，明夷诛也。",
          "translation": null
        },
        {
          "original": "井通，而困相遇也。",
          "translation": null
        },
        {
          "original": "咸速也，恒久也。",
          "translation": null
        },
        {
          "original": "涣离也，节止也。",
          "translation": null
        },
        {
          "original": "解缓也，蹇难也。",
          "translation": null
        },
        {
          "original": "睽外也，家人内也。",
          "translation": null
        },
        {
          "original": "否、泰，反其类也。",
          "translation": null
        },
        {
          "original": "大壮则止，遁则退也。",
          "translation": null
        },
        {
          "original": "大有众也，同人亲也。",
          "translation": null
        },
        {
          "original": "革去故也，鼎取新也。",
          "translation": null
        },
        {
          "original": "小过过也，中孚信也。",
          "translation": null
        },
        {
          "original": "丰多故也，亲寡旅也。",
          "translation": null
        },
        {
          "original": "离上，而坎下也。",
          "translation": null
        },
        {
          "original": "小畜寡也，履不处也。",
          "translation": null
        },
        {
          "original": "需不进也，讼不亲也。",
          "translation": null
        },
        {
          "original": "大过颠也，姤遇也，柔遇刚也。",
          "translation": null
        },
        {
          "original": "渐女归待男行也，颐养正也，既济定也。",
          "translation": null
        },
        {
          "original": "归妹女之终也，未济男之穷也。",
          "translation": null
        },
        {
          "original": "夬决也，刚决柔也。君子道长，小人道消也。",
          "translation": null
        }
      ]
    }
  ]
}
