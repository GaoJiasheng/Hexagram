      {
        "term": "眚",
        "ref": true
      },
      {
        "term": "何之",
        "note": "之，往也。更往何处去。"
      }
    ],
    "daxiang": [
      {
        "term": "物与无妄",
        "note": "与，赋予。万物各得其性，无有差妄。"
      },
      {
        "term": "茂对时",
        "note": "茂，勉力；对，应合。勉力应合天时。"
      }
    ],
    "xiaoxiang": {
      "5": [
        {
          "term": "不可试",
          "note": "试，轻用。无病而药，不可轻试。"
        }
      ]
    }
  },
  "26": {
