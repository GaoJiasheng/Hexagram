        "reading": "jiàn",
        "note": "再、相继。水相继而至。"
      },
      {
        "term": "常德行",
        "note": "常，恒常不变。恒久其德行。"
      }
    ],
    "xiaoxiang": {
      "3": [
        {
          "term": "来之坎坎",
          "note": "之，往。来去皆是坎险。"
        }
      ],
      "4": [
        {
          "term": "樽酒簋贰",
          "reading": "樽 zūn 簋 guǐ",
          "note": "一樽酒、两簋食。簋，盛黍稷之器。礼薄而诚。"
        }
      ]
