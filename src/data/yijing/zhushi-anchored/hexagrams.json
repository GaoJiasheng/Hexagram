{
  "1": {
    "tuan": [
      {
        "term": "资始",
        "note": "资，凭借、依赖。万物皆赖乾元而开始。"
      },
      {
        "term": "品物流形",
        "note": "品物，众类之物；流形，禀受元气流布而成形体。"
      },
      {
        "term": "保合大和",
        "note": "大和即太和，阴阳会合冲和之气；保而常存，合而常和。",
        "source": "朱熹《周易本义》"
      },
      {
        "term": "首出庶物",
        "note": "庶物，万物。高出于万物之首，喻圣人居众人之上。"
      }
    ],
    "daxiang": [
      {
        "term": "天行健",
        "note": "行，运行。天体运行昼夜不息，至为刚健。"
      }
    ],
    "xiaoxiang": {
      "3": [
        {
          "term": "反复道也",
          "note": "反复践行其道，进退皆不离正道。"
        }
      ],
      "5": [
        {
          "term": "造",
          "reading": "zào",
          "note": "作也，兴起有为。大人奋起而作，如圣人出世。"
        }
      ],
      "use": [
        {
          "term": "不可为首",
          "note": "刚健而不自居首倡，恃刚逞强则有悔。"
        }
      ]
    }
  },
  "2": {
    "tuan": [
      {
        "term": "资生",
        "note": "资，依赖。万物赖坤元而生成；乾施其始，坤成其生。"
      },
      {
        "term": "含弘光大",
        "note": "含，包容；弘，宽裕；光，昭明；大，博厚。",
        "source": "朱熹《周易本义》"
      },
      {
        "term": "牝马地类",
        "note": "牝马，母马。性柔顺而行地不息，与地同类。"
      },
      {
        "term": "西南得朋",
        "note": "朋，同类。西南为阴方，往之得同类；东北阳方，故丧朋。"
      }
    ],
    "daxiang": [
      {
        "term": "地势",
        "note": "地之形势，高下相因顺承，顺之至也。"
      }
    ],
    "xiaoxiang": {
      "1": [
        {
          "term": "驯致",
          "note": "驯，顺习渐进。顺其势逐渐发展而至。"
        }
      ],
      "3": [
        {
          "term": "知",
          "reading": "zhì",
          "note": "通「智」，智慧。"
        }
      ],
      "5": [
        {
          "term": "文在中",
          "note": "文德蕴藏于内而不显露，故美在其中。"
        }
      ],
      "use": [
        {
          "term": "以大终",
          "note": "阳大阴小，用六之爻变而为阳，以阳刚收束，故曰大终。"
        }
      ]
    }
  },
  "3": {
    "tuan": [
      {
        "term": "天造草昧",
        "note": "天地始创，万物草创混沌未明。造，始也；昧，冥昧。",
        "source": "孔颖达《周易正义》"
      }
    ],
    "daxiang": [
      {
        "term": "经纶",
        "note": "理丝为经、编丝为纶，引申为筹划治理。",
        "source": "朱熹《周易本义》"
      }
    ],
    "xiaoxiang": {
      "1": [
        {
          "term": "磐桓",
          "ref": true
        },
        {
          "term": "以贵下贱",
          "note": "以尊贵之身谦居卑贱者之下。"
        }
      ],
      "2": [
        {
          "term": "乘刚",
          "note": "阴爻居阳爻之上曰乘刚，柔乘凌于刚，多有不顺。"
        },
        {
          "term": "十年乃字",
          "note": "字，许嫁；一说生育。十年方嫁，极言其久。"
        }
      ],
      "3": [
        {
          "term": "即鹿无虞",
          "note": "即，就、追逐；虞，虞人，掌山林之官。逐鹿而无向导。"
        }
      ],
      "5": [
        {
          "term": "屯其膏",
          "note": "膏，膏泽、恩泽。恩泽艰于施布，未能光大。"
        }
      ],
      "6": [
        {
          "term": "泣血涟如",
          "note": "泣极无声而血出，泪流不断貌。"
        }
      ]
    }
  },
  "4": {
    "tuan": [
      {
        "term": "时中",
        "note": "随时而得中，不先不后，恰当其可。"
      },
      {
        "term": "筮",
        "reading": "shì",
        "note": "以蓍草占卦问疑。"
      },
      {
        "term": "再三渎",
        "note": "渎，轻慢不敬。一再占问，是亵渎蓍筮。"
      }
    ],
    "daxiang": [
      {
        "term": "果行",
        "note": "果，果决。以果决之行培育德性，如泉出山而必行。"
      }
    ],
    "xiaoxiang": {
      "1": [
        {
          "term": "刑人",
          "note": "刑，典刑、法则；一说刑罚。以法正人，立其始。"
        }
      ],
      "2": [
        {
          "term": "子克家",
          "note": "克，能也。子能承担治家之任。"
        }
      ],
      "4": [
        {
          "term": "独远实也",
          "reading": "远 yuàn",
          "note": "实，指阳刚之贤。独远离阳刚，故困于蒙昧。"
        }
      ],
      "5": [
        {
          "term": "巽",
          "reading": "xùn",
          "note": "逊也，谦逊柔顺。"
        }
      ]
    }
  },
  "5": {
    "tuan": [
      {
        "term": "须",
        "note": "等待。需即待时而进之义。"
      },
      {
        "term": "位乎天位",
        "note": "九五居天位（第五爻为天子之位），既正且中。"
      }
    ],
    "xiaoxiang": {
      "1": [
        {
          "term": "不犯难行也",
          "reading": "难 nàn",
          "note": "犯，冒犯、强行。不冒险难而轻进。"
        }
      ],
      "2": [
        {
          "term": "衍",
          "reading": "yǎn",
          "note": "宽绰从容。居中而宽和不迫。"
        }
      ],
      "4": [
        {
          "term": "顺以听",
          "note": "顺势而听从时命，不与争抗，故能出于险地。"
        }
      ]
    }
  },
  "6": {
    "tuan": [
      {
        "term": "窒",
        "reading": "zhì",
        "note": "窒塞不通。诚信被窒，故起争讼。"
      },
      {
        "term": "刚来而得中",
        "note": "阳刚来居下卦之中（九二），处讼而能持中。"
      }
    ],
    "daxiang": [
      {
        "term": "违行",
        "note": "相背而行。天西转，水东流，其行相违，故成讼象。"
      }
    ],
    "xiaoxiang": {
      "2": [
        {
          "term": "逋窜",
          "reading": "bū cuàn",
          "note": "逋，逃亡；窜，藏匿。败讼而逃归藏匿。"
        },
        {
          "term": "掇",
          "reading": "duō",
          "note": "拾取。患祸之来如俯身拾物，自取之也。"
        }
      ],
      "4": [
        {
          "term": "复即命渝",
          "note": "复，返；即，就；命，正理；渝，变。返就正理而变其讼心。"
        }
      ],
      "6": [
        {
          "term": "受服",
          "note": "服，官服佩饰，指讼胜所得鞶带之赏。"
        }
      ]
    }
  },
  "7": {
    "tuan": [
      {
        "term": "毒",
        "note": "害也。兴师不免荼毒天下，然民犹从之，以其正也。",
        "source": "朱熹《周易本义》"
      },
      {
        "term": "王",
        "reading": "wàng",
        "note": "动词，称王、王天下。"
      }
    ],
    "daxiang": [
      {
        "term": "畜众",
        "reading": "畜 xù",
        "note": "畜，养也。容保其民，畜养众庶。"
      }
    ],
    "xiaoxiang": {
      "2": [
        {
          "term": "锡",
          "ref": true
        },
        {
          "term": "怀万邦",
          "note": "怀，安抚、使归服。安抚万国之心。"
        }
      ],
      "4": [
        {
          "term": "左次",
          "note": "次，驻扎；左次，退舍后撤。知难而退，未失常法。"
        }
      ],
      "5": [
        {
          "term": "中行",
          "ref": true
        }
      ],
      "6": [
        {
          "term": "大君",
          "note": "天子、君主之尊称。"
        }
      ]
    }
  },
  "8": {
    "tuan": [
      {
        "term": "原筮",
        "note": "原，推原再度；筮，占决。再三审度以求可亲辅之主。"
      },
      {
        "term": "不宁方来",
        "note": "方，方国、邦国。不得安宁的邦国前来归附。"
      },
      {
        "term": "后夫",
        "note": "夫，人也。迟迟后至之人，亲比之道已穷，故凶。"
      }
    ],
    "xiaoxiang": {
      "1": [
        {
          "term": "有它吉",
          "note": "它，意外。诚信充盈，更有意外之吉。"
        }
      ],
      "5": [
        {
          "term": "舍逆取顺",
          "note": "田猎三驱之礼：逆来向己者纵之，顺走背己者取之。"
        },
        {
          "term": "不诫",
          "note": "诫，警戒。邑人不相警备，见上之使民宽而得中。"
        }
      ]
    }
  }
}