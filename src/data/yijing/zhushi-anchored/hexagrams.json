  },
  "30": {
    "tuan": [
      {
        "term": "丽",
        "note": "附丽、依附。万物各有所附。"
      },
      {
        "term": "重明",
        "note": "重，两重。上下皆离明，喻明而又明。"
      },
      {
        "term": "畜牝牛",
        "note": "牝牛，母牛，至顺之物。养柔顺之德。"
      }
    ],
    "daxiang": [
      {
        "term": "明两作",
        "note": "作，起也。光明相继而起。"
      }
    ],
    "xiaoxiang": {
      "1": [
        {
          "term": "履错",
          "note": "错然，交错貌；一说敬慎貌。始动而慎。"
        },
        {
          "term": "辟",
          "reading": "bì",
          "note": "通「避」。"
        }
      ],
      "2": [
        {
          "term": "黄离",
          "note": "黄，中色。附丽得中，文明中正之吉。"
        }
      ],
      "3": [
        {
          "term": "昃",
          "reading": "zè",
          "note": "日偏西。"
        }
      ],
      "5": [
        {
          "term": "离王公",
          "note": "离，附丽。附丽于王公之尊位。"
        }
      ]
    }
  },
  "31": {
    "tuan": [
      {
        "term": "男下女",
        "note": "下，谦下。男以礼下求于女，感应之正。"
      },
      {
        "term": "止而说",
        "reading": "说 yuè",
        "note": "说，通「悦」。笃实而和悦。"
      }
    ],
    "daxiang": [
      {
        "term": "虚受人",
        "note": "虚其心以受纳于人。山上有泽，虚而能受。"
      }
    ],
    "xiaoxiang": {
      "1": [
        {
          "term": "拇",
          "reading": "mǔ",
          "note": "足大趾。感之尚浅。"
        }
      ],
      "3": [
        {
          "term": "股",
          "note": "大腿。随足而动，不能自主。"
        },
        {
          "term": "所执下",
          "note": "执，操守。所守卑下，随人而动。"
        }
      ],
      "4": [
        {
          "term": "憧憧",
          "reading": "chōng chōng",
          "note": "往来不绝、心意不定貌。"
        }
      ],
      "5": [
        {
          "term": "脢",
          "reading": "méi",
          "note": "背脊肉。背于心而不相感。"
        },
        {
          "term": "志末",
          "note": "末，浅末。其志浅末。"
        }
      ],
      "6": [
        {
          "term": "辅",
          "note": "上颌牙床，与颊、舌皆言语之具。"
        },
        {
          "term": "滕口说",
          "reading": "滕 téng",
          "note": "滕，张口放言。徒以口舌取悦于人。"
        }
      ]
    }
  },
  "32": {
    "tuan": [
      {
        "term": "得天",
        "note": "得天之道，顺天运行，故能久照。"
      }
    ],
    "daxiang": [
      {
        "term": "不易方",
        "note": "方，道义常法。立身处世不变其常道。"
      }
    ],
    "xiaoxiang": {
      "1": [
        {
          "term": "浚恒",
          "reading": "浚 jùn",
          "note": "浚，深。始交而求之过深，故凶。"
        }
      ],
      "4": [
        {
          "term": "安得禽",
          "note": "安，何。田猎无禽，何能有获。"
        }
      ],
      "5": [
        {
          "term": "制义",
          "note": "裁断事宜。丈夫当裁度事理之宜。"
        }
      ],
      "6": [
        {
          "term": "振恒",
          "note": "振，振动不安。居上而躁动不休。"
        }
      ]
    }
  },
  "33": {
    "tuan": [
      {
        "term": "浸而长",
        "note": "浸，渐也。阴柔渐长，君子当遁。"
      }
    ],
    "daxiang": [
      {
        "term": "不恶而严",
        "reading": "恶 wù",
        "note": "恶，憎恶疾言。不显憎恶之色而自有威严。"
      }
    ],
    "xiaoxiang": {
      "1": [
        {
          "term": "遁尾",
          "note": "遁而居后如尾，迟则有危。"
        }
      ],
      "3": [
        {
          "term": "惫",
          "reading": "bèi",
          "note": "疲困。"
        }
      ],
      "4": [
        {
          "term": "好遁",
          "reading": "好 hào",
          "note": "好，喜好。能舍所好而遁。"
        },
        {
          "term": "否",
          "reading": "pǐ",
          "note": "不能也。小人则不能。"
        }
      ],
      "5": [
        {
          "term": "嘉遁",
          "note": "嘉，美。合乎时宜的美善之遁。"
        }
      ],
      "6": [
        {
          "term": "肥遁",
          "note": "肥，宽裕自得。远遁无碍，绰绰有余。"
        }
      ]
    }
  },
  "34": {
    "xiaoxiang": {
      "1": [
        {
          "term": "其孚穷",
          "note": "孚，信。其困穷可必信。"
        }
      ],
      "3": [
        {
          "term": "罔",
          "note": "无也。君子不恃其壮；一说罔为网罗。"
        }
      ],
      "4": [
        {
          "term": "藩决不羸",
          "reading": "羸 léi",
          "note": "藩，篱笆；决，破开；羸，缠累。篱开而角不被缠。"
        }
      ],
      "5": [
        {
          "term": "丧羊于易",
          "reading": "易 yì",
          "note": "易，田畔疆场；一说轻易。失羊于场圃之间。"
        }
      ],
      "6": [
        {
          "term": "遂",
          "note": "进也。进退两难。"
        },
        {
          "term": "不详",
          "note": "详，审慎。不审慎所致；一说通「祥」。"
        }
