      ],
      "2": [
        {
          "term": "失类",
          "note": "失其同类，所行无与为伴。"
        }
      ],
      "3": [
        {
          "term": "悖",
          "reading": "bèi",
          "note": "违背、悖乱。"
        }
      ],
      "4": [
        {
          "term": "颠颐",
          "note": "颠，倒置。居上反求养于下，于四则吉。"
        }
      ],
      "6": [
        {
          "term": "由颐",
          "note": "由，依赖。天下由之而得养。"
        }
      ]
    }
  },
  "28": {
    "tuan": [
      {
        "term": "栋桡",
        "reading": "桡 ráo",
        "note": "桡，弯曲。屋栋弯曲，本末（初上两阴）皆弱。"
      },
      {
        "term": "说",
        "reading": "yuè",
        "note": "通「悦」。"
      }
    ],
    "daxiang": [
      {
        "term": "泽灭木",
        "note": "灭，淹没。泽水淹没树木，过甚之象。"
      },
      {
        "term": "遁世无闷",
        "note": "遁，隐退。避世而心无烦闷。"
      }
    ],
    "xiaoxiang": {
      "1": [
        {
          "term": "藉",
          "reading": "jiè",
          "note": "衬垫。以白茅垫物，敬慎之至。"
        }
      ],
      "4": [
        {
          "term": "桡",
          "reading": "ráo",
          "note": "弯曲。不向下弯曲。"
        }
      ],
      "5": [
        {
          "term": "华",
          "reading": "huā",
          "note": "同「花」。枯杨开花，荣不久长。"
        },
        {
          "term": "士夫",
          "note": "士，未娶之年少男子。老妇配少夫。"
        }
      ]
    }
  },
  "29": {
    "tuan": [
      {
        "term": "习坎",
