      },
      {
        "term": "维心亨",
        "note": "维，唯。唯其心诚则亨通。"
      },
      {
        "term": "行有尚",
        "note": "尚，嘉尚、功效。行则有功。"
      }
    ],
    "daxiang": [
      {
