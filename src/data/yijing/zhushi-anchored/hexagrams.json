      {
        "term": "不家食",
        "note": "不使贤者食禄于家，谓养贤于朝。"
      }
    ],
    "daxiang": [
      {
        "term": "识",
        "reading": "zhì",
        "note": "记也。多记前贤言行以蓄养己德。"
      }
    ],
    "xiaoxiang": {
      "1": [
        {
          "term": "已",
          "reading": "yǐ",
          "note": "止也。有危则止，不犯灾难。"
        }
      ],
      "2": [
        {
          "term": "舆说輹",
          "reading": "说 tuō 輹 fù",
