      },
      {
        "term": "七日来复",
        "note": "阳消至尽凡七变而复生，故七日而回复。"
      },
      {
        "term": "天地之心",
        "note": "天地生生不已之心，于一阳来复处可见。"
      }
    ],
    "daxiang": [
      {
        "term": "至日",
        "note": "冬至之日。一阳初生，故安静以养之。"
      },
      {
        "term": "后不省方",
        "reading": "省 xǐng",
        "note": "后，君也；省方，巡视四方。"
      }
    ],
    "xiaoxiang": {
      "2": [
        {
          "term": "休复",
          "note": "休，美善。谦下亲仁，美善之复。"
        }
      ],
      "3": [
        {
          "term": "频复",
          "note": "频，屡次；一说颦蹙。屡失屡复，危而无咎。"
        }
      ],
      "4": [
        {
          "term": "中行",
          "ref": true
        }
      ],
      "5": [
        {
          "term": "自考",
          "note": "考，省察；一说成也。自我省察而成其德。"
        }
      ]
    }
  },
  "25": {
