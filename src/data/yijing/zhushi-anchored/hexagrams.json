{
  "1": {
    "tuan": [
      {
        "term": "资始",
        "note": "资，凭借、依赖。万物皆赖乾元而开始。"
      },
      {
        "term": "品物流形",
        "note": "品物，众类之物；流形，禀受元气流布而成形体。"
      },
      {
        "term": "保合大和",
        "note": "大和即太和，阴阳会合冲和之气；保而常存，合而常和。",
        "source": "朱熹《周易本义》"
      },
      {
        "term": "首出庶物",
        "note": "庶物，万物。高出于万物之首，喻圣人居众人之上。"
      }
    ],
    "daxiang": [
      {
        "term": "天行健",
        "note": "行，运行。天体运行昼夜不息，至为刚健。"
      }
    ],
    "xiaoxiang": {
      "3": [
        {
          "term": "反复道也",
          "note": "反复践行其道，进退皆不离正道。"
        }
      ],
      "5": [
        {
          "term": "造",
          "reading": "zào",
          "note": "作也，兴起有为。大人奋起而作，如圣人出世。"
        }
      ],
      "use": [
        {
          "term": "不可为首",
          "note": "刚健而不自居首倡，恃刚逞强则有悔。"
        }
      ]
    }
  },
  "2": {
    "tuan": [
      {
        "term": "资生",
        "note": "资，依赖。万物赖坤元而生成；乾施其始，坤成其生。"
      },
      {
        "term": "含弘光大",
        "note": "含，包容；弘，宽裕；光，昭明；大，博厚。",
        "source": "朱熹《周易本义》"
      },
      {
        "term": "牝马地类",
        "note": "牝马，母马。性柔顺而行地不息，与地同类。"
      },
      {
        "term": "西南得朋",
        "note": "朋，同类。西南为阴方，往之得同类；东北阳方，故丧朋。"
      }
    ],
    "daxiang": [
      {
        "term": "地势",
        "note": "地之形势，高下相因顺承，顺之至也。"
      }
    ],
    "xiaoxiang": {
      "1": [
        {
          "term": "驯致",
          "note": "驯，顺习渐进。顺其势逐渐发展而至。"
        }
      ],
      "3": [
        {
          "term": "知",
          "reading": "zhì",
          "note": "通「智」，智慧。"
        }
      ],
      "5": [
        {
          "term": "文在中",
          "note": "文德蕴藏于内而不显露，故美在其中。"
        }
      ],
      "use": [
        {
          "term": "以大终",
          "note": "阳大阴小，用六之爻变而为阳，以阳刚收束，故曰大终。"
        }
      ]
    }
  },
  "3": {
    "tuan": [
      {
        "term": "天造草昧",
        "note": "天地始创，万物草创混沌未明。造，始也；昧，冥昧。",
        "source": "孔颖达《周易正义》"
      }
    ],
    "daxiang": [
      {
        "term": "经纶",
        "note": "理丝为经、编丝为纶，引申为筹划治理。",
        "source": "朱熹《周易本义》"
      }
    ],
    "xiaoxiang": {
      "1": [
        {
          "term": "磐桓",
          "ref": true
        },
        {
          "term": "以贵下贱",
          "note": "以尊贵之身谦居卑贱者之下。"
        }
      ],
      "2": [
        {
          "term": "乘刚",
          "note": "阴爻居阳爻之上曰乘刚，柔乘凌于刚，多有不顺。"
        },
        {
          "term": "十年乃字",
          "note": "字，许嫁；一说生育。十年方嫁，极言其久。"
        }
      ],
      "3": [
        {
          "term": "即鹿无虞",
          "note": "即，就、追逐；虞，虞人，掌山林之官。逐鹿而无向导。"
        }
      ],
      "5": [
        {
          "term": "屯其膏",
          "note": "膏，膏泽、恩泽。恩泽艰于施布，未能光大。"
        }
      ],
      "6": [
        {
          "term": "泣血涟如",
          "note": "泣极无声而血出，泪流不断貌。"
        }
      ]
    }
  },
  "4": {
    "tuan": [
      {
        "term": "时中",
        "note": "随时而得中，不先不后，恰当其可。"
      },
      {
        "term": "筮",
        "reading": "shì",
        "note": "以蓍草占卦问疑。"
      },
      {
        "term": "再三渎",
        "note": "渎，轻慢不敬。一再占问，是亵渎蓍筮。"
      }
    ],
    "daxiang": [
      {
        "term": "果行",
        "note": "果，果决。以果决之行培育德性，如泉出山而必行。"
      }
    ],
    "xiaoxiang": {
      "1": [
        {
          "term": "刑人",
          "note": "刑，典刑、法则；一说刑罚。以法正人，立其始。"
        }
      ],
      "2": [
        {
          "term": "子克家",
          "note": "克，能也。子能承担治家之任。"
        }
      ],
      "4": [
        {
          "term": "独远实也",
          "reading": "远 yuàn",
          "note": "实，指阳刚之贤。独远离阳刚，故困于蒙昧。"
        }
      ],
      "5": [
        {
          "term": "巽",
          "reading": "xùn",
          "note": "逊也，谦逊柔顺。"
        }
      ]
    }
  },
  "5": {
    "tuan": [
      {
        "term": "须",
        "note": "等待。需即待时而进之义。"
      },
      {
        "term": "位乎天位",
        "note": "九五居天位（第五爻为天子之位），既正且中。"
      }
    ],
    "xiaoxiang": {
      "1": [
        {
          "term": "不犯难行也",
          "reading": "难 nàn",
          "note": "犯，冒犯、强行。不冒险难而轻进。"
        }
      ],
      "2": [
        {
          "term": "衍",
          "reading": "yǎn",
          "note": "宽绰从容。居中而宽和不迫。"
        }
      ],
      "4": [
        {
          "term": "顺以听",
          "note": "顺势而听从时命，不与争抗，故能出于险地。"
        }
      ]
    }
  },
  "6": {
    "tuan": [
      {
        "term": "窒",
        "reading": "zhì",
        "note": "窒塞不通。诚信被窒，故起争讼。"
      },
      {
        "term": "刚来而得中",
        "note": "阳刚来居下卦之中（九二），处讼而能持中。"
      }
    ],
    "daxiang": [
      {
        "term": "违行",
        "note": "相背而行。天西转，水东流，其行相违，故成讼象。"
      }
    ],
    "xiaoxiang": {
      "2": [
        {
          "term": "逋窜",
          "reading": "bū cuàn",
          "note": "逋，逃亡；窜，藏匿。败讼而逃归藏匿。"
        },
        {
          "term": "掇",
          "reading": "duō",
          "note": "拾取。患祸之来如俯身拾物，自取之也。"
        }
      ],
      "4": [
        {
          "term": "复即命渝",
          "note": "复，返；即，就；命，正理；渝，变。返就正理而变其讼心。"
        }
      ],
      "6": [
        {
          "term": "受服",
          "note": "服，官服佩饰，指讼胜所得鞶带之赏。"
        }
      ]
    }
  },
  "7": {
    "tuan": [
      {
        "term": "毒",
        "note": "害也。兴师不免荼毒天下，然民犹从之，以其正也。",
        "source": "朱熹《周易本义》"
      },
      {
        "term": "王",
        "reading": "wàng",
        "note": "动词，称王、王天下。"
      }
    ],
    "daxiang": [
      {
        "term": "畜众",
        "reading": "畜 xù",
        "note": "畜，养也。容保其民，畜养众庶。"
      }
    ],
    "xiaoxiang": {
      "2": [
        {
          "term": "锡",
          "ref": true
        },
        {
          "term": "怀万邦",
          "note": "怀，安抚、使归服。安抚万国之心。"
        }
      ],
      "4": [
        {
          "term": "左次",
          "note": "次，驻扎；左次，退舍后撤。知难而退，未失常法。"
        }
      ],
      "5": [
        {
          "term": "中行",
          "ref": true
        }
      ],
      "6": [
        {
          "term": "大君",
          "note": "天子、君主之尊称。"
        }
      ]
    }
  },
  "8": {
    "tuan": [
      {
        "term": "原筮",
        "note": "原，推原再度；筮，占决。再三审度以求可亲辅之主。"
      },
      {
        "term": "不宁方来",
        "note": "方，方国、邦国。不得安宁的邦国前来归附。"
      },
      {
        "term": "后夫",
        "note": "夫，人也。迟迟后至之人，亲比之道已穷，故凶。"
      }
    ],
    "xiaoxiang": {
      "1": [
        {
          "term": "有它吉",
          "note": "它，意外。诚信充盈，更有意外之吉。"
        }
      ],
      "5": [
        {
          "term": "舍逆取顺",
          "note": "田猎三驱之礼：逆来向己者纵之，顺走背己者取之。"
        },
        {
          "term": "不诫",
          "note": "诫，警戒。邑人不相警备，见上之使民宽而得中。"
        }
      ]
    }
  },
  "9": {
    "tuan": [
      {
        "term": "尚往",
        "note": "尚，上也。阳气尚在上行，畜聚未极，故未成雨。"
      },
      {
        "term": "施未行",
        "note": "施，雨泽之施。畜而未成，泽未下行。"
      }
    ],
    "daxiang": [
      {
        "term": "懿",
        "reading": "yì",
        "note": "美也，修美。所畜未能及物，故先修美文德。"
      }
    ],
    "xiaoxiang": {
      "2": [
        {
          "term": "牵复",
          "note": "牵，牵连提携。与初九牵连而返于正道。"
        }
      ],
      "5": [
        {
          "term": "挛如",
          "reading": "挛 luán",
          "note": "牵系连结貌。诚信相系，与人同富。"
        }
      ],
      "6": [
        {
          "term": "德积载",
          "note": "畜德积满而成雨，如车之满载。"
        }
      ]
    }
  },
  "10": {
    "tuan": [
      {
        "term": "说",
        "reading": "yuè",
        "note": "通「悦」，欣悦。下兑为悦，以悦应乾刚。"
      },
      {
        "term": "咥",
        "reading": "dié",
        "note": "咬、啮。"
      },
      {
        "term": "不疚",
        "note": "疚，病、愧。居帝位而无愧病。"
      }
    ],
    "xiaoxiang": {
      "1": [
        {
          "term": "素履",
          "note": "素，朴素本分。安于平素而行。"
        }
      ],
      "2": [
        {
          "term": "幽人",
          "note": "幽静恬退之人。"
        }
      ],
      "3": [
        {
          "term": "眇",
          "reading": "miǎo",
          "note": "一目失明。"
        }
      ],
      "4": [
        {
          "term": "愬愬",
          "reading": "sù sù",
          "note": "恐惧戒慎貌。"
        }
      ],
      "5": [
        {
          "term": "夬履",
          "reading": "夬 guài",
          "note": "夬，决。行事果决无疑。"
        }
      ]
    }
  },
  "11": {
    "tuan": [
      {
        "term": "小往大来",
        "note": "小谓阴，大谓阳。阴往居外，阳来居内，故通泰。"
      }
    ],
    "daxiang": [
      {
        "term": "后",
        "note": "君主。古称天子诸侯皆曰后。"
      },
      {
        "term": "财成",
        "note": "财，通「裁」，裁节成就。"
      },
      {
        "term": "辅相",
        "reading": "相 xiàng",
        "note": "辅助赞助，使得其宜。"
      },
      {
        "term": "左右",
        "note": "助也，扶持保佑其民。"
      }
    ],
    "xiaoxiang": {
      "1": [
        {
          "term": "拔茅",
          "note": "茅草根相牵连，拔一根则同类相连而起，喻同志相引。"
        }
      ],
      "2": [
        {
          "term": "包荒",
          "note": "荒，秽恶、广大。有包容荒秽之量。"
        },
        {
          "term": "中行",
          "ref": true
        }
      ],
      "3": [
        {
          "term": "际",
          "note": "交会、交接之处。泰极否来，天地交接之际。"
        }
      ],
      "4": [
        {
          "term": "翩翩",
          "note": "轻快连飞貌，喻相率而下。"
        },
        {
          "term": "失实",
          "note": "实，富实，指阳。阴虚失实，故不富。"
        }
      ],
      "5": [
        {
          "term": "祉",
          "reading": "zhǐ",
          "note": "福也。"
        }
      ],
      "6": [
        {
          "term": "隍",
          "reading": "huáng",
          "note": "无水之城壕。掘隍土筑城，城坏则土复倾于隍。"
        }
      ]
    }
  },
  "12": {
    "tuan": [
      {
        "term": "匪人",
        "note": "匪，非。行为不正之人；一说非人道之世。"
      }
    ],
    "daxiang": [
      {
        "term": "辟难",
        "reading": "辟 bì",
        "note": "辟，通「避」。以俭约之德避祸难。"
      }
    ],
    "xiaoxiang": {
      "1": [
        {
          "term": "拔茅",
          "note": "茅草根相牵连，拔一根则同类相连而起，喻同志相引。"
        }
      ],
      "3": [
        {
          "term": "包羞",
          "note": "包藏羞辱，所行不正而蒙羞。"
        }
      ]
    }
  },
  "13": {
    "daxiang": [
      {
        "term": "类族辨物",
        "note": "类聚族群，分辨事物，使各从其类。"
      }
    ],
    "xiaoxiang": {
      "3": [
        {
          "term": "伏戎于莽",
          "note": "戎，兵；莽，草丛。藏兵于草莽之中。"
        },
        {
          "term": "安行",
          "note": "安，何也。何敢行动。"
        }
      ],
      "4": [
        {
          "term": "墉",
          "reading": "yōng",
          "note": "城墙。"
        },
        {
          "term": "反则",
          "note": "反，返。穷困而返于正则。"
        }
      ]
    }
  },
  "14": {
    "tuan": [
      {
        "term": "大中",
        "note": "居尊位而得大中之道，指六五。"
      }
    ],
    "daxiang": [
      {
        "term": "休命",
        "note": "休，美也。顺奉上天之美命。"
      }
    ],
    "xiaoxiang": {
      "1": [
        {
          "term": "无交害",
          "note": "未涉交往，故无害；一说不交相为害。"
        }
      ],
      "3": [
        {
          "term": "亨",
          "reading": "xiǎng",
          "note": "通「享」，朝献宴享。公侯朝享于天子。"
        }
      ],
      "4": [
        {
          "term": "彭",
          "reading": "páng",
          "note": "盛大貌。不处盛极，故无咎。"
        }
      ],
      "5": [
        {
          "term": "厥",
          "note": "其也。"
        },
        {
          "term": "易而无备",
          "note": "易，平易坦然。威信自然而不待戒备。"
        }
      ]
    }
  },
  "15": {
    "tuan": [
      {
        "term": "下济",
        "note": "济，施降。天道之气下施于地，故万物生而光明。"
      },
      {
        "term": "亏盈而益谦",
        "note": "亏，损减。天道损减盈满而增益谦虚。"
      },
      {
        "term": "变盈而流谦",
        "note": "流，流注。地道变易盈满之地，流注增益谦下之处。"
      }
    ],
    "daxiang": [
      {
        "term": "裒",
        "reading": "póu",
        "note": "取也、减损。取多余以增不足。"
      },
      {
        "term": "称物平施",
        "reading": "称 chèn",
        "note": "称，权衡。称量财物多寡而公平施予。"
      }
    ],
    "xiaoxiang": {
      "1": [
        {
          "term": "自牧",
          "note": "牧，养也。以谦卑自养其德。"
        }
      ],
      "4": [
        {
          "term": "㧑",
          "reading": "huī",
          "note": "挥散、发挥。施布其谦于上下。"
        }
      ]
    }
  },
  "16": {
    "tuan": [
      {
        "term": "忒",
        "reading": "tè",
        "note": "差错。四时运行无差错。"
      },
      {
        "term": "时义",
        "note": "随时之宜、时机之意义。赞叹豫卦时义之大。"
      }
    ],
    "daxiang": [
      {
        "term": "殷荐",
        "note": "殷，盛大；荐，进献。盛大地献乐于上帝。"
      },
      {
        "term": "配祖考",
        "note": "配，配享。使祖先配享祭祀。考，亡父。"
      }
    ],
    "xiaoxiang": {
      "3": [
        {
          "term": "盱",
          "reading": "xū",
          "note": "张目仰视，谄媚上视。"
        }
      ],
      "4": [
        {
          "term": "由豫",
          "note": "由，自、经由。众由之而得豫乐。"
        }
      ],
      "5": [
        {
          "term": "恒不死",
          "note": "久处忧危而不亡，以其得中。"
        }
      ],
      "6": [
        {
          "term": "冥豫",
          "note": "冥，昏冥沉溺。沉溺于逸乐而不知返。"
        }
      ]
    }
  },
  "17": {
    "tuan": [
      {
        "term": "刚来而下柔",
        "note": "阳刚来居阴柔之下，能下人者人随之。"
      },
      {
        "term": "说",
        "reading": "yuè",
        "note": "通「悦」。动而人悦，故天下相随。"
      }
    ],
    "daxiang": [
      {
        "term": "向晦入宴息",
        "note": "向晦，将近天黑；宴息，安歇。随昼夜之时作息。"
      }
    ],
    "xiaoxiang": {
      "1": [
        {
          "term": "官有渝",
          "note": "官，主守、职位；渝，变。所主有变，从正则吉。"
        }
      ],
      "2": [
        {
          "term": "弗兼与",
          "note": "与，相从。不能两者兼从，系此则失彼。"
        }
      ],
      "5": [
        {
          "term": "嘉",
          "note": "善也，美善之人事。"
        }
      ]
    }
  },
  "18": {
    "tuan": [
      {
        "term": "先甲三日",
        "note": "甲为事端之始。先甲后甲各三日，谓究其先后、慎终如始。"
      }
    ],
    "daxiang": [
      {
        "term": "振民",
        "note": "振，振奋拯济。救济民众，培育己德。"
      }
    ],
    "xiaoxiang": {
      "1": [
        {
          "term": "干",
          "reading": "gàn",
          "note": "主持、匡正。匡正父辈之弊事。"
        },
        {
          "term": "考",
          "note": "亡父曰考。"
        }
      ],
      "4": [
        {
          "term": "裕",
          "note": "宽缓、拖延。宽裕不治其弊，则往而不济。"
        }
      ],
      "6": [
        {
          "term": "志可则",
          "note": "则，效法。其志高洁，可为法则。"
        }
      ]
    }
  },
  "19": {
    "tuan": [
      {
        "term": "刚浸而长",
        "reading": "长 zhǎng",
        "note": "浸，渐也。阳刚渐次生长，指初九、九二。"
      },
      {
        "term": "八月",
        "note": "卦气说：阳息至临历八月而阴长阳消，戒盛之必衰。"
      }
    ],
    "daxiang": [
      {
        "term": "教思",
        "note": "教化之意无有穷尽。思，心思、关怀。"
      }
    ],
    "xiaoxiang": {
      "1": [
        {
          "term": "咸",
          "note": "感也。以诚感而临人。"
        }
      ],
      "3": [
        {
          "term": "甘",
          "note": "甘美之言。以甘言谄媚临人。"
        }
      ],
      "6": [
        {
          "term": "敦",
          "note": "敦厚。以敦厚之德临下。"
        }
      ]
    }
  },
  "20": {
    "tuan": [
      {
        "term": "盥而不荐",
        "reading": "盥 guàn",
        "note": "盥，祭前洁手酌酒灌地降神；荐，献牲。重始之诚。"
      },
      {
        "term": "颙若",
        "reading": "颙 yóng",
        "note": "庄严恭敬仰望貌。"
      },
      {
        "term": "神道设教",
        "note": "观天之神妙规律而设立教化。"
      }
    ],
    "daxiang": [
      {
        "term": "省方",
        "reading": "省 xǐng",
        "note": "省，视察。巡视四方。"
      }
    ],
    "xiaoxiang": {
      "1": [
        {
          "term": "童观",
          "note": "如孩童之观，所见浅近。"
        }
      ],
      "2": [
        {
          "term": "窥观",
          "note": "窥，从隙缝中看。所见狭隘不广。"
        }
      ],
      "3": [
        {
          "term": "观我生",
          "note": "生，所行所为。省察自己的行为出处。"
        }
      ],
      "4": [
        {
          "term": "尚宾",
          "note": "志在仕进，愿为君上之宾。尚，尊尚。"
        }
      ]
    }
  },
  "21": {
    "tuan": [
      {
        "term": "颐中有物",
        "note": "颐，口腮。口中有物，咬合方通。"
      },
      {
        "term": "章",
        "note": "彰明、显著。"
      },
      {
        "term": "用狱",
        "note": "治狱、断案。"
      }
    ],
    "daxiang": [
      {
        "term": "敕法",
        "reading": "敕 chì",
        "note": "敕，整饬。严明刑罚，整饬法令。"
      }
    ],
    "xiaoxiang": {
      "1": [
        {
          "term": "屦校灭趾",
          "reading": "屦 jù 校 jiào",
          "note": "屦，践、着；校，木枷。足着刑具，遮没脚趾。"
        }
      ],
      "2": [
        {
          "term": "乘刚",
          "note": "阴爻居阳爻之上曰乘刚，柔乘凌于刚，多有不顺。"
        }
      ],
      "3": [
        {
          "term": "遇毒",
          "note": "毒，腐肉之恶味，喻治人而遇怨恶。"
        }
      ],
      "6": [
        {
          "term": "何校灭耳",
          "reading": "何 hè",
          "note": "何，通「荷」，负荷。颈负木枷，遮没双耳。"
        },
        {
          "term": "聪",
          "note": "听觉聪敏。恶积不可掩，故失其聪。"
        }
      ]
    }
  },
  "22": {
    "tuan": [
      {
        "term": "柔来而文刚",
        "note": "文，文饰。阴柔来文饰阳刚，刚柔交错成文。"
      },
      {
        "term": "人文",
        "note": "人伦文明之序，礼乐教化。"
      }
    ],
    "daxiang": [
      {
        "term": "折狱",
        "reading": "折 zhé",
        "note": "判断讼狱。文饰之道不可施于断狱。"
      }
    ],
    "xiaoxiang": {
      "1": [
        {
          "term": "舍车而徒",
          "note": "舍，舍弃；徒，徒步。义不当乘则宁可步行。"
        }
      ],
      "2": [
        {
          "term": "须",
          "note": "面之胡须，附丽于上而动，喻随上而兴。"
        }
      ],
      "3": [
        {
          "term": "陵",
          "note": "侵凌、欺侮。"
        }
      ],
      "4": [
        {
          "term": "尤",
          "note": "怨咎、过失。"
        }
      ],
      "6": [
        {
          "term": "白贲",
          "note": "白，素白无饰。饰极反素，质朴为上。"
        }
      ]
    }
  },
  "23": {
    "tuan": [
      {
        "term": "消息盈虚",
        "note": "消亡、生息、盈满、虚损，天道循环之理。"
      }
    ],
    "daxiang": [
      {
        "term": "厚下",
        "note": "厚待下民。下厚则上安，如宅之有基。"
      }
    ],
    "xiaoxiang": {
      "2": [
        {
          "term": "辨",
          "reading": "biàn",
          "note": "床身与床足之间的分界，即床干。"
        },
        {
          "term": "未有与",
          "note": "与，党与、应援。孤立无援。"
        }
      ],
      "6": [
        {
          "term": "得舆",
          "note": "舆，车。硕果不食，君子得民拥戴如乘车。"
        },
        {
          "term": "剥庐",
          "note": "庐，屋舍。小人剥极并失其庇身之所。"
        }
      ]
    }
  },
  "24": {
    "tuan": [
      {
        "term": "刚反",
        "note": "反，返。阳刚消尽而复返，一阳生于下。"
      },
      {
        "term": "七日来复",
        "note": "阳消至尽凡七变而复生，故七日而回复。"
      },
      {
        "term": "天地之心",
        "note": "天地生生不已之心，于一阳来复处可见。"
      }
    ],
    "daxiang": [
      {
        "term": "至日",
        "note": "冬至之日。一阳初生，故安静以养之。"
      },
      {
        "term": "后不省方",
        "reading": "省 xǐng",
        "note": "后，君也；省方，巡视四方。"
      }
    ],
    "xiaoxiang": {
      "2": [
        {
          "term": "休复",
          "note": "休，美善。谦下亲仁，美善之复。"
        }
      ],
      "3": [
        {
          "term": "频复",
          "note": "频，屡次；一说颦蹙。屡失屡复，危而无咎。"
        }
      ],
      "4": [
        {
          "term": "中行",
          "ref": true
        }
      ],
      "5": [
        {
          "term": "自考",
          "note": "考，省察；一说成也。自我省察而成其德。"
        }
      ]
    }
  },
  "25": {
