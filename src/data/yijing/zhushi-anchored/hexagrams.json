  },
  "27": {
    "tuan": [
      {
        "term": "口实",
        "note": "口中之食物。自谋饮食，观其自养之道。"
      }
    ],
    "xiaoxiang": {
      "1": [
        {
          "term": "朵颐",
          "note": "朵，动也。鼓动腮颊嚼食，垂涎欲食貌。"
        }
      ],
      "2": [
        {
          "term": "失类",
          "note": "失其同类，所行无与为伴。"
        }
      ],
      "3": [
        {
          "term": "悖",
          "reading": "bèi",
          "note": "违背、悖乱。"
        }
      ],
      "4": [
        {
          "term": "颠颐",
          "note": "颠，倒置。居上反求养于下，于四则吉。"
        }
      ],
      "6": [
        {
          "term": "由颐",
          "note": "由，依赖。天下由之而得养。"
        }
      ]
    }
  },
  "28": {
    "tuan": [
      {
        "term": "栋桡",
        "reading": "桡 ráo",
        "note": "桡，弯曲。屋栋弯曲，本末（初上两阴）皆弱。"
      },
      {
        "term": "说",
        "reading": "yuè",
        "note": "通「悦」。"
      }
    ],
    "daxiang": [
      {
        "term": "泽灭木",
        "note": "灭，淹没。泽水淹没树木，过甚之象。"
      },
      {
        "term": "遁世无闷",
        "note": "遁，隐退。避世而心无烦闷。"
      }
    ],
    "xiaoxiang": {
      "1": [
        {
          "term": "藉",
          "reading": "jiè",
          "note": "衬垫。以白茅垫物，敬慎之至。"
        }
      ],
      "4": [
        {
          "term": "桡",
          "reading": "ráo",
          "note": "弯曲。不向下弯曲。"
        }
      ],
      "5": [
        {
          "term": "华",
          "reading": "huā",
          "note": "同「花」。枯杨开花，荣不久长。"
        },
        {
          "term": "士夫",
          "note": "士，未娶之年少男子。老妇配少夫。"
        }
      ]
    }
  },
  "29": {
    "tuan": [
      {
        "term": "习坎",
        "note": "习，重也；一说反复练习。两坎相重，故曰习坎。"
      },
      {
        "term": "维心亨",
        "note": "维，唯。唯其心诚则亨通。"
      },
      {
        "term": "行有尚",
        "note": "尚，嘉尚、功效。行则有功。"
      }
    ],
    "daxiang": [
      {
        "term": "洊",
        "reading": "jiàn",
        "note": "再、相继。水相继而至。"
      },
      {
        "term": "常德行",
        "note": "常，恒常不变。恒久其德行。"
      }
    ],
    "xiaoxiang": {
      "3": [
        {
          "term": "来之坎坎",
          "note": "之，往。来去皆是坎险。"
        }
      ],
      "4": [
        {
          "term": "樽酒簋贰",
          "reading": "樽 zūn 簋 guǐ",
          "note": "一樽酒、两簋食。簋，盛黍稷之器。礼薄而诚。"
        }
      ]
    }
  },
  "30": {
    "tuan": [
      {
        "term": "丽",
        "note": "附丽、依附。万物各有所附。"
      },
      {
        "term": "重明",
        "note": "重，两重。上下皆离明，喻明而又明。"
      },
      {
        "term": "畜牝牛",
        "note": "牝牛，母牛，至顺之物。养柔顺之德。"
      }
    ],
    "daxiang": [
      {
        "term": "明两作",
        "note": "作，起也。光明相继而起。"
      }
    ],
    "xiaoxiang": {
      "1": [
        {
          "term": "履错",
          "note": "错然，交错貌；一说敬慎貌。始动而慎。"
        },
        {
          "term": "辟",
          "reading": "bì",
          "note": "通「避」。"
        }
      ],
      "2": [
        {
          "term": "黄离",
          "note": "黄，中色。附丽得中，文明中正之吉。"
        }
      ],
      "3": [
        {
          "term": "昃",
          "reading": "zè",
          "note": "日偏西。"
        }
      ],
      "5": [
        {
          "term": "离王公",
          "note": "离，附丽。附丽于王公之尊位。"
        }
      ]
    }
  },
  "31": {
    "tuan": [
      {
        "term": "男下女",
        "note": "下，谦下。男以礼下求于女，感应之正。"
      },
      {
        "term": "止而说",
        "reading": "说 yuè",
        "note": "说，通「悦」。笃实而和悦。"
      }
    ],
    "daxiang": [
      {
        "term": "虚受人",
        "note": "虚其心以受纳于人。山上有泽，虚而能受。"
      }
    ],
    "xiaoxiang": {
      "1": [
        {
          "term": "拇",
          "reading": "mǔ",
          "note": "足大趾。感之尚浅。"
        }
      ],
      "3": [
        {
          "term": "股",
          "note": "大腿。随足而动，不能自主。"
        },
        {
          "term": "所执下",
          "note": "执，操守。所守卑下，随人而动。"
        }
      ],
      "4": [
        {
          "term": "憧憧",
          "reading": "chōng chōng",
          "note": "往来不绝、心意不定貌。"
        }
      ],
      "5": [
        {
          "term": "脢",
          "reading": "méi",
          "note": "背脊肉。背于心而不相感。"
        },
        {
          "term": "志末",
          "note": "末，浅末。其志浅末。"
        }
      ],
      "6": [
        {
          "term": "辅",
          "note": "上颌牙床，与颊、舌皆言语之具。"
        },
        {
          "term": "滕口说",
          "reading": "滕 téng",
          "note": "滕，张口放言。徒以口舌取悦于人。"
        }
      ]
    }
  },
  "32": {
    "tuan": [
      {
        "term": "得天",
        "note": "得天之道，顺天运行，故能久照。"
      }
    ],
    "daxiang": [
      {
        "term": "不易方",
        "note": "方，道义常法。立身处世不变其常道。"
      }
    ],
    "xiaoxiang": {
      "1": [
        {
          "term": "浚恒",
          "reading": "浚 jùn",
          "note": "浚，深。始交而求之过深，故凶。"
        }
      ],
      "4": [
        {
          "term": "安得禽",
          "note": "安，何。田猎无禽，何能有获。"
        }
      ],
      "5": [
        {
          "term": "制义",
          "note": "裁断事宜。丈夫当裁度事理之宜。"
        }
      ],
      "6": [
        {
          "term": "振恒",
          "note": "振，振动不安。居上而躁动不休。"
        }
      ]
    }
  }
}