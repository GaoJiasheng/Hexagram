{
  "1": {
    "0": [
      {
        "term": "幽赞",
        "note": "幽，深隐；赞，佐助。深得神明之助。"
      },
      {
        "term": "蓍",
        "reading": "shī",
        "note": "蓍草，揲筮所用。"
      },
      {
        "term": "参天两地",
        "reading": "参 sān",
        "note": "参，三。取三于天、取二于地而立数。"
      },
      {
        "term": "倚数",
        "note": "倚，立。据以确立数。"
      }
    ]
  },
  "2": {
    "0": [
      {
        "term": "兼三才而两之",
        "note": "三才各以两画象之，故成六画。"
      },
      {
        "term": "成章",
        "note": "章，文章条理。六位错杂成文。"
      }
    ]
  },
  "3": {
    "0": [
      {
        "term": "相薄",
        "reading": "薄 bó",
        "note": "薄，迫近、相激。"
      },
      {
        "term": "不相射",
        "reading": "射 yì",
        "note": "射，厌弃；一说相害。水火异性而不相厌害。"
      },
      {
        "term": "逆数",
        "note": "逆推未来之数。易主预知来事，故曰逆数。"
      }
    ]
  },
  "4": {
    "0": [
      {
        "term": "烜",
        "reading": "xuǎn",
        "note": "晒干、曝晒。"
      },
      {
        "term": "说",
        "reading": "yuè",
        "note": "通「悦」。"
      },
      {
        "term": "君",
        "note": "主宰、统领。"
      }
    ]
  },
  "5": {
    "0": [
      {
        "term": "帝",
        "note": "天帝，万物生化之主宰。"
      },
      {
        "term": "齐",
        "note": "整齐洁净。万物洁齐于巽。"
      },
      {
        "term": "致役",
        "note": "役，效劳役养。万物致养于坤。"
      },
      {
        "term": "劳乎坎",
        "note": "劳，劳倦归息；一说慰劳。万物归藏休息于坎。"
      }
    ],
    "2": [
      {
        "term": "洁齐",
        "note": "洁净整齐。万物至此鲜明齐整。"
      }
    ],
    "3": [
      {
        "term": "南面",
        "note": "面向南。古者君位坐北朝南。"
      },
      {
        "term": "听天下",
        "note": "听，治理。听断天下之政。"
      }
    ],
    "5": [
      {
        "term": "正秋",
        "note": "仲秋八月，兑当正西，于时为秋。"
      }
    ],
    "6": [
      {
        "term": "相薄",
        "reading": "薄 bó",
        "note": "迫近、相激。阴阳交战相迫。"
      }
    ],
    "8": [
      {
        "term": "终而所成始",
        "note": "既成万物之终，又成万物之始。艮居岁末年初。"
      }
    ]
