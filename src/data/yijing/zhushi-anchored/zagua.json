{
  "1": {
    "1": [
      { "term": "或与或求", "note": "与，施予；求，求取。二卦一施一求。" }
    ],
    "2": [
      { "term": "见", "reading": "xiàn", "note": "同「现」，显现。" },
      { "term": "杂而著", "note": "蒙昧错杂而渐显明。" }
    ],
    "7": [
      { "term": "谦轻", "note": "轻，不自尊大。谦者自处卑轻。" },
      { "term": "怠", "note": "怠惰。豫乐则易怠。" }
    ],
    "9": [
      { "term": "见", "reading": "xiàn", "note": "同「现」。兑悦显于外，巽顺伏于内。" }
    ],
    "10": [
      { "term": "无故", "note": "故，事故。随时而动，无所造作生事。" },
      { "term": "饬", "reading": "chì", "note": "整治。蛊坏则须整饬。" }
    ],
    "12": [
      { "term": "诛", "note": "伤也，谓明见诛伤。" }
    ],
    "23": [
      { "term": "多故", "note": "故，事变。盛大则多事变。" },
      { "term": "亲寡", "note": "亲附者少。语倒，即「旅亲寡」。" }
    ],
    "25": [
      { "term": "不处", "note": "处，安止。履者践行，不敢安处。" }
    ],
    "27": [
      { "term": "颠", "note": "颠覆。本末俱弱，故颠。" }
    ]
  }
}
