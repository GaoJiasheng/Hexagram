[
  { "term": "利涉大川", "note": "利于渡涉大河——宜于冒险济难、成就大事。", "source": "程颐《伊川易传》" },
  { "term": "不利涉大川", "note": "不利于渡涉大河——不宜冒险涉难。", "source": null },
  { "term": "利见大人", "note": "利于见到大德大位之人。", "source": null },
  { "term": "利有攸往", "note": "利于有所前往。攸，所也。", "source": null },
  { "term": "有攸往", "note": "有所前往。攸，所也。", "source": null },
  { "term": "无攸利", "note": "无所利——做什么都不利。", "source": null },
