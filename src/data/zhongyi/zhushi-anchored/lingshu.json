{
  "1": {
    "0": [
      {
        "term": "法天",
        "note": "效法天道。旧或作篇首标目，谓针法取法于天。"
      }
    ],
    "1": [
      {
        "term": "余子万民",
        "reading": "zǐ wàn mín",
        "note": "子，以…为子，意动用法。视万民如己子。"
      },
      {
        "term": "毒药",
        "note": "古指药性峻烈之药，泛称汤药，非今之毒物义。"
      },
      {
        "term": "砭石",
        "reading": "biān shí",
        "note": "上古以石制器破痈排脓之法，针术之前身。"
      },
      {
        "term": "经纪",
        "note": "纲纪条理，谓为针法建立条贯。"
      }
    ],
    "2": [
      {
        "term": "麤守形",
        "reading": "cū shǒu xíng",
        "note": "麤同粗，粗工。守形，拘泥于外在形迹。"
      },
      {
        "term": "上守神",
        "note": "上工持守神气，即气机之微。"
      },
      {
        "term": "客在门",
        "note": "客，邪气;门，门户孔窍。谓邪气客于经穴。"
      }
    ],
    "3": [
      {
        "term": "宛陈则除之",
        "reading": "yù chén",
        "note": "宛同郁，郁积;陈，陈久。谓郁积陈久之血当除。"
      },
      {
        "term": "内温",
        "reading": "nà yùn",
        "note": "温通蕴，谓邪气蓄积于内不得外散。"
      },
      {
        "term": "蚊虞",
        "reading": "wén yú",
        "note": "虞为虻之讹;喻持针之态轻微。"
      },
      {
        "term": "悬阳",
        "note": "旧注不一，或指目，或指阳气;此存疑。"
      }
    ],
    "5": [
      {
        "term": "镵针",
        "reading": "chán zhēn",
        "note": "九针之一，头大末锐。镵，锐利。"
      },
      {
        "term": "一寸六分",
        "note": "古尺寸单位，十分为寸;此记针之长短形制。"
      }
    ],
    "7": [
      {
        "term": "𫔂针",
        "reading": "tí zhēn",
        "note": "九针之一，锋如黍粟，主按脉。𫔂，即𫔂字。"
      }
    ],
    "9": [
      {
        "term": "铍针",
        "reading": "pī zhēn",
        "note": "九针之一，末如剑锋，以排脓。铍，两刃刀。"
      }
    ],
    "11": [
      {
        "term": "毫针",
        "note": "九针之一，尖细如毫，后世针灸常用之针。"
      }
    ],
    "16": [
      {
        "term": "黍粟",
        "reading": "shǔ sù",
        "note": "黍米与粟米，喻针锋之细小。"
      }
    ],
    "17": [
      {
        "term": "三隅",
        "reading": "sān yú",
        "note": "三棱。隅，棱角。锋针刃作三棱。"
      },
      {
        "term": "痼疾",
        "reading": "gù jí",
        "note": "久治不愈之顽疾。痼，病久难治。"
      }
    ],
    "19": [
      {
        "term": "牦",
        "reading": "máo",
        "note": "牦牛尾之长毛，喻员利针粗细之状。"
      }
    ],
    "20": [
      {
        "term": "嘘虞喙",
        "note": "嘘虞即蚊虻;喙，虫口。喻针尖之细。"
      },
      {
        "term": "痛痹",
        "note": "痹证之一，以疼痛为征。痹，经气闭阻。"
      }
    ],
    "22": [
      {
        "term": "挺",
        "reading": "tǐng",
        "note": "杖梃、挺杖，喻大针之状。"
      },
      {
        "term": "机关",
        "note": "指关节;此谓关节间积水。"
      }
    ],
    "24": [
      {
        "term": "恇",
        "reading": "kuāng",
        "note": "怯弱、虚怯。误针夺气则人怯弱。"
      },
      {
        "term": "苍天",
        "note": "苍青之天。喻气至见效之明朗。"
      }
    ],
    "26": [
      {
        "term": "所溜为荥",
        "reading": "yíng",
        "note": "溜同流;荥，五输穴之一，喻经气微流。"
      },
      {
        "term": "二十七气",
        "note": "十二经脉、十五络脉相合之数，谓经络之气。"
      },
      {
        "term": "三百六十五会",
        "note": "周身骨节交会之数，应一岁之日数。"
      }
    ],
    "28": [
      {
        "term": "重竭",
        "reading": "chóng jié",
        "note": "内气已绝又泻其外，重复耗竭。重，再。"
      },
      {
        "term": "膺",
        "reading": "yīng",
        "note": "胸前两旁之肉。腋与膺为取穴部位。"
      }
    ],
    "29": [
      {
        "term": "逆厥",
        "note": "气逆而厥。厥，气血逆乱、四末不温之证。"
      },
      {
        "term": "四末",
        "note": "四肢之末端。末，梢。"
      },
      {
        "term": "痈疡",
        "reading": "yōng yáng",
        "note": "痈肿疮疡。痈，气血壅滞所成之肿。"
      }
    ],
    "30": [
      {
        "term": "十二原",
        "note": "五脏六腑之原穴，共十二，为脏腑之气所出。"
      },
      {
        "term": "四关",
        "note": "旧注指两肘两膝，或指两腕两踝之关节。"
      }
    ],
    "31": [
      {
        "term": "太渊",
        "note": "肺之原穴，在腕后陷中。渊，深处。"
      },
      {
        "term": "阳中之少阴",
        "note": "以阴阳部位定脏属，肺居膈上属阳而性属阴。"
      }
    ],
    "32": [
      {
        "term": "大陵",
        "note": "原文以为心之原穴，在掌后腕中。"
      }
    ],
    "33": [
      {
        "term": "太冲",
        "note": "肝之原穴，在足背。冲，要道。"
      }
    ],
    "34": [
      {
        "term": "太白",
        "note": "脾之原穴，在足内侧。"
      },
      {
        "term": "至阴",
        "note": "阴之极。脾属土，居至阴之位。"
      }
    ],
    "35": [
      {
        "term": "太谿",
        "reading": "tài xī",
        "note": "肾之原穴，在足内踝后。谿，山间水道。"
      }
    ],
    "36": [
      {
        "term": "膏",
        "reading": "gāo",
        "note": "旧注指心下脂膏之处，与肓相对。"
      },
      {
        "term": "鸠尾",
        "reading": "jiū wěi",
        "note": "穴名，在胸骨剑突下，形如鸠鸟之尾。"
      }
    ],
    "37": [
      {
        "term": "肓",
        "reading": "huāng",
        "note": "旧注指膈上腔膜之处。肓膏为膏肓之分。"
      },
      {
        "term": "脖胦",
        "reading": "bó yāng",
        "note": "穴名，即气海，在脐下。胦，脐。"
      }
    ],
    "38": [
      {
        "term": "三阳",
        "note": "太阳、阳明、少阳之合称，此指阳经。"
      },
      {
        "term": "飧泄",
        "reading": "sūn xiè",
        "note": "完谷不化之泄泻。飧，水浇饭，喻食物不化。"
      }
    ],
    "39": [
      {
        "term": "譬犹",
        "note": "譬如、好比。设喻之辞。"
      }
    ],
    "41": [
      {
        "term": "雪",
        "note": "洗涤、洗去。雪污，犹言洗净污垢。"
      }
    ],
    "44": [
      {
        "term": "未得其术",
        "note": "未掌握针刺之术。术，技法。"
      }
    ],
    "45": [
      {
        "term": "探汤",
        "note": "以手试热水，喻刺热证手法之疾速。汤，热水。"
      }
    ],
    "47": [
      {
        "term": "下陵三里",
        "note": "即足三里穴，在膝下。下陵为其旧称。"
      },
      {
        "term": "殆",
        "reading": "dài",
        "note": "危险。正往无殆，谓直刺而无危殆。"
      }
    ],
    "48": [
      {
        "term": "阴之陵泉",
        "note": "即阴陵泉穴，在膝内侧。"
      }
    ],
    "49": [
      {
        "term": "阳之陵泉",
        "note": "即阳陵泉穴，在膝外侧。"
      }
    ]
  },
  "2": {
    "0": [
      {
