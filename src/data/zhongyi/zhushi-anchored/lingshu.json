      },
      {
        "term": "如环无端",
        "note": "喻气血循行周而复始,无起无止。"
      },
      {
        "term": "阳陇",
        "reading": "yáng lóng",
        "note": "陇通隆,阳气隆盛之意。"
      },
      {
        "term": "合阴",
        "note": "夜半营卫大会、阴气合聚之时。"
      }
    ],
    "3": [
      {
        "term": "气道涩",
