      },
      {
        "term": "卫气内伐",
        "note": "伐谓侵扰,卫气不外护而内扰。"
      },
      {
        "term": "昼精",
        "note": "精谓精神振作,白天精力充沛。"
      }
    ],
    "5": [
      {
        "term": "中焦",
        "note": "三焦之一,旧说主腐熟水谷、化生营血。"
      },
      {
        "term": "下焦",
        "note": "三焦之一,旧说主分别清浊、渗利二便。"
      }
    ],
    "7": [
      {
        "term": "上焦",
        "note": "三焦之一,旧说主宣发布散,如雾露之溉。"
      },
      {
        "term": "贯膈",
        "note": "膈即膈膜,贯穿胸腹之间的膜。"
      },
      {
        "term": "太阴之分",
        "note": "指手太阴肺经所主的部位。"
      }
    ],
    "9": [
      {
        "term": "腠理",
        "reading": "còu lǐ",
        "note": "皮肤肌肉的纹理与间隙。"
      },
      {
        "term": "慓悍滑疾",
        "reading": "piāo hàn huá jí",
        "note": "形容卫气剽疾迅猛、滑利急速。"
      },
      {
        "term": "漏泄",
