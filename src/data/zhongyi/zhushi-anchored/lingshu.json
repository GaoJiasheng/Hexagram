      }
    ],
    "18": [
      {
        "term": "悗乱",
        "reading": "mèn luàn",
        "note": "悗同闷;烦闷昏乱之状。"
      },
      {
        "term": "四支",
        "note": "支同肢;四肢。"
      }
    ],
    "19": [
      {
        "term": "狂忘",
        "note": "忘同妄;狂乱妄为,一说健忘。"
      },
      {
        "term": "阴缩",
        "note": "前阴内缩;肝主筋,筋急故缩。"
      },
      {
        "term": "两恢骨",
        "note": "恢乃胠之讹;胠指胁肋部。"
      }
    ],
    "20": [
      {
        "term": "皮革焦",
        "note": "革,皮也;肺主皮毛,魄伤故皮枯焦。"
      }
    ],
    "21": [
      {
        "term": "俛仰",
        "reading": "fǔ yǎng",
        "note": "俛同俯;低头与仰头,谓俯仰之动。"
      },
      {
        "term": "季夏",
        "note": "夏季之末月,长夏,五行属土应脾。"
      }
    ],
    "22": [
      {
        "term": "骨酸痿厥",
        "reading": "wěi jué",
        "note": "痿,肢体痿弱;厥,逆冷;骨节酸软之状。"
      }
    ],
    "23": [
      {
        "term": "存亡",
        "note": "存与亡,谓精神魂魄之尚在与已失。"
      }
    ],
    "25": [
      {
        "term": "荣",
        "note": "荣同营,营气;脾化生营气以养身。"
      },
      {
        "term": "经溲不利",
        "reading": "jīng sōu",
        "note": "经,谓二便之经;溲,小便;二便不通利。"
      }
    ],
    "27": [
      {
        "term": "喘喝",
        "reading": "chuǎn hè",
        "note": "喝,喘息有声;气逆喘鸣。"
      },
      {
        "term": "仰息",
        "note": "仰头而呼吸,胸满气促之状。"
      }
    ],
    "28": [
      {
        "term": "厥",
        "reading": "jué",
        "note": "气逆而手足逆冷。"
      }
    ]
  },
  "3": {
