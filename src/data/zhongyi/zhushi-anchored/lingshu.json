      },
      {
        "term": "气悍以清",
        "note": "悍谓剽疾,谓酒气剽疾而轻清。"
      }
    ],
    "18": [
      {
        "term": "如沤",
        "reading": "rú ōu",
        "note": "沤谓水中浸渍,喻中焦腐熟之象。"
      },
      {
        "term": "如渎",
        "reading": "rú dú",
        "note": "渎谓沟渠,喻下焦渗利下泄之象。"
      }
    ]
  },
  "4": {
