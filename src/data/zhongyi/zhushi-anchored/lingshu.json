        "note": "恩德惠泽向下流布。"
      }
    ],
    "1": [
      {
        "term": "远乎哉问也",
        "note": "赞其所问深远。倒装感叹句。"
      },
      {
        "term": "逆而能治",
        "note": "逆,违逆事理。谓违逆而能治者未有。"
      }
    ],
    "3": [
      {
        "term": "入家问讳",
        "reading": "huì",
        "note": "讳,所避忌之名、事。先问其避讳。"
      },
      {
        "term": "临病人问所便",
        "reading": "biàn",
        "note": "便,适宜、相宜。问其所宜。"
      }
    ],
    "5": [
      {
        "term": "消瘅",
        "reading": "xiāo dān",
        "note": "古病名,以内热多饮多食消瘦为候。"
      },
      {
        "term": "悬心善饥",
        "note": "悬心,心下空悬如悬。善饥,易饥。"
      },
      {
        "term": "出黄如糜",
        "reading": "mí",
        "note": "糜,稀粥。谓所下黄而稀烂。"
      },
      {
        "term": "飧泄",
        "reading": "sūn xiè",
        "note": "完谷不化的泄泻。飧,水浇饭。"
      }
    ],
    "6": [
      {
        "term": "血食之君",
        "note": "享用肉食祭飨之贵君,指王公大人。"
      },
      {
        "term": "骄恣从欲",
        "reading": "zì",
        "note": "恣,放纵;从,通纵。骄横纵欲。"
      }
    ],
    "7": [
      {
        "term": "莫不恶死而乐生",
        "reading": "wù",
        "note": "恶,厌恶。无人不厌死乐生。"
      },
      {
        "term": "无道之人",
        "note": "不循事理、不讲道义之人。"
      }
    ],
    "9": [
      {
        "term": "先治其标",
        "note": "标,枝末、后生之证。与本相对。"
      },
      {
        "term": "后治其本",
        "note": "本,根本、先病之处。"
      }
    ],
    "11": [
      {
        "term": "凄怆",
        "reading": "qī chuàng",
        "note": "寒冷刺骨、凄寒之貌。"
      },
      {
        "term": "灼灼",
        "reading": "zhuó",
        "note": "炽热灼烫貌。"
      },
      {
        "term": "沧沧",
        "reading": "cāng",
        "note": "寒冷貌。"
      },
      {
        "term": "邪僻",
        "reading": "pì",
        "note": "偏邪不正之气,泛指致病外邪。"
      }
    ],
    "12": [
      {
        "term": "本藏",
        "reading": "zàng",
        "note": "《灵枢·本藏》篇名,论脏腑形候。"
      },
      {
        "term": "镰肉",
        "reading": "jùn",
        "note": "镰当作䐃,肌肉隆起结聚处。"
      },
      {
        "term": "扪循",
        "reading": "mén xún",
        "note": "抚摸触按。扪,按;循,顺摩。"
      }
    ],
    "13": [
      {
        "term": "藏府之盖",
        "note": "盖,覆盖、外表。谓身形为脏腑之外候。"
      },
      {
        "term": "面部之阅",
        "note": "阅,察看、检视。"
      }
    ],
    "14": [
      {
        "term": "阅于面者",
        "note": "阅,显现、可察见。谓气色见于面。"
      }
    ],
    "15": [
      {
        "term": "肺为之盖",
        "note": "肺位最高覆诸脏,故称华盖。"
      },
      {
        "term": "巨肩陷",
        "note": "肩高大而胸廓内陷之形。"
      }
    ],
    "17": [
      {
        "term": "缺盆",
        "note": "穴名兼部位,锁骨上窝处。"
      },
      {
        "term": "艶骨",
        "note": "艶当作𩩲骬,胸骨下端蔽骨(剑突)。"
      },
      {
        "term": "颕奣",
        "note": "讹字,当作心气强弱之候。"
      }
    ],
    "19": [
      {
        "term": "主为将",
        "note": "肝在脏象配将军之官,主谋虑。"
      },
      {
        "term": "使之候外",
        "note": "候,察候、外应。谓肝外应于目。"
      }
    ],
    "21": [
      {
        "term": "主为卫",
        "note": "脾主运化输布,如卫护之职。"
      },
      {
        "term": "迎粮",
        "note": "迎,接纳;粮,水谷。谓脾纳运水谷。"
      }
    ],
    "23": [
      {
        "term": "主为外",
        "note": "肾外应于耳,主听。"
      },
      {
        "term": "远听",
        "note": "谓耳能远闻,为肾之外候。"
      }
    ],
    "25": [
      {
        "term": "胃为之海",
        "note": "胃受纳水谷,为水谷之海。"
      },
      {
        "term": "广骸大颈",
        "reading": "hái",
        "note": "骸,骨骼。形容骨大颈粗之相。"
      },
      {
        "term": "鼻隧",
        "reading": "suì",
        "note": "隧,通道。指鼻孔之道。"
      },
      {
        "term": "目下果",
        "reading": "guǒ",
        "note": "果通裹,目下卧蚕、下睑隆起处。"
      }
