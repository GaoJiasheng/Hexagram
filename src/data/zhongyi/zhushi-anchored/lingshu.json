      }
    ],
    "6": [
      {
        "term": "任物",
        "note": "任,担当、应接;谓心能应接外物。"
      }
    ],
    "9": [
      {
        "term": "存变",
        "note": "存,思量存想;反复推度事之变化。"
      }
    ],
    "10": [
      {
        "term": "远慕",
        "note": "慕,追慕推求;向远深处推想谋虑。"
      }
    ],
    "12": [
      {
        "term": "长生久视",
        "note": "久视,长久存活;视犹活,《老子》语。"
      },
      {
        "term": "怵惕",
        "reading": "chù tì",
        "note": "惊惧戒惧之貌。"
      },
      {
        "term": "僻邪",
        "reading": "pì xié",
        "note": "僻,不正;指偏邪之气,旧注亦作邪僻。"
      },
      {
        "term": "流淫",
        "note": "淫,渗泄;精气流泄不止。"
      }
    ],
    "13": [
      {
        "term": "惮散",
        "reading": "dàn sàn",
        "note": "惮,惊动;神受惊而散逸不藏。"
      }
    ],
    "14": [
      {
        "term": "气闭寒",
