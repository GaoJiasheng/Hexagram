      }
    ],
    "15": [
      {
        "term": "回肠",
        "note": "古指大肠盘曲之处。"
      },
      {
        "term": "济泌别汁",
        "note": "济泌谓渗滤,分别水谷清浊之汁。"
      }
    ],
    "17": [
      {
