  "rounds": [
    {
      "phase": "立义",
      "turns": [
        {
          "school": "ganying",
          "rebut": null,
          "point": "劝善之书开篇即立此义:祸福无门,惟人自召——把祸福之柄从外面收回到人自身。",
          "cite": {
            "corpus": "dao",
            "slug": "ganyingpian",
            "ch": 1,
            "quote": "祸福无门，惟人自召",
            "label": "太上感应篇"
          }
        },
        {
          "school": "laozi",
          "rebut": null,
          "point": "天地不仁,以万物为刍狗。天地无所偏私,亦不为谁另设一册赏罚之案。",
          "cite": {
            "corpus": "dao",
            "slug": "daodejing",
            "ch": 5,
            "quote": "天地不仁，以万物为刍狗",
            "label": "道德经·五章"
          }
        },
        {
          "school": "zhuang",
          "rebut": null,
          "point": "死生命也,其有夜旦之常,天也。人之有所不得与,则追问祸福所自来,已是多事。",
          "cite": {
            "corpus": "dao",
            "slug": "zhuangzi-neipian",
            "ch": 6,
            "quote": "死生，命也；其有夜旦之常，天也",
            "label": "庄子·大宗师"
          }
        }
      ]
    },
    {
      "phase": "刍狗之问",
      "turns": [
        {
          "school": "laozi",
          "rebut": "ganying",
          "point": "若一一有神司过、有算可夺,则天成了执簿之吏。天之道不召而自来,原无须此。",
          "cite": {
            "corpus": "dao",
            "slug": "daodejing",
            "ch": 73,
            "quote": "不争而善胜，不言而善应，不召而自来",
            "label": "道德经·七十三章"
          }
        },
        {
          "school": "ganying",
          "rebut": "laozi",
          "point": "老氏亦言天道无亲、常与善人。劝善之书不过把这一句说得极详,使常人有所畏惮。",
          "cite": {
            "corpus": "dao",
            "slug": "daodejing",
            "ch": 79,
            "quote": "天道无亲，常与善人",
            "label": "道德经·七十九章"
          }
        }
      ]
    },
    {
      "phase": "安命",
      "turns": [
        {
          "school": "zhuang",
          "rebut": "ganying",
          "point": "安时而处顺,哀乐不能入。若终日校计善恶之报,心先为祸福所系,已自不得安。",
          "cite": {
            "corpus": "dao",
            "slug": "zhuangzi-neipian",
            "ch": 3,
            "quote": "安时而处顺，哀乐不能入也",
            "label": "庄子·养生主"
          }
        },
        {
          "school": "ganying",
          "rebut": "zhuang",
          "point": "篇中所重,原在心起于善则吉神已随、恶念未行而凶神已随——说的是心念,不是账簿。",
          "cite": {
            "corpus": "dao",
            "slug": "ganyingpian",
            "ch": 1,
            "quote": "夫心起于善，善虽未为，而吉神已随之",
            "label": "太上感应篇"
          }
        },
        {
          "school": "laozi",
          "rebut": "zhuang",
          "point": "安命固是。然天网恢恢、疏而不失,亦非说无理可循,只是其理不作人情之赏罚。",
          "cite": {
            "corpus": "dao",
            "slug": "daodejing",
            "ch": 73,
            "quote": "天网恢恢，疏而不失",
            "label": "道德经·七十三章"
          }
        }
      ]
    },
    {
      "phase": "劝善之旨",
      "turns": [
        {
          "school": "ganying",
          "rebut": "laozi",
          "point": "是道则进,非道则退。所举善恶条目,意在使人日省其行,不在许人以何种结果。",
          "cite": {
            "corpus": "dao",
            "slug": "ganyingpian",
            "ch": 1,
            "quote": "是道则进，非道则退",
            "label": "太上感应篇"
          }
        },
        {
          "school": "zhuang",
          "rebut": "laozi",
          "point": "天网之说亦是言。天与人不相胜也,是之谓真人;既不相胜,更不须问网之疏密。",
          "cite": {
            "corpus": "dao",
            "slug": "zhuangzi-neipian",
            "ch": 6,
            "quote": "天与人不相胜也，是之谓真人",
            "label": "庄子·大宗师"
          }
        }
      ]
    },
    {
      "phase": "析辞",
      "turns": [
        {
          "school": "laozi",
          "rebut": null,
          "point": "飘风不终朝,骤雨不终日;天地尚不能久,而况于人?此是观势之言,不是许诺。",
          "cite": {
            "corpus": "dao",
            "slug": "daodejing",
            "ch": 23,
            "quote": "飘风不终朝，骤雨不终日",
            "label": "道德经·二十三章"
          }
        },
        {
          "school": "ganying",
          "rebut": null,
          "point": "后人读之,当知此为劝善之教:诸恶莫作,众善奉行——句意在劝,不在断人祸福。",
          "cite": {
            "corpus": "dao",
            "slug": "ganyingpian",
            "ch": 1,
            "quote": "诸恶莫作，众善奉行",
            "label": "太上感应篇"
          }
        },
        {
          "school": "zhuang",
          "rebut": null,
          "point": "知其不可奈何而安之若命。三说同出道门而不同调,原可各行其是。",
          "cite": {
            "corpus": "dao",
            "slug": "zhuangzi-neipian",
            "ch": 4,
            "quote": "知其不可奈何而安之若命",
            "label": "庄子·人间世"
