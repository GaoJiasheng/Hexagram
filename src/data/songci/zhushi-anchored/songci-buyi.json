{
  "1": {
    "0": [
      {
        "term": "大江东去",
        "note": "《念奴娇》是调名，与内容无关（相传得名唐天宝歌妓念奴）；「赤壁怀古」是词题"
      },
      {
        "term": "浪淘尽",
        "note": "洪迈《容斋续笔》记所见黄庭坚手书本此作「浪声沈」"
      },
      {
        "term": "风流人物",
        "note": "杰出而有风采的人物；非今语「风流」之义"
      }
    ],
    "1": [
      {
        "term": "故垒",
        "note": "旧时的营垒。垒，军营的壁墙"
      },
      {
        "term": "人道是",
        "note": "人们说是。苏轼所游为黄州赤鼻矶，非三国赤壁战地，故用存疑的口气"
      },
      {
        "term": "三国",
        "note": "洪迈记黄庭坚手书本此二字作「孙吴」，即「孙吴赤壁」"
      },
      {
        "term": "周郎",
        "note": "周瑜。少有美名，吴中皆呼周郎。赤壁之战时为东吴都督"
      }
    ],
    "2": [
      {
        "term": "乱石穿空",
        "note": "洪迈记黄庭坚手书本作「乱石崩云」"
      },
      {
        "term": "惊涛拍岸",
        "note": "洪迈记黄本作「惊涛掠岸」；此二句今传诸本异文最多"
      },
      {
        "term": "千堆雪",
        "note": "以雪喻浪花，非实指雪"
      }
    ],
    "3": [
      {
        "term": "一时",
        "note": "指一个时期之内，此谓三国之世"
      }
    ],
    "4": [
      {
        "term": "公瑾",
        "note": "周瑜的字。宋人称古人多举其字"
      },
      {
        "term": "小乔",
        "note": "乔公次女，周瑜之妻。《三国志》字作「桥」"
      },
      {
        "term": "初嫁了",
        "note": "史载小乔之嫁在赤壁战前多年，此言「初嫁」是词家取其近"
      },
      {
        "term": "雄姿英发",
        "note": "《词综》主张「了」字属下句，作「了雄姿英发」；今多从「初嫁了」断"
      }
    ],
    "5": [
      {
        "term": "羽扇纶巾",
        "note": "纶读 guān。羽扇与青丝巾，六朝以来以为儒将之服"
      },
      {
        "term": "谈笑处",
        "note": "本站正文作「谈笑处」，今人通行本作「谈笑间」，出《词综》一路"
      },
      {
        "term": "樯𫇛",
        "note": "𫇛为「橹」的异体，本站底本用字；今通行作「樯橹」。樯，桅杆"
      }
    ],
    "6": [
      {
        "term": "故国",
        "note": "旧时的地方，此指赤壁旧战地，非谓故乡或故都"
      },
      {
        "term": "多情应笑我",
        "note": "洪迈记黄庭坚手书本作「多情应是、笑我生华发」，句读迥异"
      },
      {
        "term": "华发",
        "note": "华读 huā，花白。华发即斑白的头发"
      }
    ],
    "7": [
      {
        "term": "人间如梦",
        "note": "本站作「人间」，今人多作「人生如梦」；洪迈记黄本作「人生如寄」"
      },
      {
        "term": "一尊",
        "note": "尊同樽，酒杯。此二字亦有本作「一樽」"
      },
      {
        "term": "酹",
        "note": "读 lèi，以酒浇地祭奠"
      }
    ]
  },
  "2": {
    "0": [
      {
        "term": "红酥手",
        "note": "《钗头凤》是调名，与内容无关。红酥，红润细腻，状手；一说指点心，非通行"
      },
      {
        "term": "黄縢酒",
        "note": "縢读 téng，封缄。宋时官酒以黄纸封口，故称黄縢酒"
      },
      {
        "term": "宫墙柳",
        "note": "旧说绍兴有宋室行宫，故城中有宫墙；一说泛指官家园墙"
      }
    ],
    "1": [
      {
        "term": "东风恶",
        "note": "恶，猛烈狠戾。东风即春风，此处兼取其摧花之意"
      },
      {
        "term": "离索",
        "note": "离群索居。语本《礼记·檀弓》「吾离群而索居」"
      },
      {
        "term": "错！错！错！",
        "note": "末三字叠句是《钗头凤》的定格，非临时叠用；下片作「莫！莫！莫！」"
      }
    ],
    "2": [
      {
        "term": "人空瘦",
        "note": "空，徒然、白白地"
      },
      {
        "term": "浥",
        "note": "读 yì，沾湿。红指泪痕中和着的胭脂"
      },
      {
        "term": "鲛绡",
        "note": "传说鲛人所织的薄纱，诗词中多指手帕"
      }
    ],
    "3": [
      {
        "term": "闲池阁",
        "note": "池阁空闲着，谓无人再来"
      },
      {
        "term": "山盟",
        "note": "以山川为喻的盟誓，谓其不改"
      },
      {
        "term": "锦书",
        "note": "书信。用前秦苏蕙织锦为回文诗寄夫窦滔事"
      },
      {
        "term": "莫！莫！莫！",
        "note": "犹言罢了、算了。宋人口语"
      }
    ]
  }
}
