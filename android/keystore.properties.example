# 复制为 android/keystore.properties 并填好(该文件已 gitignore,绝不会进仓库)。
# 生成密钥:
#   keytool -genkeypair -v -keystore ~/hexa-release.keystore \
#     -alias hexa -keyalg RSA -keysize 2048 -validity 10000
#
# ⚠️ keystore 丢了不可恢复 —— 备份到本机之外,口令与文件分开存。
storeFile=/绝对路径/hexa-release.keystore
storePassword=
keyAlias=hexa
keyPassword=
