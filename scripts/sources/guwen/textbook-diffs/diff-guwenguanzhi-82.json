 "paragraphStarts": [
  "屈原者，名平，楚",
  "上官大夫与之同列",
  "屈平疾王听之不聪",
  "屈平既绌，其后秦",
  "明年，秦割汉中地",
  "其后诸侯共击楚，",
  "时秦昭王与楚婚，",
  "长子顷襄王立，以",
  "令尹子兰闻之，大",
  "屈原至于江滨，被",
  "屈原既死之后，楚",
  "太史公曰：“余读"
 ],
