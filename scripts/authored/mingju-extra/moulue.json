[
 {
  "q": "栖守道德者，寂寞一时；依附权势者，凄凉万古。",
  "label": "菜根谭",
  "corpus": "moulue",
  "slug": "caigentan",
  "ch": 1,
  "seg": 1
 },
 {
  "q": "天地寂然不动，而气机无一息少停",
  "label": "菜根谭",
  "corpus": "moulue",
  "slug": "caigentan",
  "ch": 1,
  "seg": 8
 },
 {
  "q": "夜深人静，独坐观心，始觉妄穷而真独露",
  "label": "菜根谭",
  "corpus": "moulue",
  "slug": "caigentan",
  "ch": 1,
  "seg": 9
 },
 {
  "q": "盖世功劳，当不得一个矜字；弥天罪过，当不得一个悔字。",
  "label": "菜根谭",
  "corpus": "moulue",
  "slug": "caigentan",
  "ch": 1,
  "seg": 18
 },
 {
  "q": "家庭有个真佛，日用有种真道。",
  "label": "菜根谭",
  "corpus": "moulue",
  "slug": "caigentan",
  "ch": 1,
  "seg": 21
 },
 {
  "q": "处世不必邀功，无过便是功；与人不求感德，无怨便是德。",
  "label": "菜根谭",
  "corpus": "moulue",
  "slug": "caigentan",
  "ch": 1,
  "seg": 28
 },
 {
  "q": "钓水逸事也、尚持生杀之柄。奕棋清戏也、且动战争之心。",
  "label": "菜根谭",
  "corpus": "moulue",
  "slug": "caigentan",
  "ch": 2,
  "seg": 2
 },
 {
  "q": "趋炎附势之祸、甚惨亦甚速。栖恬守逸之味、最淡亦最长。",
  "label": "菜根谭",
  "corpus": "moulue",
  "slug": "caigentan",
  "ch": 2,
  "seg": 21
 },
 {
  "q": "人生原是一傀儡。只要根蒂在手。",
  "label": "菜根谭",
  "corpus": "moulue",
  "slug": "caigentan",
  "ch": 2,
  "seg": 127
 },
 {
  "q": "人生减省一分、便超脱一分。",
  "label": "菜根谭",
  "corpus": "moulue",
  "slug": "caigentan",
  "ch": 2,
  "seg": 131
 },
 {
  "q": "博学笃志，切问近思，此八字，是收放心的工夫",
  "label": "围炉夜话",
  "corpus": "moulue",
  "slug": "weiluyehua",
  "ch": 1,
  "seg": 2
 },
 {
  "q": "神闲气静，智深勇沉，此八字，是干大事的本领",
  "label": "围炉夜话",
  "corpus": "moulue",
  "slug": "weiluyehua",
  "ch": 1,
  "seg": 3
 },
 {
  "q": "不必于世事件件皆能，惟求与古人心心相印",
  "label": "围炉夜话",
  "corpus": "moulue",
  "slug": "weiluyehua",
  "ch": 1,
  "seg": 9
 },
 {
  "q": "贫贱非辱，贫贱而谄求于人者为辱",
  "label": "围炉夜话",
  "corpus": "moulue",
  "slug": "weiluyehua",
  "ch": 1,
  "seg": 17
 },
 {
  "q": "富贵非荣，富贵而利济于世者为荣",
  "label": "围炉夜话",
  "corpus": "moulue",
  "slug": "weiluyehua",
  "ch": 1,
  "seg": 18
 },
 {
  "q": "打算精明，自谓得计，然败祖父之家声者，必此人也",
  "label": "围炉夜话",
  "corpus": "moulue",
  "slug": "weiluyehua",
  "ch": 1,
  "seg": 54
 },
 {
  "q": "朴实浑厚，初无甚奇，然培子孙之元气者，必此人也",
  "label": "围炉夜话",
  "corpus": "moulue",
  "slug": "weiluyehua",
  "ch": 1,
  "seg": 55
 },
 {
  "q": "须使人不忍欺我，勿使人不敢欺我",
  "label": "围炉夜话",
  "corpus": "moulue",
  "slug": "weiluyehua",
  "ch": 1,
  "seg": 62
 },
 {
  "q": "敬他人，即是敬自己。靠自己，胜于靠他人",
  "label": "围炉夜话",
  "corpus": "moulue",
  "slug": "weiluyehua",
  "ch": 1,
  "seg": 160
 },
 {
  "q": "教子弟求显荣，不如教子弟立品行",
  "label": "围炉夜话",
  "corpus": "moulue",
  "slug": "weiluyehua",
  "ch": 1,
  "seg": 169
 },
 {
  "q": "伏久者，飞必高；开先者，谢独早。",
  "label": "小窗幽记",
  "corpus": "moulue",
  "slug": "xiaochuangyouji",
  "ch": 1,
  "seg": 36
 },
 {
  "q": "理之所必无，安知非情之所或有？",
  "label": "小窗幽记",
  "corpus": "moulue",
  "slug": "xiaochuangyouji",
  "ch": 2,
  "seg": 1
 },
 {
  "q": "枕边梦去心亦去，醒后梦还心不还",
  "label": "小窗幽记",
  "corpus": "moulue",
  "slug": "xiaochuangyouji",
  "ch": 2,
  "seg": 12
 },
 {
  "q": "宁为真士夫，不为假道学",
  "label": "小窗幽记",
  "corpus": "moulue",
  "slug": "xiaochuangyouji",
  "ch": 3,
  "seg": 8
 },
 {
  "q": "士人有百折不回之真心，才有万变不穷之妙用",
  "label": "小窗幽记",
  "corpus": "moulue",
  "slug": "xiaochuangyouji",
  "ch": 3,
  "seg": 30
 },
 {
  "q": "宇宙内事，要力担当，又要善摆脱",
  "label": "小窗幽记",
  "corpus": "moulue",
  "slug": "xiaochuangyouji",
  "ch": 3,
  "seg": 37
 },
 {
  "q": "事遇快意处当转，言遇快意处当住。",
  "label": "小窗幽记",
  "corpus": "moulue",
  "slug": "xiaochuangyouji",
  "ch": 4,
  "seg": 2
 },
 {
  "q": "闭门即是深山，读书随处净土。",
  "label": "小窗幽记",
  "corpus": "moulue",
  "slug": "xiaochuangyouji",
  "ch": 4,
  "seg": 71
 },
 {
  "q": "凡名易居，只有清名难居；凡福易享，只有清福难享。",
  "label": "小窗幽记",
  "corpus": "moulue",
  "slug": "xiaochuangyouji",
  "ch": 4,
  "seg": 142
 },
 {
  "q": "松间明月，槛外青山，未常拒人，而人人自拒者何哉？",
  "label": "小窗幽记",
  "corpus": "moulue",
  "slug": "xiaochuangyouji",
  "ch": 5,
  "seg": 0
 },
 {
  "q": "逢人不说人间事，便是人间无事人。",
  "label": "小窗幽记",
  "corpus": "moulue",
  "slug": "xiaochuangyouji",
  "ch": 5,
  "seg": 96
 },
 {
  "q": "山居有四法：树无行次，石无位置，屋无宏肆，心无机事。",
  "label": "小窗幽记",
  "corpus": "moulue",
  "slug": "xiaochuangyouji",
  "ch": 6,
  "seg": 53
 },
 {
  "q": "支笻散步，觉数十年尘土肺肠，俱为洗净。",
  "label": "小窗幽记",
  "corpus": "moulue",
  "slug": "xiaochuangyouji",
  "ch": 6,
  "seg": 47
 },
 {
  "q": "填不满贪海，攻不破疑城。",
  "label": "小窗幽记",
  "corpus": "moulue",
  "slug": "xiaochuangyouji",
  "ch": 7,
  "seg": 18
 },
 {
  "q": "山以虚而受，水以实而流，读书当作如是观。",
  "label": "小窗幽记",
  "corpus": "moulue",
  "slug": "xiaochuangyouji",
  "ch": 7,
  "seg": 91
 },
 {
  "q": "观山水亦如读书，随其见趣高下。",
  "label": "小窗幽记",
  "corpus": "moulue",
  "slug": "xiaochuangyouji",
  "ch": 7,
  "seg": 75
 },
 {
  "q": "一段世情，全凭冷眼觑破；几番幽趣，半从热肠换来。",
  "label": "小窗幽记",
  "corpus": "moulue",
  "slug": "xiaochuangyouji",
  "ch": 8,
  "seg": 21
 },
 {
  "q": "千载奇逢，无如好书良友；一生清福，只在茗碗炉烟。",
  "label": "小窗幽记",
  "corpus": "moulue",
  "slug": "xiaochuangyouji",
  "ch": 8,
  "seg": 40
 },
 {
  "q": "大豪杰，舍己为人，小丈夫，因人利己。",
  "label": "小窗幽记",
  "corpus": "moulue",
  "slug": "xiaochuangyouji",
  "ch": 8,
  "seg": 20
 },
 {
  "q": "花看半开，酒饮微醉。",
  "label": "小窗幽记",
  "corpus": "moulue",
  "slug": "xiaochuangyouji",
  "ch": 9,
  "seg": 17
 },
 {
  "q": "野花艳目，不必牡丹；村酒醉人，何须绿蚁。",
  "label": "小窗幽记",
  "corpus": "moulue",
  "slug": "xiaochuangyouji",
  "ch": 9,
  "seg": 22
 },
 {
  "q": "不恨我不见古人，惟恨古人不见我。",
  "label": "小窗幽记",
  "corpus": "moulue",
  "slug": "xiaochuangyouji",
  "ch": 10,
  "seg": 30
 },
 {
  "q": "敢于世上放开眼，不向人间浪皱眉。",
  "label": "小窗幽记",
  "corpus": "moulue",
  "slug": "xiaochuangyouji",
  "ch": 10,
  "seg": 77
 },
 {
  "q": "才以气雄，品由心定。",
  "label": "小窗幽记",
  "corpus": "moulue",
  "slug": "xiaochuangyouji",
  "ch": 10,
  "seg": 56
 },
 {
  "q": "立身高一步方超达，处世退一步方安乐。",
  "label": "小窗幽记",
  "corpus": "moulue",
  "slug": "xiaochuangyouji",
  "ch": 11,
  "seg": 21
 },
 {
  "q": "人之恩可念不可忘，人之仇可忘不可念。",
  "label": "小窗幽记",
  "corpus": "moulue",
  "slug": "xiaochuangyouji",
  "ch": 11,
  "seg": 74
 },
 {
  "q": "一心可以交万友，二心不可以交一友。",
  "label": "小窗幽记",
  "corpus": "moulue",
  "slug": "xiaochuangyouji",
  "ch": 11,
  "seg": 1
 },
 {
  "q": "纸窗竹屋，夏葛冬裘，饭后黑甜，日中白醉，足矣！",
  "label": "小窗幽记",
  "corpus": "moulue",
  "slug": "xiaochuangyouji",
  "ch": 12,
  "seg": 6
 },
 {
  "q": "鄙吝一消，白云亦可赠客；渣滓尽化，明月亦来照人。",
  "label": "小窗幽记",
  "corpus": "moulue",
  "slug": "xiaochuangyouji",
  "ch": 12,
  "seg": 32
 },
 {
  "q": "匠成舆者，忧人不贵；作箭者，恐人不伤。",
  "label": "长短经·序",
  "corpus": "moulue",
  "slug": "changduanjing",
  "ch": 1,
  "seg": 1
 },
 {
  "q": "三代不同礼，五霸不同法，非其相反，盖以救弊也。",
  "label": "长短经·序",
  "corpus": "moulue",
  "slug": "changduanjing",
  "ch": 1,
  "seg": 2
 },
 {
  "q": "管子曰：「圣人能辅时，不能违时。智者善谋，不如当时。」",
  "label": "长短经·序",
  "corpus": "moulue",
  "slug": "changduanjing",
  "ch": 1,
  "seg": 2
 },
 {
  "q": "亡国之主似智，亡国之臣似忠",
  "label": "长短经·大体第一",
  "corpus": "moulue",
  "slug": "changduanjing",
  "ch": 2,
  "seg": 28
 },
 {
  "q": "帝者与师处，王者与友处，霸者与臣处，亡国与厮役处。",
  "label": "长短经·论士第七",
  "corpus": "moulue",
  "slug": "changduanjing",
  "ch": 2,
  "seg": 126
 },
 {
  "q": "以言信行，失之宰予；以貌度性，失之子羽",
  "label": "长短经·大体第一",
  "corpus": "moulue",
  "slug": "changduanjing",
  "ch": 2,
  "seg": 120
 },
 {
  "q": "理国之本，刑与德也。二者相须而行，相待而成也。",
  "label": "长短经·君德第九",
  "corpus": "moulue",
  "slug": "changduanjing",
  "ch": 3,
  "seg": 11
 },
 {
  "q": "仁莫大于爱人，智莫大于知人。",
  "label": "长短经·君德第九",
  "corpus": "moulue",
  "slug": "changduanjing",
  "ch": 3,
  "seg": 102
 },
 {
  "q": "凡人之道，心欲小，志欲大，智欲圆，行欲方，能欲多，事欲少。",
  "label": "长短经·君德第九",
  "corpus": "moulue",
  "slug": "changduanjing",
  "ch": 3,
  "seg": 203
 },
 {
  "q": "臣闻三代之亡，非法亡也；御法者，非其人矣。",
  "label": "长短经·反经十三",
  "corpus": "moulue",
  "slug": "changduanjing",
  "ch": 4,
  "seg": 2
 },
 {
  "q": "故仁者，所以博施于物，亦所以生偏私。",
  "label": "长短经·反经十三",
  "corpus": "moulue",
  "slug": "changduanjing",
  "ch": 4,
  "seg": 3
 },
 {
  "q": "巧诈不如拙诚。",
  "label": "长短经·反经十三",
  "corpus": "moulue",
  "slug": "changduanjing",
  "ch": 4,
  "seg": 104
 },
 {
  "q": "成康之隆也，刑措四十余年而不用",
  "label": "长短经·霸图十七",
  "corpus": "moulue",
  "slug": "changduanjing",
  "ch": 5,
  "seg": 1
 },
 {
  "q": "虽屈于一人之下，则申于万人之上，唯贤人而后能为之。",
  "label": "长短经·霸图十七",
  "corpus": "moulue",
  "slug": "changduanjing",
  "ch": 5,
  "seg": 1
 },
 {
  "q": "壮士不死则已，死则举大名。侯王将相，宁有种乎？",
  "label": "长短经·霸图十七",
  "corpus": "moulue",
  "slug": "changduanjing",
  "ch": 5,
  "seg": 4
 },
 {
  "q": "古之善制事者，转祸而为福，因败而为功。",
  "label": "长短经·七雄略十八",
  "corpus": "moulue",
  "slug": "changduanjing",
  "ch": 6,
  "seg": 8
 },
 {
  "q": "宁为鸡口，无为牛后。",
  "label": "长短经·七雄略十八",
  "corpus": "moulue",
  "slug": "changduanjing",
  "ch": 6,
  "seg": 17
 },
 {
  "q": "积羽沉舟，群轻折轴，众口铄金。",
  "label": "长短经·七雄略十八",
  "corpus": "moulue",
  "slug": "changduanjing",
  "ch": 6,
  "seg": 28
 },
 {
  "q": "智者之虑，必杂于利害",
  "label": "长短经·三国权十九",
  "corpus": "moulue",
  "slug": "changduanjing",
  "ch": 7,
  "seg": 1
 },
 {
  "q": "地利不如人和，在德不在险",
  "label": "长短经·三国权十九",
  "corpus": "moulue",
  "slug": "changduanjing",
  "ch": 7,
  "seg": 76
 },
 {
  "q": "为国之本，唯道义而已，君若不修德，舟中之人尽敌国也",
  "label": "长短经·三国权十九",
  "corpus": "moulue",
  "slug": "changduanjing",
  "ch": 7,
  "seg": 112
 },
 {
  "q": "利人者，天下启之；害人者，天下闭之。",
  "label": "长短经·惧戒二十",
  "corpus": "moulue",
  "slug": "changduanjing",
  "ch": 8,
  "seg": 2
 },
 {
  "q": "野兽尽而猎狗烹，敌国破而谋臣亡。",
  "label": "长短经·惧戒二十",
  "corpus": "moulue",
  "slug": "changduanjing",
  "ch": 8,
  "seg": 26
 },
 {
  "q": "天下者，非一人之天下也，天下之天下也。",
  "label": "长短经·惧戒二十",
  "corpus": "moulue",
  "slug": "changduanjing",
  "ch": 8,
  "seg": 76
 },
 {
  "q": "夫命之在德，则吉凶祸福不由天也",
  "label": "长短经·运命二九",
  "corpus": "moulue",
  "slug": "changduanjing",
  "ch": 9,
  "seg": 76
 },
 {
  "q": "观物之智，而为反身之察，则能恕而自鉴",
  "label": "长短经·昏智三二",
  "corpus": "moulue",
  "slug": "changduanjing",
  "ch": 9,
  "seg": 97
 },
 {
  "q": "所贵圣人之理者，不贵其独治，贵其能与众共治也。",
  "label": "长短经·卑政三三",
  "corpus": "moulue",
  "slug": "changduanjing",
  "ch": 9,
  "seg": 105
 },
 {
  "q": "是知圣人之用兵也，非好乐之，将以诛暴讨乱。",
  "label": "长短经·出军四一",
  "corpus": "moulue",
  "slug": "changduanjing",
  "ch": 10,
  "seg": 5
 },
 {
  "q": "将不知兵，以其主与敌也；君不择将，以其国与敌也。",
  "label": "长短经·出军四一",
  "corpus": "moulue",
  "slug": "changduanjing",
  "ch": 10,
  "seg": 6
 },
 {
  "q": "然而战胜者，以丧礼处之。将军缟素，请罪于君。",
  "label": "长短经·还师六四",
  "corpus": "moulue",
  "slug": "changduanjing",
  "ch": 10,
  "seg": 213
 }
]