 },
 {
  "q": "室如县罄，野无青草，何恃而不恐？",
  "label": "《左传·展喜犒师》",
  "corpus": "guwen",
  "slug": "guwenguanzhi",
  "ch": 16,
  "seg": 1
 },
 {
  "q": "劳师以袭远，非所闻也。",
  "label": "《左传·蹇叔哭师》",
  "corpus": "guwen",
  "slug": "guwenguanzhi",
  "ch": 18,
  "seg": 0
 },
 {
  "q": "鼎之轻重，未可问也。",
  "label": "《左传·王孙满对楚子》",
  "corpus": "guwen",
  "slug": "guwenguanzhi",
  "ch": 20,
  "seg": 0
 },
 {
  "q": "周德虽衰，天命未改。",
  "label": "《左传·王孙满对楚子》",
  "corpus": "guwen",
  "slug": "guwenguanzhi",
  "ch": 20,
  "seg": 0
 },
 {
  "q": "象有齿以焚其身，贿也。",
  "label": "《左传·子产告范宣子轻币》",
  "corpus": "guwen",
  "slug": "guwenguanzhi",
  "ch": 26,
  "seg": 1
 },
 {
  "q": "宽以济猛，猛以济宽，政是以和。",
  "label": "《左传·子产论政宽猛》",
  "corpus": "guwen",
  "slug": "guwenguanzhi",
  "ch": 33,
  "seg": 2
 },
 {
  "q": "国人莫敢言、道路以目。",
  "label": "《国语·召公谏厉王止谤》",
  "corpus": "guwen",
  "slug": "guwenguanzhi",
  "ch": 36,
  "seg": 0
 },
 {
  "q": "是故为川者决之使导、为民者宣之使言。",
  "label": "《国语·召公谏厉王止谤》",
  "corpus": "guwen",
  "slug": "guwenguanzhi",
  "ch": 36,
  "seg": 0
 },
 {
  "q": "由是观之、生王之头、曾不若死士之垄也。",
  "label": "《战国策·颜斶说齐王》",
  "corpus": "guwen",
  "slug": "guwenguanzhi",
  "ch": 61,
  "seg": 0
 },
 {
  "q": "三窟已就、君姑高枕为乐矣。",
  "label": "《战国策·冯煖客孟尝君》",
  "corpus": "guwen",
  "slug": "guwenguanzhi",
  "ch": 62,
  "seg": 2
 },
 {
  "q": "臣闻善作者不必善成、善始者不必善终。",
  "label": "《战国策·乐毅报燕王书》",
  "corpus": "guwen",
  "slug": "guwenguanzhi",
  "ch": 70,
  "seg": 6
 },
 {
  "q": "是其曲弥高、其和弥寡。",
  "label": "《楚辞·宋玉对楚王问》",
  "corpus": "guwen",
  "slug": "guwenguanzhi",
  "ch": 73,
  "seg": 0
 },
 {
  "q": "夫饥寒并至、而能无为非者寡矣。",
  "label": "西汉文《景帝令二千石修职诏》",
  "corpus": "guwen",
  "slug": "guwenguanzhi",
  "ch": 91,
  "seg": 0
 },
 {
  "q": "盖有非常之功、必待非常之人",
  "label": "西汉文《武帝求茂材异等诏》",
  "corpus": "guwen",
  "slug": "guwenguanzhi",
  "ch": 92,
  "seg": 0
 },
 {
  "q": "请看今日之域中、竟是谁家之天下。",
  "label": "骆宾王《为徐敬业讨武曌檄》",
  "corpus": "guwen",
  "slug": "guwenguanzhi",
  "ch": 112,
  "seg": 1
 },
 {
  "q": "况阳春召我以烟景、大块假我以文章。",
  "label": "李白《春夜宴桃李园序》",
  "corpus": "guwen",
  "slug": "guwenguanzhi",
  "ch": 115,
  "seg": 0
 },
 {
  "q": "是故事修而谤兴、德高而毁来。",
  "label": "韩愈《原毁》",
  "corpus": "guwen",
  "slug": "guwenguanzhi",
  "ch": 120,
  "seg": 2
 },
 {
  "q": "大凡物不得其平则鸣。",
  "label": "韩愈《送孟东野序》",
  "corpus": "guwen",
  "slug": "guwenguanzhi",
  "ch": 134,
  "seg": 0
 },
 {
  "q": "燕赵古称多感慨悲歌之士。",
  "label": "韩愈《送董邵南序》",
  "corpus": "guwen",
  "slug": "guwenguanzhi",
  "ch": 136,
  "seg": 0
 },
 {
  "q": "伯乐一过冀北之野、而马群遂空。",
  "label": "韩愈《送温处士赴河阳军序》",
  "corpus": "guwen",
  "slug": "guwenguanzhi",
  "ch": 139,
  "seg": 0
 },
 {
  "q": "呜呼、士穷乃见节义。",
  "label": "韩愈《柳子厚墓志铭》",
  "corpus": "guwen",
  "slug": "guwenguanzhi",
  "ch": 142,
  "seg": 1
 },
 {
  "q": "信义行于君子、而刑戮施于小人。",
  "label": "欧阳修《纵囚论》",
  "corpus": "guwen",
  "slug": "guwenguanzhi",
  "ch": 163,
  "seg": 0
 },
 {
  "q": "然则非诗之能穷人，殆穷者而后工也。",
  "label": "欧阳修《梅圣俞诗集序》",
  "corpus": "guwen",
  "slug": "guwenguanzhi",
  "ch": 165,
  "seg": 0
 },
 {
  "q": "月晕而风，础润而雨，人人知之。",
  "label": "苏洵《辨奸论》",
  "corpus": "guwen",
  "slug": "guwenguanzhi",
  "ch": 176,
  "seg": 0
 },
 {
  "q": "古者赏不以爵禄，刑不以刀锯。",
  "label": "苏轼《刑赏忠厚之至论》",
  "corpus": "guwen",
  "slug": "guwenguanzhi",
  "ch": 179,
  "seg": 2
 },
 {
  "q": "物之废兴成毁，不可得而知也。",
  "label": "苏轼《凌虚台记》",
  "corpus": "guwen",
  "slug": "guwenguanzhi",
  "ch": 186,
  "seg": 2
 },
 {
  "q": "彼游于物之内，而不游于物之外。",
  "label": "苏轼《超然台记》",
  "corpus": "guwen",
  "slug": "guwenguanzhi",
  "ch": 187,
  "seg": 1
 },
 {
  "q": "秦之有韩、魏，譬如人之有腹心之疾也。",
  "label": "苏辙《六国论》",
  "corpus": "guwen",
  "slug": "guwenguanzhi",
  "ch": 196,
  "seg": 1
 },
 {
  "q": "且夫人之学也，不志其大，虽多而何为？",
  "label": "苏辙《上枢密韩太尉书》",
  "corpus": "guwen",
  "slug": "guwenguanzhi",
  "ch": 197,
  "seg": 2
 },
 {
  "q": "乃工于谋人而拙于谋天也。",
  "label": "方孝孺《深虑论》",
  "corpus": "guwen",
  "slug": "guwenguanzhi",
  "ch": 209,
  "seg": 2
 },
 {
  "q": "忿必争，争必败；骄必傲，傲必亡。",
  "label": "方孝孺《豫让论》",
  "corpus": "guwen",
  "slug": "guwenguanzhi",
  "ch": 210,
  "seg": 2
 },
 {
  "q": "友人惭，下车引之。元方入门不顾。",
  "label": "《世说新语·陈太丘与友期行》",
  "corpus": "guwen",
  "slug": "kewen",
  "ch": 2,
  "seg": 0
 },
 {
  "q": "乃悟前狼假寐，盖以诱敌。",
  "label": "蒲松龄《狼》",
  "corpus": "guwen",
  "slug": "kewen",
  "ch": 4,
  "seg": 0
 },
 {
  "q": "求能之若此，不若无闻也。",
  "label": "《吕氏春秋·穿井得一人》",
  "corpus": "guwen",
  "slug": "kewen",
  "ch": 5,
  "seg": 0
 },
 {
  "q": "青树翠蔓，蒙络摇缀，参差披拂。",
  "label": "柳宗元《小石潭记》",
  "corpus": "guwen",
  "slug": "kewen",
  "ch": 14,
  "seg": 0
 },
 {
  "q": "潭中鱼可百许头，皆若空游无所依。",
  "label": "柳宗元《小石潭记》",
  "corpus": "guwen",
  "slug": "kewen",
  "ch": 14,
  "seg": 1
 }
]
