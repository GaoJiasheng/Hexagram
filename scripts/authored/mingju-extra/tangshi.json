[
 {
  "q": "但去莫复问，白云无尽时。",
  "label": "王维《送别·下马饮君酒》",
  "corpus": "tangshi",
  "slug": "tangshi300",
  "ch": 1,
  "seg": 31
 },
 {
  "q": "举杯邀明月，对影成三人。",
  "label": "李白《月下独酌》",
  "corpus": "tangshi",
  "slug": "tangshi300",
  "ch": 1,
  "seg": 75
 },
 {
  "q": "会当凌绝顶，一览众山小。",
  "label": "杜甫《望岳》",
  "corpus": "tangshi",
  "slug": "tangshi300",
  "ch": 1,
  "seg": 89
 },
 {
  "q": "人生不相见，动如参与商。",
  "label": "杜甫《赠卫八处士》",
  "corpus": "tangshi",
  "slug": "tangshi300",
  "ch": 1,
  "seg": 91
 },
 {
  "q": "明日隔山岳，世事两茫茫。",
  "label": "杜甫《赠卫八处士》",
  "corpus": "tangshi",
  "slug": "tangshi300",
  "ch": 1,
  "seg": 102
 },
 {
  "q": "在山泉水清，出山泉水浊。",
  "label": "杜甫《佳人》",
  "corpus": "tangshi",
  "slug": "tangshi300",
  "ch": 1,
  "seg": 112
 },
 {
  "q": "冠盖满京华，斯人独憔悴。",
  "label": "杜甫《梦李白·其二》",
  "corpus": "tangshi",
  "slug": "tangshi300",
  "ch": 1,
  "seg": 131
 },
 {
  "q": "千秋万岁名，寂寞身后事。",
  "label": "杜甫《梦李白·其二》",
  "corpus": "tangshi",
  "slug": "tangshi300",
  "ch": 1,
  "seg": 133
 },
 {
  "q": "世事波上舟，沿洄安得住。",
  "label": "韦应物《初发扬子寄元大校书》",
  "corpus": "tangshi",
  "slug": "tangshi300",
  "ch": 1,
  "seg": 187
 },
 {
  "q": "落叶满空山，何处寻行迹。",
  "label": "韦应物《寄全椒山中道士》",
  "corpus": "tangshi",
  "slug": "tangshi300",
  "ch": 1,
  "seg": 192
 },
 {
  "q": "草木有本心，何求美人折。",
  "label": "张九龄《感遇·兰叶春葳蕤》",
  "corpus": "tangshi",
  "slug": "tangshi300",
  "ch": 1,
  "seg": 238
 },
 {
  "q": "岂伊地气暖，自有岁寒心。",
  "label": "张九龄《感遇·江南有丹橘》",
  "corpus": "tangshi",
  "slug": "tangshi300",
  "ch": 1,
  "seg": 246
 },
 {
  "q": "回眸一笑百媚生，六宫粉黛无颜色。",
  "label": "白居易《长恨歌》",
  "corpus": "tangshi",
  "slug": "tangshi300",
  "ch": 2,
  "seg": 9
 },
 {
  "q": "在天愿作比翼鸟，在地愿为连理枝。",
  "label": "白居易《长恨歌》",
  "corpus": "tangshi",
  "slug": "tangshi300",
  "ch": 2,
  "seg": 64
 },
 {
  "q": "别有幽愁恨生，此时无声胜有声。",
  "label": "白居易《琵琶行》",
  "corpus": "tangshi",
  "slug": "tangshi300",
  "ch": 2,
  "seg": 83
 },
 {
  "q": "同是天涯沦落人，相逢何必曾相识。",
  "label": "白居易《琵琶行》",
  "corpus": "tangshi",
  "slug": "tangshi300",
  "ch": 2,
  "seg": 100
 },
 {
  "q": "忽如一夜春风来，千树万树梨花开。",
  "label": "岑参《白雪歌送武判官归京》",
  "corpus": "tangshi",
  "slug": "tangshi300",
  "ch": 2,
  "seg": 133
 },
 {
  "q": "山回路转不见君，雪上空留马行处。",
  "label": "岑参《白雪歌送武判官归京》",
  "corpus": "tangshi",
  "slug": "tangshi300",
  "ch": 2,
  "seg": 140
 },
 {
  "q": "五岳寻仙不辞远，一生好入名山游。",
  "label": "李白《庐山谣寄卢侍御虚舟》",
  "corpus": "tangshi",
  "slug": "tangshi300",
  "ch": 2,
  "seg": 144
 },
 {
  "q": "安能摧眉折腰事权贵，使我不得开心颜。",
  "label": "李白《梦游天姥吟留别》",
  "corpus": "tangshi",
  "slug": "tangshi300",
  "ch": 2,
  "seg": 178
 },
 {
  "q": "弃我去者，昨日之日不可留。",
  "label": "李白《宣州谢朓楼饯别校书叔云》",
  "corpus": "tangshi",
  "slug": "tangshi300",
  "ch": 2,
  "seg": 184
 },
 {
  "q": "抽刀断水水更流，举杯销愁愁更愁。",
  "label": "李白《宣州谢朓楼饯别校书叔云》",
  "corpus": "tangshi",
  "slug": "tangshi300",
  "ch": 2,
  "seg": 189
 },
 {
  "q": "志士幽人莫怨嗟，古来材大难为用。",
  "label": "杜甫《古柏行》",
  "corpus": "tangshi",
  "slug": "tangshi300",
  "ch": 2,
  "seg": 349
 },
 {
  "q": "烟销日出不见人，欸乃一声山水绿。",
  "label": "柳宗元《渔翁》",
  "corpus": "tangshi",
  "slug": "tangshi300",
  "ch": 2,
  "seg": 372
 },
 {
  "q": "前不见古人，后不见来者。",
  "label": "陈子昂《登幽州台歌》",
  "corpus": "tangshi",
  "slug": "tangshi300",
  "ch": 2,
  "seg": 375
 },
 {
  "q": "念天地之悠悠，独怆然而涕下。",
  "label": "陈子昂《登幽州台歌》",
  "corpus": "tangshi",
  "slug": "tangshi300",
  "ch": 2,
  "seg": 376
 },
 {
  "q": "黄河远上白云间，一片孤城万仞山。",
  "label": "王之涣《出塞》",
  "corpus": "tangshi",
  "slug": "tangshi300",
  "ch": 3,
  "seg": 0
 },
 {
  "q": "秦时明月汉时关，万里长征人未还。",
  "label": "王昌龄《出塞》",
  "corpus": "tangshi",
  "slug": "tangshi300",
  "ch": 3,
  "seg": 6
 },
 {
  "q": "但使龙城飞将在，不教胡马度阴山。",
  "label": "王昌龄《出塞》",
  "corpus": "tangshi",
  "slug": "tangshi300",
  "ch": 3,
  "seg": 7
 },
 {
  "q": "劝君更尽一杯酒，西出阳关无故人。",
  "label": "王维《渭城曲》",
  "corpus": "tangshi",
  "slug": "tangshi300",
  "ch": 3,
  "seg": 25
 },
 {
  "q": "云想衣裳花想容，春风拂槛露华浓。",
  "label": "李白《清平调》",
  "corpus": "tangshi",
  "slug": "tangshi300",
  "ch": 3,
  "seg": 74
 },
 {
  "q": "君不见，黄河之水天上来，奔流到海不复回！",
  "label": "李白《将进酒》",
  "corpus": "tangshi",
  "slug": "tangshi300",
  "ch": 3,
  "seg": 83
 },
 {
  "q": "天生我材必有用，千金散尽还复来。",
  "label": "李白《将进酒》",
  "corpus": "tangshi",
  "slug": "tangshi300",
  "ch": 3,
  "seg": 86
 },
 {
  "q": "长风破浪会有时，直挂云帆济沧海。",
  "label": "李白《行路难》",
  "corpus": "tangshi",
  "slug": "tangshi300",
  "ch": 3,
  "seg": 117
 },
 {
  "q": "郎骑竹马来，遶床弄青梅。",
  "label": "李白《长干行》",
  "corpus": "tangshi",
  "slug": "tangshi300",
  "ch": 3,
  "seg": 138
 },
 {
  "q": "同居长干里，两小无嫌猜。",
  "label": "李白《长干行》",
  "corpus": "tangshi",
  "slug": "tangshi300",
  "ch": 3,
  "seg": 139
 },
 {
  "q": "蜀道之难，难于上青天！",
  "label": "李白《蜀道难》",
  "corpus": "tangshi",
  "slug": "tangshi300",
  "ch": 3,
  "seg": 154
 },
 {
  "q": "剑阁峥嵘而崔嵬，一夫当关，万夫莫开。",
  "label": "李白《蜀道难》",
  "corpus": "tangshi",
  "slug": "tangshi300",
  "ch": 3,
  "seg": 172
 },
 {
  "q": "长安一片月，万户捣衣声。",
  "label": "李白《子夜吴歌·秋歌》",
  "corpus": "tangshi",
  "slug": "tangshi300",
  "ch": 3,
  "seg": 188
 },
 {
  "q": "早知潮有信，嫁与弄潮儿。",
  "label": "李益《江南曲》",
  "corpus": "tangshi",
  "slug": "tangshi300",
  "ch": 3,
  "seg": 204
 },
 {
  "q": "君不见青海头，古来白骨无人收。",
  "label": "杜甫《兵车行》",
  "corpus": "tangshi",
  "slug": "tangshi300",
  "ch": 3,
  "seg": 228
 },
 {
  "q": "慈母手中线，游子身上衣。",
  "label": "孟郊《游子吟》",
  "corpus": "tangshi",
  "slug": "tangshi300",
  "ch": 3,
  "seg": 285
 },
 {
  "q": "谁言寸草心，报得三春晖。",
  "label": "孟郊《游子吟》",
  "corpus": "tangshi",
  "slug": "tangshi300",
  "ch": 3,
  "seg": 287
 },
 {
  "q": "战士军前半死生，美人帐下犹歌舞。",
  "label": "高适《燕歌行》",
  "corpus": "tangshi",
  "slug": "tangshi300",
  "ch": 3,
  "seg": 295
 },
 {
  "q": "君家何处住？妾住在横塘。",
  "label": "崔颢《长干行·其一》",
  "corpus": "tangshi",
  "slug": "tangshi300",
  "ch": 3,
  "seg": 305
 },
 {
  "q": "月黑雁飞高，单于夜遁逃。",
  "label": "卢纶《塞下曲·其三》",
  "corpus": "tangshi",
  "slug": "tangshi300",
  "ch": 3,
  "seg": 321
 },
 {
  "q": "海内存知己，天涯若比隣。",
  "label": "王勃《送杜少府之任蜀州》",
  "corpus": "tangshi",
  "slug": "tangshi300",
  "ch": 4,
  "seg": 3
 },
 {
  "q": "江流天地外，山色有无中。",
  "label": "王维《汉江临眺》",
  "corpus": "tangshi",
  "slug": "tangshi300",
  "ch": 4,
  "seg": 12
 },
 {
  "q": "行到水穷处，坐看云起时。",
  "label": "王维《终南别业》",
  "corpus": "tangshi",
  "slug": "tangshi300",
  "ch": 4,
  "seg": 18
 },
 {
  "q": "明月松间照，清泉石上流。",
  "label": "王维《山居秋暝》",
  "corpus": "tangshi",
  "slug": "tangshi300",
  "ch": 4,
  "seg": 42
 },
 {
  "q": "海日生残夜，江春入旧年。",
  "label": "王湾《次北固山下》",
  "corpus": "tangshi",
  "slug": "tangshi300",
  "ch": 4,
  "seg": 53
 },
 {
  "q": "雨中黄叶树，灯下白头人。",
  "label": "司空曙《喜外弟卢纶见宿》",
  "corpus": "tangshi",
  "slug": "tangshi300",
  "ch": 4,
  "seg": 62
 },
 {
  "q": "野火烧不尽，春风吹又生。",
  "label": "白居易《赋得古原草送别》",
  "corpus": "tangshi",
  "slug": "tangshi300",
  "ch": 4,
  "seg": 72
 },
 {
  "q": "山随平野尽，江入大荒流。",
  "label": "李白《渡荆门送别》",
  "corpus": "tangshi",
  "slug": "tangshi300",
  "ch": 4,
  "seg": 102
 },
 {
  "q": "浮云游子意，落日故人情。",
  "label": "李白《送友人》",
  "corpus": "tangshi",
  "slug": "tangshi300",
  "ch": 4,
  "seg": 108
 },
 {
  "q": "吴楚东南坼，乾坤日夜浮。",
  "label": "杜甫《登岳阳楼》",
  "corpus": "tangshi",
  "slug": "tangshi300",
  "ch": 4,
  "seg": 142
 },
 {
  "q": "星垂平野阔，月涌大江流。",
  "label": "杜甫《旅夜书怀》",
  "corpus": "tangshi",
  "slug": "tangshi300",
  "ch": 4,
  "seg": 157
 },
 {
  "q": "露从今夜白，月是故乡明。",
  "label": "杜甫《月夜忆舍弟》",
  "corpus": "tangshi",
  "slug": "tangshi300",
  "ch": 4,
  "seg": 171
 },
 {
  "q": "文章憎命达，魑魅喜人过。",
  "label": "杜甫《天末怀李白》",
  "corpus": "tangshi",
  "slug": "tangshi300",
  "ch": 4,
  "seg": 177
 },
 {
  "q": "国破山河在，城春草木深。",
  "label": "杜甫《春望》",
  "corpus": "tangshi",
  "slug": "tangshi300",
  "ch": 4,
  "seg": 185
 },
 {
  "q": "烽火连三月，家书抵万金。",
  "label": "杜甫《春望》",
  "corpus": "tangshi",
  "slug": "tangshi300",
  "ch": 4,
  "seg": 187
 },
 {
  "q": "故人具鸡黍，邀我至田家。",
  "label": "孟浩然《过故人庄》",
  "corpus": "tangshi",
  "slug": "tangshi300",
  "ch": 4,
  "seg": 243
 },
 {
  "q": "气蒸云梦泽，波撼岳阳城。",
  "label": "孟浩然《临洞庭赠张丞相》",
  "corpus": "tangshi",
  "slug": "tangshi300",
  "ch": 4,
  "seg": 254
 },
 {
  "q": "人事有代谢，往来成古今。",
  "label": "孟浩然《与诸子登岘山》",
  "corpus": "tangshi",
  "slug": "tangshi300",
  "ch": 4,
  "seg": 258
 },
 {
  "q": "曲径通幽处，禅房花木深。",
  "label": "常建《题破山寺后禅院》",
  "corpus": "tangshi",
  "slug": "tangshi300",
  "ch": 4,
  "seg": 313
 },
 {
  "q": "海上生明月，天涯共此时。",
  "label": "张九龄《望月怀远》",
  "corpus": "tangshi",
  "slug": "tangshi300",
  "ch": 4,
  "seg": 317
 },
 {
  "q": "诚知此恨人人有，贫贱夫妻百事哀。",
  "label": "元稹《遣悲怀·其二》",
  "corpus": "tangshi",
  "slug": "tangshi300",
  "ch": 5,
  "seg": 9
 },
 {
  "q": "漠漠水田飞白鹭，阴阴夏木啭黄鹂。",
  "label": "王维《积雨辋川庄作》",
  "corpus": "tangshi",
  "slug": "tangshi300",
  "ch": 5,
  "seg": 32
 },
 {
  "q": "总为浮云能蔽日，长安不见使人愁。",
  "label": "李白《登金陵凤凰台》",
  "corpus": "tangshi",
  "slug": "tangshi300",
  "ch": 5,
  "seg": 49
 },
 {
  "q": "相见时难别亦难，东风无力百花残。",
  "label": "李商隐《无题·相见时难别亦难》",
  "corpus": "tangshi",
  "slug": "tangshi300",
  "ch": 5,
  "seg": 51
 },
 {
  "q": "春蚕到死丝方尽，蜡炬成灰泪始乾。",
  "label": "李商隐《无题·相见时难别亦难》",
  "corpus": "tangshi",
  "slug": "tangshi300",
  "ch": 5,
  "seg": 52
 },
 {
  "q": "此情可待成追忆，只是当时已惘然。",
  "label": "李商隐《锦瑟》",
  "corpus": "tangshi",
  "slug": "tangshi300",
  "ch": 5,
  "seg": 69
 },
 {
  "q": "春心莫共花争发，一寸相思一寸灰。",
  "label": "李商隐《无题·飒飒东风细雨来》",
  "corpus": "tangshi",
  "slug": "tangshi300",
  "ch": 5,
  "seg": 88
 },
 {
  "q": "身无彩凤双飞翼，心有灵犀一点通。",
  "label": "李商隐《无题·昨夜星辰昨夜风》",
  "corpus": "tangshi",
  "slug": "tangshi300",
  "ch": 5,
  "seg": 100
 },
 {
  "q": "一去紫台连朔漠，独留青冢向黄昏。",
  "label": "杜甫《咏怀古迹·其三》",
  "corpus": "tangshi",
  "slug": "tangshi300",
  "ch": 5,
  "seg": 129
 },
 {
  "q": "剑外忽传收蓟北，初闻涕泪满衣裳。",
  "label": "杜甫《闻官军收河南河北》",
  "corpus": "tangshi",
  "slug": "tangshi300",
  "ch": 5,
  "seg": 143
 },
 {
  "q": "无边落木萧萧下，不尽长江滚滚来。",
  "label": "杜甫《登高》",
  "corpus": "tangshi",
  "slug": "tangshi300",
  "ch": 5,
  "seg": 164
 },
 {
  "q": "锦江春色来天地，玉垒浮云变古今。",
  "label": "杜甫《登楼》",
  "corpus": "tangshi",
  "slug": "tangshi300",
  "ch": 5,
  "seg": 172
 },
 {
  "q": "出师未捷身先死",
  "label": "杜甫《蜀相》",
  "corpus": "tangshi",
  "slug": "tangshi300",
  "ch": 5,
  "seg": 182
 },
 {
  "q": "长使英雄泪满襟",
  "label": "杜甫《蜀相》",
  "corpus": "tangshi",
  "slug": "tangshi300",
  "ch": 5,
  "seg": 183
 },
 {
  "q": "身多疾病思田里，邑有流亡愧俸钱。",
  "label": "韦应物《寄李儋元锡》",
  "corpus": "tangshi",
  "slug": "tangshi300",
  "ch": 5,
  "seg": 211
 },
 {
  "q": "苦恨年年压金线，为他人作嫁衣裳。",
  "label": "秦韬玉《贫女》",
  "corpus": "tangshi",
  "slug": "tangshi300",
  "ch": 5,
  "seg": 222
 },
 {
  "q": "黄鹤一去不复返，白云千载空悠悠。",
  "label": "崔颢《黄鹤楼》",
  "corpus": "tangshi",
  "slug": "tangshi300",
  "ch": 5,
  "seg": 235
 },
 {
  "q": "日暮乡关何处是？烟波江上使人愁。",
  "label": "崔颢《黄鹤楼》",
  "corpus": "tangshi",
  "slug": "tangshi300",
  "ch": 5,
  "seg": 237
 },
 {
  "q": "人世几回伤往事，山形依旧枕寒流。",
  "label": "刘禹锡《西塞山怀古》",
  "corpus": "tangshi",
  "slug": "tangshi300",
  "ch": 5,
  "seg": 271
 },
 {
  "q": "白头宫女在，闲坐说玄宗。",
  "label": "元稹《行宫》",
  "corpus": "tangshi",
  "slug": "tangshi300",
  "ch": 6,
  "seg": 2
 },
 {
  "q": "白日依山尽，黄河入海流。",
  "label": "王之涣《登鹳雀楼》",
  "corpus": "tangshi",
  "slug": "tangshi300",
  "ch": 6,
  "seg": 4
 },
 {
  "q": "欲穷千里目，更上一层楼。",
  "label": "王之涣《登鹳雀楼》",
  "corpus": "tangshi",
  "slug": "tangshi300",
  "ch": 6,
  "seg": 5
 },
 {
  "q": "红豆生南国，春来发几枝。",
  "label": "王维《相思》",
  "corpus": "tangshi",
  "slug": "tangshi300",
  "ch": 6,
  "seg": 10
 },
 {
  "q": "愿君多采撷，此物最相思。",
  "label": "王维《相思》",
  "corpus": "tangshi",
  "slug": "tangshi300",
  "ch": 6,
  "seg": 11
 },
 {
  "q": "空山不见人，但闻人语响。",
  "label": "王维《鹿柴》",
  "corpus": "tangshi",
  "slug": "tangshi300",
  "ch": 6,
  "seg": 16
 },
 {
  "q": "独坐幽篁里，弹琴复长啸。",
  "label": "王维《竹里馆》",
  "corpus": "tangshi",
  "slug": "tangshi300",
  "ch": 6,
  "seg": 19
 },
 {
  "q": "春草明年绿，王孙归不归。",
  "label": "王维《送别·山中相送罢》",
  "corpus": "tangshi",
  "slug": "tangshi300",
  "ch": 6,
  "seg": 23
 },
 {
  "q": "晚来天欲雪，能饮一杯无？",
  "label": "白居易《问刘十九》",
  "corpus": "tangshi",
  "slug": "tangshi300",
  "ch": 6,
  "seg": 24
 },
 {
  "q": "夕阳无限好　只是近黄昏",
  "label": "李商隐《登乐游原》",
  "corpus": "tangshi",
  "slug": "tangshi300",
  "ch": 6,
  "seg": 42
 },
 {
  "q": "功盖三分国，名成八阵图。",
  "label": "杜甫《八阵图》",
  "corpus": "tangshi",
  "slug": "tangshi300",
  "ch": 6,
  "seg": 52
 },
 {
  "q": "野旷天低树，江清月近人。",
  "label": "孟浩然《宿建德江》",
  "corpus": "tangshi",
  "slug": "tangshi300",
  "ch": 6,
  "seg": 56
 },
 {
  "q": "春眠不觉晓，处处闻啼鸟。",
  "label": "孟浩然《春晓》",
  "corpus": "tangshi",
  "slug": "tangshi300",
  "ch": 6,
  "seg": 58
 },
 {
  "q": "夜来风雨声，花落知多少。",
  "label": "孟浩然《春晓》",
  "corpus": "tangshi",
  "slug": "tangshi300",
  "ch": 6,
  "seg": 59
 },
 {
  "q": "千山鸟飞绝，万径人踪灭。",
  "label": "柳宗元《江雪》",
  "corpus": "tangshi",
  "slug": "tangshi300",
  "ch": 6,
  "seg": 64
 },
 {
  "q": "孤舟蓑笠翁，独钓寒江雪。",
  "label": "柳宗元《江雪》",
  "corpus": "tangshi",
  "slug": "tangshi300",
  "ch": 6,
  "seg": 65
 },
 {
  "q": "松下问童子，言师采药去。",
  "label": "贾岛《寻隐者不遇》",
  "corpus": "tangshi",
  "slug": "tangshi300",
  "ch": 6,
  "seg": 80
 },
 {
  "q": "只在此山中，云深不知处。",
  "label": "贾岛《寻隐者不遇》",
  "corpus": "tangshi",
  "slug": "tangshi300",
  "ch": 6,
  "seg": 81
 },
 {
  "q": "洛阳亲友如相问，一片冰心在玉壶。",
  "label": "王昌龄《芙蓉楼送辛渐》",
  "corpus": "tangshi",
  "slug": "tangshi300",
  "ch": 7,
  "seg": 2
 },
 {
  "q": "忽见陌头杨柳色，悔教夫婿觅封侯。",
  "label": "王昌龄《闺怨》",
  "corpus": "tangshi",
  "slug": "tangshi300",
  "ch": 7,
  "seg": 5
 },
 {
  "q": "独在异乡为异客，每逢佳节倍思亲。",
  "label": "王维《九月九日忆山东兄弟》",
  "corpus": "tangshi",
  "slug": "tangshi300",
  "ch": 7,
  "seg": 10
 },
 {
  "q": "醉卧沙场君莫笑，古来征战几人回。",
  "label": "王翰《凉州词》",
  "corpus": "tangshi",
  "slug": "tangshi300",
  "ch": 7,
  "seg": 14
 },
 {
  "q": "马上相逢无纸笔，凭君传语报平安。",
  "label": "岑参《逢入京使》",
  "corpus": "tangshi",
  "slug": "tangshi300",
  "ch": 7,
  "seg": 30
 },
 {
  "q": "故人西辞黄鹤楼，烟花三月下扬州。",
  "label": "李白《送孟浩然之广陵》",
  "corpus": "tangshi",
  "slug": "tangshi300",
  "ch": 7,
  "seg": 31
 },
 {
  "q": "两岸猿声啼不尽，轻舟已过万重山。",
  "label": "李白《下江陵》",
  "corpus": "tangshi",
  "slug": "tangshi300",
  "ch": 7,
  "seg": 36
 },
 {
  "q": "不知何处吹芦管，一夜征人尽望乡。",
  "label": "李益《夜上受降城闻笛》",
  "corpus": "tangshi",
  "slug": "tangshi300",
  "ch": 7,
  "seg": 43
 },
 {
  "q": "可怜夜半虚前席，不问苍生问鬼神。",
  "label": "李商隐《贾生》",
  "corpus": "tangshi",
  "slug": "tangshi300",
  "ch": 7,
  "seg": 46
 },
 {
  "q": "碧海青天夜夜心",
  "label": "李商隐《嫦娥》",
  "corpus": "tangshi",
  "slug": "tangshi300",
  "ch": 7,
  "seg": 61
 },
 {
  "q": "何当共剪西窗烛",
  "label": "李商隐《夜雨寄北》",
  "corpus": "tangshi",
  "slug": "tangshi300",
  "ch": 7,
  "seg": 65
 },
 {
  "q": "正是江南好风景，落花时节又逢君。",
  "label": "杜甫《江南逢李龟年》",
  "corpus": "tangshi",
  "slug": "tangshi300",
  "ch": 7,
  "seg": 79
 },
 {
  "q": "二十四桥明月夜，玉人何处教吹箫？",
  "label": "杜牧《寄扬州韩绰判官》",
  "corpus": "tangshi",
  "slug": "tangshi300",
  "ch": 7,
  "seg": 98
 },
 {
  "q": "东风不与周郎便，铜雀春深锁二乔。",
  "label": "杜牧《赤壁》",
  "corpus": "tangshi",
  "slug": "tangshi300",
  "ch": 7,
  "seg": 115
 },
 {
  "q": "商女不知亡国恨",
  "label": "杜牧《泊秦淮》",
  "corpus": "tangshi",
  "slug": "tangshi300",
  "ch": 7,
  "seg": 118
 },
 {
  "q": "春潮带雨晚来急，野渡无人舟自横。",
  "label": "韦应物《滁州西涧》",
  "corpus": "tangshi",
  "slug": "tangshi300",
  "ch": 7,
  "seg": 135
 },
 {
  "q": "多情只有春庭月，犹为离人照落花。",
  "label": "张泌《寄人》",
  "corpus": "tangshi",
  "slug": "tangshi300",
  "ch": 7,
  "seg": 141
 },
 {
  "q": "月落乌啼霜满天，江枫渔火对愁眠。",
  "label": "张继《枫桥夜泊》",
  "corpus": "tangshi",
  "slug": "tangshi300",
  "ch": 7,
  "seg": 159
 },
 {
  "q": "可怜无定河边骨，犹是深闺梦里人。",
  "label": "陈陶《陇西行》",
  "corpus": "tangshi",
  "slug": "tangshi300",
  "ch": 7,
  "seg": 163
 },
 {
  "q": "少小离家老大回，乡音无改鬓毛衰，儿童相见不相识，笑问客从何处来。",
  "label": "贺知章《回乡偶书》",
  "corpus": "tangshi",
  "slug": "tangshi300",
  "ch": 7,
  "seg": 168
 },
 {
  "q": "飞入寻常百姓家。",
  "label": "刘禹锡《乌衣巷》",
  "corpus": "tangshi",
  "slug": "tangshi300",
  "ch": 7,
  "seg": 185
 },
 {
  "q": "春城无处不飞花，寒食东风御柳斜。",
  "label": "韩翃《寒食》",
  "corpus": "tangshi",
  "slug": "tangshi300",
  "ch": 7,
  "seg": 197
 },
 {
  "q": "天长地久有时尽，此恨緜緜无绝期。",
  "label": "白居易《长恨歌》",
  "corpus": "tangshi",
  "slug": "tangshi300",
  "ch": 2,
  "seg": 65
 },
 {
  "q": "羌笛何须怨杨柳，春风不度玉门关。",
  "label": "王之涣《出塞》",
  "corpus": "tangshi",
  "slug": "tangshi300",
  "ch": 3,
  "seg": 3
 },
 {
  "q": "花开堪折直须折，莫待无花空折枝。",
  "label": "无名氏《金缕衣》",
  "corpus": "tangshi",
  "slug": "tangshi300",
  "ch": 3,
  "seg": 273
 },
 {
  "q": "万里悲秋常作客，百年多病独登台。",
  "label": "杜甫《登高》",
  "corpus": "tangshi",
  "slug": "tangshi300",
  "ch": 5,
  "seg": 166
 }
]