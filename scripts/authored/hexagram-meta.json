{
  "1": {
    "pinyin": "qián",
    "summary": "刚健不息，自强进德",
    "guazhu": {
      "line": 5,
      "note": "九五「飞龙在天」,刚健中正,纯阳之尊,乾之主。"
    }
  },
  "2": {
    "pinyin": "kūn",
    "summary": "厚德载物，柔顺守正",
    "guazhu": {
      "line": 2,
      "note": "六二「直方大」,柔顺中正,得坤道之纯,坤之主。"
    }
  },
  "3": {
    "pinyin": "zhūn",
    "summary": "万物始生，盘桓建侯",
    "guazhu": {
      "line": 1,
      "note": "初九,刚柔始交,「以贵下贱,大得民也」,磐桓建侯,成卦之主。"
    }
  },
  "4": {
    "pinyin": "méng",
    "summary": "童蒙求我，启蒙养正",
    "guazhu": {
      "line": 2,
      "note": "九二「包蒙」,刚中而应,任发蒙之责,蒙之主。"
    }
  },
  "5": {
    "pinyin": "xū",
    "summary": "云上于天，待时而进",
    "guazhu": {
      "line": 5,
      "note": "九五「需于酒食」,位乎天位以正中(彖),需之主。"
    }
  },
  "6": {
    "pinyin": "sòng",
    "summary": "上刚下险，慎争息讼",
    "guazhu": {
      "line": 5,
      "note": "九五听讼,「讼元吉,以中正也」,讼之主。"
    }
  },
  "7": {
    "pinyin": "shī",
    "summary": "以正用众，行险而顺",
    "guazhu": {
      "line": 2,
      "note": "九二「在师中吉」,刚中而应,将帅之任,师之主。"
    }
  },
  "8": {
    "pinyin": "bǐ",
    "summary": "亲辅相依，择善而从",
    "guazhu": {
      "line": 5,
      "note": "九五「显比」,一阳居尊而众阴比之,比之主。"
    }
  },
  "9": {
    "pinyin": "xiǎo xù",
    "summary": "密云不雨，以柔畜刚",
    "guazhu": {
      "line": 4,
      "note": "六四以一阴畜众阳,「柔得位而上下应之」(彖),成卦之主。"
    }
  },
  "10": {
    "pinyin": "lǚ",
    "summary": "履虎尾，危而能安",
    "guazhu": {
      "line": 3,
      "note": "六三以柔履刚,履虎尾者,卦之所由名,成卦之主;主卦之善在九五。"
    }
  },
  "11": {
    "pinyin": "tài",
    "summary": "天地交而万物通",
    "guazhu": {
      "line": 2,
      "note": "九二「包荒,得尚于中行」,内阳之主,与六五刚柔相应而成泰。"
    }
  },
  "12": {
    "pinyin": "pǐ",
    "summary": "天地不交，俭德辟难",
    "guazhu": {
      "line": 5,
      "note": "九五「休否」,大人之吉,扭转否运之主。"
    }
  },
  "13": {
    "pinyin": "tóng rén",
    "summary": "与人同心，文明以健",
    "guazhu": {
      "line": 2,
      "note": "六二「柔得位得中而应乎乾」(彖),同人之所由,成卦之主。"
    }
  },
  "14": {
    "pinyin": "dà yǒu",
    "summary": "顺天休命，所有者大",
    "guazhu": {
      "line": 5,
      "note": "六五「柔得尊位大中,而上下应之」(彖),大有之主。"
    }
  },
  "15": {
    "pinyin": "qiān",
    "summary": "谦谦君子，卑以自牧",
    "guazhu": {
      "line": 3,
      "note": "九三「劳谦君子」,一阳居下卦之上,万民所服,谦之主。"
    }
  },
  "16": {
    "pinyin": "yù",
    "summary": "顺以动，豫备安乐",
    "guazhu": {
      "line": 4,
      "note": "九四「由豫,大有得」,刚应而志行(彖),豫之主。"
    }
  },
  "17": {
    "pinyin": "suí",
    "summary": "随时之宜，动而相悦",
    "guazhu": {
      "line": 1,
      "note": "初九「刚来而下柔」(彖),官有渝而从正,随之所由,成卦之主。"
    }
  },
  "18": {
    "pinyin": "gǔ",
    "summary": "整饬积弊，拨乱反正",
    "guazhu": {
      "line": 5,
      "note": "六五「干父用誉」,以柔居尊承先业,治蛊之主。"
    }
  },
  "19": {
    "pinyin": "lín",
    "summary": "以大临小，教思无穷",
    "guazhu": {
      "line": 2,
      "note": "九二「咸临」,刚中而应(彖),阳浸而长之主。"
    }
  },
  "20": {
    "pinyin": "guān",
    "summary": "观天之道，以示天下",
    "guazhu": {
      "line": 5,
      "note": "九五「大观在上」,观我生以示天下,观之主。"
    }
  },
  "21": {
    "pinyin": "shì kè",
    "summary": "明罚敕法，刚柔相济",
    "guazhu": {
      "line": 5,
      "note": "六五「柔得中而上行,虽不当位,利用狱」(彖),治狱之主。"
    }
  },
  "22": {
    "pinyin": "bì",
    "summary": "文饰得宜，文明以止",
    "guazhu": {
      "line": 2,
      "note": "六二「柔来而文刚」(彖),贲饰之所由,成卦之主;上九「白贲」与之相终始。"
    }
  },
  "23": {
    "pinyin": "bō",
    "summary": "阴长阳消，顺势而止",
    "guazhu": {
      "line": 6,
      "note": "上九「硕果不食」,一阳仅存而君子得舆,剥之主。"
    }
  },
  "24": {
    "pinyin": "fù",
    "summary": "一阳来复，天地之心",
    "guazhu": {
      "line": 1,
      "note": "初九一阳来复,「复其见天地之心」(彖),复之主。"
    }
  },
  "25": {
    "pinyin": "wú wàng",
    "summary": "不妄而行，动合天理",
    "guazhu": {
      "line": 1,
      "note": "初九「刚自外来而为主于内」(彖),无妄之主。"
    }
  },
  "26": {
    "pinyin": "dà xù",
    "summary": "刚健笃实，畜德养贤",
    "guazhu": {
      "line": 6,
      "note": "上九「何天之衢」,畜极而通,大畜之主。"
    }
  },
  "27": {
    "pinyin": "yí",
    "summary": "自求口实，养正则吉",
    "guazhu": {
      "line": 6,
      "note": "上九「由颐,厉吉」,天下由之以养,颐之主。"
    }
  },
  "28": {
    "pinyin": "dà guò",
    "summary": "栋梁之任，非常之时",
    "guazhu": {
      "line": 2,
      "note": "九二「枯杨生稊」,刚过而中(彖),济大过之主。"
    }
  },
  "29": {
    "pinyin": "kǎn",
    "summary": "重险之中，维心亨通",
    "guazhu": {
      "line": 5,
      "note": "九五「坎不盈」,阳刚中正居尊,行险而不失其信,坎之主。"
    }
  },
  "30": {
    "pinyin": "lí",
    "summary": "附丽光明，柔顺中正",
    "guazhu": {
      "line": 2,
      "note": "六二「黄离元吉」,柔丽乎中正(彖),离之主。"
    }
  },
  "31": {
    "pinyin": "xián",
    "summary": "二气感应，虚己受人",
    "guazhu": {
      "line": 4,
      "note": "九四居心之位,「贞吉悔亡」,感之专者,咸之主。"
    }
  },
  "32": {
    "pinyin": "héng",
    "summary": "恒久之道，守常不已",
    "guazhu": {
      "line": 2,
      "note": "九二「悔亡」,能久中(小象),恒之主。"
    }
  },
  "33": {
    "pinyin": "dùn",
    "summary": "知时而退，远害全身",
    "guazhu": {
      "line": 5,
      "note": "九五「嘉遁贞吉」,刚当位而应,与时行也(彖),遁之主。"
    }
  },
  "34": {
    "pinyin": "dà zhuàng",
    "summary": "刚以动壮，非礼弗履",
    "guazhu": {
      "line": 4,
      "note": "九四「藩决不羸」,四阳并进之首,大壮之主。"
    }
  },
  "35": {
    "pinyin": "jìn",
    "summary": "明出地上，柔进上行",
    "guazhu": {
      "line": 5,
      "note": "六五「柔进而上行」(彖),大明在上,晋之主。"
    }
  },
  "36": {
    "pinyin": "míng yí",
    "summary": "明入地中，晦以守明",
    "guazhu": {
      "line": 5,
      "note": "六五「箕子之明夷」,内难而能正其志(彖),明夷之主。"
    }
  },
  "37": {
    "pinyin": "jiā rén",
    "summary": "正家之道，各正其位",
    "guazhu": {
      "line": 2,
      "note": "六二「无攸遂,在中馈」,女正位乎内(彖),与九五内外各正,家人之主。"
    }
  },
  "38": {
    "pinyin": "kuí",
    "summary": "异中求同，睽而能通",
    "guazhu": {
      "line": 5,
      "note": "六五「柔进而上行,得中而应乎刚」(彖),济睽之主。"
    }
  },
  "39": {
    "pinyin": "jiǎn",
    "summary": "见险而止，反身修德",
    "guazhu": {
      "line": 5,
      "note": "九五「大蹇朋来」,当位贞吉以正邦(彖),济蹇之主。"
    }
  },
  "40": {
    "pinyin": "xiè",
    "summary": "险以动解，赦过宥罪",
    "guazhu": {
      "line": 2,
      "note": "九二「田获三狐,得黄矢」,乃得中也(彖),解之主。"
    }
  },
  "41": {
    "pinyin": "sǔn",
    "summary": "损下益上，惩忿窒欲",
    "guazhu": {
      "line": 5,
      "note": "六五「或益之,十朋之龟」,受益之尊,损道上行之归,损之主。"
    }
  },
  "42": {
    "pinyin": "yì",
    "summary": "损上益下，见善则迁",
    "guazhu": {
      "line": 5,
      "note": "九五「有孚惠心,勿问元吉」,损上益下之主。"
    }
  },
  "43": {
    "pinyin": "guài",
    "summary": "刚决去柔，扬于王庭",
    "guazhu": {
      "line": 5,
      "note": "九五「苋陆夬夬」,亲决一阴,中行无咎,夬之主。"
    }
  },
  "44": {
    "pinyin": "gòu",
    "summary": "柔遇刚，戒之在初",
    "guazhu": {
      "line": 1,
      "note": "初六一阴始生,「柔遇刚也」(彖),卦之所由,成卦之主;制之在九五。"
    }
  },
  "45": {
    "pinyin": "cuì",
    "summary": "萃聚以正，顺天致聚",
    "guazhu": {
      "line": 5,
      "note": "九五「萃有位」,刚中而应(彖),聚天下之主。"
    }
  },
  "46": {
    "pinyin": "shēng",
    "summary": "柔以时升，积小成高",
    "guazhu": {
      "line": 2,
      "note": "九二「刚中而应」(彖),孚乃利用禴,升之所恃,升之主。"
    }
  },
  "47": {
    "pinyin": "kùn",
    "summary": "困而不失，致命遂志",
    "guazhu": {
      "line": 5,
      "note": "九五「乃徐有说,以中直也」,处困而亨,济困之主。"
    }
  },
  "48": {
    "pinyin": "jǐng",
    "summary": "井养不穷，劳民劝相",
    "guazhu": {
      "line": 5,
      "note": "九五「井冽寒泉食」,井道之成,井之主。"
    }
  },
  "49": {
    "pinyin": "gé",
    "summary": "顺天应人，革故鼎新",
    "guazhu": {
      "line": 5,
      "note": "九五「大人虎变」,顺天应人,革之主。"
    }
  },
  "50": {
    "pinyin": "dǐng",
    "summary": "鼎新承命，养贤致用",
    "guazhu": {
      "line": 5,
      "note": "六五「鼎黄耳金铉」,得中而应乎刚(彖),养贤之主。"
    }
  },
  "51": {
    "pinyin": "zhèn",
    "summary": "震惊百里，恐惧修省",
    "guazhu": {
      "line": 1,
      "note": "初九一阳动于二阴之下,震之所由生,「恐致福也」,震之主。"
    }
  },
  "52": {
    "pinyin": "gèn",
    "summary": "时止则止，时行则行",
    "guazhu": {
      "line": 6,
      "note": "上九「敦艮之吉,以厚终也」,成止之功,艮之主。"
    }
  },
  "53": {
    "pinyin": "jiàn",
    "summary": "循序渐进，女归之吉",
    "guazhu": {
      "line": 5,
      "note": "九五「鸿渐于陵」,进得位,其位刚得中(彖),渐之主。"
    }
  },
  "54": {
    "pinyin": "guī mèi",
    "summary": "天地大义，永终知敝",
    "guazhu": {
      "line": 5,
      "note": "六五「帝乙归妹」,其位在中,以贵行也(小象),归妹之主。"
    }
  },
  "55": {
    "pinyin": "fēng",
    "summary": "丰大之时，宜照天下",
    "guazhu": {
      "line": 5,
      "note": "六五「来章,有庆誉」,致丰大之明主。"
    }
  },
  "56": {
    "pinyin": "lǚ",
    "summary": "旅居在外，柔顺守中",
    "guazhu": {
      "line": 5,
      "note": "六五「射雉,终以誉命」,柔得中乎外(彖),处旅之善,旅之主。"
    }
  },
  "57": {
    "pinyin": "xùn",
    "summary": "申命行事，巽以入之",
    "guazhu": {
      "line": 5,
      "note": "九五「刚巽乎中正而志行」(彖),申命行事,巽之主。"
    }
  },
  "58": {
    "pinyin": "duì",
    "summary": "朋友讲习，悦而有孚",
    "guazhu": {
      "line": 5,
      "note": "九五刚中居尊,「孚于剥」之戒所系,说道之主。"
    }
  },
  "59": {
    "pinyin": "huàn",
    "summary": "风行水上，涣散复聚",
    "guazhu": {
      "line": 5,
      "note": "九五「涣汗其大号」,王居正位,济涣之主。"
    }
  },
  "60": {
    "pinyin": "jié",
    "summary": "节以制度，中正以通",
    "guazhu": {
      "line": 5,
      "note": "九五「甘节之吉」,当位以节,中正以通(彖),节之主。"
    }
  },
  "61": {
    "pinyin": "zhōng fú",
    "summary": "信发于中，感及豚鱼",
    "guazhu": {
      "line": 5,
      "note": "九五「有孚挛如」,刚得中而位正当,孚信之主。"
    }
  },
  "62": {
    "pinyin": "xiǎo guò",
    "summary": "小者可过，宜下不宜上",
    "guazhu": {
      "line": 2,
      "note": "六二「不及其君,遇其臣」,柔得中,可小事之主。"
    }
  },
  "63": {
    "pinyin": "jì jì",
    "summary": "既成之时，思患预防",
    "guazhu": {
      "line": 2,
      "note": "六二柔得中,「初吉」之所由(彖),既济之主。"
    }
  },
  "64": {
    "pinyin": "wèi jì",
    "summary": "事未成时，慎辨居方",
    "guazhu": {
      "line": 5,
      "note": "六五柔得中,「未济亨」之所由(彖),君子之光,未济之主。"
    }
  }
}
