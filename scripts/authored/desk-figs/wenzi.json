 "5e172592eb88": {
  "kind": "flow",
  "title": "『不被害』的四级台阶（越往上越高）",
  "steps": [
   {
    "head": "① 刺不进、打不中（但仍被惦记 —— 犹辱也）"
   },
   {
    "head": "② 别人『不敢』动你（念头还在）"
   },
   {
    "head": "③ 别人连害你的念头都没有 —— 本无其意"
   }
  ],
  "result": {
   "head": "④ 天下人都想护你、利你 —— 无地而为君",
   "accent": true
  },
  "loop": false,
  "foot": [
