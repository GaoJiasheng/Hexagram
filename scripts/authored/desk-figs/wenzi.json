 "56bc350e7518": {
  "kind": "cols",
  "title": "「因」与「作」：借势 还是 硬造",
  "cols": [
   {
    "head": "因 · 顺着来",
    "lines": [
     "顺水之流而疏导",
     "借趋势之力",
     "力被放大 → 大",
     "能因则无敌于天下"
    ],
    "accent": true
   },
   {
    "head": "作 · 硬要造",
    "lines": [
     "堵水、逆性而为",
     "只凭一己之力",
     "被自己框死 → 小",
     "守一隅而遗万方"
    ]
   }
  ]
 },
 "57296d815d72": {
  "kind": "cols",
  "title": "「为善易、为不善难」难在哪？换了把尺",
  "cols": [
   {
    "head": "常识的尺",
    "lines": [
     "看「社会上多不多」",
     "为善：要克制 → 难",
     "为恶：一时爽 → 易",
     "逆水行舟，处处算计",
     "躁而多欲，心不得安"
    ]
   },
   {
    "head": "文子的尺",
    "accent": true,
    "lines": [
     "看「顺不顺本性」",
     "为善：循性保真 → 省力",
     "为恶：躁而多欲 → 内耗",
     {
      "head": "顺水推舟，本就省力",
      "body": "恒满而不溢，常虚而易赡",
      "accent": true
     }
    ]
   }
  ]
 },
