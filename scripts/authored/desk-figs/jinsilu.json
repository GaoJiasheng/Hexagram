 "1f4c6d9c5ab9": {
  "kind": "rows",
  "title": "写本朝人，全用「细节」让你看「气象」",
  "items": [
   {
    "head": "周敦颐",
    "body": [
     "窗前草不除 ·「与自家意思一般」",
     "→ 万物一体的生意"
    ],
    "accent": true
   },
   {
    "head": "张 载",
    "body": [
     "闻生皇子喜 · 见饿莩食不美",
     "→ 以天下悲欢为己悲欢"
    ],
    "accent": true
   },
   {
    "head": "程 颢",
    "body": [
     "坐如泥塑 · 接人一团和气 · 三十年无忿容",
     "→ 对己极严、待人极和，不言而化"
    ],
    "accent": true
   }
  ],
  "foot": [
   "道不在论断里，在一个个活出来的生活瞬间里"
  ]
 },
