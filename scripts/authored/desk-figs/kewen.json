 "2f1607373772": {
  "kind": "flow",
  "title": "《送东阳马生序》四段骨架",
  "steps": [
   {
    "head": "第一段 · 无书则借，无师则求",
    "body": "借书抄录、计日以还 → 遍观群书；百里从师、遇叱咄而又请 → 卒获有所闻"
   },
   {
    "head": "第二段 · 路上之寒，寓中之贫，今日之遇",
    "body": [
     "负箧曳屣、足肤皲裂；缊袍敝衣、不慕同舍 → 盖余之勤且艰若此",
     "课本节选到此为止",
     "今虽耄老，犹幸预君子之列、承天子之宠光 → 况才之过于余者乎"
    ]
   },
   {
    "head": "第三段 · 诸生今日，四样俱备",
    "body": "廪稍裘葛 · 大厦 · 司业博士 · 群书 → 心不若余之专耳"
   },
   {
    "head": "第四段 · 马生出场，说明赠言",
    "body": "称其善学 → 道为学之难以告之 → 自辩：勉乡人以学，非夸际遇"
   }
  ],
  "foot": [
   "前两段写「我」 · 第三段写「你们」 · 末段才写「你」"
  ]
 },
 "3153b189ac82": {
  "kind": "cols",
  "title": "两套说法：同一个「期」字",
  "cols": [
   {
    "head": "友人的说法",
    "lines": [
     "前提 · 与人期行",
     "（「日中」被悄悄删去）",
     "事实 · 相委而去",
     "结论 · 非人哉"
    ]
   },
   {
    "head": "元方的说法",
    "lines": [
     "前提 · 期日中",
     "（把时间条件补回来）",
     "那时 · 日中不至",
     "→ 则是无信",
     "此刻 · 对子骂父",
     "→ 则是无礼"
    ],
    "accent": true
   }
  ],
  "foot": [
   "友人删掉时间条件，把「迟到」说成「被丢下」；",
   "元方把条件补回，再添一条当场的「无礼」。"
  ]
 },
