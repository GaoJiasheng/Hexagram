 "fe38d824e386": {
  "kind": "flow",
  "title": "一句话在宋国兜的一圈",
  "steps": [
   {
    "head": "丁氏",
    "body": "「吾穿井得一人」",
    "accent": true
   },
   {
    "mark": "告人",
    "head": "传之者",
    "body": "「丁氏穿井得一人」"
   },
   {
    "mark": "传之",
    "head": "国人",
    "body": "道之"
   },
   {
    "mark": "闻于",
    "head": "宋君",
    "body": "令人问之"
   }
  ],
  "result": {
   "head": "宋君令人问之于丁氏 —— 回到源头",
   "body": "丁氏对曰：「得一人之使，非得一人于井中也。」",
   "accent": true
  },
  "foot": [
   "越往右，离丁家门口越远，知道前情的人越少",
   "往外传，没人补得回前情；绕回说话的人那里，一问即破"
  ]
 },
