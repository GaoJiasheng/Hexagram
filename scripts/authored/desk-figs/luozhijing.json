 "8878cca10373": {
  "kind": "rows",
  "title": "四道「不可」：把人封进孤岛的闸门",
  "items": [
   {
    "mark": "权",
    "head": "不可废 —— 废则失本",
    "body": "权柄是命根，一刻不能松手"
   },
   {
    "mark": "情",
    "head": "不可滥 —— 滥则人忌",
    "body": "动情太多，反招人忌恨"
   },
   {
    "mark": "人",
    "head": "不可密 —— 密则疑生",
    "body": "走得太近，就生出猜疑"
   },
   {
    "mark": "心",
    "head": "不可托 —— 托则祸伏",
    "body": "交出真心，等于埋下祸根"
   }
  ],
  "foot": [
   "四闸齐落，人即成孤岛——这不是清醒，是把自己变成不会信任的机器"
  ]
 },
 "89a1c1070691": {
  "kind": "quote",
  "text": "机为要，无机自毁\n事可绝，人伦亦灭",
  "gloss": "—— 把权力放到至高无上，\n这套逻辑必然推到『连人伦都可踩碎』",
  "source": "《罗织经·控权卷四》· 托名伪书，示众而非传授",
  "foot": [
   "观象 · 批判存档"
  ]
 },
 "939ce45c76e9": {
  "kind": "cols",
  "title": "刑罚的两种目的:被偷换的那一步",
  "cols": [
   {
    "head": "正常司法",
    "lines": [
     "先有事实",
     "↓ 调查取证",
     "↓ 据证定罪",
     "刑罚=结果",
     "目的:查清真相"
    ]
   },
   {
    "head": "本卷所教(整人)",
    "accent": true,
    "lines": [
     "先选定人",
     "↓ 扣谋反罪名",
     "↓ 上刑逼认",
     "刑罚=工具",
     "目的:压垮意志"
    ]
   }
  ]
 },
 "9944b02239c2": {
  "kind": "flow",
  "title": "《刑罚卷》整人链条 · 每一环都藏着谎言",
  "steps": [
   {
    "head": "① 先选定要除掉的人"
   },
   {
    "head": "② 扣最重罪名(构其反)",
    "body": "骗举证",
    "accent": true
   },
   {
    "head": "③ 看人下菜 · 攻其软肋"
   },
   {
    "head": "④ 不认就加罪 · 没证就伪证",
    "body": "造假证",
    "accent": true
   },
   {
    "head": "⑤ 罪坐成 · 整人者「贵」"
   }
  ],
  "foot": [
   "真正的目的(②④是伪造,⑤才是动机):掌人生死、自抬身价"
  ]
 },
 "a449d25b9153": {
  "kind": "tree",
  "title": "它如何让被告变成「孤岛」",
  "root": {
   "head": "被告",
   "body": "无人可依",
   "accent": true
  },
  "branches": [
   {
    "head": "同情他的人",
    "body": "→ 被疑「不忠」"
   },
   {
    "head": "替他求情的人",
    "body": "→ 被「重惩」"
   },
   {
    "head": "他的朋友同党",
    "body": "→ 被牵连株连"
   },
   {
    "head": "心软的办案者",
    "body": "→ 被逆向淘汰"
   }
  ]
 },
 "b590c3332c8f": {
  "kind": "tree",
  "title": "站队思维:善恶被简化成连线题",
  "root": {
   "head": "要巴结的",
   "body": "那位",
   "accent": true
  },
  "branches": [
   {
    "head": "他的友",
    "body": [
     "「其奸亦忠」",
     "真奸也判成忠"
    ]
   },
   {
    "head": "他的敌",
    "body": [
     "「非奸亦奸」",
     "不奸也扣帽子"
    ]
   }
  ]
 },
 "be55d3a5850a": {
