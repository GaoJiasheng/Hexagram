 "e17b87f7c630": {
  "kind": "quote",
  "text": "心无滞碍，害不侵矣",
  "gloss": "它把良心、不忍、是非感,统称为「滞碍」",
  "source": "《罗织经·保身卷七》· 托名之作,读以鉴恶,非以效行",
  "foot": [
   "所谓「不侵」,代价是丢掉一颗会痛的心",
   "观谋"
  ]
 },
 "e72f7835720e": {
  "kind": "rows",
  "title": "「制敌」四手 · 从权谋到犯罪",
  "items": [
   {
    "head": "惑敌于不觉",
    "body": "示弱迷惑、暗中等待时机 —— 盗用兵家「示形」之名"
   },
   {
    "head": "制敌于未动",
    "body": "趁人未发先下手 —— 借兵家「先机」却丢其前提"
   },
   {
    "head": "构敌于为乱 ⚠",
    "body": "无中生有,诬陷谋反 —— 这就是「罗织」,是重罪",
    "accent": true
   },
   {
    "head": "害敌以淫邪 ⚠",
    "body": "用下流龌龊手段害人,还叫你「不耻」 —— 麻醉良知",
    "accent": true
   }
  ],
  "foot": [
   "越往下,越是赤裸的恶——读它是为了识破,不是施用",
   "出处:托名《罗织经·制敌卷五》 · 本图意在防范,非操作手册"
  ]
 },
 "ec06b1f2af22": {
  "kind": "rows",
  "title": "「恩威同施」引擎的四个齿轮",
  "items": [
   {
    "head": "以好诱之",
    "accent": true,
    "body": [
     "投其所好,把人勾住",
     "→ 把好恶当绳子"
    ]
   },
   {
    "head": "以惧迫之",
    "accent": true,
    "body": [
     "攻其所惧,逼人就范",
     "→ 把恐惧当夹子"
    ]
   },
   {
    "head": "赏勿吝",
    "accent": true,
    "body": [
     "厚赏养安逸",
     "→ 捧杀,坠其志"
    ]
   },
   {
    "head": "罚适时",
    "accent": true,
    "body": [
     "挑时机敲打",
     "→ 警心,使人怵"
    ]
   }
  ],
  "foot": [
   "四轮咬合,目的只有一个:操控,而非公正"
  ]
 },
 "f4f9a2de8915": {
  "kind": "quote",
  "text": "上所予,自可取,\n生死于人,安可逆乎?",
  "gloss": "——它先把人吓进「命悬一线」的幻觉,",
  "source": "罗织经 · 事上卷二",
  "foot": [
   "再宣称尊严是奢侈品。这是话术,不是真理。"
  ]
 },
 "fc62f249a41f": {
  "kind": "quote",
  "text": "利为上,愚者惟求良善",
  "gloss": "它把「想做个好人」\n直接定义成了「愚蠢」",
  "source": "——托名《罗织经·制敌卷五》",
  "foot": [
   "⚠ 这正是整卷最该警惕的一句"
  ]
 }
}
