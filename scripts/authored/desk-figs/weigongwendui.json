{
 "1626895d21a9": {
  "kind": "cols",
  "cols": [
   {
    "head": "我方 · 奇正在我",
    "lines": [
     {
      "head": "敌实",
      "body": "我以正",
      "accent": true
     },
     {
      "head": "敌虚",
      "body": "我为奇",
      "accent": true
     }
    ]
   },
   {
    "head": "敌方 · 虚实在敌",
    "lines": [
     {
      "head": "绷紧处",
      "body": "正兵稳顶，拖住它"
     },
     {
      "head": "松动处",
      "body": "奇兵插入，击其松"
     }
    ]
   }
  ]
 },
 "23f302a7aa0c": {
  "kind": "quote",
  "title": "李卫公问对 · 卷中",
  "text": "致人而不致于人",
  "gloss": "牵着敌人走，绝不被敌人牵着走",
  "foot": [
   "千章万句，不出乎此而已"
  ]
 },
 "4b57bc4fd209": {
  "kind": "flow",
  "title": "奇正相生 · 循环之无端",
  "steps": [
   {
    "head": "正"
   },
   {
    "head": "奇"
   }
  ],
  "loop": true,
  "foot": [
   "相生",
   "无端 · 无穷"
  ]
 },
 "4c79d4334f57": {
  "kind": "quote",
  "text": "正兵受之于君\n奇兵将所自出",
  "source": "《李卫公问对 · 卷上》"
 },
 "7886f5f1f381": {
  "kind": "cols",
  "title": "正 与 奇：一对会互相变身的名分",
  "cols": [
   {
    "head": "正",
    "lines": [
     "向前进击",
     "大众所合、正面对阵",
     "受之于君（明令）",
     "让敌看作寻常"
    ]
   },
   {
    "head": "奇",
    "lines": [
     "后退诱敌",
     "将领自出、绕侧突袭",
     "将所自出（临机）",
     "让敌意想不到"
    ]
   }
  ],
  "foot": [
   "敌一旦识其正，正即成奇；识其奇，奇即成正——名分随人而转"
  ]
 },
 "7b1cd71a1bd1": {
  "kind": "quote",
  "text": "安营据地\n便乎人事而已",
  "source": "——《李卫公问对·卷下》李靖"
 },
 "915681c89562": {
  "kind": "rows",
  "title": "治力之法 · 三义推为六",
  "items": [
   {
    "mark": "本",
    "head": "孙子三义",
    "body": [
     "以近待远",
     "以佚待劳",
     "以饱待饥"
    ],
    "accent": true
   },
   {
    "mark": "推衍",
    "head": "推 · 李靖六法",
    "body": [
     "以诱待来",
     "以静待躁",
     "以重待轻",
     "以严待懈",
     "以治待乱",
     "以守待攻"
    ],
    "accent": true
   }
  ],
  "foot": [
   "攒着劲儿，等对方力气泄了那一刻",
   "句式一律：以我之从容，待敌之失态"
  ]
 },
 "957ef51506e1": {
  "kind": "rows",
  "title": "六花阵 · 外方内圆",
  "items": [
   {
    "head": "方 · 正兵",
    "body": "矩其步 · 稳"
   },
   {
    "head": "圆 · 奇兵",
    "body": "缀其旋 · 活",
    "accent": true
   },
   {
    "head": "大将"
   }
  ],
  "foot": [
   "外有边界规矩，内留灵活调度"
  ]
 },
 "b13080a32e31": {
  "kind": "cols",
  "title": "分合两种病：都是\"该动不动\"",
  "cols": [
   {
    "head": "縻军",
    "lines": [
     "该分而不分",
     "几十万人挤成一坨",
     "一处松动便全盘崩",
     "例：苻坚百万众",
     "败于淝水"
    ]
   },
   {
    "head": "孤旅",
    "lines": [
     "该聚而不聚",
     "一支孤军单独暴露",
     "被围而无人接应",
     "反例：吴汉与刘尚",
     "分屯而能合击"
    ]
   }
  ]
 },
 "d3da1bee9fac": {
  "kind": "cols",
  "title": "攻守，其实是同一套\"示形\"",
  "cols": [
   {
    "head": "守 · 示敌以不足",
    "lines": [
     "故意露出弱相",
     "敌必来攻",
     "= 敌不知其所攻"
    ]
   },
   {
    "head": "攻 · 示敌以有余",
    "lines": [
     "故意显出强势",
     "敌必自守",
     "= 敌不知其所守"
    ]
   }
  ],
  "foot": [
   "攻守者，一而已矣"
  ]
 },
 "efda721a8cd8": {
  "kind": "table",
  "title": "丘井九宫 · 起于五，终于八",
  "rows": [
   [
    "部",
    "部",
    "部"
   ],
   [
    "部",
    "大将 虚其中",
    "部"
   ],
   [
    "部",
    "部",
    "部"
   ]
  ],
  "foot": [
   "中心留空以居大将，八部环绕相连",
   "散而成八，复而为一"
  ]
 },
 "f56d02049c99": {
  "kind": "rows",
  "title": "学兵三层楼 · 由下而上",
  "items": [
   {
    "head": "道",
    "body": "至微至深"
   },
   {
    "head": "天地",
    "body": "阴阳 · 险易（孟子：天时地利）"
   },
   {
    "head": "将法",
    "body": [
     "任人 · 利器（三略得士者昌 · 管子器必坚利）",
     "最实可学"
    ]
   }
  ],
  "foot": [
   "繇下及中及上",
   "先从下等达中等，再从中等达上等，渐而深矣"
  ]
 }
