 "f752201f259e": {
  "kind": "quote",
  "text": "有必救之军者，\n则有必守之城。",
  "gloss": "守得住一座城的，从来不只是城墙，而是那份「人一定会来」的信。",
  "source": "《尉缭子 · 守权》"
 },
 "fbb09aa7213d": {
  "kind": "cols",
  "title": "君与臣：两套活儿，互相校验",
  "cols": [
   {
    "head": "主上之操",
    "lines": [
     "明法 · 稽验",
     "定规矩、核查",
     "像「出题＋定判分标准」"
    ]
   },
   {
    "head": "臣下之节",
    "lines": [
     "守法 · 稽断",
     "照规矩办事、裁断",
     "像「按标准批改给分」"
    ]
   }
  ],
  "foot": [
   "同一把尺子，谁也别想浑水摸鱼——这就是「明法稽验」的用意"
  ]
 },
 "fc926809f8c8": {
  "kind": "cols",
  "title": "资源 ≠ 实力：差在两个动词",
  "cols": [
