 "4261e161c688": {
  "kind": "cols",
  "title": "「权·武」抢先 vs 落后",
  "cols": [
   {
    "head": "先加人 · 我抢先",
    "lines": [
     {
      "head": "权先加人",
      "body": "→ 敌不力交（使不上劲）",
      "accent": true
     },
     {
      "head": "武先加人",
      "body": "→ 敌无威接（势先泄）",
      "accent": true
     }
    ]
   },
   {
    "head": "后加人 · 我落后",
    "lines": [
     {
      "head": "权被人先加",
      "body": "→ 我不力交（被别住）"
     },
     {
      "head": "武被人先加",
      "body": "→ 我无威接（接不住）"
     }
    ]
   }
  ],
  "foot": [
