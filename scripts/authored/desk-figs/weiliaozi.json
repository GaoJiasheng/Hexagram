 "2b63f1a2f654": {
  "kind": "rows",
  "title": "《兵令上》逻辑链",
  "items": [
   {
    "mark": "慎",
    "head": "兵者凶器逆德，争者事之末——能不打就不打",
    "accent": true
   },
   {
    "mark": "立体",
    "head": "以武为外、以文为内——拳头要有骨架",
    "accent": true
   },
   {
    "mark": "聚",
    "head": "专一则胜，离散则败——把人拧成一股",
    "accent": true
   },
   {
    "mark": "可算",
    "head": "畏将立纪、称将于敌——未战即知胜败",
    "accent": true
   },
   {
    "mark": "致胜",
    "head": "正兵先合、而后扼之——从容制敌",
    "accent": true
   }
  ],
  "foot": [
   "胜负的天平，在开打之前就已大半压定"
  ]
 },
 "3391f5d4f219": {
  "kind": "rows",
  "title": "天子之事·四象(由因到果)",
  "items": [
   {
    "head": "神明",
    "body": "智虑通达，看透当下局面"
   },
   {
    "head": "垂光",
    "body": "恩泽教化，普照于民"
   },
   {
    "head": "洪叙",
    "body": "建大秩序，纲纪宏正"
   },
   {
    "head": "无敌",
    "body": "前三者既成，自然天下莫当(果)",
    "accent": true
   }
  ]
 },
 "33b34a2fb029": {
  "kind": "quote",
  "text": "必死则生",
  "gloss": "指敌忘身 · 急胜为下\n把退路放下,反爆发出最大的力;\n但越是急着赢,越容易乱了分寸。"
 },
