 "1dd843db1901": {
  "kind": "rows",
  "title": "六种败因 · 全是'将之过'",
  "items": [
   {
    "head": "走",
    "body": "以一击十——明知悬殊还硬打，士卒只能逃",
    "accent": true
   },
   {
    "head": "弛",
    "body": "卒强吏弱——好兵配弱官，松散使不上劲",
    "accent": true
   },
   {
    "head": "陷",
    "body": "吏强卒弱——强官带弱兵，一上去就陷住",
    "accent": true
   },
   {
    "head": "崩",
    "body": "大吏怒而不服——内部离心，主将又不知其能",
    "accent": true
   },
   {
    "head": "乱",
    "body": "将弱不严——没规矩没训导，布阵纵横散乱",
    "accent": true
   },
   {
    "head": "北",
    "body": "不能料敌——以弱击强、又无精锐，败逃",
    "accent": true
   }
  ],
  "foot": [
   "非天之灾 · 将之过也",
   "六种死法，主语全是'带队的人'"
  ]
 },
