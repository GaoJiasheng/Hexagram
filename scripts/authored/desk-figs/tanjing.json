 "2ac184afe505": {
  "kind": "cols",
  "title": "「法无顿渐，人有利钝」",
  "cols": [
   {
    "head": "同一种法（同一个太阳）",
    "lines": [
     "大窗·利根",
     "一开就亮（顿）",
     "小窗·钝根",
     "慢慢透（渐）"
    ]
   },
   {
    "head": "不是两种法在打架",
    "lines": [
     "顿 ≠ 高级套餐",
     "渐 ≠ 低级套餐",
     "差别在窗（人）",
     "不在光（法）"
    ]
   }
  ]
 },
 "35895bc347ea": {
