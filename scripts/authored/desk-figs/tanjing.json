 "50ec0adacecb": {
  "kind": "cols",
  "title": "忏 与 悔:一个词的两半",
  "cols": [
   {
    "head": "忏",
    "lines": [
     "忏其前衍",
     "面向过去",
     "旧账一笔勾销",
     "永不复起"
    ]
   },
   {
    "head": "悔",
    "lines": [
     "悔其后过",
     "面向未来",
     "同错不再犯",
     "更不复作"
    ]
   }
  ],
  "foot": [
   "只忏不悔 → 前衍不灭，后过又生（循环不止）"
  ]
 },
 "5c955ba3c36c": {
  "kind": "rows",
  "title": "「魔」和「佛」在同一间屋子里轮流坐庄",
  "items": [
   {
    "head": "你这一间「屋子」＝你的心"
   },
   {
    "head": "贪 · 嗔 · 痴（三毒）＝魔"
   },
   {
    "head": "清明的觉性＝佛",
    "accent": true
   }
  ],
  "foot": [
   "能救你的和能坑你的，是同一个人"
  ]
 },
 "6f7188f64952": {
  "kind": "cols",
  "title": "面对告别：两种反应，两种落点",
  "cols": [
   {
    "head": "大部分弟子：痛哭",
    "lines": [
     "把「他」当成会永远",
     "消失的东西",
     "→ 恐慌、被抽空"
    ]
   },
   {
    "head": "神会：不动声色",
    "lines": [
     "看见那个不随生灭",
     "起落的「本性」",
     "→ 从容、稳得住"
    ]
   }
  ],
  "foot": [
   "差别不在有没有感情，在重心朝外还是朝内"
  ]
 },
 "700335ea18d9": {
  "kind": "cols",
  "title": "两首壁偈 · 渐与顿",
  "cols": [
   {
    "head": "神秀 · 渐修",
    "lines": [
     "身是菩提树",
     "心如明镜台",
     "时时勤拂拭",
     "勿使惹尘埃",
     "有镜子、有灰",
     "天天擦 → 稳、可操作"
    ]
   },
   {
    "head": "惠能 · 顿悟",
    "accent": true,
    "lines": [
     "菩提本无树",
     "明镜亦非台",
     "本来无一物",
     "何处惹尘埃",
     "根上无一物",
     "无灰可落 → 直下认取"
    ]
   }
  ]
 },
 "81c8111e5c01": {
  "kind": "flow",
  "title": "三问一钥:同一把钥匙开三把锁",
  "steps": [
   {
    "head": "功德 → 向布施供养找?"
   },
   {
    "head": "西方 → 向十万里外找?"
   },
   {
    "head": "修行 → 向寺庙墙里找?"
   }
  ],
  "result": {
   "head": "向心觅",
   "body": "同一个「向内」的答案",
   "accent": true
  },
  "foot": [
   "问的是三件事，听出来的是一件事:别再往外找了"
  ]
 },
 "8d042988da0b": {
  "kind": "quote",
  "title": "心",
  "text": "道由心悟\n岂在坐也",
  "source": "《坛经 · 护法品》"
 },
