 "98b1770c31ba": {
  "kind": "flow",
  "title": "付嘱品的一条脑回路：从「向外」拗回「向内」",
  "steps": [
   {
    "head": "迷的人：拼命向外找佛、找答案、找靠山"
   },
   {
    "head": "惠能一问：那个「能找」的心，是从哪儿冒出来的？"
   },
   {
    "head": "发现：万种法都是「本心」生出来的——找的人和被找的，本是同一个"
   }
  ],
  "result": {
   "head": "结论：自心是佛，更莫狐疑",
   "accent": true
  }
 },
 "9acf4cb67612": {
  "kind": "quote",
  "text": "口念心不行，\n如幻如化，如露如电。",
  "gloss": "道理只挂在嘴上，就像朝露闪电，转眼即逝"
 },
 "a111e911cb7f": {
  "kind": "cols",
  "title": "两种「戒定慧」·对照",
  "cols": [
   {
    "head": "神秀·从外往里管（渐）",
    "lines": [
     "诸恶莫作 → 戒",
     "诸善奉行 → 慧",
     "自净其意 → 定",
     "像给浊水加净化剂",
     "·过滤·搅拌·努力弄清",
     "立规矩，一条条去做"
    ]
   },
   {
    "head": "惠能·从里往外流（顿）",
    "lines": [
     "心地无非 → 自性戒",
     "心地无痴 → 自性慧",
     "心地无乱 → 自性定",
     "水本来就清·别晃它",
     "静下来泥自己就沉了",
     "不外立·从自性起用"
    ]
   }
  ]
 },
 "a50e46f2377f": {
  "kind": "cols",
  "title": "三场「一句话」过招",
  "cols": [
   {
    "head": "行思",
    "lines": [
     "圣谛尚不为",
     "何阶级之有",
     "连最高目标都放下"
    ]
   },
   {
    "head": "怀让",
    "lines": [
     "说似一物",
     "即不中",
     "一比方就跑偏"
    ]
   },
   {
    "head": "玄觉",
    "lines": [
     "生死事大",
     "无常迅速",
     "时间不等人"
    ]
   }
  ],
  "foot": [
   "三人所卡不同,慧能各接一路",
   "怀让「修证即不无,染污即不得」",
   "= 修是拨云,不是把太阳洗白"
  ]
 },
 "a9e72c363ca9": {
  "kind": "flow",
  "title": "「十万八千里」的重新换算",
  "steps": [
   {
    "head": "当下的心",
    "body": "(此岸)"
   },
   {
    "head": "十万里 = 十恶",
    "body": "除十恶,即行十万",
    "accent": true
   },
   {
    "head": "八千里 = 八邪",
    "body": "除八邪,乃过八千",
    "accent": true
   }
  ],
  "result": {
   "head": "西方",
   "body": "「到如弹指」"
  },
  "foot": [
   "路不是用脚走的,是用「改毛病」走的"
  ]
 },
 "a9f36e47d686": {
  "kind": "cols",
  "title": "坐禅 与 心悟：形式与本事",
  "cols": [
   {
    "head": "坐",
    "lines": [
     "身体的姿势",
     "可以是助缘",
     "像跑鞋、像健身卡",
     "坐对了未必悟"
    ]
   },
   {
    "head": "悟",
    "lines": [
     "心地的事",
     {
      "head": "才是那件事本身"
     },
     "不来不去、不生不灭",
     "走着站着都在"
    ]
   }
  ],
  "foot": [
   "把「坐」当成「悟」→ 穿再贵的跑鞋不跑，还是不会瘦"
  ]
 },
 "aa4fa523146a": {
  "kind": "quote",
  "title": "付嘱品",
  "text": "此宗本无诤\n诤即失道意",
  "source": "——《坛经·付嘱品》真假动静偈"
 },
 "ac8affcc0d87": {
  "kind": "rows",
  "title": "护法品的对话结构：一场隔空的四来回",
  "items": [
   {
    "head": "薛简问·坐禅",
    "body": "道由心悟",
    "accent": true
   },
   {
    "head": "问·一灯燃百灯",
    "body": "道无明暗",
    "accent": true
   },
   {
    "head": "问·智慧照破烦恼",
    "body": "烦恼即菩提",
    "accent": true
   },
   {
    "head": "问·不生灭异外道否",
    "body": "本自无生",
    "accent": true
   }
  ],
  "foot": [
   "薛简一路带着朝廷的成见来问，惠能一路把成见拆掉"
  ]
 },
 "adf9d0187728": {
  "kind": "rows",
  "title": "五分法身香:五炷点不着的香",
  "items": [
   {
    "head": "戒香",
    "body": "心里没有恶念、嫉妒、贪嗔、害人之心"
   },
   {
    "head": "定香",
    "body": "顺境逆境当前，自心不乱"
   },
   {
    "head": "慧香",
    "body": "敬上念下、矜恤孤贫，修善而不执著"
   },
   {
    "head": "解脱香",
    "body": "不思善、不思恶，自在无碍"
   },
   {
    "head": "解脱知见香",
    "body": [
     "不沉空守寂，广学多闻、和光接物，",
     "回到人群里，真性不变"
    ]
   }
  ]
 },
 "b478e1bc09e3": {
  "kind": "cols",
  "cols": [
   {
    "head": "坐",
    "lines": [
     "外·善恶境界",
     "心念不起",
     "(对外不攀)"
    ]
   },
   {
    "head": "禅",
    "lines": [
     "内·见自性",
     "不动",
     "(向内不乱)"
    ]
   }
  ]
 },
 "b480f925a2ab": {
  "kind": "rows",
  "title": "先认这一品的四个字",
  "items": [
   {
    "mark": "胡",
    "head": "hú",
    "body": "「胡跪」，当时的一种跪礼"
   },
   {
    "mark": "薰",
    "head": "xūn",
    "body": "同「熏」，向内熏染、涵养"
   },
   {
    "mark": "憍",
    "head": "jiāo",
    "body": "同「骄」，「憍诳」即骄慢欺诳"
   },
   {
    "mark": "衍",
    "head": "qiān",
    "body": "此处同「愆」，过失、过错"
   }
  ]
 },
 "b7b82d6e8104": {
  "kind": "notes",
  "title": "「依言背义」的病·图解",
  "lines": [
   "经文的字（言）",
   "「佛性是常」",
   "→",
   "抠死字面",
   "常＝僵死固定 → 永不可变",
   "无常＝断灭 → 啥都没了",
   "（两头抠成极端·纵览千遍无益）",
   "经文的意（义）",
   "人人可转、可成佛",
   "→",
   "直取本意",
   "佛性「可变」，迷才能转悟",
   "读书接「义」不抠「言」——背菜谱背得再熟，不接火候手感也炒糊"
  ]
 },
 "b89c3d7196b6": {
  "kind": "rows",
  "title": "五叹「何期自性」",
  "items": [
   {
    "mark": "净",
    "head": "本自清净",
    "body": "本来就干净,不用刷",
    "accent": true
   },
   {
    "mark": "恒",
    "head": "本不生灭",
    "body": "不来不去,不生不死"
   },
   {
    "mark": "足",
    "head": "本自具足",
    "body": "什么都不缺,不假外求"
   },
   {
    "mark": "定",
    "head": "本无动摇",
    "body": "稳稳当当,不被境牵"
   },
   {
    "mark": "生",
    "head": "能生万法",
    "body": "万事万物,由此而起",
    "accent": true
   }
  ],
  "foot": [
   "惠能大悟时,一口气认出的五件事"
  ]
 },
 "c068fa9bc847": {
  "kind": "rows",
  "title": "先认这一品的几个字",
  "items": [
   {
    "mark": "麓",
    "head": "lù",
    "body": "山脚；「林麓」即山林间",
    "accent": true
   },
   {
    "mark": "阙",
    "head": "què",
    "body": "宫阙、朝廷；「归阙」即回宫",
    "accent": true
   },
   {
    "mark": "谢",
    "head": "xiè",
    "body": "「代谢」即更替交代，新旧相代",
    "accent": true
   },
   {
    "mark": "摩纳",
    "head": "mó nà",
    "body": "一种细软的贵重衣料",
    "accent": true
   }
  ]
 },
 "c229205df011": {
  "kind": "cols",
  "title": "道须通流 · 两种心",
  "cols": [
   {
    "head": "心住法 · 自缚",
    "lines": [
     "石头堵河 → 死水",
     "坐成木头 · 障道"
    ]
   },
   {
    "head": "心不住法 · 通流",
    "accent": true,
    "lines": [
     "河水畅流 → 活水",
     "行住坐卧 · 直心"
    ]
   }
  ],
  "foot": [
   "「心不住法，道即通流；心若住法，名为自缚。」"
  ]
 },
 "c4b4b813a0b9": {
  "kind": "cols",
  "title": "三无 · 于中而离",
  "cols": [
   {
    "head": "无念（宗）",
    "lines": [
     "于念而无念",
     "念如飘云",
     "来去不追"
    ]
   },
   {
    "head": "无相（体）",
    "lines": [
     "于相而离相",
     "橱窗尽收",
     "不被勾魂"
    ]
   },
   {
    "head": "无住（本）",
    "lines": [
     "念念不住",
     "不思酬害",
     "不思前境"
    ]
   }
  ],
  "foot": [
   "念念相续不断 → 系缚",
   "念念不住其上 → 无缚"
  ]
 },
 "c61f00d4bf8a": {
  "kind": "flow",
  "title": "好的传承：不是递拐杖，是撤拐杖",
  "steps": [
   {
    "head": "靠「衣钵」这件信物证明正宗"
   },
   {
    "head": "惠能：衣钵到我为止，不传了"
   }
  ],
  "result": {
   "head": "信根淳熟，不必再靠外物证明",
   "accent": true
  },
  "foot": [
   "像好老师盼学生超过自己、好父母盼孩子走远",
   "培养一个人的终极目标，是让他不再需要你"
  ]
 },
 "cb640fcc6f6b": {
  "kind": "cols",
  "cols": [
   {
    "head": "常人以为的「坐禅」",
    "lines": [
     "身体不动",
     "把念头摁死",
     "守住「一片净」",
     "向外求一个境界"
    ]
   },
   {
    "head": "慧能说的「坐禅」",
    "lines": [
     "心念不起",
     "见境而心不乱",
     "本性本来就净",
     "向内见自性不动"
    ]
   }
  ]
 },
 "dd726fed5ce0": {
  "kind": "quote",
  "text": "起心著净\n却生净妄",
  "source": "《坛经·坐禅品》"
 },
 "de28099247c6": {
  "kind": "rows",
  "title": "定慧 · 灯与光",
  "items": [
   {
    "mark": "灯",
    "head": "定·体·稳"
   },
   {
    "mark": "光",
    "head": "慧·用·亮",
    "accent": true
   },
   {
    "head": "一盏灯，通电即同时"
   },
   {
    "head": "名虽有二"
   },
   {
    "head": "体本同一",
    "accent": true,
    "body": [
     "不是先定后慧",
     "也不是先慧后定"
    ]
   }
  ],
  "foot": [
   "内外一种，定慧即等"
  ]
 },
 "df388aa5284a": {
  "kind": "cols",
  "cols": [
   {
    "head": "向上使劲(常人)",
    "lines": [
     "去「造」一个清净",
     "给心不断「加」",
     "越用力越紧"
    ]
   },
   {
    "head": "向下松手(慧能)",
    "accent": true,
    "lines": [
     "清净本自具足",
     "把妄念「减」掉",
     "妄息则自净"
    ]
   }
  ]
 },
 "e4d431e37211": {
  "kind": "tree",
  "title": "六祖拆解「摩诃般若波罗蜜」",
  "root": {
   "head": "摩诃般若波罗蜜",
   "body": "梵语咒名，人人本自有",
   "accent": true
  },
  "branches": [
   {
    "head": "摩诃 = 大",
    "body": "心量如虚空 能容，不被染"
   },
   {
    "head": "般若 = 智慧",
    "body": "念念不愚 一念智即生"
   },
   {
    "head": "波罗蜜 = 到彼岸",
    "body": "离境无生灭 松手即水长流"
   }
  ],
  "foot": [
   "见性：般若无形相，智慧心即是",
   "不在口念、不向外求，只在自心当下",
   "口念心不行＝念菜单 ｜ 口念心行＝真吃饭",
   "关键落点始终是「心行」二字"
  ]
 },
 "f6088a688223": {
  "kind": "cols",
  "title": "两种思路：砍烦恼 vs 认烦恼",
  "cols": [
   {
    "head": "智慧 ⚔ 烦恼",
    "lines": [
     "当成两样东西",
     "拿这个破那个",
     "越砍越累（羊鹿之机）"
    ]
   },
   {
    "head": "烦恼 = 菩提",
    "lines": [
     "同一颗心两种态",
     "一转即是，如冰化水",
     "这仗根本不必打（大根）"
    ],
    "accent": true
   }
  ],
  "foot": [
   "最高的解决，是让问题根本不成为问题",
   "据《坛经·护法品》「烦恼即是菩提」一段"
  ]
 },
