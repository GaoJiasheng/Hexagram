  "title": "佛 遗 教 经 · 总 纲",
  "text": "戒为第一\n安隐功德住处",
  "gloss": "—— 临终所托,以规矩为依归"
 },
 "97712bedd290": {
  "kind": "flow",
  "title": "戒 · 定 · 慧 —— 一条向上的链",
  "steps": [
   {
    "head": "戒",
    "body": "把行为管住 · 打地基",
    "accent": true
   },
   {
    "head": "定",
    "body": "心静下来"
   },
   {
    "head": "慧",
    "body": "看清真相"
   }
  ]
 },
 "9bb269cfda28": {
  "kind": "rows",
  "title": "本章「制心」的五个比喻",
  "items": [
   {
    "head": "① 牧牛执杖",
    "body": "看着它,该拦就拦",
    "accent": true
   },
   {
    "head": "② 手执蜜器",
    "body": "只盯甜头,不见深坑",
    "accent": true
   },
   {
    "head": "③ 狂象无钩",
    "body": "失控横冲,需有钩制",
    "accent": true
   },
   {
    "head": "④ 猿猴得树",
    "body": "上蹿下跳,一刻不停",
    "accent": true
   },
   {
    "head": "⑤ 制之一处",
    "body": "专注一点,无事不办",
    "accent": true
   }
  ]
 },
 "c078c7b5b317": {
  "kind": "cols",
  "title": "「知足」的反转 —— 富贫不在外",
  "cols": [
   {
    "head": "知 足",
    "lines": [
     "虽卧地上",
     "犹为安乐",
     "虽贫而富"
    ]
   },
   {
    "head": "不 知 足",
    "lines": [
     "虽处天堂",
     "亦不称意",
     "虽富而贫"
    ]
   }
  ],
  "foot": [
   "富不富,不看有多少,看心里够不够"
  ]
 }
}
