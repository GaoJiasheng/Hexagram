 "8a57f2246c2c": {
  "kind": "tree",
  "title": "这首歌反复在说的一件事",
  "root": {
   "head": "本来就在的自性",
   "body": "(佛性 · 法身 · 本源)",
   "accent": true
  },
  "branches": [
   {
    "head": "不用去除妄想",
    "body": "删念头是做减法"
   },
   {
    "head": "不用求取真理",
    "body": "求真理是做加法"
   },
   {
    "head": "不用刻意用功",
    "body": "使劲是更大的折腾"
   }
  ],
  "foot": [
   "加减法都停下 → 那个本来的它自己就显出来了",
   "据《永嘉证道歌》开篇数句梳理"
  ]
 },
 "9e683ce6516c": {
  "kind": "cols",
  "title": "对付念头的两种脑回路",
  "cols": [
   {
    "head": "常人:除妄想",
    "lines": [
     "念头来了 → 想删它",
     "删的动作 = 又一个念头",
     "越删越多 → 更累",
     "像伸手抹平水波",
     "一抹又起新波"
    ]
   },
   {
    "head": "闲道人:不除",
    "accent": true,
    "lines": [
     "念头来了 → 看着它",
     "不追、不删",
     "不搅它 → 自己平",
     "像把手放下",
     "水面自己静"
    ]
   }
  ],
  "foot": [
   "据『不除妄想不求真』一句的两种态度对照"
  ]
 }
}
