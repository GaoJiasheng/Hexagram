   },
   {
    "head": "孝之终",
    "lines": [
     "关键词",
     "立身 · 显父母",
     "境界：一生的志业",
     "范围：光荣反射回父母"
    ],
    "accent": true
   }
  ]
 },
 "40328d562a0a": {
  "kind": "rows",
  "title": "敬一人，动一张网",
  "items": [
