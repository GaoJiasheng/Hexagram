 "5e9cb4adf899": {
  "kind": "cols",
  "title": "求在我者 · 求在外者",
  "cols": [
   {
    "head": "求在我者",
    "accent": true,
    "lines": [
     "仁义 · 厚道 · 正直",
     "守身向内",
     "求则得之，舍则失之",
     {
      "head": "求有益于得",
      "accent": true
     },
     "→ 由己，向内用力"
    ]
   },
   {
    "head": "求在外者",
    "lines": [
     "官位 · 财富",
     "别人的认可",
     "求之有道，得之有命",
     "求无益于得",
     "→ 尽其在己，不强求"
    ]
   }
  ]
 },
 "61e060408923": {
  "kind": "cols",
  "cols": [
   {
