 "17ad5c182f5d": {
  "kind": "tree",
  "title": "「封象有庳」：私情与公义如何两全",
  "root": {
   "head": "舜（天子）",
   "accent": true
  },
  "branches": [
   {
    "head": "象：有封号·收贡税",
    "body": [
