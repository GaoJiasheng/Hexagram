 },
 "332b911085fc": {
  "kind": "flow",
  "title": "孟子治国的「层层递进」",
  "steps": [
   {
    "head": "性善 · 人心本有善苗",
    "accent": true
   },
   {
    "head": "恒产 —— 先给百姓家业"
   },
   {
    "head": "恒心 —— 心才稳得住"
   }
  ],
  "result": {
   "head": "井田定产 + 庠序明人伦 = 王道"
  },
  "loop": false
 },
 "35d01a8e4354": {
  "kind": "rows",
  "title": "性善论的三层，缺一层就误读孟子",
  "items": [
   {
    "mark": "一",
    "head": "善是「自带」的，不是外加的",
    "body": "四端「我固有之」· 反驳告子的柳条/浇铸说",
    "accent": true
   },
   {
    "mark": "二",
    "head": "善是「种子」，不是果实",
    "body": "要养、要思、要求、要熟 · 性善＝可能性＋责任，非免责声明",
    "accent": true
   },
   {
    "mark": "三",
    "head": "善会「丢」，丢了还能找回来",
    "body": "牛山会秃 · 本心会放 · 但「求则得之」，永远有回头路",
    "accent": true
   }
  ],
  "foot": [
   "只记住「人性本善」四字而漏掉二、三层，就把论断读成了免责声明"
  ]
 },
 "3ecd04386df0": {
  "kind": "cols",
  "title": "经与权:同是「援」,所用不同",
  "cols": [
   {
    "head": "嫂溺",
    "lines": [
