 "f9c96472f7ba": {
  "kind": "quote",
  "text": "虚盛之治，相背千里；\n吉凶之机，应若影响。",
  "source": "《伤寒论·伤寒例第三》",
  "foot": [
   "例"
  ]
 },
 "f9cfa7a7d83e": {
  "kind": "tree",
  "title": "「投石问路」：大动作之前，先小成本探一下",
  "root": {
   "head": "先小小地试探一下",
   "body": "拿不准是否已结实",
   "accent": true
  },
  "branches": [
   {
    "head": "有反应(转矢气)",
    "body": "→ 确有结实，可攻"
   },
   {
    "head": "无反应",
    "body": "→ 尚未结实，不可攻"
   }
  ]
 },
 "fd9756ee9ce7": {
  "kind": "rows",
  "title": "「一顿操作」之后，身体可能滑向的几个方向",
  "items": [
   {
    "head": "水停 —— 渴却水入则吐，名曰「水逆」"
   },
   {
    "head": "扰心 —— 虚烦不得眠，反复颠倒"
   },
   {
    "head": "伤阳 —— 昼日烦躁、脉沉微，内外俱虚"
   },
   {
    "head": "邪陷半表半里 —— 往来寒热，胸胁苦满"
   }
  ],
  "foot": [
   "据本篇诸「发汗后/下之后」条归纳，仅呈现辨证脉络，非诊疗方案"
  ]
 },
 "ff2e0aff4630": {
  "kind": "tree",
  "title": "同是「差后更发热」，脉一分岔",
  "root": {
   "head": "病好了又发热"
  },
  "branches": [
   {
    "head": "脉浮",
    "body": "邪在浅表 → 向外透（汗）",
    "accent": true
   },
   {
    "head": "脉沉实",
    "body": "结在里头 → 向下导"
   }
  ],
  "foot": [
   "发热是症状，脉浮脉沉才是路标",
   "据本篇三九四条示辨证之理，非用药指导"
  ]
 }
