 "f5312d118be6": {
  "kind": "quote",
  "text": "自利不渴者，属太阴",
  "gloss": "拉肚子却不口渴——寒证的关键眼目",
  "source": "《伤寒论·辨太阴病脉证并治》第二七七条"
 },
 "f94a1e343311": {
  "kind": "tree",
  "title": "同是「谵语」，病机相反",
