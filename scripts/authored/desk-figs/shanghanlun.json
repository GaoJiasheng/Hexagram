    "mark": "②",
    "head": "宿食，在上脘者",
    "body": "停食的位置偏高"
   },
   {
    "mark": "③",
    "head": "手足厥冷、脉乍结，客气在胸中",
    "body": "假象在四肢，病定位在胸中"
   }
  ],
  "foot": [
   "共同判据：病位在「上」"
  ]
 },
