 "25c79b3ae400": {
  "kind": "cols",
  "title": "同叫「结」，一阳一阴，路数正相反",
  "cols": [
   {
    "head": "阳 结",
    "accent": true,
    "lines": [
     "脉浮而数",
     "能食",
     "不大便",
     "古人归为「实」"
    ]
   },
   {
    "head": "阴 结",
    "lines": [
     "脉沉而迟",
     "不能食、身重",
     "大便反硬",
     "古人归为「阴」"
    ]
   }
  ],
  "foot": [
