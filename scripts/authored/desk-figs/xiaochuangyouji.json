     "无米之炊也做成",
     "当大计而扬眉",
     "品由心定",
     {
      "head": "遇事见真章",
      "accent": true
     }
    ]
   },
   {
    "head": "假 英 雄",
    "lines": [
     "靠意气嗓门",
     "专吷不鸣之剑",
     "遇真人而落胆",
     "故为玩世欺世",
     "一照面就露馅"
    ]
   }
  ]
 },
