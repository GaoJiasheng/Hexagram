 "d17371ceab00": {
  "kind": "quote",
  "title": "小 窗 幽 记 · 集 情",
  "text": "当为情死\n不当为情怨"
 },
 "da72cd5e0e43": {
  "kind": "rows",
  "title": "《集醒》里的五味醒酒方",
  "items": [
   {
    "mark": "藏",
    "head": "藏巧于拙，用晦而明——聪明不必写在脸上"
   },
   {
    "mark": "试",
    "head": "澹泊镇定，须从秾艳纷纭场中试炼出来"
   },
   {
    "mark": "恕",
    "head": "攻人毋太严，教人莫过高——给人留余地"
   },
   {
    "mark": "稳",
    "head": "花繁柳密拨得开，风狂雨急立得定"
   },
   {
    "mark": "长",
    "head": "伏久者飞必高，知足者身贫心富——看长线"
   }
  ]
 },
 "def4e5b09f2a": {
  "kind": "quote",
  "text": "不恨我不见古人\n惟恨古人不见我",
  "source": "《小窗幽记·集豪第十》",
  "foot": [
   "集 豪"
  ]
 },
 "e0d4751473b4": {
  "kind": "cols",
  "title": "豪 之 三 征",
  "cols": [
   {
    "head": "胆",
    "lines": [
     "家徒四壁",
     "一掷千金"
    ]
   },
   {
    "head": "才",
    "lines": [
     "兴酣落笔",
     "泼墨千言"
    ]
   },
   {
    "head": "语",
    "lines": [
     "我才必用",
     "黄金复来"
    ]
   }
  ]
 },
 "e5913688f85c": {
  "kind": "quote",
  "text": "闭门即是深山\n读书随处净土",
  "source": "《小窗幽记 · 集灵》"
 },
 "e9b6de29ff72": {
  "kind": "cols",
  "title": "两把尺子:对己一把,对人一把",
  "cols": [
   {
    "head": "对自己 —— 严",
    "lines": [
     "礼义廉耻,拿来律己",
     "立身高一步",
     "昼观诸妻子,夜卜诸梦寐",
     "求真知于自己",
     "从战战兢兢来"
    ],
    "accent": true
   },
   {
    "head": "对别人 —— 宽",
    "lines": [
     "礼义廉耻,不可绳人",
     "处世退一步",
     "于有过中求无过",
     "恩可念,仇可忘",
     "觉诈受侮,不形于色"
    ]
   }
  ]
 },
 "f41676b74f0d": {
  "kind": "cols",
  "title": "长安风雪夜 · 一庙之内两种人",
  "cols": [
   {
    "head": "古庙冷铺 · 乞儿丐僧",
    "lines": [
     "身上：一件破衣",
     "心里：空空的",
     "齁齁如雷",
     "睡得香甜"
    ]
   },
   {
    "head": "拥锦下帷 · 白髭贵人",
    "lines": [
     "身上：锦被暖帐",
     "心里：装得太满",
     "求一合眼不得",
     "整夜睁眼"
    ]
   }
  ],
  "foot": [
   "vs",
   "让人睡不着的，从来不是穷，是心里放不下"
  ]
 },
 "f7af71b25e3c": {
  "kind": "tree",
  "title": "醒的心法：内精明 · 外浑厚",
  "root": {
   "head": "德量",
   "body": "生成的"
  },
  "branches": [
   {
    "head": "内精明",
    "body": "好丑贤愚，心里看得清",
    "accent": true
   },
   {
    "head": "外浑厚",
    "body": "看清了，脸上不挂出来",
    "accent": true
   }
  ],
  "foot": [
   "好丑两得其平，贤愚共受其益"
  ]
 },
 "fbcc743a948d": {
  "kind": "cols",
  "title": "同「以一物著名」，局面相去甚远",
  "cols": [
   {
    "head": "赵飞燕",
    "lines": [
     "仙风留于绉裙",
     "歌舞自赏 · 极致风韵",
     {
      "head": "审美之倩",
      "accent": true
     }
    ]
   },
   {
    "head": "韩昭侯",
    "lines": [
     "俭德昭于敝裤",
     "颦笑不轻 · 内敛操守",
     {
      "head": "德行之倩",
      "accent": true
     }
    ]
   }
  ],
  "foot": [
   "作者不评谁高谁低——动人的韵致，不止一种"
  ]
 }
