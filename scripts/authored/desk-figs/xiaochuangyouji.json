 "0ccb69ccd8ea": {
  "kind": "cols",
  "title": "同样焚香啜茗，分水岭在哪",
  "cols": [
   {
    "head": "假 韵",
    "lines": [
     "清凉在口",
     "尘俗在心",
     "道具摆得越全越像",
     "俨然自附于韵",
     "如老妪念佛便云成佛"
    ]
   },
   {
    "head": "真 韵",
    "lines": [
     "俗尘扫去",
     "目明耳聪",
     "器物疏疏落落才得致",
     "看进了眼前的青山",
     "动作止于心，心动才算"
    ]
   }
  ]
 },
 "0fe4bcf030eb": {
  "kind": "quote",
  "title": "倩",
  "text": "鄙吝一消，白云亦可赠客；\n渣滓尽化，明月亦来照人。",
  "gloss": "心里的小算计一空，不要钱的天地反而全来了",
  "source": "《小窗幽记·集倩》"
 },
 "195201543cf3": {
  "kind": "quote",
  "text": "脸上三斗俗尘，何时扫去？\n韵之一字，其世人对症之药乎？",
  "gloss": "韵不是锦上添花的装饰，是给满面俗尘的人开的一味药",
  "source": "《小窗幽记 · 集韵第七》"
 },
 "2703ce85fb2a": {
  "kind": "flow",
  "title": "「倩」是怎么生出来的",
  "steps": [
   {
    "head": "洗心涤虑",
    "body": "放下鄙吝渣滓"
   },
   {
    "head": "心闲无累",
    "body": "不被俗情占满"
   },
   {
    "head": "会心相遇",
    "body": "心与景一拍即合"
   },
   {
    "head": "万物呈倩",
    "body": "花月皆成故人",
    "accent": true
   }
  ],
  "foot": [
   "据《小窗幽记·集倩》\"非有洗心涤虑…不可独契此语\"归纳"
  ]
 },
