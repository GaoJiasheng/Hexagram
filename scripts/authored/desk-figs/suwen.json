 "cfc7a87d261f": {
  "kind": "cols",
  "title": "病机十九条 · 归纳的三类枢纽（文献训读，非诊断）",
  "cols": [
   {
    "head": "归 五脏",
    "lines": [
     "诸风掉眩 → 肝",
     "诸寒收引 → 肾",
     "诸气郁 → 肺",
     "诸湿肿满 → 脾",
     "诸痛痒疮 → 心"
    ]
   },
   {
    "head": "归 上下",
    "lines": [
     "诸厥固泄 → 下",
     "诸痿喘呕 → 上",
     "以「部位」为枢纽"
    ]
   },
   {
    "head": "归 六气",
    "lines": [
     "诸暴强直 → 风",
     "诸痉项强 → 湿",
     "诸胀腹大 → 热",
     "诸病水液清冷 → 寒",
     {
      "head": "诸热瞀瘛、诸躁狂越 → 火",
      "accent": true
     }
    ]
   }
  ],
  "foot": [
   "句式：诸（各种）…… 皆属于 ……",
   "把无穷的现象，归到有限的枢纽上——十九条中「火/热」占了近半",
   "（本图为文献结构示意，不作病症判断之用）"
  ]
 },
