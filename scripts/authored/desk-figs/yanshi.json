     "微行险服显摆",
     {
      "head": "→ 遂无免者 ✗",
      "accent": true
     }
    ]
   }
  ]
 },
 "99474e069e3f": {
  "kind": "cols",
  "title": "同一对兄弟，两个人生阶段",
  "cols": [
   {
    "head": "幼时 · 方其幼也",
    "accent": true,
    "lines": [
     "食则同案",
     "衣则传服",
     "学则连业",
     "游则共方",
     {
      "head": "坏人也「不能不相爱」",
      "accent": true
     }
    ]
   },
   {
    "head": "成年 · 及其壮也",
    "lines": [
     "各妻其妻",
     "各子其子",
     "各立门户",
     "各有重心",
     "好人也「不能不少衰」"
    ]
   }
  ],
  "foot": [
