 "dca4d7f0d86b": {
  "kind": "cols",
  "title": "「染」的两个方向",
  "cols": [
   {
    "head": "与善人居",
    "lines": [
     "如入芝兰之室",
     {
      "head": "久而自芳",
      "accent": true
     },
     "无意求香 · 香自上身",
     "白丝投青则青"
    ]
   },
   {
    "head": "与恶人居",
    "lines": [
     "如入鲍鱼之肆",
     "久而自臭",
     "无心向坏 · 臭自上身",
     "白丝投黄则黄"
    ]
   }
  ]
 },
 "e038d31953b9": {
  "kind": "tree",
  "title": "颜之推的一把尺：礼缘人情",
  "root": {
   "head": "真情（本）",
   "accent": true,
   "body": "礼·风操（表达真情的形式）"
  },
  "branches": [
   {
    "head": "形式 ≤ 真情",
    "body": [
     "合情，可取",
     "迎送作揖·称名"
    ]
   },
   {
    "head": "形式 > 真情",
    "body": [
     "过事，可笑",
     "闻讳必哭·辰日不哭"
    ]
   }
  ],
  "foot": [
   "同一篇里反复用这把尺称量每条规矩——《风操第六》"
  ]
 },
 "e6840a4b52f5": {
  "kind": "rows",
  "title": "三种人对名声的态度",
  "items": [
   {
    "mark": "上士",
    "head": "忘名",
    "body": [
     "体道合德,根本没把名当回事",
     "名是顺带来的结果"
    ],
    "accent": true
   },
   {
    "mark": "中士",
    "head": "立名",
    "body": [
     "真修身,但在乎被人看见",
     "事是真的,掺了点想被看见"
    ]
   },
   {
    "mark": "下士",
    "head": "窃名",
    "body": [
     "厚貌深奸,直接造假名",
     "压根得不到真名声 · 全篇批判对象"
    ],
    "accent": true
   }
  ]
 },
 "e705e73b329c": {
  "kind": "cols",
  "title": "颜之推反的不是「读书」，是「读书的悬空」",
  "cols": [
   {
    "head": "他批评的",
    "lines": [
     "高谈虚论",
     "品藻古今",
     "左琴右书",
     "学问悬空，不沾实务"
    ]
   },
   {
    "head": "他要的",
    "lines": [
     "有益于物",
     "能守一职",
     "晓习吏用",
     "学问落地，办成实事"
    ],
    "accent": true
   }
  ]
 },
 "e8a2c38eaba0": {
  "kind": "cols",
  "title": "南北续室之俗 · 两种结构两种后果",
  "cols": [
   {
    "head": "江左(南方)",
    "accent": true,
    "lines": [
     "不讳庶孽",
     "妻死 → 以妾媵终家事",
     "嫡庶名分 = 缓冲带",
     "结果",
     "疥癣蚊虻之小摩擦",
     "稀鬬阋之耻"
    ]
   },
   {
    "head": "河北(北方)",
    "accent": true,
    "lines": [
     "鄙于侧出",
     "妻死 → 必须重娶三四回",
     "母年或少于子",
     "结果",
     {
      "head": "辞讼盈公门",
      "accent": true
     },
     {
      "head": "谤辱彰道路",
      "accent": true
     }
    ]
   }
  ]
 },
 "ea69c2138e78": {
  "kind": "flow",
  "title": "《归心第十六》的三大块",
  "steps": [
   {
    "head": "①总论",
    "body": "佛儒「本为一体」 · 五戒即仁义礼智信 · 背释归孔是迷",
    "accent": true
   },
   {
    "head": "②五条申辩（主体）",
    "body": [
     "释一 · 答「神化荒诞」——你连天地都没弄懂，凭什么断言宇宙外无物",
     "释二 · 答「报应不灵」——善恶有报，迟早而已，业缘未到",
     "释三 · 答「僧尼不纯」——拿戒律比《诗》《礼》，谁又做全了",
     "释四 · 答「损耗国力」——错在为政不节制，非佛教本旨"
    ],
    "accent": true
   }
  ],
  "result": {
   "head": "③落到戒杀",
   "body": "释五（精神不灭）+ 儒者亦戒杀（高柴、折像）+ 七则好杀遭报的故事",
   "accent": true
  },
  "loop": false
 },
 "ea9262baec34": {
  "kind": "cols",
  "title": "谁的话更管用？",
  "cols": [
   {
    "head": "身份高 · 离得远",
    "lines": [
     {
      "head": "师友之诫",
      "body": "劝顽童别闹"
     },
     {
      "head": "尧舜之道",
      "body": "劝人别争斗"
     }
    ]
   },
   {
    "head": "身份低 · 离得近",
    "accent": true,
    "lines": [
     {
      "head": "傅婢之指挥",
      "body": "奶娘一句话"
     },
     {
      "head": "寡妻之诲谕",
      "body": "妻子一劝"
     }
    ]
   }
  ],
  "foot": [
   "决定话有没有用的，是'亲'与'服'，不在身份高低"
  ]
 },
 "ec913e7037c5": {
  "kind": "rows",
  "title": "颜之推的「知足清单」(以二十口之家为准)",
  "items": [
   {
    "head": "奴婢",
    "body": "不超过二十人"
   },
   {
    "head": "良田",
    "body": "十顷为限"
   },
   {
    "head": "堂室",
    "body": "能遮风避雨即可"
   },
   {
    "head": "车马",
    "body": "够代步即可"
   },
   {
    "head": "蓄财",
    "body": "数万,够应急即可"
   },
   {
    "head": "超过这条线",
    "body": "以义散之 · 分出去",
    "accent": true
   },
   {
    "head": "不到这条线",
    "body": "勿非道求 · 不歪门捞"
   }
  ]
 },
 "f1f40846a83c": {
  "kind": "quote",
  "text": "蓬生麻中，\n不劳翰墨。",
  "source": "风操第六"
 },
