  ]
 },
 "76b8ac46b4bb": {
  "kind": "quote",
  "text": "名之与实\n犹形之与影也",
  "gloss": "身子立住了,影子自然周正",
  "source": "《颜氏家训 · 名实第十》"
 },
 "7b1cb4933e4c": {
  "kind": "flow",
  "title": "「半桶水」文士 · 两种时局，同一结局",
  "steps": [
   {
    "head": "颇读兵书，微有经略"
   },
   {
    "head": "承平之世",
    "body": [
     "睥睨宫阃 · 首为逆乱",
     "幸灾乐祸 · 诖误善良"
    ]
   },
   {
    "head": "兵革之时",
    "body": [
     "构扇反复 · 纵横说诱",
     "不识存亡 · 强相扶戴"
