  ]
 },
 "9b308abd7bfa": {
  "kind": "quote",
  "title": "文 章 第 九 · 金 句",
  "text": "文章当以理致为心肾，\n华丽为冠冕。",
  "gloss": "思想是命根，辞藻是帽子 —— 顺序不能乱"
 },
 "9bbea85c0613": {
  "kind": "rows",
  "title": "四面镜子 · 颜之推的案例库",
  "items": [
   {
    "head": "正例 · 王僧辩与魏夫人",
    "body": [
     "年逾四十,母仍捶挞之",
     "→ 终生严格,故成勋业",
     "(手段属古代,取其『一以贯之』)"
    ],
    "accent": true
   },
   {
    "head": "反例 · 梁元帝时的学士",
    "body": [
     "夸过失、掩其非,冀其自改",
     "→ 暴慢日滋",
     "→ 为周逖抽肠衅鼓"
    ]
   },
   {
    "head": "反例 · 共叔段",
    "body": [
     "母偏爱怂恿 → 谋反身死",
     "『母实为之』"
    ]
   },
   {
    "head": "反例 · 赵王如意",
    "body": [
     "父偏宠招祸 → 被戮",
     "『父实使之』"
    ]
   }
  ],
  "foot": [
   "一正三反:严而有恒者成,偏宠纵容者覆"
  ]
 },
 "9e916b054647": {
  "kind": "flow",
  "title": "养生第十五 · 三段递进",
  "steps": [
   {
    "head": "第一段",
    "body": [
     "辨真伪",
     "成仙不可信，调养却有用",
     "破除长生迷信，保留顺养禀赋"
    ],
    "accent": true
   },
   {
    "head": "第二段",
    "body": [
     "虑祸根",
     "养生先须虑祸，保命比保养更根本",
     "先有这条命，才谈得上养它"
    ],
    "accent": true
   }
  ],
  "result": {
   "head": "第三段",
   "body": [
    "立底线",
    "命要惜，却不可苟惜",
    "有些东西，比命更重"
   ],
   "accent": true
  },
  "loop": false
 },
 "9eeb986cb53f": {
  "kind": "cols",
  "title": "「贵耳贱目」之蔽是怎么运作的",
  "cols": [
   {
    "head": "身边的人（近）",
    "lines": [
     "看得见缺点、狼狈、人味",
     "↓ 敬意被不断稀释",
     "结果：相狎侮，不加礼敬",
     {
      "head": "东家丘 · 宫之奇",
      "accent": true
     },
     "圣人被轻称 / 贤臣谏不纳"
    ]
   },
   {
    "head": "远方的人（遥）",
    "lines": [
     "只听得到美化的「风声」",
     "↓ 距离天然镀金",
     "结果：延颈企踵，甚于饥渴",
     "而「校其长短」",
     "或彼不能如此矣"
    ]
   }
  ]
 },
 "ae204ab803ed": {
  "kind": "cols",
  "title": "颜之推给后代排的「轻重」",
  "cols": [
   {
    "head": "朽壤 · 身后之礼",
    "lines": [
     "坟墓 · 棺椁 · 陪葬",
     "祭品 · 排场",
     "「不可顾恋」→ 一概从简"
    ]
   },
   {
    "head": "传业 · 扬名",
    "lines": [
     "把家学家业传下去",
     "让名声立起来",
     "「宜以……为务」→ 真正的要事"
    ],
    "accent": true
   }
  ],
  "foot": [
   "把分量从「守坟」挪到「传续」——这是全书最后的嘱托"
  ]
 },
 "b00df1dc9a2f": {
  "kind": "quote",
  "text": "何惜数年勤学，\n长受一生愧辱哉！",
  "gloss": "几年的辛苦，与一生的难堪；",
  "foot": [
   "舍不得这几年，便要赔上一生。"
  ]
 },
 "b7935be8b42c": {
  "kind": "cols",
  "title": "治家四案 · 因与果",
  "cols": [
   {
    "head": "反 · 失度",
    "accent": true,
    "lines": [
     {
      "head": "中书舍人 · 过严刻",
      "body": "→ 妻妾雇刺客杀之",
      "accent": true
     },
     {
      "head": "邺下领军 · 贪积",
      "body": "→ 坐事伏法，籍没家产",
      "accent": true
     },
     {
      "head": "南阳人 · 俭吝待客",
      "body": "→ 诸子争财，兄杀弟",
      "accent": true
     }
    ]
   },
   {
    "head": "正 · 有度",
    "lines": [
     {
      "head": "房文烈 · 宽而不怒",
      "body": "→ 婢逃不挞，得人心"
     },
     {
      "head": "裴子野 · 俭而收养",
      "body": "→ 同食薄粥，无厌色"
     }
    ]
   }
  ],
  "foot": [
   "宽严有度、俭而不吝者安；失度贪吝者，祸常自其家出"
  ]
 },
 "bb3bb1d3f980": {
  "kind": "cols",
  "title": "「省」与「不省」的那条线",
  "cols": [
   {
    "head": "要省的",
    "lines": [
     "多言多事",
     "上书钻营",
     "争名求官",
     "党人非义",
     "—— 为自己往上爬的事"
    ]
   },
   {
    "head": "不省的",
    "lines": [
     {
      "head": "穷鸟入怀",
      "accent": true
     },
     {
      "head": "死士归我",
      "accent": true
     },
     {
      "head": "亲友危难",
      "accent": true
     },
     {
      "head": "家财己力不吝",
      "accent": true
     },
     "—— 救人于难的事"
    ]
   }
  ]
 },
 "bf4563d8ae71": {
  "kind": "quote",
  "text": "考校是非，\n特须消息。",
  "gloss": "判断一件事的对错,尤其要反复斟酌。",
  "source": "— 《颜氏家训 · 书证第十七》"
 },
 "bf76e0aeee08": {
  "kind": "cols",
  "title": "教什么 · 两种教子观的分野",
  "cols": [
   {
    "head": "那位齐朝士大夫",
    "lines": [
     "教鲜卑语、琵琶",
     "为伏事公卿、得宠爱",
     "衡量:能否得贵人喜",
     "『亦要事也』"
    ]
   },
   {
    "head": "颜之推",
    "accent": true,
    "lines": [
     "先教做正派的人",
     "为修身、立德",
     "衡量:路子正不正",
     {
      "head": "『亦不愿汝曹为之』",
      "accent": true
     }
    ]
   }
  ],
  "foot": [
   "同一句『教子』,两条相反的路:把孩子工具化,还是教他立身"
  ]
 },
 "c19d848c6652": {
  "kind": "rows",
  "title": "颜之推自定的「薄葬清单」",
  "items": [
   {
    "head": "一张「不要什么」的清单"
   },
   {
    "mark": "入殓",
    "head": "沐浴即可，不招魂，穿常衣"
   },
   {
    "mark": "棺木",
    "head": "松木二寸，薄棺"
   },
   {
    "mark": "随葬",
    "head": "衣帽之外，一概不放",
    "body": "玉豚、锡人、明器、碑志，全免"
   },
   {
    "mark": "下葬",
    "head": "贴土而下，平地无坟",
    "body": "至多四周筑矮墙作记号"
   },
   {
    "mark": "祭品",
    "head": "白粥 · 清水 · 干枣",
    "body": "无酒肉饼果，拒亲友祭奠",
    "accent": true
   },
   {
    "mark": "底线",
    "head": "不得「有加先妣」，否则陷父不孝"
   }
  ]
 },
 "c22e7df6fac3": {
  "kind": "cols",
  "title": "学如种树：春华可观，秋实可食",
  "cols": [
   {
    "head": "春 · 华",
    "lines": [
     "讲论文章",
     "能写会说、援引古今",
     "可观 · 供人玩赏"
    ]
   },
   {
    "head": "秋 · 实",
    "lines": [
     "修身利行",
     "改变为人、落到行事",
     "可食 · 树之根本"
    ],
    "accent": true
   }
  ],
  "foot": [
   "只开花不结果，便是「华而不实」"
  ]
 },
 "c753c112e4bd": {
  "kind": "cols",
  "title": "「命」与「学」是两回事，不可混比",
  "cols": [
   {
    "head": "命之穷达",
    "lines": [
     "＝材质（金玉／木石）",
     {
      "head": "金玉 × 打磨 → 更美",
      "accent": true
     },
     "有学之人，穷亦是磨亮的金玉",
     "价值在内在质地"
    ]
   },
   {
    "head": "修以学艺",
    "lines": [
     "＝磨莹雕刻的功夫",
     "木石 × 雕刻 → 仍是木石",
     "无学之人，富亦只是未雕的料",
     "富贵是命，非关于学"
    ]
   }
  ],
  "foot": [
   "「不得以有学之贫贱，比于无学之富贵也」"
  ]
 },
 "c79b9f2d4906": {
  "kind": "cols",
  "title": "同样的聪明，两种用法",
  "cols": [
   {
    "head": "多为少善",
    "lines": [
     "力气撒一地",
     "经史文书卜医乐射…",
     "样样摸过",
     "皆不通熟"
    ]
   },
   {
    "head": "省其异端",
    "lines": [
     {
      "head": "力气压一处",
      "accent": true
     },
     "专攻一门",
     "力气集中",
     {
      "head": "当精妙也",
      "accent": true
     }
    ]
   }
  ]
 },
 "c8e1a271bff7": {
  "kind": "quote",
  "text": "世以儒雅为业，\n未有用兵以取达者。",
  "source": "诫兵第十四"
 },
 "cb6556a24bc2": {
  "kind": "cols",
  "title": "肠不可冷，腹不可热",
  "cols": [
   {
    "head": "太冷",
    "lines": [
     "杨朱之侣",
     "一毛不拔 → 无情"
    ]
   },
   {
    "head": "恰好",
    "accent": true,
    "lines": [
     "以仁义为节文",
     "该热则热，该冷则冷"
    ]
   },
   {
    "head": "太热",
    "lines": [
     "墨翟之徒",
     "无差别滥救 → 失节"
    ]
   }
  ],
  "foot": [
   "关键不在冷热，在那把叫「仁义」的尺"
  ]
 },
