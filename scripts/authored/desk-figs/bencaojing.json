 "933ddd769ee2": {
  "kind": "cols",
  "title": "「令人肥健嗜食」——一句褒奖，两个时代",
  "cols": [
   {
    "head": "汉代语境",
    "lines": [
     "肥、健、能吃 = 福",
     "常年半饥，长壮即健康",
     "故「令人肥健」是赞语"
    ]
   },
   {
    "head": "今日语境",
    "lines": [
     "「肥」多含贬义",
     "物丰之世，常言控糖减脂",
     "同一词，褒贬已翻转"
    ]
   }
  ],
  "foot": [
   "据《本草经》水斳条 · 词义随时代身体观而变"
  ]
 },
 "984e976ffd90": {
