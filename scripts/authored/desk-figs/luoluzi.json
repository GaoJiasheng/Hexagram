    ]
   },
   {
    "head": "未",
    "lines": [
     "季夏 · 六月",
     "余气：丁火",
     "（刚过去的夏）",
     "库：木",
     "（再往前的春）"
    ]
   },
   {
    "head": "戌",
    "lines": [
     "季秋 · 九月",
     "余气：辛金",
     "（刚过去的秋）",
     "库：火",
     "（再往前的夏）"
    ]
   },
