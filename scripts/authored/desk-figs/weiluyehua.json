{
 "25d4bae2601b": {
  "kind": "cols",
  "title": "先收心，再干事",
  "cols": [
   {
    "head": "收放心的工夫",
    "lines": [
     "把跑野的心收回来",
     "博学 笃志",
     "切问 近思",
     "学得扎实 · 想得就近"
    ]
   },
   {
    "head": "干大事的本领",
    "lines": [
     "越到关口越要沉住",
     "神闲 气静",
     "智深 勇沉",
     "四样都是往下压"
    ]
   }
  ],
  "foot": [
   "心先落地，事才做得成"
  ]
 },
 "7089322b33d8": {
  "kind": "quote",
  "text": "须使人不忍欺我\n勿使人不敢欺我",
  "gloss": "让人不忍心欺你，而不是不敢欺你",
  "source": "围炉夜话"
 },
 "fc4eeb428368": {
  "kind": "cols",
  "cols": [
   {
    "head": "打算精明",
    "lines": [
     "自谓得计 · 处处占便宜",
     "短线:今天占了便宜",
     "长线:人心里记着账",
     "败祖父之家声"
    ]
   },
   {
    "head": "朴实浑厚",
    "lines": [
     "初无甚奇 · 不声不响",
     "短线:看不出好处",
     "长线:人都愿跟你来往",
     "培子孙之元气"
    ]
   }
  ]
 }
}
