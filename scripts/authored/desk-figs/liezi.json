   "观道"
  ]
 },
 "ad65602e0d13": {
  "kind": "timeline",
  "title": "列子学道九年:心境的四级台阶",
  "points": [
   {
    "when": "三年",
    "head": "不敢念是非",
    "body": "(硬憋)师一眄"
   },
   {
    "when": "五年",
    "head": "更念是非",
    "body": "(放松)师一笑"
   },
   {
    "when": "七年",
    "head": "从心更无是非",
    "body": "(自然)师并席"
   },
   {
    "when": "九年",
    "head": "心凝形释",
    "body": "(忘我)理无所隐",
    "accent": true
   }
  ],
  "foot": [
