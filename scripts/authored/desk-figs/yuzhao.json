 "2ee95113ea1a": {
  "kind": "rows",
  "title": "一句经、一段注：五个零件",
  "items": [
   {
    "mark": "一",
    "head": "经 · 断语",
    "body": "四言、六言相间，一句一断：「丙北壬南，必有破逃之客」"
   },
   {
    "mark": "二",
    "head": "注 · 释名",
    "body": "把干支换成名目：「六庚为白虎」「六丙为朱雀」"
   },
   {
    "mark": "三",
    "head": "注 · 说理",
    "body": "给一个联想式的理由：「水火相易也，各离本位」"
   },
   {
    "mark": "四",
    "head": "注 · 假令",
    "body": "举一个生年配日时的例子：「丙子人，壬午日时」"
   },
   {
    "mark": "五",
    "head": "注 · 倣此",
    "body": "向外推广：「外倣此」「外颇同此」"
   }
  ],
  "foot": [
   "例句均取自本段",
   "有时另附一条退路：「不则……」「不尔……」",
   "有时挂一则异说：「又云……」"
  ]
 },
