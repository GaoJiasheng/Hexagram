 "666c3cd6f035": {
  "kind": "rows",
  "title": "一条断语的四个零件",
  "items": [
   {
    "mark": "经句",
    "head": "癸壬亥子，工巧之人。",
    "body": "四言、六言相间的短句断语，不押韵"
   },
   {
    "mark": "释词",
    "head": "壬癸主智，亥子又主智，智者主巧性。",
    "body": "先解释经句里的术语，这里是「水→智→巧」的取象链"
   },
   {
    "mark": "假令",
    "head": "假令壬子人、癸亥日时，",
    "body": "举一组干支作例，只举一个"
   },
   {
    "mark": "收尾",
    "head": "外倣此也。",
    "body": "「其余照此类推」——规则不论证，例子不多给"
   }
  ]
 },
