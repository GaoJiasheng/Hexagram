{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hexa.gavin.pub/desk/standard/schema/book.json",
  "title": "deskbook · book.json(书目清单)",
  "description": "书包格式标准 v1 §2。字数上限(x-deskbook-maxChars)按「去掉空白与 ** 后的字数」计,由校验器 deskbook.mjs 核;JSON Schema 只表达结构。",
  "type": "object",
  "required": ["format", "version", "id", "revision", "kind", "title", "authors", "lang", "summary", "source", "unit", "chapters"],
  "properties": {
    "format": { "const": "deskbook" },
    "version": { "const": 1 },
    "id": { "type": "string", "pattern": "^[ug]-[a-z0-9-]{1,62}$", "not": { "enum": ["daodejing", "lunyu", "sunzi", "guiguzi", "zhuangzi", "yijing"] }, "description": "书包 id 必须带前缀:u-<名>-<8 位十六进制>(自己做的)或 g-<名>(书房)。不带前缀的 id 留给书桌内置的官方典籍。重出不换 id。" },
    "revision": { "type": "integer", "minimum": 1 },
    "kind": { "enum": ["classic", "book", "collection"] },
    "title": { "$ref": "#/$defs/text" },
    "subtitle": { "$ref": "#/$defs/text" },
    "authors": { "type": "array", "items": { "$ref": "#/$defs/text" } },
    "lang": { "type": "string", "pattern": "^[a-z]{2,3}(-[A-Za-z0-9]{2,8})*$" },
    "summary": { "$ref": "#/$defs/text", "x-deskbook-maxChars": 60 },
    "description": { "$ref": "#/$defs/text", "x-deskbook-maxChars": 400 },
    "category": { "type": "string", "pattern": "^\\S+$", "description": "一个词。命中医学 / 命理领域须带对应 disclaimer(§6)" },
    "tags": { "type": "array", "maxItems": 8, "items": { "$ref": "#/$defs/text" } },
    "source": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": { "enum": ["original", "digest", "public-domain", "licensed"] },
        "of": {
          "type": "object",
          "required": ["title", "author"],
          "properties": {
            "title": { "$ref": "#/$defs/text" },
            "author": { "$ref": "#/$defs/text" },
            "publisher": { "$ref": "#/$defs/text" },
            "year": { "type": "integer" }
          }
        },
        "note": { "$ref": "#/$defs/text" }
      },
      "if": { "properties": { "type": { "enum": ["digest", "licensed"] } } },
      "then": { "required": ["type", "of"] }
    },
    "disclaimer": {
      "description": "medical | divination | 自写一句(每句 ≤ 120 字),或其中几项的数组。命中医学 / 命理领域须含对应值,两个都命中两个都要带(§6)",
      "x-deskbook-maxChars": 120,
      "anyOf": [
        { "$ref": "#/$defs/text" },
        { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/text" } }
      ]
    },
    "unit": { "$ref": "#/$defs/text" },
    "theme": {
      "type": "object",
      "description": "三项都可单独缺,缺的用书桌默认色",
      "properties": {
        "accent": { "$ref": "#/$defs/color" },
        "accent2": { "$ref": "#/$defs/color" },
        "paper": { "$ref": "#/$defs/color" }
      }
    },
    "cover": { "$ref": "#/$defs/image", "description": "建议竖版 2:3(偏差超 5% 校验器提示),不带文字" },
    "banner": { "$ref": "#/$defs/image", "description": "建议横版 3:2(偏差超 5% 校验器提示),不带文字" },
    "parts": {
      "type": "array",
      "minItems": 1,
      "description": "须连续覆盖全部章(校验器核)",
      "items": {
        "type": "object",
        "required": ["title", "from", "to"],
        "properties": { "title": { "$ref": "#/$defs/text" }, "from": { "type": "integer", "minimum": 1 }, "to": { "type": "integer", "minimum": 1 } }
      }
    },
    "chapters": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2000,
      "description": "no 从 1 连续;file = chapters/ + 章号补零到三位 + .json(校验器核)",
      "items": {
        "type": "object",
        "required": ["no", "file", "title"],
        "properties": {
          "no": { "type": "integer", "minimum": 1 },
          "file": { "type": "string", "pattern": "^chapters/\\d{3,}\\.json$" },
          "title": { "$ref": "#/$defs/text" },
          "subtitle": { "$ref": "#/$defs/text" },
          "summary": { "type": "string", "pattern": "^[^\\r\\n]*\\S[^\\r\\n]*$", "x-deskbook-maxChars": 80, "description": "一句话说这一章,一行,列表里显示" },
          "minutes": { "type": "number", "exclusiveMinimum": 0 },
          "author": { "$ref": "#/$defs/text" },
          "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
          "head": { "$ref": "#/$defs/image", "description": "章题头图,建议横版 3:2,不带文字" }
        }
      }
    },
    "mindmap": { "const": "mindmap.json", "description": "有全书脑图时写这一项,路径固定(§10)" },
    "generator": { "type": "string" }
  },
  "$defs": {
    "text": { "type": "string", "pattern": "\\S" },
    "color": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" },
    "image": { "type": "string", "pattern": "^media/([a-z0-9_-][a-z0-9._-]*/)*[a-z0-9_-][a-z0-9._-]*\\.(jpg|png|webp)$" }
  }
}
