# Dependencies
node_modules

# Data pipeline cache
scripts/.cache

# Build output
dist
dist-ssr
public/content/
public/sitemap.xml
public/robots.txt
public/sitemaps/
public/llms.txt
public/feed.xml

# Local env files
*.local
.dev.vars

# Local wrangler dev state (D1 sqlite, etc.)
.wrangler/

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Claude Code local settings
.claude/settings.local.json

# Editor / OS
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# 生成的临时 workflow 脚本(由 gen-zhuzi-wf.mjs / gen-baihua-wf.mjs 产出,可重生)
scripts/.*-translate-wf.js
scripts/.baihua-*-wf.js

# Stray root-level fetch cache (recon)
.cache/

# 白话通宵编排尝试计数(run-state,可重生)
scripts/.baihua-attempts.json
.ios-ship.env
.baidu.env
.search-console.json
.polish-*
scripts/.polish-*

scripts/.bold-*

# 观书并发产出的中转文件(由 scripts/merge-books.mjs 合并进 index.json 后删除)
src/data/books/*/_entry.json

# 安卓签名密钥 —— 本仓库是 PUBLIC 的,keystore 一旦推上去等于把签名权公开;
# 而它丢了也不可恢复(iOS 证书能让 Apple 重签,安卓不能),必须备份到本机之外。
*.keystore
*.jks
android/keystore.properties
android/app/*.keystore

# agent 走查时用的临时文件,别再误提交
.tmp-*

# 观数白话代理复核的分片输入 / 输出与 workflow 脚本(scripts/mingli-review-prep.mjs 生成)
scripts/.mingli-review/
scripts/.mingli-*-wf*.js

# 白话代理复核(各组通用,scripts/baihua-review-prep.mjs 生成)的分片输入 / 输出
scripts/.baihua-review/

# 每周流量周报(scripts/weekly-report.mjs)输出:流量与地区数据,公开仓库不入库
reports/

# 观象 · 书桌:内容包是构建产物(scripts/build-desk-packs.mjs);Xcode 工程与 Info.plist 由 xcodegen 从 project.yml 生成
public/desk/
apps/desk/Desk.xcodeproj/
apps/desk/Desk/Info.plist
