{
  "name": "hexagram",
  "private": true,
  "version": "1.32.0",
  "type": "module",
  "description": "观象 — 个人学习站(首个模块:易经研习)",
  "scripts": {
    "content:build": "node scripts/build-content-assets.mjs",
    "check-links": "npm run content:build && node scripts/check-links.mjs",
    "dev": "npm run content:build && vite",
    "build": "npm run content:build && vite build",
    "preview": "vite preview",
    "test": "vitest run --passWithNoTests",
    "data:fetch": "node scripts/fetch-data.mjs",
    "check-data": "node scripts/check-data.mjs",
    "data:fetch-dao": "node scripts/fetch-dao.mjs",
    "data:fetch-ru": "node scripts/fetch-corpus.mjs ru",
    "data:fetch-fo": "node scripts/fetch-corpus.mjs fo",
    "data:fetch-shili": "node scripts/fetch-shili.mjs",
    "build:cap": "npm run content:build && VITE_CAP=1 vite build",
    "cap:sync": "npm run content:build && VITE_CAP=1 vite build && npx cap sync",
    "cap:ios": "npm run content:build && VITE_CAP=1 vite build && npx cap sync ios && npx cap open ios",
    "deploy:cf": "npm run build && npx wrangler pages deploy dist --project-name=hexagram"
  },
  "dependencies": {
    "@capacitor/android": "^8.4.1",
    "@capacitor/app": "^8.1.0",
    "@capacitor/cli": "^8.4.1",
    "@capacitor/core": "^8.4.1",
    "@capacitor/ios": "^8.4.1",
    "@capacitor/splash-screen": "^8.0.1",
    "@capacitor/status-bar": "^8.0.2",
    "@capawesome/capacitor-app-shortcuts": "^8.0.1",
    "@fontsource/noto-serif-sc": "^5.2.9",
    "lunar-javascript": "^1.7.7",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.6.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.0.0",
    "opencc-js": "^1.0.5",
    "vite": "^7.0.0",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^3.2.4"
  }
}
