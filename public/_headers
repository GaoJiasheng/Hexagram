# Cloudflare Pages — 缓存策略(对齐 nginx:带 hash 的资源永久 immutable、入口/SW 不缓存,发布即生效)
/assets/*
  Cache-Control: public, max-age=31536000, immutable

/index.html
  Cache-Control: no-cache, no-store, must-revalidate

/sw.js
  Cache-Control: no-cache, no-store, must-revalidate

/manifest.webmanifest
  Cache-Control: no-cache

# 观书是管理员专属内容(functions/_middleware.js 鉴权)。
# 必须 private + no-store:否则一旦被 CDN / 代理 / 浏览器共享缓存留下副本,
# 后续匿名请求可能直接命中缓存、根本不经过那道闸 —— 鉴权就白做了。
/content/books/*
  Cache-Control: private, no-store
  X-Robots-Tag: noindex, nofollow

/books/*
  Cache-Control: private, no-store
  X-Robots-Tag: noindex, nofollow
